// Set up SysV INTEGER call arguments from fixed frame slots [rbp-offset].
// The locations come from the integrated C8 sysv_integer_args.plan; memory
// operands from the integrated CR8 nasm_memory_operand.encode; decimal byte
// counts from the integrated CR4 decimal_integer. Order: "sub rsp, N" (when
// any stack words), every STACK word through RAX in word order, then every
// REGISTER word in word order, so RAX scratch never clobbers a loaded argument.
// cleanup emits the matching "add rsp, N". Everything is built in local
// scratch; out and the result object are written once, after every check.
module bootstrap.nasm_sysv_call_args;
import bootstrap.sysv_integer_args as abi;
import bootstrap.nasm_memory_operand as mem;
import bootstrap.decimal_integer as dec;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
pub struct Result{pub written:usize,pub stack_bytes:usize}
pub const MAX_WORDS:usize=16;
const MAX:u64=0xffff_ffff_ffff_ffff;
const RBP:u64=5;const RSP:u64=4;
// Length bound (all 16 words, offsets up to 4096, stack index at most 15*8=120):
//   STACK word: "mov rax, qword " (15) + "[rbp - 4096]" (12) + "\n" (1) = 28
//             + "mov qword " (10) + "[rsp + 120]" (11) + ", rax\n" (6)  = 27  -> 55
//   REGISTER word: "mov " (4) + "rdi" (3) + ", qword " (8) + 12 + "\n" (1) = 28 <= 55
//   "sub rsp, " (9) + at most 3 digits + "\n" (1) = 13
//   total <= 13 + 16*55 = 893 < TEXT. Every append is still bounds-checked.
const TEXT:usize=1024;
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn argument(index:usize)[]const u8{
 if index==0{return "rdi";}if index==1{return "rsi";}if index==2{return "rdx";}
 if index==3{return "rcx";}if index==4{return "r8";}return "r9";
}
// Append text at *at within out[0..limit); false (without writing) if it would not fit.
unsafe fn put(out:[]u8,at:*usize,text:[]const u8)bool{unsafe{
 if text.len>out.len-*at{return false;}
 var i:usize=0;while i<text.len{out[*at+i]=text[i];i+=1;}*at+=text.len;return true;
}}
// CR8 operand "[base +/- disp]" appended at *at.
unsafe fn operand(out:[]u8,at:*usize,base:u64,displacement:i64)bool{unsafe{
 var text:[32]u8=[0;32];var n:usize=0;
 if mem.encode(base,displacement,slice_from_raw_parts(&text[0],32),&n)!=mem.OK{return false;}
 return put(out,at,slice_from_raw_parts(&text[0],n));
}}
unsafe fn number(out:[]u8,at:*usize,value:u64)bool{unsafe{
 var text:[24]u8=[0;24];var n:usize=0;
 if dec.encode(value,64,false,slice_from_raw_parts(&text[0],24),&n)!=dec.OK{return false;}
 return put(out,at,slice_from_raw_parts(&text[0],n));
}}
pub unsafe fn setup(kinds:[]const u8,source_offsets:[]const usize,out:[]u8,result:*Result)u64{unsafe{
 let rp=result as u64;let kp=kinds.ptr as u64;let sp=source_offsets.ptr as u64;let op=out.ptr as u64;let rn=sizeof(Result);
 if result==null||(rp&7)!=0||!span(rp,rn){return INVALID;}
 if source_offsets.len>MAX/8{return INVALID;}
 let kn=kinds.len;let sn=source_offsets.len*8;let on=out.len;
 if !span(kp,kn)||!span(sp,sn)||(sn!=0&&(sp&7)!=0)||!span(op,on){return INVALID;}
 // Inputs may overlap each other; out and result are disjoint from both inputs and from each other.
 if overlap(kp,kn,op,on)||overlap(kp,kn,rp,rn)||overlap(sp,sn,op,on)||overlap(sp,sn,rp,rn)||overlap(op,on,rp,rn){return INVALID;}
 if kinds.len>MAX_WORDS{return INVALID;}
 var words:usize=0;var i:usize=0;
 while i<kinds.len{let k=kinds[i];if k==0{words+=1;}else if k==1{words+=2;}else{return INVALID;}i+=1;}
 if words>MAX_WORDS||source_offsets.len!=words{return INVALID;}
 i=0;while i<words{let o=source_offsets[i];if o<8||o>4096||(o&7)!=0{return INVALID;}i+=1;}
 var locations:[16]abi.Location=[abi.Location{kind:0,index:0};16];var plan=abi.Result{used:0,stack_bytes:0};
 if abi.plan(kinds,slice_from_raw_parts(&locations[0],MAX_WORDS),&plan)!=abi.OK||plan.used!=words{return INVALID;}
 var buffer:[1024]u8=[0;1024];let text=slice_from_raw_parts(&buffer[0],TEXT);var at:usize=0;
 if plan.stack_bytes!=0{
  if !put(text,&at,"sub rsp, ")||!number(text,&at,plan.stack_bytes as u64)||!put(text,&at,"\n"){return INVALID;}
 }
 i=0;
 while i<words{
  if locations[i].kind==abi.STACK{
   let di=locations[i].index;
   if !put(text,&at,"mov rax, qword ")||!operand(text,&at,RBP,-(source_offsets[i]as i64))||!put(text,&at,"\n")
    ||!put(text,&at,"mov qword ")||!operand(text,&at,RSP,di as i64)||!put(text,&at,", rax\n"){return INVALID;}
  }
  i+=1;
 }
 i=0;
 while i<words{
  if locations[i].kind==abi.REGISTER{
   if !put(text,&at,"mov ")||!put(text,&at,argument(locations[i].index))||!put(text,&at,", qword ")
    ||!operand(text,&at,RBP,-(source_offsets[i]as i64))||!put(text,&at,"\n"){return INVALID;}
  }
  i+=1;
 }
 if at>out.len{return CAPACITY;}
 i=0;while i<at{out[i]=buffer[i];i+=1;}
 *result=Result{written:at,stack_bytes:plan.stack_bytes};return OK;
}}
pub unsafe fn cleanup(stack_bytes:usize,out:[]u8,written:*usize)u64{unsafe{
 let wp=written as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8){return INVALID;}
 if !span(op,out.len){return INVALID;}
 if overlap(wp,8,op,out.len){return INVALID;}
 if stack_bytes>128||(stack_bytes&15)!=0{return INVALID;}
 // "add rsp, 128\n" is at most 13 bytes.
 var buffer:[32]u8=[0;32];let text=slice_from_raw_parts(&buffer[0],32);var at:usize=0;
 if stack_bytes!=0{
  if !put(text,&at,"add rsp, ")||!number(text,&at,stack_bytes as u64)||!put(text,&at,"\n"){return INVALID;}
 }
 if at>out.len{return CAPACITY;}
 var i:usize=0;while i<at{out[i]=buffer[i];i+=1;}
 *written=at;return OK;
}}

 if which==0{CATALOG_STORAGE.incarnation[CURRENT]=value;}else if which==1{CATALOG_STORAGE.configuration[CURRENT]=value;}
 else if which==2{memory.PROCESSES[CURRENT].root=value;}else if which==3{memory.GENERATION=value;}
 else if which==4{memory.PROCESSES[CURRENT].ready=value;}else if which==5{CATALOG=null;}
 else if which==6{SMP_ENABLED=value!=0;}else if which==7{CURRENT=value as usize;}
 else if which==30{CATALOG_STORAGE.incarnation[CURRENT]=value;CATALOG_STORAGE.states[CURRENT].process=(value<<8)|(CURRENT as u64+1);}
 else if which==31{CATALOG_STORAGE.ready=value;}else if which==32{CATALOG_STORAGE.count=value as usize;}
 else if which==33{CATALOG_STORAGE.slot[CURRENT]=value;}else if which==34{CATALOG_STORAGE.states[CURRENT].configuration=value;}
 else if which==35{CATALOG_STORAGE.states[CURRENT].process=value;}else if which==36{CATALOG_STORAGE.states[CURRENT].state=value;}

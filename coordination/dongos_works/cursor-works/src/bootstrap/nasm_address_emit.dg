// Emit one NASM lea of base+displacement into a 64-bit register.
// Address text comes from CR8 nasm_memory_operand.encode into stack
// scratch first so failures never leave a half-written instruction.
// INVALID precedes CAPACITY.
module bootstrap.nasm_address_emit;
import bootstrap.nasm_memory_operand as mem;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
const MAX:u64=0xffff_ffff_ffff_ffff;
const I32_MIN:i64=-2147483648;
const I32_MAX:i64=2147483647;
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn reg64_len(r:u64)usize{
 if r<=7{return 3;}
 if r<=9{return 2;}
 return 3;
}
fn write_reg64(out:[]u8,at:usize,r:u64)usize{
 if r==0{out[at]=114;out[at+1]=97;out[at+2]=120;return at+3;}
 if r==1{out[at]=114;out[at+1]=99;out[at+2]=120;return at+3;}
 if r==2{out[at]=114;out[at+1]=100;out[at+2]=120;return at+3;}
 if r==3{out[at]=114;out[at+1]=98;out[at+2]=120;return at+3;}
 if r==4{out[at]=114;out[at+1]=115;out[at+2]=112;return at+3;}
 if r==5{out[at]=114;out[at+1]=98;out[at+2]=112;return at+3;}
 if r==6{out[at]=114;out[at+1]=115;out[at+2]=105;return at+3;}
 if r==7{out[at]=114;out[at+1]=100;out[at+2]=105;return at+3;}
 if r==8{out[at]=114;out[at+1]=56;return at+2;}
 if r==9{out[at]=114;out[at+1]=57;return at+2;}
 if r==10{out[at]=114;out[at+1]=49;out[at+2]=48;return at+3;}
 if r==11{out[at]=114;out[at+1]=49;out[at+2]=49;return at+3;}
 if r==12{out[at]=114;out[at+1]=49;out[at+2]=50;return at+3;}
 if r==13{out[at]=114;out[at+1]=49;out[at+2]=51;return at+3;}
 if r==14{out[at]=114;out[at+1]=49;out[at+2]=52;return at+3;}
 out[at]=114;out[at+1]=49;out[at+2]=53;return at+3;
}
fn copy(out:[]u8,at:usize,text:[]const u8)usize{
 var i:usize=0;while i<text.len{out[at+i]=text[i];i+=1;}return at+text.len;
}
pub unsafe fn emit(destination:u64,base:u64,displacement:i64,out:[]u8,written:*usize)u64{unsafe{
 let wp=written as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8){return INVALID;}
 if !span(op,out.len){return INVALID;}
 if overlap(wp,8,op,out.len){return INVALID;}
 if destination>15||base>15{return INVALID;}
 if displacement<I32_MIN||displacement>I32_MAX{return INVALID;}
 var ob:[64]u8=[0;64];var ow:usize=0;
 let osl=slice_from_raw_parts(&ob[0],64);
 let ms=mem.encode(base,displacement,osl,&ow);
 if ms!=OK{return ms;}
 let dl=reg64_len(destination);
 // "lea " + dest + ", " + operand + LF
 if 4>MAX-dl{return INVALID;}let a1=4+dl;
 if 2>MAX-a1{return INVALID;}let a2=a1+2;
 if ow>MAX-a2{return INVALID;}let a3=a2+ow;
 if 1>MAX-a3{return INVALID;}let total=a3+1;
 if total>out.len{return CAPACITY;}
 out[0]=108;out[1]=101;out[2]=97;out[3]=32;
 var at=write_reg64(out,4,destination);
 out[at]=44;out[at+1]=32;at+=2;
 at=copy(out,at,slice_from_raw_parts(&ob[0],ow));
 out[at]=10;
 *written=total;return OK;
}}

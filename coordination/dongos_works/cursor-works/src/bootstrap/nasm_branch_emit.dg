// Emit NASM conditional/unconditional jumps from an integrated CR6 Plan.
// Calls bootstrap.branch_plan.plan and CR4 decimal_integer for block labels.
// All descriptors, plans, and need length finish before any user-out write.
module bootstrap.nasm_branch_emit;
import bootstrap.branch_plan as bp;
import bootstrap.decimal_integer as dec;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
const MAX:u64=0xffff_ffff_ffff_ffff;
const LAB:usize=8; // "__dong_b"
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn copy(out:[]u8,at:usize,text:[]const u8)usize{
 var i:usize=0;while i<text.len{out[at+i]=text[i];i+=1;}return at+text.len;
}
fn write_lab(out:[]u8,at:usize)usize{
 out[at]=95;out[at+1]=95;out[at+2]=100;out[at+3]=111;out[at+4]=110;out[at+5]=103;out[at+6]=95;out[at+7]=98;
 return at+8;
}
fn mnem_len(cond:u64)usize{
 if cond==1||cond==3||cond==5||cond==7||cond==9{return 3;}
 if cond<=9{return 2;}
 return 0;
}
fn write_mnem(out:[]u8,at:usize,cond:u64)usize{
 if cond==0{out[at]=106;out[at+1]=101;return at+2;}
 if cond==1{out[at]=106;out[at+1]=110;out[at+2]=101;return at+3;}
 if cond==2{out[at]=106;out[at+1]=98;return at+2;}
 if cond==3{out[at]=106;out[at+1]=98;out[at+2]=101;return at+3;}
 if cond==4{out[at]=106;out[at+1]=97;return at+2;}
 if cond==5{out[at]=106;out[at+1]=97;out[at+2]=101;return at+3;}
 if cond==6{out[at]=106;out[at+1]=108;return at+2;}
 if cond==7{out[at]=106;out[at+1]=108;out[at+2]=101;return at+3;}
 if cond==8{out[at]=106;out[at+1]=103;return at+2;}
 out[at]=106;out[at+1]=103;out[at+2]=101;return at+3;
}
pub unsafe fn emit(condition:u64,yes:u64,no:u64,fallthrough:u64,out:[]u8,written:*usize)u64{unsafe{
 let wp=written as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8){return INVALID;}
 if !span(op,out.len){return INVALID;}
 if overlap(wp,8,op,out.len){return INVALID;}
 var plan:bp.Plan=bp.Plan{has_cond:0,condition:0,cond_target:0,has_jump:0,jump_target:0};
 let ps=bp.plan(condition,yes,no,fallthrough,&plan);
 if ps!=OK{return INVALID;}
 var cbuf:[20]u8=[0;20];var jbuf:[20]u8=[0;20];var cw:usize=0;var jw:usize=0;
 var cond_len:usize=0;var jump_len:usize=0;
 if plan.has_cond!=0{
  let ml=mnem_len(plan.condition);
  if ml==0{return INVALID;}
  let sc=dec.encode(plan.cond_target,64,false,slice_from_raw_parts(&cbuf[0],20),&cw);
  if sc!=OK{return sc;}
  // mnemonic + ' ' + __dong_b + digits + LF
  if ml>MAX-1{return INVALID;}
  if LAB>MAX-(ml+1){return INVALID;}
  if cw>MAX-(ml+1+LAB){return INVALID;}
  if 1>MAX-(ml+1+LAB+cw){return INVALID;}
  cond_len=ml+1+LAB+cw+1;
 }
 if plan.has_jump!=0{
  let sj=dec.encode(plan.jump_target,64,false,slice_from_raw_parts(&jbuf[0],20),&jw);
  if sj!=OK{return sj;}
  // "jmp " + __dong_b + digits + LF
  if 4>MAX-LAB{return INVALID;}
  if jw>MAX-(4+LAB){return INVALID;}
  if 1>MAX-(4+LAB+jw){return INVALID;}
  jump_len=4+LAB+jw+1;
 }
 if cond_len>MAX-jump_len{return INVALID;}
 let total=cond_len+jump_len;
 if total==0{*written=0;return OK;}
 if total>out.len{return CAPACITY;}
 var at:usize=0;
 if plan.has_cond!=0{
  at=write_mnem(out,at,plan.condition);
  out[at]=32;at+=1;
  at=write_lab(out,at);
  at=copy(out,at,slice_from_raw_parts(&cbuf[0],cw));
  out[at]=10;at+=1;
 }
 if plan.has_jump!=0{
  out[at]=106;out[at+1]=109;out[at+2]=112;out[at+3]=32;at+=4;
  at=write_lab(out,at);
  at=copy(out,at,slice_from_raw_parts(&jbuf[0],jw));
  out[at]=10;at+=1;
 }
 *written=total;return OK;
}}

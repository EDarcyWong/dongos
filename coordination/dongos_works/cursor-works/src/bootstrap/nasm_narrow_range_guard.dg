// NASM debug narrow arithmetic range guard for a full 64-bit RAX result.
// signed:   mov r11,<min>; cmp rax,r11; jl trap; mov r11,<max>; cmp rax,r11; jg trap
// unsigned: mov r11,<max>; cmp rax,r11; ja trap
// Width is only 8/16/32. Decimals reuse integrated CR4. Built in a local
// 256-byte buffer, copied to out after every check.
module bootstrap.nasm_narrow_range_guard;
import bootstrap.decimal_integer as dec;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
pub const NONE:u64=0xffff_ffff_ffff_ffff;
const MAX:u64=0xffff_ffff_ffff_ffff;
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn copy(out:[]u8,at:usize,text:[]const u8)usize{
 var i:usize=0;while i<text.len{out[at+i]=text[i];i+=1;}return at+text.len;
}
fn width_ok(w:u64)bool{return w==8||w==16||w==32;}
fn min_bits(width:u64)u64{
 // 64-bit two's-complement bits for signed lower bound.
 if width==8{return 0xffff_ffff_ffff_ff80;}
 if width==16{return 0xffff_ffff_ffff_8000;}
 return 0xffff_ffff_8000_0000;
}
fn max_mag(width:u64,signed:bool)u64{
 if signed{
  if width==8{return 127;}
  if width==16{return 32767;}
  return 2147483647;
 }
 if width==8{return 255;}
 if width==16{return 65535;}
 return 4294967295;
}
pub unsafe fn emit(width:u64,signed:bool,trap_block:u64,out:[]u8,written:*usize)u64{unsafe{
 let wp=written as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8){return INVALID;}
 if !span(op,out.len){return INVALID;}
 if overlap(wp,8,op,out.len){return INVALID;}
 if !width_ok(width)||trap_block==NONE{return INVALID;}
 var tdig:[24]u8=[0;24];var tcount:usize=0;
 let ts=dec.encode(trap_block,64,false,slice_from_raw_parts(&tdig[0],24),&tcount);
 if ts!=dec.OK{return INVALID;}
 var maxdig:[24]u8=[0;24];var maxcount:usize=0;
 let ms=dec.encode(max_mag(width,signed),64,false,slice_from_raw_parts(&maxdig[0],24),&maxcount);
 if ms!=dec.OK{return INVALID;}
 // Longest signed i32 / 20-digit trap: 131 bytes (see .md). Local 256 suffices.
 var text:[256]u8=[0;256];let buffer=slice_from_raw_parts(&text[0],256);
 var at:usize=0;
 if signed{
  var mindig:[24]u8=[0;24];var mincount:usize=0;
  let ns=dec.encode(min_bits(width),64,true,slice_from_raw_parts(&mindig[0],24),&mincount);
  if ns!=dec.OK{return INVALID;}
  at=copy(buffer,0,"mov r11, ");
  at=copy(buffer,at,slice_from_raw_parts(&mindig[0],mincount));buffer[at]=10;at+=1;
  at=copy(buffer,at,"cmp rax, r11\n");
  at=copy(buffer,at,"jl __dong_b");
  at=copy(buffer,at,slice_from_raw_parts(&tdig[0],tcount));buffer[at]=10;at+=1;
  at=copy(buffer,at,"mov r11, ");
  at=copy(buffer,at,slice_from_raw_parts(&maxdig[0],maxcount));buffer[at]=10;at+=1;
  at=copy(buffer,at,"cmp rax, r11\n");
  at=copy(buffer,at,"jg __dong_b");
  at=copy(buffer,at,slice_from_raw_parts(&tdig[0],tcount));buffer[at]=10;at+=1;
 }else{
  at=copy(buffer,0,"mov r11, ");
  at=copy(buffer,at,slice_from_raw_parts(&maxdig[0],maxcount));buffer[at]=10;at+=1;
  at=copy(buffer,at,"cmp rax, r11\n");
  at=copy(buffer,at,"ja __dong_b");
  at=copy(buffer,at,slice_from_raw_parts(&tdig[0],tcount));buffer[at]=10;at+=1;
 }
 if at>out.len{return CAPACITY;}
 var i:usize=0;while i<at{out[i]=buffer[i];i+=1;}
 *written=at;return OK;
}}

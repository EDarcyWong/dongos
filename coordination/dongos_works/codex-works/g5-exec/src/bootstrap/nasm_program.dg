   }else if x.operation==ir.ADDRESS||x.operation==ir.LOAD||x.operation==ir.OFFSET||x.operation==ir.BRANCH{
    if !offset(x.a,1,f.frame_bytes){return false;}
   }else if x.operation==ir.STORE||x.operation==ir.INDEX||x.operation==ir.BINARY{
    if !offset(x.a,1,f.frame_bytes)||!offset(x.b,1,f.frame_bytes){return false;}
    if x.operation==ir.STORE&&!offset(x.b,words,f.frame_bytes){return false;}
    if x.operation==ir.INDEX&&x.extra!=0&&!offset(x.extra,1,f.frame_bytes){return false;}
   }else if x.operation==ir.RETURN{if words!=0&&!offset(x.a,words,f.frame_bytes){return false;}}
   if x.operation==ir.LABEL||x.operation==ir.JUMP||x.operation==ir.BRANCH{if x.value>=(*p).block_count{return false;}}
   if x.operation==ir.BRANCH&&x.extra>=(*p).block_count{return false;}
   if x.operation==ir.CALL||x.operation==ir.INDIRECT_CALL{
    if x.a>(*p).arguments.len||x.b>(*p).arguments.len-x.a{return false;}
    if x.operation==ir.CALL{if x.value>=(*g).symbols.len||((*g).symbols[x.value].kind!=names.FUNCTION&&(*g).symbols[x.value].kind!=names.METHOD){return false;}}
    else if !offset(x.extra,1,f.frame_bytes)||x.value>=(*g).types.len||(*g).types[x.value].kind!=sem.FUNCTION{return false;}
    if words!=0&&!offset(x.destination,words,f.frame_bytes){return false;}
    var k:usize=0;while k<x.b{let a=(*p).arguments[x.a+k];let aw=ir.words(g,a.typ);if aw==0||aw==NONE||!offset(a.offset,aw,f.frame_bytes){return false;}k+=1;}
   }
   if x.operation==ir.ASM{if words!=0||x.value>7{return false;}}
   if x.operation==ir.MEMORY{
    if x.value<4||x.value>12||x.a>(*p).arguments.len||x.b>(*p).arguments.len-x.a{return false;}
    var arity:usize=2;if x.value==12{arity=0;}else if x.value==10{arity=3;}else if x.value==4||x.value==6||x.value==8{arity=1;}
    if x.b!=arity{return false;}
    if x.value==12{if words!=0{return false;}}
    else{if x.extra>=8{return false;}let ptr=(*p).arguments[x.a];
     if ptr.typ>=(*g).types.len||(*g).types[ptr.typ].kind!=sem.POINTER||(*g).types[ptr.typ].element!=x.extra{return false;}
     if x.value>=8&&x.extra!=2&&x.extra!=3{return false;}
     let writing=x.value==5||x.value==7||x.value==9||x.value==10||x.value==11;
     if writing&&((*g).types[ptr.typ].flags&1)!=0{return false;}
     let returns=x.value!=5&&x.value!=7&&x.value!=9;
     if returns{if x.typ!=x.extra||!offset(x.destination,1,f.frame_bytes){return false;}}else if words!=0{return false;}
     var k:usize=0;while k<x.b{let a=(*p).arguments[x.a+k];if !offset(a.offset,1,f.frame_bytes)||(k!=0&&a.typ!=x.extra){return false;}k+=1;}
    }
   }j+=1;
  }i+=1;
 }return true;
}}
pub unsafe fn emit(p:*const ir.Program,w:*const Workspace,out:[]u8,written:*usize)u64{unsafe{
 if !descriptors(p,w,out,written)||!valid(p){return INVALID;}
 if (*w).piece.len<1024{return CAPACITY;}
 var s=State{p:p,w:w,at:0,status:0,frame_bytes:0,trap:0,next_block:(*p).block_count,stack_extra:0};
 put(&s,"bits 64\ndefault rel\nsection .text\n");var i:usize=0;
 let g=(*p).graph;while i<(*g).symbols.len&&s.status==0{let sy=(*g).symbols[i];
  if (sy.kind==names.FUNCTION||sy.kind==names.METHOD)&&(*g).nodes[(*g).units[sy.unit].node_start+sy.declaration].c==NONE{
   put(&s,"extern ");symbol(&s,i);put(&s,"\n");
  }i+=1;
 }i=0;
 while i<(*p).functions.len&&s.status==0{let f=(*p).functions[i];s.frame_bytes=f.frame_bytes;s.trap=f.trap_block;
  s.stack_extra=0;
  export_aliases(&s,f.symbol);put(&s,"global ");symbol(&s,f.symbol);put(&s,"\n");symbol(&s,f.symbol);put(&s,":\n");
  let sy=(*g).symbols[f.symbol];let ft=(*g).types[(*g).node_types[(*g).units[sy.unit].node_start+sy.declaration]];
  if (ft.flags&1)!=0{win_wrapper(&s,&f);win_body(&s,f.symbol);put(&s,":\n");}
  var n:usize=0;let status=frame.prologue(f.frame_bytes,0,(*w).piece,&n);piece(&s,status,n);put(&s,"cld\n");incoming(&s,&f);
  var j:usize=0;while j<f.count&&s.status==0{instruction(&s,&(*p).instructions[f.first+j]);j+=1;}
  // No unsupported/dead-tail path is permitted to fall into the next body.
  put(&s,"ud2\n");label(&s,0,f.trap_block);put(&s,"ud2\n");i+=1;
 }
 put(&s,"section .rodata\n");var u:usize=0;while u<(*(*p).graph).units.len{let unit=(*(*p).graph).units[u];var j:usize=0;while j<unit.node_count{let node=(*(*p).graph).nodes[unit.node_start+j];
  if node.kind==ast.STRING{let token=(*(*p).graph).tokens[unit.token_start+node.token];string_label(&s,u,j);put(&s,": db ");var b:usize=0;
   while b<token.value_length{if b!=0{put(&s,",");}number(&s,(*(*p).graph).strings[unit.string_start+token.value_start+b]as u64);b+=1;}
   if token.value_length==0{put(&s,"0");}put(&s,"\n");}j+=1;}u+=1;}
 static_constants(&s);static_globals(&s);
 put(&s,"%ifidn __OUTPUT_FORMAT__,elf64\nsection .note.GNU-stack noalloc noexec nowrite progbits\n%endif\n");
 if s.status!=0{return s.status;}if out.len<s.at{return CAPACITY;}
 i=0;while i<s.at{out[i]=(*w).text[i];i+=1;}*written=s.at;return OK;
}}

   if x.operation==ir.CONSTANT&&words!=1{return false;}
   if x.operation>=ir.ZERO&&x.operation<=ir.FUNCTION_ADDRESS{var destination_words=words;if x.operation==ir.STATIC_ADDRESS{destination_words=1;}if !offset(x.destination,destination_words,f.frame_bytes){return false;}
    if x.operation==ir.FUNCTION_ADDRESS{if x.value>=(*g).symbols.len||(*g).symbols[x.value].kind!=names.FUNCTION||x.typ>=(*g).types.len||(*g).types[x.typ].kind!=sem.FUNCTION||words!=1{return false;}}
    if x.operation==ir.TAGGED{

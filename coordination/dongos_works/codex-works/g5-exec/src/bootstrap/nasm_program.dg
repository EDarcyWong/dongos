    }
    if x.operation==ir.STATIC_ADDRESS{if x.value>=(*g).symbols.len||((*g).symbols[x.value].kind!=names.CONST&&(*g).symbols[x.value].kind!=names.GLOBAL){return false;}}
    if x.operation==ir.SUBSLICE{if x.typ>=(*g).types.len||(*g).types[x.typ].kind!=sem.SLICE||words!=2||!offset(x.a,1,f.frame_bytes)||!offset(x.b,1,f.frame_bytes)||!offset(x.value,1,f.frame_bytes)||!offset(x.extra,1,f.frame_bytes){return false;}}

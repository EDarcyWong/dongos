  Region{p:(*g).arena.ptr as u64,n:(*g).arena.len},Region{p:(*g).sources.ptr as u64,n:(*g).sources.len*40},
  Region{p:(*p).functions.ptr as u64,n:(*p).functions.len*sizeof(ir.Function)},
  Region{p:(*p).instructions.ptr as u64,n:(*p).instructions.len*sizeof(ir.Instruction)},
  Region{p:(*p).arguments.ptr as u64,n:(*p).arguments.len*sizeof(ir.Argument)}];

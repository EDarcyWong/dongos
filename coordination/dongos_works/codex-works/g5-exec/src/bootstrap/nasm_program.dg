    if x.operation==ir.STRING{if words!=2||x.unit>=(*g).units.len{return false;}let u=(*g).units[x.unit];if x.node>=u.node_count{return false;}let a=(*g).nodes[u.node_start+x.node];if a.kind!=ast.STRING{return false;}}

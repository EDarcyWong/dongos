// General typed slot IR -> complete NASM module. All component text is emitted
// by native Dong; the caller owns scratch and the final output is atomic.
module bootstrap.nasm_program;
import bootstrap.program_ir as ir;
import bootstrap.nasm_memmove as memmove;
import bootstrap.expression as ast;
import bootstrap.frontend as frontend;
import bootstrap.semantic_types as sem;
import bootstrap.names as names;
import bootstrap.binding as binding;
import bootstrap.sysv_integer_args as abi;
import bootstrap.nasm_symbol as symbols;
import bootstrap.nasm_integer_load as imm;
import bootstrap.nasm_integer_memory_load as memload;
import bootstrap.nasm_integer_memory_store as memstore;
import bootstrap.nasm_address_emit as addr;
import bootstrap.nasm_function_frame as frame;
import bootstrap.nasm_integer_binary as binary;
import bootstrap.nasm_integer_unary as unary;
import bootstrap.nasm_integer_cast as cast;
import bootstrap.nasm_compare_emit as compare;
import bootstrap.nasm_checked_add_sub as checked;
import bootstrap.nasm_checked_multiply as multiply;
import bootstrap.nasm_narrow_range_guard as narrow;
import bootstrap.nasm_bounds_guard as bounds;
import bootstrap.nasm_block_emit as blocks;
import bootstrap.nasm_branch_emit as branches;
import bootstrap.nasm_shift_guard as shiftguard;
import bootstrap.nasm_variable_shift as shift;
import bootstrap.nasm_division_guard as divguard;
import bootstrap.nasm_integer_divide as divide;
import bootstrap.decimal_integer as decimal;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;pub const UNSUPPORTED:u64=3;pub const FRAME:u64=4;
const NONE:usize=0xffff_ffff_ffff_ffff;
pub struct Workspace{pub text:[]u8,pub piece:[]u8,pub kinds:[]u8,pub locations:[]abi.Location}
struct State{p:*const ir.Program,w:*const Workspace,at:usize,status:u64,frame_bytes:usize,trap:usize,next_block:usize,stack_extra:usize}
struct Region{p:u64,n:usize}
fn span(p:u64,n:usize)bool{return n==0||(p!=0&&n<=NONE-p);}
fn overlap(a:u64,n:usize,b:u64,m:usize)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn equal(a:[]const u8,b:[]const u8)bool{
 if a.len!=b.len{return false;}var i:usize=0;while i<a.len{if a[i]!=b[i]{return false;}i+=1;}return true;
}
unsafe fn put(s:*State,text:[]const u8)bool{unsafe{
 if (*s).status!=0{return false;}
 if text.len>(*(*s).w).text.len-(*s).at{(*s).status=CAPACITY;return false;}
 var i:usize=0;while i<text.len{(*(*s).w).text[(*s).at+i]=text[i];i+=1;}(*s).at+=text.len;return true;
}}
unsafe fn piece(s:*State,status:u64,n:usize)bool{unsafe{
 if (*s).status!=0{return false;}if status!=0||n>(*(*s).w).piece.len{(*s).status=INVALID;return false;}
 return put(s,slice_from_raw_parts((*(*s).w).piece.ptr,n));
}}
unsafe fn load(s:*State,r:u64,base:u64,off:i64,width:usize,signed:bool)bool{unsafe{
 var n:usize=0;let status=memload.emit(r,base,off,width,signed,(*(*s).w).piece,&n);return piece(s,status,n);
}}
unsafe fn store(s:*State,r:u64,base:u64,off:i64,width:usize)bool{unsafe{
 var n:usize=0;let status=memstore.emit(r,base,off,width,(*(*s).w).piece,&n);return piece(s,status,n);
}}
unsafe fn slotload(s:*State,r:u64,off:usize)bool{unsafe{return load(s,r,5,-(off as i64),64,false);}}
unsafe fn slotstore(s:*State,r:u64,off:usize)bool{unsafe{return store(s,r,5,-(off as i64),64);}}
unsafe fn immediate(s:*State,r:u64,value:u64)bool{unsafe{
 var n:usize=0;let status=imm.emit(r,value,64,false,(*(*s).w).piece,&n);return piece(s,status,n);
}}
unsafe fn arithmetic(s:*State,op:u64,d:u64,a:u64)bool{unsafe{
 var n:usize=0;let status=binary.emit(op,d,a,(*(*s).w).piece,&n);return piece(s,status,n);
}}
unsafe fn label(s:*State,kind:u64,b:usize)bool{unsafe{
 var n:usize=0;let status=blocks.emit(kind,b,(*(*s).w).piece,&n);return piece(s,status,n);
}}
unsafe fn branch(s:*State,condition:u64,yes:usize,no:usize)bool{unsafe{
 var n:usize=0;let status=branches.emit(condition,yes,no,NONE,(*(*s).w).piece,&n);return piece(s,status,n);
}}
unsafe fn normalize(s:*State,t:usize)bool{unsafe{
 let g=(*(*s).p).graph;let width=ir.width(g,t);if width==0{(*s).status=UNSUPPORTED;return false;}
 var n:usize=0;let status=cast.emit(0,0,width,ir.signed(g,t),(*(*s).w).piece,&n);return piece(s,status,n);
}}
unsafe fn typed_load(s:*State,t:usize,off:usize)bool{unsafe{
 let g=(*(*s).p).graph;if ir.words(g,t)==2{return slotload(s,0,off)&&slotload(s,2,off-8);}
 let width=ir.width(g,t);if width==0{(*s).status=UNSUPPORTED;return false;}
 return load(s,0,5,-(off as i64),width,ir.signed(g,t));
}}
unsafe fn typed_save(s:*State,t:usize,off:usize)bool{unsafe{
 let words=ir.words((*(*s).p).graph,t);if words==0{return true;}
 if words==NONE{(*s).status=UNSUPPORTED;return false;}
 if !slotstore(s,0,off){return false;}if words==2{return slotstore(s,2,off-8);}return true;
}}
// Link names have already passed the syntax check for ASCII identifiers.
// Only bodyless declarations use them as their primary symbol; definitions
// keep their module identity and publish an optional linker alias separately.
unsafe fn link_name(s:*State,index:usize)bool{unsafe{
 let g=(*(*s).p).graph;let sy=(*g).symbols[index];let u=(*g).units[sy.unit];var i:usize=0;
 while i<u.node_count{let n=(*g).nodes[u.node_start+i];if n.kind==ast.DECLARATION&&n.a==sy.declaration{
  var a=n.b;while a!=NONE{let attr=(*g).nodes[u.node_start+a];var value:usize=NONE;
   if attr.op==271{value=attr.a;}else if attr.op==267{value=attr.b;}
   if value!=NONE{let v=(*g).nodes[u.node_start+value];let token=(*g).tokens[u.token_start+v.token];
    return put(s,"$")&&put(s,slice_from_raw_parts((*g).strings.ptr+u.string_start+token.value_start,token.value_length));}
   a=attr.next;
  }
 }i+=1;}
 return put(s,"$")&&put(s,names.text((*g).sources,(*g).units,(*g).tokens,sy.unit,sy.name_token));
}}
// Names are derived from the checked source catalog, never from host-created
// labels. Each module path is canonical and its declaration has matched it.
fn hex_digit(n:u8)u8{if n<10{return 48+n;}return 87+n;}
unsafe fn symbol(s:*State,index:usize)bool{unsafe{
 let g=(*(*s).p).graph;if index>=(*g).symbols.len{(*s).status=INVALID;return false;}let sy=(*g).symbols[index];
 if (sy.kind==names.FUNCTION||sy.kind==names.METHOD)&&(*g).nodes[(*g).units[sy.unit].node_start+sy.declaration].c==NONE{return link_name(s,index);}
 let path=(*g).sources[(*g).units[sy.unit].source_index].path;
 if path.len<4||path.len-3>256{(*s).status=UNSUPPORTED;return false;}
 var name:[256]u8=[0;256];var i:usize=0;while i<path.len-3{var b=path[i];if b==47{b=46;}name[i]=b;i+=1;}
 let item=names.text((*g).sources,(*g).units,(*g).tokens,sy.unit,sy.name_token);
 var n:usize=0;let status=symbols.encode(slice_from_raw_parts(&name[0],path.len-3),item,(*(*s).w).piece,&n);
 if !piece(s,status,n){return false;}
 if sy.kind==names.METHOD{
  let ft=(*g).node_types[(*g).units[sy.unit].node_start+sy.declaration];let t=(*g).types[ft];
  let receiver=(*g).types[(*g).fields[t.first].typ];let nominal=(*g).types[receiver.element];
  let decl=(*g).nodes[(*g).units[nominal.unit].node_start+nominal.node];
  let name=names.text((*g).sources,(*g).units,(*g).tokens,nominal.unit,decl.token);
  // Ordinary symbols end in hex item bytes. This non-hex separator and the
  // nominal receiver name distinguish methods from free functions and peers.
  put(s,"_t");i=0;while i<name.len{let b=name[i];let pair=[hex_digit(b/16),hex_digit(b%16)];
   put(s,slice_from_raw_parts(&pair[0],2));i+=1;
  }
 }
 return (*s).status==0;
}}
fn reg(index:usize)u64{if index==0{return 7;}if index==1{return 6;}if index==2{return 2;}if index==3{return 1;}return index+4;}
unsafe fn plan(s:*State,first:usize,count:usize,result:*abi.Result)bool{unsafe{
 let p=(*s).p;let w=(*s).w;
 if first>(*p).arguments.len||count>(*p).arguments.len-first{(*s).status=INVALID;return false;}
 if count>(*w).kinds.len{(*s).status=CAPACITY;return false;}
 var i:usize=0;while i<count{let words=ir.words((*p).graph,(*p).arguments[first+i].typ);
  if words!=1&&words!=2{(*s).status=UNSUPPORTED;return false;}(*w).kinds[i]=(words-1)as u8;i+=1;
 }
 let status=abi.plan(slice_from_raw_parts((*w).kinds.ptr,count),(*w).locations,result);
 if status==abi.CAPACITY{(*s).status=CAPACITY;return false;}if status!=abi.OK{(*s).status=INVALID;return false;}return true;
}}
unsafe fn stack_adjust(s:*State,subtract:bool,bytes:usize)bool{unsafe{
 if bytes==0{return true;}if subtract{put(s,"sub rsp, ");}else{put(s,"add rsp, ");}
 var n:usize=0;let status=decimal.encode(bytes,64,false,(*(*s).w).piece,&n);return piece(s,status,n)&&put(s,"\n");
}}
unsafe fn incoming(s:*State,f:*const ir.Function)bool{unsafe{
 var a=abi.Result{used:0,stack_bytes:0};if !plan(s,(*f).parameter_first,(*f).parameter_count,&a){return false;}
 var at:usize=0;var i:usize=0;while i<(*f).parameter_count{
  let arg=(*(*s).p).arguments[(*f).parameter_first+i];let words=ir.words((*(*s).p).graph,arg.typ);var j:usize=0;
  while j<words{let location=(*(*s).w).locations[at];let off=arg.offset-j*8;
   if location.kind==abi.REGISTER{slotstore(s,reg(location.index),off);}
   else{load(s,0,5,(16+location.index)as i64,64,false);slotstore(s,0,off);}at+=1;j+=1;
  }i+=1;
 }return (*s).status==0;
}}
unsafe fn invoke(s:*State,x:*const ir.Instruction)bool{unsafe{
 let g=(*(*s).p).graph;var ft=(*x).value;
 if (*x).operation==ir.CALL{let sy=(*g).symbols[ft];ft=(*g).node_types[(*g).units[sy.unit].node_start+sy.declaration];}
 if ft>=(*g).types.len||(*g).types[ft].kind!=sem.FUNCTION{(*s).status=INVALID;return false;}
 if ((*g).types[ft].flags&1)!=0{return win_invoke(s,x);}
 var a=abi.Result{used:0,stack_bytes:0};if !plan(s,(*x).a,(*x).b,&a){return false;}
 if (*s).stack_extra>4080-(*s).frame_bytes||a.stack_bytes>4080-(*s).frame_bytes-(*s).stack_extra{(*s).status=FRAME;return false;}
 stack_adjust(s,true,a.stack_bytes);var word:usize=0;var i:usize=0;
 // Stack words first: RAX scratch never destroys a register argument already
 // assigned, including the whole-pair-on-stack rule with a spare register.
 while i<(*x).b{let arg=(*(*s).p).arguments[(*x).a+i];let words=ir.words((*(*s).p).graph,arg.typ);var j:usize=0;
  while j<words{let location=(*(*s).w).locations[word];if location.kind==abi.STACK{
   slotload(s,0,arg.offset-j*8);store(s,0,4,location.index as i64,64);
  }word+=1;j+=1;}i+=1;
 }
 word=0;i=0;while i<(*x).b{let arg=(*(*s).p).arguments[(*x).a+i];let words=ir.words((*(*s).p).graph,arg.typ);var j:usize=0;
  while j<words{let location=(*(*s).w).locations[word];if location.kind==abi.REGISTER{slotload(s,reg(location.index),arg.offset-j*8);}word+=1;j+=1;}i+=1;
 }
 call_target(s,x);if (*x).typ==sem.NORETURN{return put(s,"ud2\n");}stack_adjust(s,false,a.stack_bytes);
 if ir.words((*(*s).p).graph,(*x).typ)==1{normalize(s,(*x).typ);}
 return typed_save(s,(*x).typ,(*x).destination);
}}
unsafe fn call_target(s:*State,x:*const ir.Instruction)bool{unsafe{
 if (*x).operation==ir.INDIRECT_CALL{slotload(s,11,(*x).extra);return put(s,"call r11\n");}
 return put(s,"call ")&&symbol(s,(*x).value)&&put(s,"\n");
}}
fn win_reg(i:usize)u64{if i==0{return 1;}if i==1{return 2;}return (i+6)as u64;}
unsafe fn win_invoke(s:*State,x:*const ir.Instruction)bool{unsafe{
 var bytes:usize=32;if (*x).b>4{bytes+=((*x).b-4)*8;}bytes=(bytes+15)/16*16;
 if (*s).stack_extra>4080-(*s).frame_bytes||bytes>4080-(*s).frame_bytes-(*s).stack_extra{(*s).status=FRAME;return false;}
 stack_adjust(s,true,bytes);var i:usize=0;
 while i<(*x).b{let arg=(*(*s).p).arguments[(*x).a+i];if ir.words((*(*s).p).graph,arg.typ)!=1{(*s).status=INVALID;return false;}
  if i>=4{slotload(s,0,arg.offset);store(s,0,4,(32+(i-4)*8)as i64,64);}i+=1;
 }i=0;while i<(*x).b&&i<4{let arg=(*(*s).p).arguments[(*x).a+i];slotload(s,win_reg(i),arg.offset);i+=1;}
 call_target(s,x);if (*x).typ==sem.NORETURN{return put(s,"ud2\n");}stack_adjust(s,false,bytes);
 if ir.words((*(*s).p).graph,(*x).typ)==1{normalize(s,(*x).typ);}return typed_save(s,(*x).typ,(*x).destination);
}}
unsafe fn win_body(s:*State,index:usize)bool{unsafe{return put(s,"__dong_winbody_")&&symbol(s,index);}}
unsafe fn win_wrapper(s:*State,f:*const ir.Function)bool{unsafe{
 var outgoing:usize=0;if (*f).parameter_count>6{outgoing=((*f).parameter_count-6)*8;}let bytes=(176+outgoing+15)/16*16;
 if bytes+16>4080-(*f).frame_bytes{(*s).status=FRAME;return false;}(*s).stack_extra=bytes+16;
 var n:usize=0;let status=frame.prologue(bytes,0,(*(*s).w).piece,&n);piece(s,status,n);put(s,"cld\n");
 store(s,7,5,-8,64);store(s,6,5,-16,64);var i:usize=0;
 while i<10{put(s,"movdqu [rbp-");number(s,32+16*i);put(s,"], xmm");number(s,6+i);put(s,"\n");i+=1;}
 i=6;while i<(*f).parameter_count{load(s,0,5,(48+8*(i-4))as i64,64,false);store(s,0,4,(8*(i-6))as i64,64);i+=1;}
 if (*f).parameter_count>0{put(s,"mov rdi, rcx\n");}if (*f).parameter_count>1{put(s,"mov rsi, rdx\n");}
 if (*f).parameter_count>2{put(s,"mov rdx, r8\n");}if (*f).parameter_count>3{put(s,"mov rcx, r9\n");}
 if (*f).parameter_count>4{load(s,8,5,48,64,false);}if (*f).parameter_count>5{load(s,9,5,56,64,false);}
 put(s,"call ");win_body(s,(*f).symbol);put(s,"\n");if (*f).returns==sem.NORETURN{return put(s,"ud2\n");}
 i=0;while i<10{put(s,"movdqu xmm");number(s,6+i);put(s,", [rbp-");number(s,32+16*i);put(s,"]\n");i+=1;}
 load(s,7,5,-8,64,false);load(s,6,5,-16,64,false);put(s,"cld\n");n=0;let rc=frame.epilogue(bytes,0,(*(*s).w).piece,&n);return piece(s,rc,n);
}}
fn comparison(op:u64,signed:bool)u64{
 if op==514{return 0;}if op==515{return 1;}var n:u64=2;
 if op==516{n=3;}else if op==1086{n=4;}else if op==517{n=5;}else if op!=1084{return NONE;}
 if signed{n+=4;}return n;
}
unsafe fn binary_instruction(s:*State,x:*const ir.Instruction)bool{unsafe{
 let g=(*(*s).p).graph;let t=(*x).typ;let op=(*x).value;let sign=ir.signed(g,t);let width=ir.width(g,t);
 slotload(s,0,(*x).a);slotload(s,1,(*x).b);var n:usize=0;var status:u64=0;
 let cc=comparison(op,sign);if cc!=NONE{
  status=compare.emit(cc,0,1,(*(*s).w).piece,&n);piece(s,status,n);return slotstore(s,0,(*x).destination);
 }
 let pointer=t<(*g).types.len&&(*g).types[t].kind==sem.POINTER;
 if pointer&&(op==1067||op==1069){
  immediate(s,2,(*g).layouts[(*g).types[t].element].size);arithmetic(s,5,1,2);var operation:u64=0;if op==1069{operation=1;}
  arithmetic(s,operation,0,1);return slotstore(s,0,(*x).destination);
 }
 let check=(*(*s).p).mode==0&&(*x).extra==0;
 if op==1067||op==1069{var operation:u64=0;if op==1069{operation=1;}
  if check{status=checked.emit(operation,sign,0,1,(*s).trap,(*(*s).w).piece,&n);piece(s,status,n);}
  else{arithmetic(s,operation,0,1);}
 }else if op==1066{
  if check{put(s,"mov rdi, rax\nmov rsi, rcx\n");status=multiply.emit(sign,(*s).trap,(*(*s).w).piece,&n);piece(s,status,n);}
  else{arithmetic(s,5,0,1);}
 }else if op==1062||op==1148||op==1118{var operation:u64=2;if op==1148{operation=3;}else if op==1118{operation=4;}arithmetic(s,operation,0,1);}
 else if op==520||op==521{
  status=shiftguard.emit(1,width,(*s).trap,(*(*s).w).piece,&n);piece(s,status,n);
  var operation:u64=0;if op==521{operation=1;if sign{operation=2;}}
  status=shift.emit(operation,0,(*(*s).w).piece,&n);piece(s,status,n);
 }else if op==1071||op==1061{
  // Guarded divide uses a fresh globally unique block. For narrow signed
  // inputs the MIN/-1 overflow is also checked before hardware division.
  put(s,"mov rdi, rax\nmov rsi, rcx\n");let next=(*s).next_block;(*s).next_block+=1;
  status=divguard.emit(sign,(*s).trap,(*s).trap,next,(*(*s).w).piece,&n);piece(s,status,n);label(s,0,next);
  if sign&&width<64{immediate(s,0,(1 as u64)<<(width-1));put(s,"neg rax\ncmp rdi, rax\n");
   let safe=(*s).next_block;let check= safe+1;(*s).next_block+=2;branch(s,1,safe,check);label(s,0,check);
   put(s,"cmp rsi, -1\n");branch(s,0,(*s).trap,safe);label(s,0,safe);
  }
  status=divide.emit(sign,op==1061,(*(*s).w).piece,&n);piece(s,status,n);
 }else{(*s).status=UNSUPPORTED;return false;}
 if check&&width<64&&(op==1067||op==1069||op==1066){status=narrow.emit(width,sign,(*s).trap,(*(*s).w).piece,&n);piece(s,status,n);}
 normalize(s,t);return slotstore(s,0,(*x).destination);
}}
unsafe fn address_slot(s:*State,r:u64,off:usize)bool{unsafe{
 var n:usize=0;let status=addr.emit(r,5,-(off as i64),(*(*s).w).piece,&n);return piece(s,status,n);
}}
unsafe fn number(s:*State,value:u64)bool{unsafe{var n:usize=0;let status=decimal.encode(value,64,false,(*(*s).w).piece,&n);return piece(s,status,n);}}
unsafe fn string_label(s:*State,unit:usize,node:usize)bool{unsafe{return put(s,"__dong_string_")&&number(s,(*(*(*s).p).graph).units[unit].node_start+node);}}
// Static storage is serialized from checked semantic values and layouts. AST
// traversal supplies aggregate structure only; numeric source text is unused.
unsafe fn zeros(s:*State,n:usize)bool{unsafe{if n==0{return true;}return put(s,"times ")&&number(s,n)&&put(s," db 0\n");}}
unsafe fn static_value(s:*State,u:usize,id:usize,t:usize,depth:usize)bool{unsafe{
 let g=(*(*s).p).graph;if depth>=256||u>=(*g).units.len||id>=(*g).units[u].node_count||t>=(*g).types.len{(*s).status=INVALID;return false;}
 let global=(*g).units[u].node_start+id;let n=(*g).nodes[global];let typ=(*g).types[t];let size=(*g).layouts[t].size;
 let info=(*g).info[global];
 if (info.flags&64)!=0&&t==info.typ{
  put(s,"dq ");number(s,info.length);put(s,"\n");if n.kind==ast.NULL{return zeros(s,8);}
  let original=((info.flags>>32)as usize)-1;
  if !static_value(s,u,id,original,depth+1){return false;}return zeros(s,8-(*g).layouts[original].size);
 }
 if (info.flags&512)!=0&&t==info.typ&&n.kind==ast.ERROR{
  let ref=(*g).refs[global];let sy=(*g).symbols[ref.target];let value=(*g).values[(*g).units[sy.unit].node_start+sy.declaration];
  put(s,"dq ");number(s,(*g).limbs[value.first]as u64);return put(s,",0\n");
 }
 if typ.kind==sem.ENUM&&(n.kind==ast.FIELD||n.kind==ast.CALL){
  put(s,"dq ");number(s,info.length);put(s,"\n");if size==8{return true;}
  if n.kind!=ast.CALL||n.b==NONE{return zeros(s,8);}let payload=(*g).info[(*g).units[u].node_start+n.b].typ;
  if !static_value(s,u,n.b,payload,depth+1){return false;}return zeros(s,8-(*g).layouts[payload].size);
 }
 if ((*g).value_states[global]==2||(info.flags&256)!=0)&&size<=8{let v=(*g).values[global];if v.used>2||v.first>(*g).limbs.len||v.used>(*g).limbs.len-v.first{(*s).status=INVALID;return false;}
  var raw:u64=0;if v.used!=0{raw=(*g).limbs[v.first]as u64;}if v.used>1{raw|=((*g).limbs[v.first+1]as u64)<<32;}if v.negative{raw=wrapping_sub(0 as u64,raw);}
  put(s,"db ");var b:usize=0;while b<size{if b!=0{put(s,",");}number(s,(raw>>(b*8))&255);b+=1;}return put(s,"\n");
 }
 let ref=(*g).refs[global];if (n.kind==ast.NAME||n.kind==ast.FIELD)&&ref.kind==binding.GLOBAL{
  if ref.target>=(*g).symbols.len{(*s).status=INVALID;return false;}let sy=(*g).symbols[ref.target];
  if sy.kind==names.FUNCTION&&typ.kind==sem.FUNCTION{return put(s,"dq ")&&symbol(s,ref.target)&&put(s,"\n");}
  if sy.kind!=names.CONST{(*s).status=UNSUPPORTED;return false;}let decl=(*g).nodes[(*g).units[sy.unit].node_start+sy.declaration];return static_value(s,sy.unit,decl.b,t,depth+1);
 }
 if n.kind==ast.NULL{return zeros(s,size);}
 if n.kind==ast.CAST{return static_value(s,u,n.a,t,depth+1);}
 if typ.kind==sem.SLICE&&n.kind==ast.STRING{let tok=(*g).tokens[(*g).units[u].token_start+n.token];put(s,"dq ");string_label(s,u,id);put(s,",");number(s,tok.value_length);return put(s,"\n");}
 if typ.kind==sem.POINTER&&n.kind==ast.UNARY&&n.op==1062{return static_pointer(s,u,id,depth+1);}

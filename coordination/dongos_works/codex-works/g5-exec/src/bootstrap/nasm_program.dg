  ||!span(p as u64,sizeof(ir.Program))||!span(w as u64,sizeof(Workspace))||!span(written as u64,8){return false;}
 let g=(*p).graph;if g==null||(g as u64&7)!=0||!span(g as u64,sizeof(frontend.Graph)){return false;}
 if (*p).functions.len>NONE/sizeof(ir.Function)||(*p).instructions.len>NONE/sizeof(ir.Instruction)
  ||(*p).arguments.len>NONE/sizeof(ir.Argument)||(*g).sources.len>NONE/40||(*w).locations.len>NONE/sizeof(abi.Location){return false;}

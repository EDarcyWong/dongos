  if f.symbol>=(*g).symbols.len||f.frame_bytes>4080||(f.frame_bytes&15)!=0||f.first>(*p).instructions.len
   ||f.count>(*p).instructions.len-f.first||f.parameter_first>(*p).arguments.len
   ||f.parameter_count>(*p).arguments.len-f.parameter_first||f.trap_block>=(*p).block_count{return false;}
  var j:usize=0;while j<f.parameter_count{let a=(*p).arguments[f.parameter_first+j];let words=ir.words(g,a.typ);
   if words==0||words==NONE||!offset(a.offset,words,f.frame_bytes){return false;}j+=1;}
  j=0;while j<f.count{let x=(*p).instructions[f.first+j];let words=ir.words(g,x.typ);

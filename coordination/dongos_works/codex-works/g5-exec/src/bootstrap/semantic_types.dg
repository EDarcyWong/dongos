// A relocation names storage; it never reads a mutable initializer or follows
// a pointer value. Runtime typing already checked visibility, mutability,
// field access and constant array bounds before this predicate is called.
unsafe fn rt_static_place(c:*Runtime,id:usize,depth:usize)bool{unsafe{
 let s=(*c).s;if depth>=(*s).limit{return false;}let u=(*c).unit;let n=*at(s,u,id);

 if kind==ast.CAST{flags|=(*rt_info(c,(*at(s,u,id)).a)).flags&NEVER;}
 if rt_kind(c,typ)==ARRAY{flags|=LENGTH;(*info).length=(*(*s).w).types[typ].count;}
 (*info).typ=typ;(*info).flags=flags;
 if typ==NORETURN{(*info).flags|=NEVER;}

 }
 var declaration=Result{code:0,types:0,fields:0,limbs:0,unchecked_initializers:0,unit:0,token:0,detail:0};
 let status=analyze(sources,units,tokens,nodes,edges,symbols,refs,w,max_depth,&declaration);
 if status==INVALID{return INVALID;}if status!=0{*result=declaration;return status;}
 var s=State{sources:sources,units:units,tokens:tokens,nodes:nodes,symbols:symbols,refs:refs,w:w,
  type_count:declaration.types,field_count:declaration.fields,limb_count:declaration.limbs,unchecked:0,limit:max_depth,status:0,error_unit:0,error_token:0,detail:0};
 var c=Runtime{s:&s,w:rw,unit:0,returns:VOID,unsafe_depth:0,loop_depth:0,snapshot_depth:0,in_defer:false,defer_token:0,live:true};
 i=0;while i<nodes.len{(*rw).info[i]=Info{typ:NONE,flags:0,length:0};(*rw).initialized[i]=0;i+=1;}
 // Validate every error number, including unused declarations and duplicates
 // across modules. The folded initializer is the immutable lowering evidence.
 i=0;while i<symbols.len&&s.status==0{let sy=symbols[i];if sy.kind==names.ERROR{

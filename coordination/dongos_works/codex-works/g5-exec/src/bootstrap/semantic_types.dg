   if equal(key,text(s,field.unit,node.token)){if field.unit!=u&&(node.flags&1)==0{return rt_fail(c,PRIVATE,id,0);}typ=field.typ;found=true;break;}f+=1;
  }if !found{return rt_fail(c,TYPE,id,4);}flags=(*rt_info(c,n.a)).flags&(PLACE|WRITE);
  }else{return rt_fail(c,TYPE,id,5);}

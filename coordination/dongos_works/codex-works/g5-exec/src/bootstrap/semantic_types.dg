unsafe fn rt_type(c:*Runtime,kind:u64,flags:u64,element:usize,count:usize,id:usize)usize{unsafe{
 let t=Type{kind:kind,flags:flags,element:element,count:count,first:0,length:0,unit:(*c).unit,node:id,alignment:0};return compound((*c).s,&t);
}}
unsafe fn rt_fail(c:*Runtime,code:u64,id:usize,detail:u64)usize{unsafe{return fail((*c).s,code,(*c).unit,id,detail);}}
unsafe fn rt_unsafe(c:*Runtime,id:usize)bool{unsafe{if (*c).unsafe_depth==0{rt_fail(c,UNSAFE,id,0);return false;}return true;}}

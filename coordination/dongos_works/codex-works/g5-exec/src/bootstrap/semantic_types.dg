   }
  }
 }else if n.kind==ast.BINARY{typ=rt_binary(c,id,expected,depth+1);if (*s).status!=0{return NONE;}flags=(*info).flags;
 }else if n.kind==ast.CALL{typ=rt_call(c,id,expected,depth+1);if (*s).status!=0{return NONE;}flags=(*info).flags;
 }else if n.kind==ast.TRY{typ=rt_try(c,id,depth+1);if (*s).status!=0{return NONE;}flags=(*info).flags;
 }else if n.kind==ast.ORELSE{typ=rt_orelse(c,id,depth+1);if (*s).status!=0{return NONE;}flags=(*info).flags;
 }else if n.kind==ast.FIELD{
  let base=rt_expr(c,n.a,NONE,true,depth+1);if (*s).status!=0{return NONE;}if base>=(*s).type_count{return rt_fail(c,TYPE,id,30);}let t=(*w).types[base];let key=text(s,u,n.token);

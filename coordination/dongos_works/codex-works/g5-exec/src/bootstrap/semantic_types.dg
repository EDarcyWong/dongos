// Tagged values cannot retain scalar/place/length facts from their payload.
// TAG uses Info.length for the known tag; LENGTH and TAG are disjoint.
unsafe fn rt_wrap(c:*Runtime,id:usize,target:usize,present:bool)usize{unsafe{
 let info=rt_info(c,id);let original=(*info).typ;var saved:u64=0;
 if original<(*(*c).s).type_count{saved=((original+1)as u64)<<32;}

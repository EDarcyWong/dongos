unsafe fn enqueue(s:*State,id:usize,count:*usize)bool{unsafe{
 if id==NONE||id==VOID||id==NORETURN{return true;}let w=(*s).w;
 if id>=(*s).type_count{fail(s,BAD_GRAPH,0,NONE,3);return false;}if (*w).layout_map[id]!=NONE{return true;}
 if *count>=(*w).layout_ids.len{fail(s,CAPACITY,0,NONE,4);return false;}(*w).layout_ids[*count]=id;(*w).layout_map[id]=*count;*count+=1;return true;
}}
unsafe fn get_layout(s:*State,root:usize,u:usize,node:usize,depth:usize)bool{unsafe{
 if (*s).status!=0{return false;}if root>=(*s).type_count{fail(s,TYPE,u,node,8);return false;}
 if depth>=(*s).limit{fail(s,DEPTH,u,node,0);return false;}let w=(*s).w;if (*w).layout_ready[root]!=0{return true;}
 var count:usize=0;var cursor:usize=0;var restart:bool=true;
 // Populating an aggregate may evaluate sizeof/alignof recursively and borrow
 // these same staging arrays. Restart after each newly populated nominal;
 // each restart completes one nominal, so this is bounded by type_count.
 while restart{
  restart=false;var i:usize=0;while i<(*s).type_count{(*w).layout_map[i]=NONE;i+=1;}count=0;cursor=0;
  if !enqueue(s,root,&count){return false;}
  while cursor<count{
   let id=(*w).layout_ids[cursor];let t=(*w).types[id];
   if (t.kind==STRUCT||t.kind==ENUM)&&(*w).type_states[gid(s,t.unit,t.node)]!=2{
    if !populate(s,id,depth+1){return false;}restart=true;break;
   }
   if t.kind==ARRAY{
    if !enqueue(s,t.element,&count){return false;}
   }
   if t.kind==STRUCT||t.kind==ENUM{var f:usize=0;while f<t.length{if !enqueue(s,(*w).fields[t.first+f].typ,&count){return false;}f+=1;}}
   cursor+=1;
  }
 }
 var fc:usize=0;cursor=0;while cursor<count{let id=(*w).layout_ids[cursor];let t=(*w).types[id];var kind:u64=0;
  if t.kind<=4{kind=t.kind;}else if t.kind<=8{kind=t.kind-4;}else if t.kind==9{kind=layout.BOOL;}
  else if t.kind==POINTER{kind=layout.POINTER;}else if t.kind==FUNCTION{kind=layout.FUNCTION;}
  else if t.kind==SLICE{kind=layout.SLICE;}else if t.kind==OPTIONAL{kind=layout.OPTIONAL;}else if t.kind==RESULT{kind=layout.RESULT;}
  else if t.kind==ARRAY{kind=layout.ARRAY;}else if t.kind==STRUCT{kind=layout.STRUCT;}else if t.kind==ENUM{kind=layout.ENUM;}
  // Fixed-size indirections do not depend on their payload's layout. C4 only
  // needs a valid metadata index here; retain a reachable mapping when one
  // exists, otherwise use this descriptor as an opaque fixed-size target.
  // The semantic Type keeps the actual payload; all declarations/signatures
  // are checked separately before the successful graph is published.
  var element:usize=NONE;if t.kind==POINTER||t.kind==SLICE||t.kind==OPTIONAL||t.kind==RESULT||t.kind==ARRAY{if t.element!=VOID{
   element=(*w).layout_map[t.element];if element==NONE{element=cursor;}
  }}
  var first:usize=0;var length:usize=0;if t.kind==STRUCT||t.kind==ENUM{
   first=fc;length=t.length;if length>(*w).layout_fields.len-fc{fail(s,CAPACITY,u,node,5);return false;}
   var f:usize=0;while f<length{let ft=(*w).fields[t.first+f].typ;var mapped:usize=NONE;if ft!=NONE{mapped=(*w).layout_map[ft];}
    (*w).layout_fields[fc]=layout.Field{typ:mapped};fc+=1;f+=1;
   }
  }
  (*w).layout_types[cursor]=layout.Type{kind:kind,element:element,count:t.count,first:first,length:length,alignment:t.alignment,is_packed:t.kind==STRUCT&&(t.flags&1)!=0};cursor+=1;
 }
 let code=layout.calculate(slice_from_raw_parts((*w).layout_types.ptr,count),slice_from_raw_parts((*w).layout_fields.ptr,fc),
  (*w).layout_out,(*w).layout_offsets,(*w).layout_work,(*w).layout_work_offsets,(*w).layout_states,(*s).limit);
 if code!=0{var status:u64=LAYOUT;if code==layout.CYCLE{status=CYCLE;}if code==layout.DEPTH{status=DEPTH;}fail(s,status,u,node,code);return false;}
 cursor=0;while cursor<count{let id=(*w).layout_ids[cursor];let t=(*w).types[id];let lt=(*w).layout_types[cursor];
  (*w).layouts[id]=(*w).layout_out[cursor];(*w).layout_ready[id]=1;
  var f:usize=0;while f<lt.length{(*w).field_offsets[t.first+f]=(*w).layout_offsets[lt.first+f];f+=1;}cursor+=1;
 }return true;
}}
unsafe fn signature(s:*State,typ:usize,external:bool)bool{unsafe{
 let w=(*s).w;let t=(*w).types[typ];let restricted=external||(t.flags&1)!=0;
 var i:usize=0;while i<=t.length{var target=t.element;var origin=t.node;
  if i<t.length{let f=(*w).fields[t.first+i];target=f.typ;origin=f.node;}
  if target==VOID||target==NORETURN{if i<t.length{fail(s,TYPE,t.unit,origin,9);return false;}}
  else{
   if !get_layout(s,target,t.unit,origin,0){return false;}let k=(*w).types[target].kind;
   if k==STRUCT||k==ARRAY||(restricted&&!scalar(s,target)&&!(k==ENUM&&(*w).layouts[target].size==8)){
    fail(s,TYPE,t.unit,origin,10);return false;
   }
  }i+=1;
 }return true;
}}
unsafe fn top_function(s:*State,u:usize,id:usize,wrapper:usize)bool{unsafe{
 let w=(*s).w;let n=*at(s,u,id);var count:usize=0;var p=n.a;while p!=NONE{count+=1;p=(*at(s,u,p)).next;}
 let first=fields(s,u,id,count);if (*s).status!=0{return false;}p=n.a;var i:usize=0;
 while p!=NONE{let param=*at(s,u,p);let typ=resolve(s,u,param.a,0);if (*s).status!=0{return false;}
  (*w).fields[first+i]=Field{typ:typ,unit:u,node:p};p=param.next;i+=1;
 }
 let ret=resolve(s,u,n.b,0);if (*s).status!=0{return false;}var flags:u64=0;
 let d=*at(s,u,wrapper);p=d.b;while p!=NONE{let a=*at(s,u,p);
  if a.op==267&&a.a!=NONE{let string=*at(s,u,a.a);if (*s).tokens[(*s).units[u].token_start+string.token].value_length==5{flags|=1;}}
  if a.op==268{flags|=2;}p=a.next;
 }
 let t=Type{kind:FUNCTION,flags:flags,element:ret,count:0,first:first,length:count,unit:u,node:id,alignment:0};let typ=add_type(s,&t);
 if (*s).status!=0{return false;}(*w).node_types[gid(s,u,id)]=typ;return signature(s,typ,n.c==NONE);
}}
// Method declarations: pointer-to-struct receivers only (stricter than the seed's
 // enum allowance). Exact (pointee,name) uniqueness, same-module ownership, and
 // field-name clashes are checked here before any Graph publish.
unsafe fn check_method(s:*State,index:usize)bool{unsafe{
 let w=(*s).w;let sy=(*s).symbols[index];let g=gid(s,sy.unit,sy.declaration);let fn_typ=(*w).node_types[g];
 if fn_typ>=(*s).type_count{fail(s,BAD_GRAPH,sy.unit,sy.declaration,60);return false;}
 let t=(*w).types[fn_typ];if t.kind!=FUNCTION||t.length==0{fail(s,TYPE,sy.unit,sy.declaration,61);return false;}
 let recv_node=(*w).fields[t.first].node;let recv=(*w).fields[t.first].typ;
 if recv>=(*s).type_count||(*w).types[recv].kind!=POINTER{fail(s,TYPE,sy.unit,recv_node,62);return false;}
 let pointee=(*w).types[recv].element;
 if pointee>=(*s).type_count||(*w).types[pointee].kind!=STRUCT{fail(s,TYPE,sy.unit,recv_node,63);return false;}
 let st=(*w).types[pointee];if st.unit!=sy.unit{fail(s,PRIVATE,sy.unit,recv_node,64);return false;}
 if !get_layout(s,pointee,st.unit,st.node,0){return false;}
 let method_name=text(s,sy.unit,sy.name_token);var f:usize=0;let st2=(*w).types[pointee];
 while f<st2.length{let field=(*w).fields[st2.first+f];let node=*at(s,field.unit,field.node);
  if equal(method_name,text(s,field.unit,node.token)){fail(s,TYPE,sy.unit,sy.declaration,65);return false;}f+=1;
 }
 var i:usize=0;while i<index{let other=(*s).symbols[i];
  if other.kind==names.METHOD&&equal(method_name,text(s,other.unit,other.name_token)){
   let ot=(*w).node_types[gid(s,other.unit,other.declaration)];
   if ot<(*s).type_count{let ofn=(*w).types[ot];
    if ofn.kind==FUNCTION&&ofn.length!=0{let orecv=(*w).fields[ofn.first].typ;
     if orecv<(*s).type_count&&(*w).types[orecv].kind==POINTER&&(*w).types[orecv].element==pointee{
      fail(s,TYPE,sy.unit,sy.declaration,66);return false;
     }
    }
   }
  }i+=1;
 }return true;
}}
unsafe fn check_methods(s:*State)bool{unsafe{
 var i:usize=0;while i<(*s).symbols.len&&(*s).status==0{if (*s).symbols[i].kind==names.METHOD{if !check_method(s,i){return false;}}i+=1;}

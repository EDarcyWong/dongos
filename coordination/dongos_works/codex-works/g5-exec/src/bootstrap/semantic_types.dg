 }
 else if n.kind==ast.STRING{typ=rt_type(c,SLICE,1,0,0,id);flags=LENGTH;(*info).length=(*s).tokens[(*s).units[u].token_start+n.token].value_length;}
 else if n.kind==ast.NAME||(n.kind==ast.FIELD&&(*s).refs[gid(s,u,id)].kind==binding.GLOBAL){
  let r=(*s).refs[gid(s,u,id)];if r.kind==binding.LOCAL{

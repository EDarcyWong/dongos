}}

// INVALID is a descriptor/alias failure and never modifies caller memory.
// Other failures may change scratch but publish zero graph counts.
pub unsafe fn analyze(sources:[]const modules.Source,units:[]const modules.Unit,tokens:[]const lex.Token,
 nodes:[]const ast.Node,edges:[]const modules.Edge,symbols:[]const names.Symbol,refs:[]const binding.Ref,
 w:*const Workspace,max_depth:usize,result:*Result)u64{unsafe{
 if max_depth==0||max_depth>256||!span(w as u64,sizeof(Workspace))||(w as u64&7)!=0
  ||!span(result as u64,sizeof(Result))||(result as u64&7)!=0{return INVALID;}
 let inputs=[
  Region{p:sources.ptr as u64,n:sources.len,width:sizeof(modules.Source),alignment:8},
  Region{p:units.ptr as u64,n:units.len,width:sizeof(modules.Unit),alignment:8},
  Region{p:tokens.ptr as u64,n:tokens.len,width:sizeof(lex.Token),alignment:8},
  Region{p:nodes.ptr as u64,n:nodes.len,width:sizeof(ast.Node),alignment:8},
  Region{p:edges.ptr as u64,n:edges.len,width:sizeof(modules.Edge),alignment:8},
  Region{p:symbols.ptr as u64,n:symbols.len,width:sizeof(names.Symbol),alignment:8},
  Region{p:refs.ptr as u64,n:refs.len,width:sizeof(binding.Ref),alignment:8},
  Region{p:w as u64,n:1,width:sizeof(Workspace),alignment:8}];
 var outputs=[Region{p:(*w).types.ptr as u64,n:(*w).types.len,width:sizeof(Type),alignment:8},
  Region{p:(*w).fields.ptr as u64,n:(*w).fields.len,width:sizeof(Field),alignment:8},
  Region{p:(*w).node_types.ptr as u64,n:(*w).node_types.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).values.ptr as u64,n:(*w).values.len,width:sizeof(Value),alignment:8},
  Region{p:(*w).value_states.ptr as u64,n:(*w).value_states.len,width:sizeof(u8),alignment:1},
  Region{p:(*w).type_states.ptr as u64,n:(*w).type_states.len,width:sizeof(u8),alignment:1},
  Region{p:(*w).limbs.ptr as u64,n:(*w).limbs.len,width:sizeof(u32),alignment:4},
  Region{p:(*w).text.ptr as u64,n:(*w).text.len,width:sizeof(u8),alignment:1},
  Region{p:(*w).math_tokens.ptr as u64,n:(*w).math_tokens.len,width:sizeof(lex.Token),alignment:8},
  Region{p:(*w).math_nodes.ptr as u64,n:(*w).math_nodes.len,width:sizeof(ast.Node),alignment:8},
  Region{p:(*w).eval_out.ptr as u64,n:(*w).eval_out.len,width:sizeof(u32),alignment:4},
  Region{p:(*w).eval_work.ptr as u64,n:(*w).eval_work.len,width:sizeof(u32),alignment:4},
  Region{p:(*w).layout_ids.ptr as u64,n:(*w).layout_ids.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).layout_map.ptr as u64,n:(*w).layout_map.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).layout_types.ptr as u64,n:(*w).layout_types.len,width:sizeof(layout.Type),alignment:8},
  Region{p:(*w).layout_fields.ptr as u64,n:(*w).layout_fields.len,width:sizeof(layout.Field),alignment:8},
  Region{p:(*w).layout_out.ptr as u64,n:(*w).layout_out.len,width:sizeof(layout.Layout),alignment:8},
  Region{p:(*w).layout_offsets.ptr as u64,n:(*w).layout_offsets.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).layout_work.ptr as u64,n:(*w).layout_work.len,width:sizeof(layout.Layout),alignment:8},
  Region{p:(*w).layout_work_offsets.ptr as u64,n:(*w).layout_work_offsets.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).layout_states.ptr as u64,n:(*w).layout_states.len,width:sizeof(u8),alignment:1},
  Region{p:(*w).layouts.ptr as u64,n:(*w).layouts.len,width:sizeof(layout.Layout),alignment:8},
  Region{p:(*w).field_offsets.ptr as u64,n:(*w).field_offsets.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).layout_ready.ptr as u64,n:(*w).layout_ready.len,width:sizeof(u8),alignment:1},
  Region{p:result as u64,n:1,width:sizeof(Result),alignment:8}];
 var i:usize=0;while i<inputs.len{let r=inputs[i];
  if r.n>NONE/r.width||!span(r.p,r.n*r.width)||(r.n!=0&&(r.p%r.alignment)!=0){return INVALID;}i+=1;
 }
 i=0;while i<outputs.len{let r=outputs[i];if r.n>NONE/r.width||!span(r.p,r.n*r.width)||(r.n!=0&&(r.p%r.alignment)!=0){return INVALID;}
  outputs[i].n*=r.width;outputs[i].width=1;i+=1;
 }
 i=0;while i<outputs.len{var j:usize=0;while j<inputs.len{let r=inputs[j];let bytes=Region{p:r.p,n:r.n*r.width,width:1,alignment:1};
  if overlap(&outputs[i],&bytes){return INVALID;}j+=1;
 }j=0;while j<i{if overlap(&outputs[i],&outputs[j]){return INVALID;}j+=1;}i+=1;
 }
 i=0;while i<sources.len{let source=sources[i];let p=Region{p:source.path.ptr as u64,n:source.path.len,width:1,alignment:1};
  let b=Region{p:source.bytes.ptr as u64,n:source.bytes.len,width:1,alignment:1};
  if !span(p.p,p.n)||!span(b.p,b.n){return INVALID;}var j:usize=0;while j<outputs.len{if overlap(&outputs[j],&p)||overlap(&outputs[j],&b){return INVALID;}j+=1;}i+=1;
 }
 var s=State{sources:sources,units:units,tokens:tokens,nodes:nodes,symbols:symbols,refs:refs,w:w,
  type_count:0,field_count:0,limb_count:0,unchecked:0,limit:max_depth,status:0,error_unit:0,error_token:0,detail:0};
 if !names.valid_graph(sources,units,tokens,nodes,edges)||refs.len<nodes.len{s.status=BAD_GRAPH;}
 if (*w).types.len<9||(*w).node_types.len<nodes.len||(*w).values.len<nodes.len||(*w).type_states.len<nodes.len||(*w).value_states.len<nodes.len
  ||(*w).layout_ids.len<(*w).types.len||(*w).layout_map.len<(*w).types.len||(*w).layout_types.len<(*w).types.len
  ||(*w).layout_out.len<(*w).types.len||(*w).layout_work.len<(*w).types.len||(*w).layout_states.len<(*w).types.len
  ||(*w).layouts.len<(*w).types.len||(*w).layout_ready.len<(*w).types.len||(*w).layout_fields.len<(*w).fields.len
  ||(*w).layout_offsets.len<(*w).fields.len||(*w).layout_work_offsets.len<(*w).fields.len||(*w).field_offsets.len<(*w).fields.len{s.status=CAPACITY;}
 if s.status==0{
  i=0;while i<symbols.len{let sy=symbols[i];if sy.unit>=units.len||sy.declaration>=units[sy.unit].node_count{s.status=BAD_GRAPH;break;}i+=1;}
  i=0;while i<refs.len{let r=refs[i];if r.kind!=0{
   if r.unit>=units.len{s.status=BAD_GRAPH;break;}
   if (r.kind==binding.GLOBAL||r.kind==binding.METHOD_CANDIDATE)&&r.target>=symbols.len{s.status=BAD_GRAPH;break;}
   if (r.kind==binding.LOCAL||r.kind==binding.DEFERRED_MEMBER)&&r.target>=units[r.unit].node_count{s.status=BAD_GRAPH;break;}
  }i+=1;}
 }
 if s.status==0{
  i=0;while i<nodes.len{(*w).node_types[i]=NONE;(*w).type_states[i]=0;(*w).value_states[i]=0;i+=1;}
  i=0;while i<9{let t=Type{kind:(i+1)as u64,flags:0,element:NONE,count:0,first:0,length:0,unit:0,node:NONE,alignment:0};add_type(&s,&t);i+=1;}
  i=0;while i<symbols.len{let sy=symbols[i];if sy.kind==names.STRUCT||sy.kind==names.ENUM{
   var kind:u64=STRUCT;if sy.kind==names.ENUM{kind=ENUM;}
   let t=Type{kind:kind,flags:0,element:NONE,count:0,first:0,length:0,unit:sy.unit,node:sy.declaration,alignment:0};
   let id=add_type(&s,&t);if s.status!=0{break;}(*w).node_types[gid(&s,sy.unit,sy.declaration)]=id;
  }i+=1;}
  // Resolve every declaration/annotation, including unused aliases.
  var u:usize=0;while u<units.len&&s.status==0{i=0;while i<units[u].node_count&&s.status==0{let n=*at(&s,u,i);
   if n.kind>=ast.TYPE_NAME&&n.kind<=ast.TYPE_FUNCTION{resolve(&s,u,i,0);}
   if n.kind==ast.ALIAS_DECL{let target=resolve(&s,u,n.a,0);(*w).node_types[gid(&s,u,i)]=target;}
   if n.kind==ast.GLOBAL||n.kind==ast.BINDING{
    var typ:usize=NONE;if n.a!=NONE{typ=resolve(&s,u,n.a,0);(*w).node_types[gid(&s,u,i)]=typ;if typ==VOID||typ==NORETURN{fail(&s,TYPE,u,i,11);}}
    if s.status==0{
     if n.op==260&&(typ==NONE||typ<=8){var v=Value{kind:0,typ:NONE,negative:false,first:0,used:0};constant(&s,u,i,0,&v);}
     else if n.kind==ast.GLOBAL&&typ<=8{var v=Value{kind:0,typ:NONE,negative:false,first:0,used:0};if fold(&s,u,n.b,typ,0,&v){coerce(&s,u,i,&v,typ);}}
     else if n.b!=NONE{s.unchecked+=1;}
    }
   }
   if n.kind==ast.DECLARATION&&(*at(&s,u,n.a)).kind==ast.FUNCTION{top_function(&s,u,n.a,i);}
   i+=1;
  }u+=1;}
  // Layout each canonical type. C4 owns offsets, padding, packing and cycles.
  i=0;while i<s.type_count&&s.status==0{let t=(*w).types[i];get_layout(&s,i,t.unit,t.node,0);
   if s.status==0&&t.kind==FUNCTION{signature(&s,i,false);}i+=1;
  }
  if s.status==0{check_methods(&s);}
 }
 var tc:usize=0;var fc:usize=0;var lc:usize=0;var unchecked:usize=0;
 if s.status==0{tc=s.type_count;fc=s.field_count;lc=s.limb_count;unchecked=s.unchecked;}
 *result=Result{code:s.status,types:tc,fields:fc,limbs:lc,unchecked_initializers:unchecked,unit:s.error_unit,token:s.error_token,detail:s.detail};return s.status;
}}
unsafe fn rt_info(c:*Runtime,id:usize)*Info{unsafe{return (*(*c).w).info.ptr+gid((*c).s,(*c).unit,id);}}
unsafe fn rt_kind(c:*Runtime,typ:usize)u64{unsafe{
 let s=(*c).s;if typ>=(*s).type_count{return 0;}return (*(*s).w).types[typ].kind;
}}
unsafe fn rt_same(c:*Runtime,a:usize,b:usize,depth:usize)bool{unsafe{
 if a==b{return true;}let s=(*c).s;if depth>=(*s).limit{return false;}
 if a>=(*s).type_count||b>=(*s).type_count{return false;}let w=(*s).w;let x=(*w).types[a];let y=(*w).types[b];
 if x.kind!=y.kind||x.flags!=y.flags{return false;}
 if x.kind==FUNCTION{if x.length!=y.length||!rt_same(c,x.element,y.element,depth+1){return false;}
  var i:usize=0;while i<x.length{if !rt_same(c,(*w).fields[x.first+i].typ,(*w).fields[y.first+i].typ,depth+1){return false;}i+=1;}return true;
 }
 if x.kind==POINTER||x.kind==SLICE||x.kind==OPTIONAL||x.kind==RESULT||x.kind==ARRAY{
  return x.count==y.count&&rt_same(c,x.element,y.element,depth+1);
 }return false;

   if (f&PLACE)==0{return rt_fail(c,TYPE,id,1);}var readonly:u64=1;if (f&WRITE)!=0{readonly=0;}typ=rt_type(c,POINTER,readonly,child,0,id);
  }else if n.op==1066{let child=rt_expr(c,n.a,NONE,true,depth+1);if (*s).status!=0{return NONE;}
   if rt_kind(c,child)!=POINTER{return rt_fail(c,TYPE,id,2);}if !rt_unsafe(c,id){return NONE;}let t=(*w).types[child];typ=t.element;flags=PLACE;if (t.flags&1)==0{flags|=WRITE;}
  }else{
   var want:usize=NONE;if n.op==1057{want=8;}else if expected<8{want=expected;}let child=rt_expr(c,n.a,want,true,depth+1);if (*s).status!=0{return NONE;}
   if n.op==1057{typ=8;}else if n.op==1069||n.op==1150{if child!=NONE&&child>=8{return rt_fail(c,TYPE,id,3);}typ=child;}else{return rt_fail(c,UNSUPPORTED,id,n.op);}
   let g=gid(s,u,n.a);if (*w).value_states[g]==2{let value=(*w).values[g];var result=Value{kind:0,typ:NONE,negative:false,first:0,used:0};
    if !run_math(s,u,id,n.op,&value,&value,true,&result){return NONE;}
    if n.op==1150&&typ<8{if !wrapped(s,u,id,&result,typ){return NONE;}}else if typ!=NONE{if !coerce(s,u,id,&result,typ){return NONE;}}

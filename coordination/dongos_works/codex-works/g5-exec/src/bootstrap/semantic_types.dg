  if payload<8{rt_accept(c,id,payload);if (*s).status==0{return rt_wrap(c,id,target,tk==OPTIONAL);}}return NONE;
 }
 if source==NULL_TYPE&&tk==OPTIONAL{return rt_wrap(c,id,target,false);}
 if source==NULL_TYPE&&tk==POINTER{(*info).typ=target;return target;}

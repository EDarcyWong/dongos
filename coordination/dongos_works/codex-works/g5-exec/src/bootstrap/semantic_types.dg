  let base=rt_expr(c,n.a,NONE,true,depth+1);rt_expr(c,n.b,3,true,depth+1);if (*s).status!=0{return NONE;}if base>=(*s).type_count{return rt_fail(c,TYPE,id,31);}let t=(*w).types[base];
  if t.kind==ARRAY{flags=(*rt_info(c,n.a)).flags&(PLACE|WRITE);let g=gid(s,u,n.b);
   if (*w).value_states[g]==2{var index:usize=0;let v=(*w).values[g];if !small(s,u,n.b,&v,false,&index){return NONE;}if index>=t.count{return rt_fail(c,TYPE,n.b,6);}}
  }else if t.kind==SLICE||t.kind==POINTER{if t.kind==POINTER&&!rt_unsafe(c,id){return NONE;}flags=PLACE;if (t.flags&1)==0{flags|=WRITE;}
   let base_info=rt_info(c,n.a);let g=gid(s,u,n.b);if t.kind==SLICE&&((*base_info).flags&LENGTH)!=0&&(*w).value_states[g]==2{
    var index:usize=0;let v=(*w).values[g];if !small(s,u,n.b,&v,false,&index){return NONE;}if index>=(*base_info).length{return rt_fail(c,TYPE,n.b,6);}

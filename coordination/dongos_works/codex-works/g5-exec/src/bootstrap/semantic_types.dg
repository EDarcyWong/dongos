 }else if n.kind==ast.SLICE{typ=rt_slice(c,id,depth+1);if (*s).status!=0{return NONE;}flags=(*info).flags;
 }else if n.kind==ast.CAST{typ=rt_cast(c,id,depth+1);
 }else if n.kind==ast.ARRAY||n.kind==ast.REPEAT{typ=rt_array(c,id,expected,depth+1);flags=(*info).flags;
 }else if n.kind==ast.STRUCT{typ=rt_struct(c,id,depth+1);flags=(*info).flags;
 }else{return rt_fail(c,UNSUPPORTED,id,n.kind);}
 if (*s).status!=0{return NONE;}
 if n.kind==ast.UNARY||n.kind==ast.CAST||n.kind==ast.FIELD||n.kind==ast.INDEX{flags|=(*rt_info(c,n.a)).flags&NEVER;}
 if n.kind==ast.INDEX{flags|=(*rt_info(c,n.b)).flags&NEVER;}
 if rt_kind(c,typ)==ARRAY{flags|=LENGTH;(*info).length=(*w).types[typ].count;}
 (*info).typ=typ;(*info).flags=flags;
 if typ==NORETURN{(*info).flags|=NEVER;}let result=rt_accept(c,id,expected);if ((*info).flags&NEVER)!=0{(*c).live=false;}return result;
}}
unsafe fn rt_try(c:*Runtime,id:usize,depth:usize)usize{unsafe{
 let s=(*c).s;let n=*at(s,(*c).unit,id);
 if (*c).in_defer||rt_kind(c,(*c).returns)!=RESULT{return rt_fail(c,FLOW,id,80);}
 let typ=rt_expr(c,n.a,NONE,true,depth+1);if (*s).status!=0{return NONE;}
 if rt_kind(c,typ)!=RESULT{return rt_fail(c,TYPE,id,81);}

 let s=(*c).s;if depth>=(*s).limit{return false;}let n=*at(s,(*c).unit,id);
 if n.kind==ast.INTEGER||n.kind==ast.BOOLEAN||n.kind==ast.LAYOUT{return true;}
 if n.kind==ast.NAME||n.kind==ast.FIELD{let r=(*s).refs[gid(s,(*c).unit,id)];
  if r.kind==binding.GLOBAL{return (*s).symbols[r.target].kind==names.CONST&&(*(*s).w).value_states[gid(s,r.unit,(*s).symbols[r.target].declaration)]==2;}
  return r.kind==binding.LOCAL&&r.detail==260&&(*(*s).w).value_states[gid(s,r.unit,r.target)]==2;

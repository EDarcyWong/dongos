  var v=Value{kind:0,typ:NONE,negative:false,first:0,used:0};if !fold(s,u,id,expected,0,&v){return NONE;}
  typ=v.typ;let g=gid(s,u,id);(*w).values[g]=v;(*w).value_states[g]=2;flags=KNOWN;

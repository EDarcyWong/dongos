   if symbol.kind==names.GLOBAL||symbol.kind==names.CONST{flags=PLACE;if symbol.kind==names.GLOBAL{flags|=WRITE;}}
   else if symbol.kind!=names.FUNCTION&&symbol.kind!=names.METHOD{return rt_fail(c,UNSUPPORTED,id,symbol.kind);}

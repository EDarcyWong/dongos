}}
unsafe fn rt_expr_general(c:*Runtime,id:usize,expected:usize,read:bool,depth:usize)usize{unsafe{
 let s=(*c).s;let u=(*c).unit;if !enter(s,u,id,depth){return NONE;}let n=*at(s,u,id);let w=(*s).w;

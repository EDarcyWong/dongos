// Complete checking of the explicitly supported runtime subset. Unsupported
// constructs return UNSUPPORTED, never a success with unchecked initializers.
pub unsafe fn analyze_program(sources:[]const modules.Source,units:[]const modules.Unit,tokens:[]const lex.Token,
 nodes:[]const ast.Node,edges:[]const modules.Edge,symbols:[]const names.Symbol,refs:[]const binding.Ref,
 w:*const Workspace,rw:*const RuntimeWorkspace,max_depth:usize,result:*Result)u64{unsafe{
 if max_depth==0||max_depth>256||!span(w as u64,sizeof(Workspace))||(w as u64&7)!=0
  ||!span(rw as u64,sizeof(RuntimeWorkspace))||(rw as u64&7)!=0
  ||!span(result as u64,sizeof(Result))||(result as u64&7)!=0{return INVALID;}
 let inputs=[
  Region{p:sources.ptr as u64,n:sources.len,width:sizeof(modules.Source),alignment:8},
  Region{p:units.ptr as u64,n:units.len,width:sizeof(modules.Unit),alignment:8},
  Region{p:tokens.ptr as u64,n:tokens.len,width:sizeof(lex.Token),alignment:8},
  Region{p:nodes.ptr as u64,n:nodes.len,width:sizeof(ast.Node),alignment:8},
  Region{p:edges.ptr as u64,n:edges.len,width:sizeof(modules.Edge),alignment:8},
  Region{p:symbols.ptr as u64,n:symbols.len,width:sizeof(names.Symbol),alignment:8},
  Region{p:refs.ptr as u64,n:refs.len,width:sizeof(binding.Ref),alignment:8},
  Region{p:w as u64,n:1,width:sizeof(Workspace),alignment:8},
  Region{p:rw as u64,n:1,width:sizeof(RuntimeWorkspace),alignment:8},
  Region{p:(*w).types.ptr as u64,n:(*w).types.len,width:sizeof(Type),alignment:8},
  Region{p:(*w).fields.ptr as u64,n:(*w).fields.len,width:sizeof(Field),alignment:8},
  Region{p:(*w).node_types.ptr as u64,n:(*w).node_types.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).values.ptr as u64,n:(*w).values.len,width:sizeof(Value),alignment:8},
  Region{p:(*w).value_states.ptr as u64,n:(*w).value_states.len,width:sizeof(u8),alignment:1},
  Region{p:(*w).type_states.ptr as u64,n:(*w).type_states.len,width:sizeof(u8),alignment:1},
  Region{p:(*w).limbs.ptr as u64,n:(*w).limbs.len,width:sizeof(u32),alignment:4},
  Region{p:(*w).text.ptr as u64,n:(*w).text.len,width:sizeof(u8),alignment:1},
  Region{p:(*w).math_tokens.ptr as u64,n:(*w).math_tokens.len,width:sizeof(lex.Token),alignment:8},
  Region{p:(*w).math_nodes.ptr as u64,n:(*w).math_nodes.len,width:sizeof(ast.Node),alignment:8},
  Region{p:(*w).eval_out.ptr as u64,n:(*w).eval_out.len,width:sizeof(u32),alignment:4},
  Region{p:(*w).eval_work.ptr as u64,n:(*w).eval_work.len,width:sizeof(u32),alignment:4},
  Region{p:(*w).layout_ids.ptr as u64,n:(*w).layout_ids.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).layout_map.ptr as u64,n:(*w).layout_map.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).layout_types.ptr as u64,n:(*w).layout_types.len,width:sizeof(layout.Type),alignment:8},
  Region{p:(*w).layout_fields.ptr as u64,n:(*w).layout_fields.len,width:sizeof(layout.Field),alignment:8},
  Region{p:(*w).layout_out.ptr as u64,n:(*w).layout_out.len,width:sizeof(layout.Layout),alignment:8},
  Region{p:(*w).layout_offsets.ptr as u64,n:(*w).layout_offsets.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).layout_work.ptr as u64,n:(*w).layout_work.len,width:sizeof(layout.Layout),alignment:8},
  Region{p:(*w).layout_work_offsets.ptr as u64,n:(*w).layout_work_offsets.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).layout_states.ptr as u64,n:(*w).layout_states.len,width:sizeof(u8),alignment:1},
  Region{p:(*w).layouts.ptr as u64,n:(*w).layouts.len,width:sizeof(layout.Layout),alignment:8},
  Region{p:(*w).field_offsets.ptr as u64,n:(*w).field_offsets.len,width:sizeof(usize),alignment:8},
  Region{p:(*w).layout_ready.ptr as u64,n:(*w).layout_ready.len,width:sizeof(u8),alignment:1}];
 var outputs=[
  Region{p:(*rw).info.ptr as u64,n:(*rw).info.len,width:sizeof(Info),alignment:8},
  Region{p:(*rw).initialized.ptr as u64,n:(*rw).initialized.len,width:1,alignment:1},
  Region{p:(*rw).snapshots.ptr as u64,n:(*rw).snapshots.len,width:1,alignment:1},
  Region{p:(*rw).breaks.ptr as u64,n:(*rw).breaks.len,width:1,alignment:1},
  Region{p:(*rw).loop_seen.ptr as u64,n:(*rw).loop_seen.len,width:1,alignment:1},
  Region{p:result as u64,n:1,width:sizeof(Result),alignment:8}];
 var i:usize=0;while i<inputs.len{let r=inputs[i];if r.n>NONE/r.width||!span(r.p,r.n*r.width)||(r.n!=0&&r.p%r.alignment!=0){return INVALID;}i+=1;}
 i=0;while i<outputs.len{let r=outputs[i];if r.n>NONE/r.width||!span(r.p,r.n*r.width)||(r.n!=0&&r.p%r.alignment!=0){return INVALID;}
  outputs[i].n*=r.width;var j:usize=0;while j<inputs.len{let a=inputs[j];let b=Region{p:a.p,n:a.n*a.width,width:1,alignment:1};
   if overlap(&outputs[i],&b){return INVALID;}j+=1;
  }j=0;while j<i{if overlap(&outputs[i],&outputs[j]){return INVALID;}j+=1;}i+=1;
 }
 let descriptor=Region{p:rw as u64,n:sizeof(RuntimeWorkspace),width:1,alignment:8};
 i=9;while i<inputs.len{let a=inputs[i];let b=Region{p:a.p,n:a.n*a.width,width:1,alignment:1};if overlap(&descriptor,&b){return INVALID;}i+=1;}
 i=0;while i<sources.len{let source=sources[i];let path=Region{p:source.path.ptr as u64,n:source.path.len,width:1,alignment:1};
  let bytes=Region{p:source.bytes.ptr as u64,n:source.bytes.len,width:1,alignment:1};if !span(path.p,path.n)||!span(bytes.p,bytes.n){return INVALID;}
  var j:usize=0;while j<outputs.len{if overlap(&outputs[j],&path)||overlap(&outputs[j],&bytes){return INVALID;}j+=1;}i+=1;
 }
 let stride=rt_stride(nodes.len);if stride>NONE/(max_depth*2){return INVALID;}let frames=stride*max_depth;

// Native declaration types, constants/layouts and a checked runtime subset.
// Unsupported runtime constructs fail explicitly; this is not a full compiler.
module bootstrap.semantic_types;
import bootstrap.modules as modules;
import bootstrap.names as names;
import bootstrap.binding as binding;
import bootstrap.expression as ast;
import bootstrap.lexer as lex;
import bootstrap.constant_arithmetic as arithmetic;
import bootstrap.type_layout as layout;
pub const NONE:usize=0xffff_ffff_ffff_ffff;
pub const VOID:usize=0xffff_ffff_ffff_fffe;
pub const NORETURN:usize=0xffff_ffff_ffff_fffd;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;pub const TYPE:u64=3;
pub const CYCLE:u64=4;pub const CONSTANT:u64=5;pub const LAYOUT:u64=6;pub const DEPTH:u64=7;
pub const UNSUPPORTED:u64=8;pub const BAD_GRAPH:u64=9;pub const PRIVATE:u64=10;
pub const UNINITIALIZED:u64=11;pub const IMMUTABLE:u64=12;pub const UNSAFE:u64=13;
pub const RETURN_PATH:u64=14;pub const FLOW:u64=15;
pub const POINTER:u64=12;pub const SLICE:u64=13;pub const OPTIONAL:u64=14;pub const RESULT:u64=15;
pub const ARRAY:u64=16;pub const STRUCT:u64=17;pub const ENUM:u64=18;pub const FUNCTION:u64=19;
// kind 1..8 = u8/u16/u32/u64/i8/i16/i32/i64, 9 = bool.
pub struct Type{pub kind:u64,pub flags:u64,pub element:usize,pub count:usize,pub first:usize,
 pub length:usize,pub unit:usize,pub node:usize,pub alignment:usize}
pub struct Field{pub typ:usize,pub unit:usize,pub node:usize}
pub struct Value{pub kind:u64,pub typ:usize,pub negative:bool,pub first:usize,pub used:usize}
pub struct Result{pub code:u64,pub types:usize,pub fields:usize,pub limbs:usize,pub unchecked_initializers:usize,
 pub unit:usize,pub token:usize,pub detail:u64}
// Every array is caller-owned scratch. Only Result's successful counts publish
// the graph. node_types/values refer to global pool node indices.
pub struct Workspace{
 pub types:[]Type,pub fields:[]Field,pub node_types:[]usize,pub values:[]Value,
 pub value_states:[]u8,pub type_states:[]u8,pub limbs:[]u32,
 pub text:[]u8,pub math_tokens:[]lex.Token,pub math_nodes:[]ast.Node,pub eval_out:[]u32,pub eval_work:[]u32,
 pub layout_ids:[]usize,pub layout_map:[]usize,pub layout_types:[]layout.Type,pub layout_fields:[]layout.Field,
 pub layout_out:[]layout.Layout,pub layout_offsets:[]usize,pub layout_work:[]layout.Layout,
 pub layout_work_offsets:[]usize,pub layout_states:[]u8,pub layouts:[]layout.Layout,
 pub field_offsets:[]usize,pub layout_ready:[]u8
}
pub struct Info{pub typ:usize,pub flags:u64,pub length:usize}
pub struct RuntimeWorkspace{pub info:[]Info,pub initialized:[]u8,pub snapshots:[]u8,
 pub breaks:[]u8,pub loop_seen:[]u8}
const PLACE:u64=1;const WRITE:u64=2;const KNOWN:u64=4;const NEVER:u64=8;const LENGTH:u64=16;const TAG:u64=32;
const NULL_TYPE:usize=0xffff_ffff_ffff_fffc;
const ERROR_TYPE:usize=0xffff_ffff_ffff_fffb;
struct Runtime{s:*State,w:*const RuntimeWorkspace,unit:usize,returns:usize,unsafe_depth:usize,
 loop_depth:usize,snapshot_depth:usize,in_defer:bool,defer_token:usize,live:bool}
struct Region{p:u64,n:usize,width:usize,alignment:usize}
struct State{sources:[]const modules.Source,units:[]const modules.Unit,tokens:[]const lex.Token,
 nodes:[]const ast.Node,symbols:[]const names.Symbol,refs:[]const binding.Ref,w:*const Workspace,
 type_count:usize,field_count:usize,limb_count:usize,unchecked:usize,limit:usize,
 status:u64,error_unit:usize,error_token:usize,detail:u64}
fn span(p:u64,n:usize)bool{return n==0||(p!=0&&n<=NONE-p);}
fn overlap(a:*const Region,b:*const Region)bool{unsafe{
 return (*a).n!=0&&(*b).n!=0&&(*a).p<(*b).p+(*b).n&&(*b).p<(*a).p+(*a).n;
}}
fn equal(a:[]const u8,b:[]const u8)bool{
 if a.len!=b.len{return false;}var i:usize=0;while i<a.len{if a[i]!=b[i]{return false;}i+=1;}return true;
}
unsafe fn at(s:*State,u:usize,id:usize)*const ast.Node{unsafe{return (*s).nodes.ptr+(*s).units[u].node_start+id;}}
unsafe fn gid(s:*State,u:usize,id:usize)usize{unsafe{return (*s).units[u].node_start+id;}}
unsafe fn text(s:*State,u:usize,token:usize)[]const u8{unsafe{return names.text((*s).sources,(*s).units,(*s).tokens,u,token);}}
unsafe fn fail(s:*State,code:u64,u:usize,id:usize,detail:u64)usize{unsafe{
 if (*s).status==0{(*s).status=code;(*s).error_unit=u;(*s).error_token=0;
  if u<(*s).units.len&&id<(*s).units[u].node_count{(*s).error_token=(*at(s,u,id)).token;}(*s).detail=detail;
 }return NONE;
}}
unsafe fn enter(s:*State,u:usize,id:usize,depth:usize)bool{unsafe{
 if (*s).status!=0{return false;}
 if u>=(*s).units.len||id>=(*s).units[u].node_count{fail(s,BAD_GRAPH,u,id,0);return false;}
 if depth>=(*s).limit{fail(s,DEPTH,u,id,0);return false;}return true;
}}
unsafe fn store(s:*State,kind:u64,typ:usize,negative:bool,words:[]const u32,out:*Value)bool{unsafe{
 let w=(*s).w;if words.len>(*w).limbs.len-(*s).limb_count{fail(s,CAPACITY,0,NONE,1);return false;}
 let first=(*s).limb_count;var i:usize=0;while i<words.len{(*w).limbs[first+i]=words[i];i+=1;}(*s).limb_count+=words.len;
 *out=Value{kind:kind,typ:typ,negative:negative&&words.len!=0,first:first,used:words.len};return true;
}}
unsafe fn number(s:*State,value:usize,typ:usize,out:*Value)bool{unsafe{
 let words=[value as u32,(value>>32)as u32];var count:usize=0;if value!=0{count=1;if words[1]!=0{count=2;}}
 return store(s,arithmetic.INTEGER,typ,false,slice_from_raw_parts(&words[0],count),out);
}}
fn width(typ:usize)usize{if typ<4{return (8 as usize)<<typ;}if typ<8{return (8 as usize)<<(typ-4);}return 0;}
unsafe fn fits(s:*State,v:*const Value,typ:usize)bool{unsafe{
 if typ==8{return (*v).kind==arithmetic.BOOLEAN;}
 if typ>=8||(*v).kind!=arithmetic.INTEGER{return false;}let bits=width(typ);
 if typ<4&&(*v).negative{return false;}if (*v).used==0{return true;}
 let count=(bits+31)/32;if (*v).used>count{return false;}let w=(*s).w;
 if typ<4{if bits<32&&(*w).limbs[(*v).first]>((1 as u32)<<bits)-1{return false;}return true;}
 let sign=bits-1;let high=sign/32;let max=(1 as u32)<<(sign%32);
 if (*v).used<high+1{return true;}let top=(*w).limbs[(*v).first+high];
 if top<max{return true;}if !(*v).negative||top>max{return false;}
 var i:usize=0;while i<high{if (*w).limbs[(*v).first+i]!=0{return false;}i+=1;}return true;
}}
unsafe fn coerce(s:*State,u:usize,id:usize,v:*Value,typ:usize)bool{unsafe{
 if ((*v).typ!=NONE&&(*v).typ!=typ)||!fits(s,v,typ){fail(s,TYPE,u,id,typ as u64);return false;}(*v).typ=typ;return true;
}}
unsafe fn wrapped(s:*State,u:usize,id:usize,v:*Value,typ:usize)bool{unsafe{
 if typ>=8{fail(s,TYPE,u,id,typ as u64);return false;}let w=(*s).w;var raw:u64=0;
 if (*v).used!=0{raw=(*w).limbs[(*v).first]as u64;}if (*v).used>1{raw|=((*w).limbs[(*v).first+1]as u64)<<32;}
 if (*v).negative{raw=wrapping_sub(0 as u64,raw);}let bits=width(typ);var mask:u64=NONE as u64;
 if bits<64{mask=((1 as u64)<<bits)-1;raw&=mask;}let neg=typ>=4&&(raw&((1 as u64)<<(bits-1)))!=0;
 if neg{raw=wrapping_sub(0 as u64,raw)&mask;}var result=Value{kind:0,typ:NONE,negative:false,first:0,used:0};
 if !number(s,raw as usize,typ,&result){return false;}result.negative=neg&&result.used!=0;*v=result;return true;
}}
// Synthesize a tiny postorder C3 tree from already-resolved scalar operands.
// Text is only integer hex literals; C3 still performs all arithmetic.
unsafe fn operand(s:*State,v:*const Value,bytes:*usize,count:*usize)usize{unsafe{
 let w=(*s).w;var token=lex.EMPTY_TOKEN;var tag=ast.INTEGER;var start=*bytes;
 if (*v).kind==arithmetic.BOOLEAN{tag=ast.BOOLEAN;token.kind=287;if (*v).used!=0{token.kind=286;}}
 else{
  if (*v).used>(NONE-3)/8{fail(s,CAPACITY,0,NONE,2);return NONE;}var need:usize=3;if (*v).used!=0{need=2+(*v).used*8;}
  if need>(*w).text.len-*bytes{fail(s,CAPACITY,0,NONE,2);return NONE;}
  (*w).text[*bytes]=48;(*w).text[*bytes+1]=120;*bytes+=2;
  if (*v).used==0{(*w).text[*bytes]=48;*bytes+=1;}else{
   let digits="0123456789abcdef";var i=(*v).used;while i!=0{i-=1;let word=(*w).limbs[(*v).first+i];var j:usize=8;
    while j!=0{j-=1;(*w).text[*bytes]=digits[((word>>(j*4))&15)as usize];*bytes+=1;}
   }
  }token.kind=lex.INTEGER;token.start=start;token.end=*bytes;
 }
 if *count>=(*w).math_nodes.len||*count>=(*w).math_tokens.len{fail(s,CAPACITY,0,NONE,3);return NONE;}
 let index=*count;(*w).math_tokens[index]=token;(*w).math_nodes[index]=ast.Node{kind:tag,token:index,op:0,a:NONE,b:NONE,c:NONE,next:NONE,flags:0};*count+=1;
 if !(*v).negative{return index;}return operation(s,1069,index,NONE,count);
}}
unsafe fn operation(s:*State,op:u64,a:usize,b:usize,count:*usize)usize{unsafe{
 let w=(*s).w;if *count>=(*w).math_nodes.len||*count>=(*w).math_tokens.len{fail(s,CAPACITY,0,NONE,3);return NONE;}
 let index=*count;var token=lex.EMPTY_TOKEN;token.kind=op;(*w).math_tokens[index]=token;
 var kind=ast.BINARY;if b==NONE{kind=ast.UNARY;}
 (*w).math_nodes[index]=ast.Node{kind:kind,token:index,op:op,a:a,b:b,c:NONE,next:NONE,flags:0};*count+=1;return index;
}}
unsafe fn run_math(s:*State,u:usize,id:usize,op:u64,a:*const Value,b:*const Value,unary:bool,out:*Value)bool{unsafe{
 var bytes:usize=0;var count:usize=0;let left=operand(s,a,&bytes,&count);if (*s).status!=0{return false;}var right:usize=NONE;
 if !unary{right=operand(s,b,&bytes,&count);if (*s).status!=0{return false;}}
 let root=operation(s,op,left,right,&count);if (*s).status!=0{return false;}let w=(*s).w;
 var value=arithmetic.Value{kind:0,negative:false,used:0};let status=arithmetic.evaluate(slice_from_raw_parts((*w).text.ptr,bytes),
  slice_from_raw_parts((*w).math_tokens.ptr,count),slice_from_raw_parts((*w).math_nodes.ptr,count),root,(*w).eval_out,(*w).eval_work,(*s).limit,&value);
 if status!=0{var code=CONSTANT;if status==arithmetic.CAPACITY||status==arithmetic.WORKSPACE{code=CAPACITY;}fail(s,code,u,id,status);return false;}
 return store(s,value.kind,NONE,value.negative,slice_from_raw_parts((*w).eval_out.ptr,value.used),out);
}}
unsafe fn leaf(s:*State,u:usize,id:usize,out:*Value)bool{unsafe{
 let unit=(*s).units[u];let w=(*s).w;var value=arithmetic.Value{kind:0,negative:false,used:0};
 let status=arithmetic.evaluate(modules.unit_source((*s).sources,&unit),modules.unit_tokens((*s).tokens,&unit),
  modules.unit_nodes((*s).nodes,&unit),id,(*w).eval_out,(*w).eval_work,(*s).limit,&value);
 if status!=0{var code=CONSTANT;if status==arithmetic.CAPACITY||status==arithmetic.WORKSPACE{code=CAPACITY;}fail(s,code,u,id,status);return false;}
 var typ:usize=NONE;if value.kind==arithmetic.BOOLEAN{typ=8;}
 return store(s,value.kind,typ,value.negative,slice_from_raw_parts((*w).eval_out.ptr,value.used),out);
}}
unsafe fn fold(s:*State,u:usize,id:usize,expected:usize,depth:usize,out:*Value)bool{unsafe{
 if !enter(s,u,id,depth){return false;}let n=*at(s,u,id);
 if n.kind==ast.INTEGER||n.kind==ast.BOOLEAN{return leaf(s,u,id,out);}
 if n.kind==ast.NAME||n.kind==ast.FIELD{
  let r=(*s).refs[gid(s,u,id)];var owner=r.unit;var declaration=r.target;
  if r.kind==binding.GLOBAL{let sym=(*s).symbols[r.target];if sym.kind!=names.CONST{fail(s,CONSTANT,u,id,1);return false;}owner=sym.unit;declaration=sym.declaration;}
  else if r.kind!=binding.LOCAL||r.detail!=260{fail(s,UNSUPPORTED,u,id,n.kind);return false;}
  return constant(s,owner,declaration,depth+1,out);
 }
 if n.kind==ast.LAYOUT{
  let typ=resolve(s,u,n.a,depth+1);if (*s).status!=0||!get_layout(s,typ,u,id,depth+1){return false;}let w=(*s).w;var value=(*w).layouts[typ].size;
  let name=text(s,u,n.token);if equal(name,"alignof"){value=(*w).layouts[typ].alignment;}
  else if equal(name,"offsetof"){
   let t=(*w).types[typ];if t.kind!=STRUCT{fail(s,TYPE,u,id,0);return false;}var i:usize=0;var found=false;
   while i<t.length{let f=(*w).fields[t.first+i];let field=*at(s,f.unit,f.node);
    if equal(text(s,f.unit,field.token),text(s,u,n.op as usize)){
     if f.unit!=u&&(field.flags&1)==0{fail(s,PRIVATE,u,id,0);return false;}value=(*w).field_offsets[t.first+i];found=true;break;
    }i+=1;
   }if !found{fail(s,TYPE,u,id,0);return false;}
  }return number(s,value,3,out);
 }
 if n.kind==ast.CAST{
  var child=Value{kind:0,typ:NONE,negative:false,first:0,used:0};if !fold(s,u,n.a,NONE,depth+1,&child){return false;}
  let target=resolve(s,u,n.b,depth+1);if (*s).status!=0{return false;}
  if child.typ==NONE&&!coerce(s,u,n.a,&child,7){return false;}
  if child.typ>8||target>=8{fail(s,TYPE,u,id,0);return false;}child.kind=arithmetic.INTEGER;
  if !wrapped(s,u,id,&child,target){return false;}*out=child;return true;
 }
 if n.kind!=ast.UNARY&&n.kind!=ast.BINARY{fail(s,UNSUPPORTED,u,id,n.kind);return false;}
 var a=Value{kind:0,typ:NONE,negative:false,first:0,used:0};var b=a;let op=n.op;
 let comparison=op==514||op==515||op==516||op==517||op==1084||op==1086;
 var context=expected;if comparison||op==518||op==519{context=NONE;}
 if !fold(s,u,n.a,context,depth+1,&a){return false;}
 if n.kind==ast.UNARY{
  if op!=1069&&op!=1150&&op!=1057{fail(s,UNSUPPORTED,u,id,op);return false;}
  if op==1057{if !coerce(s,u,id,&a,8){return false;}}
  else{if a.kind!=arithmetic.INTEGER{fail(s,TYPE,u,id,0);return false;}
   if op==1150&&a.typ==NONE&&expected<8{if !coerce(s,u,id,&a,expected){return false;}}
  }
  let typ=a.typ;if !run_math(s,u,id,op,&a,&b,true,out){return false;}(*out).typ=typ;
  if op==1150&&typ<8{return wrapped(s,u,id,out,typ);}return typ==NONE||coerce(s,u,id,out,typ);
 }
 var right_context=context;if op==520||op==521{right_context=3;}
 if !fold(s,u,n.b,right_context,depth+1,&b){return false;}
 var typ:usize=NONE;
 if op==520||op==521{
  if a.kind!=arithmetic.INTEGER||!coerce(s,u,n.b,&b,3){fail(s,TYPE,u,id,0);return false;}
  typ=a.typ;if typ==NONE&&expected<8{if !coerce(s,u,n.a,&a,expected){return false;}typ=expected;}
  var count:usize=0;if !small(s,u,n.b,&b,false,&count){return false;}var bits:usize=64;if typ<8{bits=width(typ);}
  if count>=bits{fail(s,CONSTANT,u,id,arithmetic.SHIFT);return false;}
 }else{
  if a.typ==NONE&&b.typ!=NONE{if !coerce(s,u,n.a,&a,b.typ){return false;}}
  if b.typ==NONE&&a.typ!=NONE{if !coerce(s,u,n.b,&b,a.typ){return false;}}
  if a.typ!=b.typ||a.kind!=b.kind{fail(s,TYPE,u,id,0);return false;}typ=a.typ;
  if comparison&&typ==NONE{if !coerce(s,u,n.a,&a,7)||!coerce(s,u,n.b,&b,7){return false;}typ=7;}
  if (op==518||op==519)&&typ!=8{fail(s,TYPE,u,id,0);return false;}
  if typ==8&&op!=514&&op!=515&&op!=518&&op!=519{fail(s,TYPE,u,id,0);return false;}
 }
 // Signed minimum / -1 is invalid for both quotient and remainder.
 if (op==1071||op==1061)&&typ>=4&&typ<8&&a.negative&&b.negative&&b.used==1{
  let w=(*s).w;if (*w).limbs[b.first]==1{var positive=a;positive.negative=false;
   if !fits(s,&positive,typ){fail(s,CONSTANT,u,id,4);return false;}}
 }
 if !run_math(s,u,id,op,&a,&b,false,out){return false;}
 if comparison||op==518||op==519{(*out).typ=8;return true;}(*out).typ=typ;
 if op==520&&typ<8{return wrapped(s,u,id,out,typ);}return typ==NONE||coerce(s,u,id,out,typ);
}}
unsafe fn small(s:*State,u:usize,id:usize,value:*const Value,positive:bool,out:*usize)bool{unsafe{
 if (*value).kind!=arithmetic.INTEGER||(*value).negative||(*value).used>2||(positive&&(*value).used==0){fail(s,CONSTANT,u,id,0);return false;}
 let w=(*s).w;var n:usize=0;if (*value).used!=0{n=(*w).limbs[(*value).first]as usize;}
 if (*value).used>1{n|=((*w).limbs[(*value).first+1]as usize)<<32;}*out=n;return true;
}}
unsafe fn integer(s:*State,u:usize,id:usize,positive:bool,depth:usize,out:*usize)bool{unsafe{
 var v=Value{kind:0,typ:NONE,negative:false,first:0,used:0};return fold(s,u,id,NONE,depth+1,&v)&&small(s,u,id,&v,positive,out);
}}
unsafe fn constant(s:*State,u:usize,id:usize,depth:usize,out:*Value)bool{unsafe{
 if !enter(s,u,id,depth){return false;}let w=(*s).w;let global=gid(s,u,id);let state=(*w).value_states[global];
 if state==2{*out=(*w).values[global];return true;}if state==1{fail(s,CYCLE,u,id,1);return false;}
 let n=*at(s,u,id);if (n.kind!=ast.GLOBAL&&n.kind!=ast.BINDING)||n.op!=260{fail(s,CONSTANT,u,id,0);return false;}
 (*w).value_states[global]=1;var typ:usize=NONE;if n.a!=NONE{typ=resolve(s,u,n.a,depth+1);if (*s).status!=0{return false;}}
 if typ!=NONE&&typ>8{fail(s,UNSUPPORTED,u,id,0);return false;}
 var v=Value{kind:0,typ:NONE,negative:false,first:0,used:0};if !fold(s,u,n.b,typ,depth+1,&v){return false;}
 if typ==NONE{typ=v.typ;if typ==NONE{typ=7;}}if !coerce(s,u,id,&v,typ){return false;}
 (*w).values[global]=v;(*w).node_types[global]=typ;(*w).value_states[global]=2;*out=v;return true;
}}
unsafe fn add_type(s:*State,t:*const Type)usize{unsafe{
 let w=(*s).w;let id=(*s).type_count;if id==(*w).types.len{return fail(s,CAPACITY,(*t).unit,(*t).node,2);}
 (*w).types[id]=*t;(*w).layout_ready[id]=0;(*s).type_count+=1;return id;
}}
unsafe fn fields(s:*State,u:usize,id:usize,count:usize)usize{unsafe{
 let w=(*s).w;let first=(*s).field_count;if count>(*w).fields.len-first{return fail(s,CAPACITY,u,id,3);}
 var i:usize=0;while i<count{(*w).field_offsets[first+i]=0;i+=1;}(*s).field_count+=count;return first;
}}
unsafe fn scalar(s:*State,typ:usize)bool{unsafe{
 if typ>=(*s).type_count{return false;}let k=(*(*s).w).types[typ].kind;return k<=9||k==POINTER||k==FUNCTION;
}}
unsafe fn compound(s:*State,t:*const Type)usize{unsafe{
 let w=(*s).w;var i:usize=9;while i<(*s).type_count{let a=(*w).types[i];
  if a.kind==(*t).kind&&a.flags==(*t).flags&&a.element==(*t).element&&a.count==(*t).count&&a.kind!=STRUCT&&a.kind!=ENUM&&a.kind!=FUNCTION{return i;}i+=1;
 }return add_type(s,t);
}}
unsafe fn resolve(s:*State,u:usize,id:usize,depth:usize)usize{unsafe{
 if !enter(s,u,id,depth){return NONE;}let w=(*s).w;let global=gid(s,u,id);let n=*at(s,u,id);
 if (*w).node_types[global]!=NONE{return (*w).node_types[global];}var typ:usize=NONE;
 if n.kind==ast.TYPE_NAME{
  let r=(*s).refs[gid(s,u,n.a)];
  if r.kind==binding.BUILTIN_TYPE{
   if r.target>=1&&r.target<=9{typ=r.target-1;}else if r.target==10{typ=VOID;}else if r.target==11{typ=NORETURN;}else{return fail(s,BAD_GRAPH,u,id,1);}
  }else if r.kind==binding.GLOBAL{
   if r.target>=(*s).symbols.len{return fail(s,BAD_GRAPH,u,id,2);}let symbol=(*s).symbols[r.target];let g=gid(s,symbol.unit,symbol.declaration);
   if symbol.kind==names.STRUCT||symbol.kind==names.ENUM{typ=(*w).node_types[g];}
   else if symbol.kind==names.ALIAS{
    if (*w).type_states[g]==1{return fail(s,CYCLE,u,id,2);}if (*w).type_states[g]!=2{
     (*w).type_states[g]=1;let alias=*at(s,symbol.unit,symbol.declaration);typ=resolve(s,symbol.unit,alias.a,depth+1);
     if (*s).status!=0{return NONE;}(*w).node_types[g]=typ;(*w).type_states[g]=2;
    }else{typ=(*w).node_types[g];}
   }else{return fail(s,TYPE,u,id,1);}
  }else{return fail(s,TYPE,u,id,2);}
 }else if n.kind==ast.TYPE_FUNCTION{
  let ret=resolve(s,u,n.b,depth+1);if (*s).status!=0{return NONE;}var p=n.a;var count:usize=0;
  while p!=NONE{count+=1;p=(*at(s,u,p)).next;}let first=fields(s,u,id,count);if (*s).status!=0{return NONE;}
  p=n.a;var i:usize=0;while p!=NONE{let param=*at(s,u,p);let target=resolve(s,u,param.a,depth+1);if (*s).status!=0{return NONE;}
   (*w).fields[first+i]=Field{typ:target,unit:u,node:p};i+=1;p=param.next;
  }
  let t=Type{kind:FUNCTION,flags:n.op|(n.flags<<1),element:ret,count:0,first:first,length:count,unit:u,node:id,alignment:0};typ=add_type(s,&t);
 }else{
  var kind:u64=0;if n.kind==ast.TYPE_POINTER{kind=POINTER;}else if n.kind==ast.TYPE_SLICE{kind=SLICE;}
  else if n.kind==ast.TYPE_ARRAY{kind=ARRAY;}else if n.kind==ast.TYPE_OPTIONAL{kind=OPTIONAL;}else if n.kind==ast.TYPE_ERROR{kind=RESULT;}
  else{return fail(s,BAD_GRAPH,u,id,n.kind);}let element=resolve(s,u,n.a,depth+1);if (*s).status!=0{return NONE;}
  if element==NORETURN||(element==VOID&&kind!=RESULT){return fail(s,TYPE,u,id,3);}
  if (kind==OPTIONAL||kind==RESULT)&&element!=VOID&&!scalar(s,element){return fail(s,TYPE,u,id,4);}
  var count:usize=0;if kind==ARRAY{if !integer(s,u,n.b,true,depth+1,&count){return NONE;}}
  let t=Type{kind:kind,flags:n.flags,element:element,count:count,first:0,length:0,unit:u,node:id,alignment:0};typ=compound(s,&t);
 }
 if (*s).status==0{(*w).node_types[global]=typ;}return typ;
}}
unsafe fn populate(s:*State,typ:usize,depth:usize)bool{unsafe{
 let w=(*s).w;let t=(*w).types[typ];if t.kind!=STRUCT&&t.kind!=ENUM{return true;}
 let g=gid(s,t.unit,t.node);if (*w).type_states[g]==2{return true;}if (*w).type_states[g]==1{fail(s,CYCLE,t.unit,t.node,3);return false;}
 if !enter(s,t.unit,t.node,depth){return false;}(*w).type_states[g]=1;let n=*at(s,t.unit,t.node);
 var member=n.a;var count:usize=0;while member!=NONE{count+=1;member=(*at(s,t.unit,member)).next;}
 if count==0{fail(s,TYPE,t.unit,t.node,5);return false;}let first=fields(s,t.unit,t.node,count);if (*s).status!=0{return false;}
 (*w).types[typ].first=first;(*w).types[typ].length=count;
 var i:usize=0;member=n.a;while member!=NONE{let f=*at(s,t.unit,member);var ft:usize=NONE;
  if f.a!=NONE{ft=resolve(s,t.unit,f.a,depth+1);if (*s).status!=0{return false;}
   if ft==VOID||ft==NORETURN||(t.kind==ENUM&&!scalar(s,ft)){fail(s,TYPE,t.unit,member,6);return false;}
  }else if t.kind==STRUCT{fail(s,TYPE,t.unit,member,7);return false;}
  (*w).fields[first+i]=Field{typ:ft,unit:t.unit,node:member};i+=1;member=f.next;
 }
 let unit=(*s).units[t.unit];i=0;while i<unit.node_count{let d=*at(s,t.unit,i);
  if d.kind==ast.DECLARATION&&d.a==t.node{var attr=d.b;while attr!=NONE{let a=*at(s,t.unit,attr);
   if a.op==269{(*w).types[typ].flags|=1;}
   if a.op==270{var requested:usize=0;if !integer(s,t.unit,a.a,true,depth+1,&requested){return false;}(*w).types[typ].alignment=requested;}
   attr=a.next;
  }}i+=1;
 }

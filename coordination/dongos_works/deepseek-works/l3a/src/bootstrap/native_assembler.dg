// Restricted two-pass assembler for the native compiler's explicit NASM dialect.
// No macros, external symbols, host assembler invocation or silent fallback.
module bootstrap.native_assembler;
import bootstrap.x86_encode as x86;
import bootstrap.elf64_image as elf;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;pub const SYNTAX:u64=3;pub const SYMBOL:u64=4;pub const RANGE:u64=5;
const NONE:usize=0xffff_ffff_ffff_ffff;
pub struct Label{pub start:usize,pub length:usize,pub section:u64,pub offset:usize}
pub struct Workspace{pub labels:[]Label,pub table:[]usize,pub text:[]u8,pub data:[]u8}
pub struct Result{pub status:u64,pub line:usize,pub detail:u64,pub text_bytes:usize,pub data_bytes:usize,pub labels:usize,pub written:usize}
struct State{source:[]const u8,w:*const Workspace,status:u64,line:usize,detail:u64,pass:u64,section:u64,text:usize,data:usize,label_count:usize,text_size:usize,at:usize,end:usize,conditional:bool,metadata:bool}
struct Operand{kind:u64,reg:u64,width:u64,base:u64,disp:u64,value:u64,start:usize,length:usize}
fn span(p:u64,n:usize)bool{return n==0||(p!=0&&n<=NONE-p);}
fn overlap(a:u64,n:usize,b:u64,m:usize)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn equal(a:[]const u8,b:[]const u8)bool{if a.len!=b.len{return false;}var i:usize=0;while i<a.len{if a[i]!=b[i]{return false;}i+=1;}return true;}
unsafe fn fail(s:*State,status:u64,detail:u64)bool{unsafe{if (*s).status==0{(*s).status=status;(*s).detail=detail;}return false;}}
fn space(b:u8)bool{return b==32||b==9||b==13;}
fn namechar(b:u8)bool{return (b>=65&&b<=90)||(b>=97&&b<=122)||(b>=48&&b<=57)||b==95||b==46;}
fn identifier(name:[]const u8)bool{return name.len!=0&&((name[0]>=65&&name[0]<=90)||(name[0]>=97&&name[0]<=122)||name[0]==95);}
unsafe fn skip(s:*State)void{unsafe{while (*s).at<(*s).end&&space((*s).source[(*s).at]){(*s).at+=1;}}}
unsafe fn view(s:*const State,start:usize,length:usize)[]const u8{unsafe{return slice_from_raw_parts((*s).source.ptr+start,length);}}
unsafe fn word(s:*State)[]const u8{unsafe{skip(s);let first=(*s).at;while (*s).at<(*s).end&&namechar((*s).source[(*s).at]){(*s).at+=1;}return view(s,first,(*s).at-first);}}
unsafe fn token(s:*State,b:u8)bool{unsafe{skip(s);if (*s).at<(*s).end&&(*s).source[(*s).at]==b{(*s).at+=1;return true;}return false;}}
unsafe fn end(s:*State)bool{unsafe{skip(s);return (*s).at==(*s).end;}}
unsafe fn number(s:*State,out:*u64)bool{unsafe{
 skip(s);var negative=false;if token(s,45){negative=true;}else{token(s,43);}skip(s);let first=(*s).at;var radix:u64=10;
 if (*s).end-(*s).at>=2&&(*s).source[(*s).at]==48&&((*s).source[(*s).at+1]==120||(*s).source[(*s).at+1]==88){radix=16;(*s).at+=2;}
 let digits=(*s).at;var value:u64=0;while (*s).at<(*s).end{let b=(*s).source[(*s).at];var d:u64=NONE;
  if b>=48&&b<=57{d=(b-48)as u64;}else if b>=65&&b<=70{d=(b-55)as u64;}else if b>=97&&b<=102{d=(b-87)as u64;}
  if d>=radix{break;}if value>(NONE-d)/radix{return fail(s,RANGE,1);}value=value*radix+d;(*s).at+=1;
 }if (*s).at==digits{(*s).at=first;return false;}if negative{if value>0x8000_0000_0000_0000{return fail(s,RANGE,2);}value=wrapping_sub(0 as u64,value);}*out=value;return true;
}}
fn register(name:[]const u8,out:*Operand)bool{unsafe{
 let r64=["rax","rcx","rdx","rbx","rsp","rbp","rsi","rdi","r8","r9","r10","r11","r12","r13","r14","r15"];
 let r32=["eax","ecx","edx","ebx","esp","ebp","esi","edi","r8d","r9d","r10d","r11d","r12d","r13d","r14d","r15d"];
 let r16=["ax","cx","dx","bx","sp","bp","si","di","r8w","r9w","r10w","r11w","r12w","r13w","r14w","r15w"];
 let r8=["al","cl","dl","bl","spl","bpl","sil","dil","r8b","r9b","r10b","r11b","r12b","r13b","r14b","r15b"];
 var i:usize=0;while i<16{var width:u64=0;if equal(name,r64[i]){width=64;}else if equal(name,r32[i]){width=32;}else if equal(name,r16[i]){width=16;}else if equal(name,r8[i]){width=8;}
  if width!=0{(*out).kind=1;(*out).reg=i;(*out).width=width;return true;}i+=1;}return false;
}}
unsafe fn hash(s:*const State,start:usize,length:usize)u64{unsafe{var h:u64=14695981039346656037;var i:usize=0;while i<length{h=wrapping_mul(h^((*s).source[start+i]as u64),1099511628211);i+=1;}return h;}}
unsafe fn lookup(s:*State,start:usize,length:usize,insert:bool)usize{unsafe{
 if !identifier(view(s,start,length)){fail(s,SYNTAX,56);return NONE;}
 if length==0||(*(*s).w).table.len==0{fail(s,CAPACITY,3);return NONE;}var at=(hash(s,start,length)%(*(*s).w).table.len)as usize;var probes:usize=0;
 while probes<(*(*s).w).table.len{let index=(*(*s).w).table[at];if index==NONE{
   if !insert{return NONE;}if (*s).label_count==(*(*s).w).labels.len{fail(s,CAPACITY,4);return NONE;}
   let id=(*s).label_count;var offset=(*s).text;if (*s).section==2||(*s).section==3{offset=(*s).data;}
   (*(*s).w).labels[id]=Label{start:start,length:length,section:(*s).section,offset:offset};(*(*s).w).table[at]=id;(*s).label_count+=1;return id;
  }
  let label=(*(*s).w).labels[index];if equal(view(s,start,length),view(s,label.start,label.length)){if insert{fail(s,SYMBOL,5);return NONE;}return index;}
  at+=1;if at==(*(*s).w).table.len{at=0;}probes+=1;
 }if insert{fail(s,CAPACITY,6);}return NONE;
}}
unsafe fn address(s:*State,start:usize,length:usize,out:*u64)bool{unsafe{
 if (*s).pass==0{*out=0;return true;}let index=lookup(s,start,length,false);if index==NONE{return fail(s,SYMBOL,7);}let label=(*(*s).w).labels[index];
 var base=elf.BASE+elf.TEXT_OFFSET;if label.section==2||label.section==3{base=elf.BASE+((elf.TEXT_OFFSET+(*s).text_size+4095)&~(4095 as usize));}
 *out=base+label.offset;return true;
}}
unsafe fn operand(s:*State,out:*Operand)bool{unsafe{
 *out=Operand{kind:0,reg:0,width:0,base:0,disp:0,value:0,start:0,length:0};skip(s);let begin=(*s).at;let name=word(s);var width:u64=0;
 if equal(name,"byte"){width=8;}else if equal(name,"word"){width=16;}else if equal(name,"dword"){width=32;}else if equal(name,"qword"){width=64;}
 if width==0{(*s).at=begin;}
 if token(s,91){(*out).kind=3;(*out).width=width;let first=(*s).at;let base=word(s);
  if equal(base,"rel"){let label_start=(*s).at;let label=word(s);(*out).base=16;(*out).start=(*s).at-label.len;(*out).length=label.len;
   if label.len==0{return fail(s,SYNTAX,label_start);}if !token(s,93){return fail(s,SYNTAX,8);}return true;
  }
  var reg=Operand{kind:0,reg:0,width:0,base:0,disp:0,value:0,start:0,length:0};if !register(base,&reg)||reg.width!=64{return fail(s,SYNTAX,first);}(*out).base=reg.reg;
  skip(s);let before_index=(*s).at;if token(s,43){let index_name=word(s);var index=Operand{kind:0,reg:0,width:0,base:0,disp:0,value:0,start:0,length:0};
   if register(index_name,&index)&&index.width==64{(*out).kind=5;(*out).reg=index.reg;(*out).value=1;if token(s,42){if !number(s,&(*out).value){return fail(s,SYNTAX,54);}}}
   else{(*s).at=before_index;}
  }
  skip(s);if (*s).at<(*s).end&&(*s).source[(*s).at]!=93{if (*s).source[(*s).at]!=43&&(*s).source[(*s).at]!=45{return fail(s,SYNTAX,57);}var d:u64=0;if !number(s,&d){return fail(s,SYNTAX,9);}(*out).disp=d;}
  if !token(s,93){return fail(s,SYNTAX,10);}return true;
 }
 if width!=0{return fail(s,SYNTAX,11);}(*s).at=begin;let regname=word(s);if register(regname,out){return true;}
 (*s).at=begin;var value:u64=0;if number(s,&value){(*out).kind=2;(*out).value=value;return true;}
 if (*s).status!=0{return false;}(*s).at=begin;let label=word(s);if label.len==0{return fail(s,SYNTAX,12);}(*out).kind=4;(*out).start=(*s).at-label.len;(*out).length=label.len;return true;
}}
unsafe fn bytes(s:*State,input:[]const u8)bool{unsafe{
 if (*s).section!=1&&(*s).section!=2&&(*s).section!=3{return fail(s,SYNTAX,13);}var at=(*s).text;var out=(*(*s).w).text;if (*s).section==2||(*s).section==3{at=(*s).data;out=(*(*s).w).data;}
 if at>out.len||input.len>out.len-at{return fail(s,CAPACITY,14);}if (*s).pass!=0{var i:usize=0;while i<input.len{out[at+i]=input[i];i+=1;}}
 if (*s).section==1{(*s).text+=input.len;}else{(*s).data+=input.len;}return true;
}}
unsafe fn value_bytes(s:*State,value:u64,width:usize)bool{unsafe{var raw:[8]u8=[0;8];var i:usize=0;while i<width{raw[i]=(value>>(i*8))as u8;i+=1;}return bytes(s,slice_from_raw_parts(&raw[0],width));}}
fn operation(name:[]const u8)u64{
 if equal(name,"mov"){return x86.MOV;}if equal(name,"add"){return x86.ADD;}if equal(name,"sub"){return x86.SUB;}
 if equal(name,"and"){return x86.AND;}if equal(name,"or"){return x86.OR;}if equal(name,"xor"){return x86.XOR;}if equal(name,"cmp"){return x86.CMP;}if equal(name,"test"){return x86.TEST;}
 if equal(name,"lea"){return x86.LEA;}if equal(name,"movzx"){return x86.MOVZX;}if equal(name,"movsx"){return x86.MOVSX;}if equal(name,"movsxd"){return x86.MOVSXD;}
 if equal(name,"neg"){return x86.NEG;}if equal(name,"not"){return x86.NOT;}if equal(name,"mul"){return x86.MUL;}if equal(name,"div"){return x86.DIV;}if equal(name,"idiv"){return x86.IDIV;}if equal(name,"imul"){return x86.IMUL;}
 if equal(name,"shl"){return x86.SHL;}if equal(name,"shr"){return x86.SHR;}if equal(name,"sar"){return x86.SAR;}
 if equal(name,"push"){return x86.PUSH;}if equal(name,"pop"){return x86.POP;}if equal(name,"call"){return x86.CALL;}if equal(name,"jmp"){return x86.JMP;}
 if equal(name,"syscall"){return x86.SYSCALL;}if equal(name,"cqo"){return x86.CQO;}if equal(name,"ret"){return x86.RET;}if equal(name,"ud2"){return x86.UD2;}if equal(name,"cld"){return x86.CLD;}if equal(name,"std"){return x86.STD;}return 0;
}
fn condition(name:[]const u8)u64{
 if equal(name,"o"){return 0;}if equal(name,"no"){return 1;}if equal(name,"b")||equal(name,"c"){return 2;}if equal(name,"ae")||equal(name,"nc"){return 3;}
 if equal(name,"e")||equal(name,"z"){return 4;}if equal(name,"ne")||equal(name,"nz"){return 5;}if equal(name,"be"){return 6;}if equal(name,"a"){return 7;}
 if equal(name,"s"){return 8;}if equal(name,"ns"){return 9;}if equal(name,"p"){return 10;}if equal(name,"np"){return 11;}
 if equal(name,"l"){return 12;}if equal(name,"ge"){return 13;}if equal(name,"le"){return 14;}if equal(name,"g"){return 15;}return NONE;
}
unsafe fn instruction(s:*State,name:[]const u8)bool{unsafe{

  var content_end=finish;var scan=first;while scan<finish{if (*s).source[scan]==59{content_end=scan;break;}scan+=1;}
  while content_end>first&&space((*s).source[content_end-1]){content_end-=1;}var content_start=first;while content_start<content_end&&space((*s).source[content_start]){content_start+=1;}

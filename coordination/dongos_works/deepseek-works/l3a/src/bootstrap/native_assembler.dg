 if name.len>3&&name[0]==115&&name[1]==101&&name[2]==116{ins.op=x86.SETCC;ins.cc=condition(slice_from_raw_parts(name.ptr+3,name.len-3));}
 if equal(name,"rep"){let which=word(s);if equal(which,"movsb"){ins.op=x86.MOVSB;}else if equal(which,"stosb"){ins.op=x86.STOSB;}}
 if ins.op==0||ins.cc==NONE{return fail(s,SYNTAX,16);}var a=Operand{kind:0,reg:0,width:0,base:0,disp:0,value:0,start:0,length:0};var b=a;
 if !end(s){if !operand(s,&a){return false;}if token(s,44){if !operand(s,&b){return false;}}}
 if !end(s){return fail(s,SYNTAX,17);}var reference_start:usize=0;var reference_length:usize=0;
 if a.kind==0{ins.form=x86.NONE;}
 else if ins.op==x86.CALL||ins.op==x86.JMP||ins.op==x86.JCC{
  if b.kind!=0{return fail(s,SYNTAX,18);}if a.kind==4{ins.form=x86.REL;reference_start=a.start;reference_length=a.length;}
  else if a.kind==1{ins.form=x86.REG;ins.width=a.width;ins.dst=a.reg;}else{return fail(s,SYNTAX,19);}
 }else if b.kind==0{if ins.op==x86.SHL||ins.op==x86.SHR||ins.op==x86.SAR{return fail(s,SYNTAX,59);}if a.kind!=1{return fail(s,SYNTAX,20);}ins.form=x86.REG;ins.width=a.width;ins.dst=a.reg;}
 else if ins.op==x86.SHL||ins.op==x86.SHR||ins.op==x86.SAR{
  if a.kind!=1||b.kind!=1||b.reg!=1||b.width!=8{return fail(s,SYNTAX,21);}ins.form=x86.REG;ins.width=a.width;ins.dst=a.reg;
 }else if a.kind==1&&b.kind==5{if ins.op!=x86.LEA||a.width!=64{return fail(s,SYNTAX,55);}ins.form=x86.INDEX;ins.width=64;ins.dst=a.reg;ins.src=b.reg;ins.base=b.base;ins.disp=b.disp;ins.imm=b.value;

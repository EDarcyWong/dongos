unsafe fn line(s:*State)bool{unsafe{
 skip(s);if end(s){return true;}let first=(*s).at;
 if (*s).source[first]==37{
  let rest=view(s,first,(*s).end-first);if equal(rest,"%ifidn __OUTPUT_FORMAT__,elf64"){if (*s).conditional||(*s).metadata{return fail(s,SYNTAX,50);}(*s).conditional=true;(*s).at=(*s).end;return true;}if equal(rest,"%endif"){if !(*s).conditional||!(*s).metadata{return fail(s,SYNTAX,51);}(*s).conditional=false;(*s).at=(*s).end;return true;}return fail(s,SYNTAX,30);

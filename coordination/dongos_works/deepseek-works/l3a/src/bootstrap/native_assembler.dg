struct Region{p:u64,n:usize}
unsafe fn valid(source:[]const u8,entry:[]const u8,w:*const Workspace,out:[]u8,r:*Result)bool{unsafe{
 if w==null||r==null||(w as u64&7)!=0||(r as u64&7)!=0||!span(w as u64,sizeof(Workspace))||!span(r as u64,sizeof(Result)){return false;}
 if (*w).labels.len>NONE/sizeof(Label)||(*w).table.len>NONE/8{return false;}
 let inputs=[Region{p:source.ptr as u64,n:source.len},Region{p:entry.ptr as u64,n:entry.len},Region{p:w as u64,n:sizeof(Workspace)}];
 let outputs=[Region{p:(*w).labels.ptr as u64,n:(*w).labels.len*sizeof(Label)},Region{p:(*w).table.ptr as u64,n:(*w).table.len*8},Region{p:(*w).text.ptr as u64,n:(*w).text.len},Region{p:(*w).data.ptr as u64,n:(*w).data.len},Region{p:out.ptr as u64,n:out.len},Region{p:r as u64,n:sizeof(Result)}];
 if ((*w).labels.ptr as u64&7)!=0||((*w).table.ptr as u64&7)!=0{return false;}
 var i:usize=0;while i<inputs.len{if !span(inputs[i].p,inputs[i].n){return false;}i+=1;}
 i=0;while i<outputs.len{if !span(outputs[i].p,outputs[i].n){return false;}var j:usize=0;while j<inputs.len{if overlap(outputs[i].p,outputs[i].n,inputs[j].p,inputs[j].n){return false;}j+=1;}
  j=0;while j<i{if overlap(outputs[i].p,outputs[i].n,outputs[j].p,outputs[j].n){return false;}j+=1;}i+=1;}
 return true;
}}
pub unsafe fn assemble(source:[]const u8,entry:[]const u8,w:*const Workspace,out:[]u8,r:*Result)u64{unsafe{
 if !valid(source,entry,w,out,r){return INVALID;}
 var s=State{source:source,w:w,status:0,line:0,detail:0,pass:0,section:0,text:0,data:0,label_count:0,text_size:0,at:0,end:0,conditional:false,metadata:false};
 var i:usize=0;while i<(*w).table.len{(*w).table[i]=NONE;i+=1;}
 var entry_offset:usize=NONE;if pass(&s){s.text_size=s.text;i=0;while i<s.label_count{let label=(*w).labels[i];if equal(view(&s,label.start,label.length),entry){if label.section!=1{fail(&s,SYMBOL,48);}else{entry_offset=label.offset;}break;}i+=1;}
  if entry_offset==NONE{fail(&s,SYMBOL,49);}if s.status==0{s.pass=1;pass(&s);}
 }
 var written:usize=0;if s.status==0{let status=elf.emit(slice_from_raw_parts((*w).text.ptr,s.text),slice_from_raw_parts((*w).data.ptr,s.data),0,entry_offset,out,&written);
  if status==elf.CAPACITY{s.status=CAPACITY;}else if status!=0{s.status=RANGE;}s.detail=status;
 }
 *r=Result{status:s.status,line:s.line,detail:s.detail,text_bytes:s.text,data_bytes:s.data,labels:s.label_count,written:written};return s.status;
}}

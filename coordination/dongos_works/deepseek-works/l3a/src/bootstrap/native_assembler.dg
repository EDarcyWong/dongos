unsafe fn data_values(s:*State,width:usize)bool{unsafe{
 if (*s).section!=2&&(*s).section!=3{return fail(s,SYNTAX,27);}var count:usize=0;while true{var value:u64=0;let first=(*s).at;
  if !number(s,&value){if (*s).status!=0{return false;}(*s).at=first;let label=word(s);if width!=8||label.len==0{return fail(s,SYNTAX,28);}
   let label_start=(*s).at-label.len;var add:u64=0;if token(s,43){if !number(s,&add){return fail(s,SYNTAX,60);}}

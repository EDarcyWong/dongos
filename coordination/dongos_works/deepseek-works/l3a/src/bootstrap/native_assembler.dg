 if equal(name,"default"){if !equal(word(s),"rel")||!end(s){return fail(s,SYNTAX,37);}return true;}
 if equal(name,"section"){let section=word(s);if equal(section,".text"){(*s).section=1;}else if equal(section,".rodata"){(*s).section=2;}else if equal(section,".data"){(*s).section=3;}
  else if equal(section,".note.GNU"){return fail(s,SYNTAX,38);}else{return fail(s,SYNTAX,39);}if !end(s){return fail(s,SYNTAX,40);}return true;

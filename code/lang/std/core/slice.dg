// core.slice — byte-slice helpers. All comparisons and searches operate on
// raw bytes; NUL bytes and UTF-8 content carry no special meaning.

module core.slice;

pub fn equal(a: []const u8, b: []const u8) bool {
    if a.len != b.len { return false; }
    var i: usize = 0;
    while i < a.len {
        if a[i] != b[i] { return false; }
        i += 1;
    }
    return true;
}

// Unsigned lexicographic comparison; the shorter slice compares smaller when
// one is a prefix of the other. Returns -1, 0 or 1.
pub fn compare(a: []const u8, b: []const u8) i32 {
    var i: usize = 0;
    while i < a.len && i < b.len {
        if a[i] < b[i] { return -1; }
        if a[i] > b[i] { return 1; }
        i += 1;
    }
    if a.len < b.len { return -1; }
    if a.len > b.len { return 1; }
    return 0;
}

// Index of the first byte equal to value at or after start, or bytes.len when
// absent or when start is not less than the length.
pub fn find_byte(bytes: []const u8, value: u8, start: usize) usize {
    if start >= bytes.len { return bytes.len; }
    var i: usize = start;
    while i < bytes.len {
        if bytes[i] == value { return i; }
        i += 1;
    }
    return bytes.len;
}

// True when lower <= upper <= length. Computed without addition, so it cannot
// overflow.
pub fn range_valid(length: usize, lower: usize, upper: usize) bool {
    return lower <= upper && upper <= length;
}

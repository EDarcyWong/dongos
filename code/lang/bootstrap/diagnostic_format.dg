// Single-line diagnostic text: "path:line:column: CODE: message\n".
// Inputs are opaque borrowed bytes; nothing is re-encoded. Descriptors and
// length arithmetic are checked before any input byte is read. INVALID and
// CAPACITY leave out and *written untouched; success writes the exact prefix.
module bootstrap.diagnostic_format;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
const MAX:u64=0xffff_ffff_ffff_ffff;
// ":" ":" ": " CODE(5) ": " "\n"
const FIXED:usize=12;
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn digits(value:usize)usize{var n:usize=1;var v=value;while v>=10{v/=10;n+=1;}return n;}
fn plain(text:[]const u8)bool{
 var i:usize=0;while i<text.len{let c=text[i];if c==0||c==10||c==13{return false;}i+=1;}return true;
}
fn copy(out:[]u8,at:usize,text:[]const u8)usize{
 var i:usize=0;while i<text.len{out[at+i]=text[i];i+=1;}return at+text.len;
}
fn decimal(out:[]u8,at:usize,value:usize)usize{
 let n=digits(value);var v=value;var i=n;
 while i!=0{i-=1;out[at+i]=(48+v%10)as u8;v/=10;}return at+n;
}
pub unsafe fn render(path:[]const u8,line:usize,column:usize,
 code:[]const u8,message:[]const u8,out:[]u8,written:*usize)u64{unsafe{
 let wp=written as u64;let pp=path.ptr as u64;let cp=code.ptr as u64;let mp=message.ptr as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8){return INVALID;}
 if !span(pp,path.len)||!span(cp,code.len)||!span(mp,message.len)||!span(op,out.len){return INVALID;}
 if overlap(op,out.len,pp,path.len)||overlap(op,out.len,cp,code.len)||overlap(op,out.len,mp,message.len)
  ||overlap(wp,8,pp,path.len)||overlap(wp,8,cp,code.len)||overlap(wp,8,mp,message.len)||overlap(wp,8,op,out.len){return INVALID;}
 if line==0||column==0||path.len==0||code.len!=5{return INVALID;}
 let fixed=FIXED+digits(line)+digits(column);
 if message.len>MAX-path.len{return INVALID;}let body=path.len+message.len;
 if body>MAX-fixed{return INVALID;}let total=body+fixed;
 if code[0]!=69{return INVALID;}
 var i:usize=1;while i<5{if code[i]<48||code[i]>57{return INVALID;}i+=1;}
 if !plain(path)||!plain(message){return INVALID;}
 if total>out.len{return CAPACITY;}
 var at=copy(out,0,path);out[at]=58;at=decimal(out,at+1,line);
 out[at]=58;at=decimal(out,at+1,column);out[at]=58;out[at+1]=32;
 at=copy(out,at+2,code);out[at]=58;out[at+1]=32;
 at=copy(out,at+2,message);out[at]=10;
 *written=total;return OK;
}}

// A whole SysV function for checked 64-bit arithmetic with an observable
// error return: CR3 symbol + ":\n", C44 entry (frame 32, two INTEGER arguments
// captured into [rbp-8]/[rbp-16]), the matching checked primitive, fall-through
// success stores and C42 INTEGER_PAIR exit, then the error label with the same
// C42 exit. The generated function is Pair f(u64 a,u64 b): RAX=value, RDX=status.
// Overflow/borrow/MIN-negate become {0,1}; in-range results are {bits,0}.
// Every piece is produced for real into a bounded local scratch first; out and
// *written are published once after every check. INVALID precedes CAPACITY.
module bootstrap.nasm_checked_u64_function;
import bootstrap.nasm_symbol as sym;
import bootstrap.nasm_sysv_function_entry as ent;
import bootstrap.nasm_integer_memory_load as mld;
import bootstrap.nasm_integer_memory_store as mst;
import bootstrap.nasm_integer_load as ld;
import bootstrap.nasm_checked_add_sub as addsub;
import bootstrap.nasm_checked_multiply as mul;
import bootstrap.nasm_checked_negate as negop;
import bootstrap.nasm_block_emit as blk;
import bootstrap.nasm_sysv_function_exit as ex;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
pub const ADD:u64=0;pub const SUB:u64=1;pub const MUL:u64=2;pub const NEG:u64=3;
const MAX:u64=0xffff_ffff_ffff_ffff;
const NAME_LIMIT:usize=64;
const RAX:u64=0;const RCX:u64=1;const RSI:u64=6;const RDI:u64=7;const RBP:u64=5;
const PAIR:u64=11;const FRAME:usize=32;const LABEL:u64=0;
const B0:usize=268;const B1:usize=1536;const B2:usize=256;const B3:usize=64;
const B4:usize=512;const B5:usize=640;const TOTAL:usize=3276;const PIECE:usize=1536;
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn room(out:[]u8,at:usize,size:usize)bool{return at<=out.len&&size<=out.len-at;}
fn bound(index:usize)usize{
 if index==0{return B0;}if index==1{return B1;}if index==2{return B2;}if index==3{return B3;}
 if index==4{return B4;}return B5;
}
unsafe fn put(out:[]u8,at:*usize,text:[]const u8)bool{unsafe{
 if !room(out,*at,text.len){return false;}
 var i:usize=0;while i<text.len{out[*at+i]=text[i];i+=1;}*at+=text.len;return true;
}}
unsafe fn load_memory(piece:[]u8,at:*usize,register:u64,displacement:i64)bool{unsafe{
 if !room(piece,*at,128){return false;}
 var n:usize=0;
 if mld.emit(register,RBP,displacement,64,false,slice_from_raw_parts(&piece[*at],128),&n)!=mld.OK{return false;}
 if n>128{return false;}
 *at+=n;return true;
}}
unsafe fn store_memory(piece:[]u8,at:*usize,source:u64,displacement:i64)bool{unsafe{
 if !room(piece,*at,128){return false;}
 var n:usize=0;
 if mst.emit(source,RBP,displacement,64,slice_from_raw_parts(&piece[*at],128),&n)!=mst.OK{return false;}
 if n>128{return false;}
 *at+=n;return true;
}}
unsafe fn load_immediate(piece:[]u8,at:*usize,register:u64,value:u64)bool{unsafe{
 if !room(piece,*at,64){return false;}
 var n:usize=0;
 if ld.emit(register,value,64,false,slice_from_raw_parts(&piece[*at],64),&n)!=ld.OK{return false;}
 if n>64{return false;}
 *at+=n;return true;
}}
unsafe fn ok_exit(piece:[]u8,at:*usize)bool{unsafe{
 if !room(piece,*at,192){return false;}
 var n:usize=0;
 if ex.emit(PAIR,FRAME,0,24,32,slice_from_raw_parts(&piece[*at],192),&n)!=ex.OK{return false;}
 if n>192{return false;}
 *at+=n;return true;
}}
unsafe fn err_exit(piece:[]u8,at:*usize)bool{unsafe{
 if !room(piece,*at,192){return false;}
 var n:usize=0;let low:usize=24;let high:usize=32;
 if ex.emit(PAIR,FRAME,0,low,high,slice_from_raw_parts(&piece[*at],192),&n)!=ex.OK{return false;}
 if n>192{return false;}
 *at+=n;return true;
}}
unsafe fn piece(index:usize,module_name:[]const u8,item_name:[]const u8,operation:u64,signed:bool,
 error_block:u64,buffer:[]u8,length:*usize)bool{unsafe{
 var at:usize=0;var n:usize=0;
 if index==0{
  if !room(buffer,0,268){return false;}
  if sym.encode(module_name,item_name,slice_from_raw_parts(&buffer[0],266),&n)!=sym.OK{return false;}
  at=n;if !put(buffer,&at,":\n"){return false;}
 }else if index==1{
  if !room(buffer,0,1536){return false;}
  var kinds:[2]u8=[0;2];var offsets:[2]usize=[0;2];
  offsets[0]=8;offsets[1]=16;
  if ent.emit(slice_from_raw_parts(&kinds[0],2),slice_from_raw_parts(&offsets[0],2),FRAME,
   slice_from_raw_parts(&buffer[0],1536),&n)!=ent.OK{return false;}
  at=n;
 }else if index==2{
  if operation==MUL{
   if !load_memory(buffer,&at,RDI,-8)||!load_memory(buffer,&at,RSI,-16){return false;}
  }else if operation==NEG{
   if !load_memory(buffer,&at,RAX,-8){return false;}
  }else{
   if !load_memory(buffer,&at,RAX,-8)||!load_memory(buffer,&at,RCX,-16){return false;}
  }
 }else if index==3{
  if !room(buffer,0,64){return false;}
  if operation==MUL{
   if mul.emit(signed,error_block,slice_from_raw_parts(&buffer[0],64),&n)!=mul.OK{return false;}
  }else if operation==NEG{
   if negop.emit(RAX,error_block,slice_from_raw_parts(&buffer[0],64),&n)!=negop.OK{return false;}
  }else{
   if addsub.emit(operation,signed,RAX,RCX,error_block,slice_from_raw_parts(&buffer[0],64),&n)!=addsub.OK{return false;}
  }
  if n>64{return false;}
  at=n;
 }else if index==4{
  if !store_memory(buffer,&at,RAX,-24)||!load_immediate(buffer,&at,RAX,0)||!store_memory(buffer,&at,RAX,-32){return false;}
  if !ok_exit(buffer,&at){return false;}
 }else{
  if !room(buffer,at,64){return false;}
  if blk.emit(LABEL,error_block,slice_from_raw_parts(&buffer[at],64),&n)!=blk.OK{return false;}
  if n>64{return false;}
  at+=n;
  if !load_immediate(buffer,&at,RAX,0)||!store_memory(buffer,&at,RAX,-24){return false;}
  if !load_immediate(buffer,&at,RAX,1)||!store_memory(buffer,&at,RAX,-32){return false;}
  if !err_exit(buffer,&at){return false;}
 }
 *length=at;return true;
}}
pub unsafe fn emit(module_name:[]const u8,item_name:[]const u8,operation:u64,signed:bool,
 error_block:u64,out:[]u8,written:*usize)u64{unsafe{
 let wp=written as u64;let mp=module_name.ptr as u64;let ip=item_name.ptr as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8){return INVALID;}
 let mn=module_name.len;let inn=item_name.len;let on=out.len;
 if !span(mp,mn)||!span(ip,inn)||!span(op,on){return INVALID;}
 if overlap(wp,8,op,on){return INVALID;}
 if overlap(wp,8,mp,mn)||overlap(wp,8,ip,inn)||overlap(op,on,mp,mn)||overlap(op,on,ip,inn){return INVALID;}
 if mn==0||mn>NAME_LIMIT||inn==0||inn>NAME_LIMIT{return INVALID;}
 if operation>NEG{return INVALID;}
 if operation==NEG&&!signed{return INVALID;}
 if error_block==MAX{return INVALID;}
 var buffer:[1536]u8=[0;1536];
 var total:usize=0;var n:usize=0;var p:usize=0;
 while p<6{
  let size=bound(p);
  if size>PIECE{return INVALID;}
  if !piece(p,module_name,item_name,operation,signed,error_block,slice_from_raw_parts(&buffer[0],size),&n){return INVALID;}
  if n>size{return INVALID;}
  total+=n;p+=1;
 }
 if total>TOTAL{return INVALID;}
 if total>on{return CAPACITY;}
 var at:usize=0;p=0;
 while p<6{
  let size=bound(p);
  if !piece(p,module_name,item_name,operation,signed,error_block,slice_from_raw_parts(&buffer[0],size),&n){return INVALID;}
  if n>size||!room(out,at,n){return INVALID;}
  var i:usize=0;while i<n{out[at+i]=buffer[i];i+=1;}
  at+=n;p+=1;
 }
 *written=at;return OK;
}}

// Four NASM lines for a slice lo/hi/len joint unsigned bounds guard:
// "cmp rsi, rdx\nja __dong_b<N>\ncmp rdi, rsi\nja __dong_b<N>\n".
// Fixed RDI=lo, RSI=hi, RDX=len as full 64-bit usize. Falls through only
// when lo<=hi<=len (empty endpoints allowed). Digits reuse integrated CR4.
// Built in a local 128-byte buffer, copied to out after every check.
module bootstrap.nasm_slice_bounds_guard;
import bootstrap.decimal_integer as dec;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
pub const NONE:u64=0xffff_ffff_ffff_ffff;
const MAX:u64=0xffff_ffff_ffff_ffff;
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn copy(out:[]u8,at:usize,text:[]const u8)usize{
 var i:usize=0;while i<text.len{out[at+i]=text[i];i+=1;}return at+text.len;
}
pub unsafe fn emit(trap_block:u64,out:[]u8,written:*usize)u64{unsafe{
 let wp=written as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8){return INVALID;}
 if !span(op,out.len){return INVALID;}
 if overlap(wp,8,op,out.len){return INVALID;}
 if trap_block==NONE{return INVALID;}
 var digits:[24]u8=[0;24];var count:usize=0;
 let status=dec.encode(trap_block,64,false,slice_from_raw_parts(&digits[0],24),&count);
 if status!=dec.OK{return INVALID;}
 // Longest: 2×("cmp rsi, rdx\n"=13 + "ja __dong_b"+20+"\n"=32) with rdi/rsi = 90.
 var text:[128]u8=[0;128];let buffer=slice_from_raw_parts(&text[0],128);
 var at=copy(buffer,0,"cmp rsi, rdx\n");
 at=copy(buffer,at,"ja __dong_b");
 at=copy(buffer,at,slice_from_raw_parts(&digits[0],count));buffer[at]=10;at+=1;
 at=copy(buffer,at,"cmp rdi, rsi\n");
 at=copy(buffer,at,"ja __dong_b");
 at=copy(buffer,at,slice_from_raw_parts(&digits[0],count));buffer[at]=10;at+=1;
 if at>out.len{return CAPACITY;}
 var i:usize=0;while i<at{out[i]=buffer[i];i+=1;}
 *written=at;return OK;
}}

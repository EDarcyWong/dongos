// Bounded x86-64 instruction encoding. No symbols, allocation, or external assembler.
module bootstrap.x86_encode;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
pub const NONE:u64=0;pub const RR:u64=1;pub const RI:u64=2;pub const LOAD:u64=3;pub const STORE:u64=4;pub const MEM:u64=5;pub const REG:u64=6;pub const REL:u64=7;pub const INDEX:u64=8;
pub const MOV:u64=1;pub const ADD:u64=2;pub const SUB:u64=3;pub const AND:u64=4;pub const OR:u64=5;pub const XOR:u64=6;pub const CMP:u64=7;pub const TEST:u64=8;pub const LEA:u64=9;pub const MOVZX:u64=10;pub const MOVSX:u64=11;pub const MOVSXD:u64=12;pub const NEG:u64=13;pub const NOT:u64=14;pub const MUL:u64=15;pub const DIV:u64=16;pub const IDIV:u64=17;pub const IMUL:u64=18;pub const SHL:u64=19;pub const SHR:u64=20;pub const SAR:u64=21;pub const SETCC:u64=22;pub const PUSH:u64=23;pub const POP:u64=24;pub const CALL:u64=25;pub const JMP:u64=26;pub const JCC:u64=27;pub const CQO:u64=28;pub const RET:u64=29;pub const UD2:u64=30;pub const CLD:u64=31;pub const STD:u64=32;pub const MOVSB:u64=33;pub const STOSB:u64=34;pub const SYSCALL:u64=35;
pub const RIP:u64=16;
pub struct Instruction{pub op:u64,pub form:u64,pub width:u64,pub dst:u64,pub src:u64,pub base:u64,pub disp:u64,pub imm:u64,pub src_width:u64,pub cc:u64,pub reserved:u64}
const MAX:u64=0xffff_ffff_ffff_ffff;
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn i32fits(v:u64)bool{return v<=0x7fff_ffff||v>=0xffff_ffff_8000_0000;}
fn immediate(v:u64,w:u64)bool{
 if w==64{return true;}let limit:u64=1<<w;return v<limit||v>=MAX-(limit/2)+1;
}
fn put(b:[]u8,at:usize,v:u64,n:usize)usize{var k:usize=0;while k<n{b[at+k]=(v>>(8*k))as u8;k+=1;}return at+n;}
// Prefix including low-byte SPL/BPL/SIL/DIL selection; high byte AH..BH is never represented.
fn prefix(b:[]u8,w:u64,r:u64,m:u64,byte_reg:bool)usize{
 var n:usize=0;if w==16{b[n]=0x66;n+=1;}
 var rex:u64=0x40;if w==64{rex=rex|8;}if r>=8{rex=rex|4;}if m>=8&&m<16{rex=rex|1;}
 if rex!=0x40||byte_reg{b[n]=rex as u8;n+=1;}return n;
}
fn modrm(b:[]u8,at:usize,r:u64,m:u64,memory:bool,disp:u64)usize{
 var n=at;if !memory{b[n]=(0xc0|((r&7)<<3)|(m&7))as u8;return n+1;}
 if m==RIP{b[n]=(((r&7)<<3)|5)as u8;return put(b,n+1,disp,4);}
 b[n]=(0x80|((r&7)<<3)|(m&7))as u8;n+=1;if (m&7)==4{b[n]=0x24;n+=1;}return put(b,n,disp,4);
}
fn group(op:u64)u64{if op==ADD{return 0;}if op==OR{return 1;}if op==AND{return 4;}if op==SUB{return 5;}if op==XOR{return 6;}return 7;}
// Internal encoder only touches its private 15-byte scratch. Zero means invalid.
unsafe fn build(b:[]u8,p:*const Instruction)usize{unsafe{
 let o=(*p).op;let f=(*p).form;let w=(*p).width;let d=(*p).dst;let s=(*p).src;let base=(*p).base;
 if (*p).reserved!=0||o<MOV||o>SYSCALL||f>INDEX{return 0;}
 if o!=SETCC&&o!=JCC&&(*p).cc!=0{return 0;}
 if o!=MOVZX&&o!=MOVSX&&o!=MOVSXD&&(*p).src_width!=0{return 0;}
 if f!=RI&&f!=REL&&f!=INDEX&&(*p).imm!=0{return 0;}
 if f!=LOAD&&f!=STORE&&f!=MEM&&f!=INDEX&&(base!=0||(*p).disp!=0){return 0;}
 if f!=RR&&f!=STORE&&f!=INDEX&&(*p).src!=0{return 0;}
 if f!=RR&&f!=RI&&f!=LOAD&&f!=REG&&f!=INDEX&&(*p).dst!=0{return 0;}
 // Restricted indexed LEA: always a base, index, scale and full disp32.
 if f==INDEX{
  if o!=LEA||w!=64||d>15||s>15||s==4||base>15||!i32fits((*p).disp){return 0;}
  let scale=(*p).imm;var ss:u64=0;if scale==1{ss=0;}else if scale==2{ss=1;}else if scale==4{ss=2;}else if scale==8{ss=3;}else{return 0;}
  var rex:u64=0x48;if d>=8{rex=rex|4;}if s>=8{rex=rex|2;}if base>=8{rex=rex|1;}
  b[0]=rex as u8;b[1]=0x8d;b[2]=(0x84|((d&7)<<3))as u8;b[3]=((ss<<6)|((s&7)<<3)|(base&7))as u8;
  return put(b,4,(*p).disp,4);
 }
 if o>=CQO{
  if f!=NONE||w!=0{return 0;}
  if o==SYSCALL{b[0]=0x0f;b[1]=0x05;return 2;}
  if o==CQO{b[0]=0x48;b[1]=0x99;return 2;}
  if o==RET{b[0]=0xc3;return 1;}if o==UD2{b[0]=0x0f;b[1]=0x0b;return 2;}
  if o==CLD{b[0]=0xfc;return 1;}if o==STD{b[0]=0xfd;return 1;}
  b[0]=0xf3;if o==MOVSB{b[1]=0xa4;}else{b[1]=0xaa;}return 2;
 }
 if f==REL{
  if w!=0||!i32fits((*p).imm){return 0;}
  if o==CALL{b[0]=0xe8;return put(b,1,(*p).imm,4);}
  if o==JMP{b[0]=0xe9;return put(b,1,(*p).imm,4);}
  if o==JCC&&(*p).cc<16{b[0]=0x0f;b[1]=(0x80+(*p).cc)as u8;return put(b,2,(*p).imm,4);}return 0;
 }
 if w!=8&&w!=16&&w!=32&&w!=64{return 0;}
 let memory=f==LOAD||f==STORE||f==MEM;
 if memory&&(base>RIP||!i32fits((*p).disp)){return 0;}
 if d>15||s>15{return 0;}
 if o==PUSH||o==POP||o==CALL||o==JMP{
  if f!=REG||w!=64{return 0;}var n:usize=0;if d>=8{b[n]=0x41;n+=1;}
  if o==PUSH{b[n]=(0x50+(d&7))as u8;return n+1;}
  if o==POP{b[n]=(0x58+(d&7))as u8;return n+1;}
  b[n]=0xff;n+=1;var g:u64=2;if o==JMP{g=4;}return modrm(b,n,g,d,false,0);
 }
 if o==SETCC{
  if f!=REG||w!=8||(*p).cc>15{return 0;}var n=prefix(b,8,0,d,d>=4);b[n]=0x0f;b[n+1]=(0x90+(*p).cc)as u8;return modrm(b,n+2,0,d,false,0);
 }
 if o>=NEG&&o<=SAR&&o!=IMUL{
  if f!=REG{return 0;}var g:u64=0;
  if o==NEG{g=3;}else if o==NOT{g=2;}else if o==MUL{g=4;}else if o==DIV{g=6;}else if o==IDIV{g=7;}else if o==SHL{g=4;}else if o==SHR{g=5;}else if o==SAR{g=7;}else{return 0;}
  var n=prefix(b,w,0,d,w==8&&d>=4);var opcode:u64=0xf7;if o>=SHL{opcode=0xd3;}if w==8{opcode-=1;}b[n]=opcode as u8;return modrm(b,n+1,g,d,false,0);
 }
 if o==MOV&&f==RI{
  if !immediate((*p).imm,w){return 0;}var n=prefix(b,w,0,d,w==8&&d>=4);var opcode:u64=0xb8;if w==8{opcode=0xb0;}b[n]=(opcode+(d&7))as u8;return put(b,n+1,(*p).imm,w/8);
 }
 if o>=ADD&&o<=TEST&&f==RI{
  if (w==64&&!i32fits((*p).imm))||(w!=64&&!immediate((*p).imm,w)){return 0;}
  var n=prefix(b,w,0,d,w==8&&d>=4);var opcode:u64=0x81;var g=group(o);if o==TEST{opcode=0xf7;g=0;}if w==8{opcode-=1;}
  b[n]=opcode as u8;n=modrm(b,n+1,g,d,false,0);var bytes=w/8;if bytes>4{bytes=4;}return put(b,n,(*p).imm,bytes);
 }
 if o==MOVZX||o==MOVSX||o==MOVSXD||o==LEA||o==IMUL{
  if f!=RR&&f!=LOAD{return 0;}if o==LEA&&(f!=LOAD||w==8){return 0;}if o==IMUL&&w==8{return 0;}
  let sw=(*p).src_width;
  if (o==MOVZX||o==MOVSX)&&((sw!=8&&sw!=16)||w<=sw){return 0;}
  if o==MOVSXD&&(w!=64||sw!=32){return 0;}
  var m=s;if memory{m=base;}var n=prefix(b,w,d,m,!memory&&sw==8&&m>=4);
  if o==LEA{b[n]=0x8d;n+=1;}else if o==MOVSXD{b[n]=0x63;n+=1;}else{
   b[n]=0x0f;n+=1;var opcode:u64=0xaf;if o==MOVZX{opcode=0xb6;}if o==MOVSX{opcode=0xbe;}if (o==MOVZX||o==MOVSX)&&sw==16{opcode+=1;}b[n]=opcode as u8;n+=1;
  }return modrm(b,n,d,m,memory,(*p).disp);
 }
 if o>=MOV&&o<=TEST&&(f==RR||f==LOAD||f==STORE){
  var r=s;var m=d;if f==LOAD{r=d;m=base;}if f==STORE{m=base;}
  var n=prefix(b,w,r,m,w==8&&(r>=4||(!memory&&m>=4)));
  var opcode:u64=0x89;if o==TEST{opcode=0x85;}else if o!=MOV{opcode=group(o)*8+1;}
  if f==LOAD{if o==TEST{return 0;}opcode+=2;}if w==8{opcode-=1;}b[n]=opcode as u8;return modrm(b,n+1,r,m,memory,(*p).disp);
 }
 return 0;
}}
pub unsafe fn encode(out:[]u8,ins:*const Instruction,written:*usize)u64{unsafe{
 let op=out.ptr as u64;let ip=ins as u64;let wp=written as u64;
 if ins==null||written==null||(ip&7)!=0||(wp&7)!=0{return INVALID;}
 if !span(op,out.len)||!span(ip,sizeof(Instruction))||!span(wp,8){return INVALID;}
 if overlap(op,out.len,ip,sizeof(Instruction))||overlap(op,out.len,wp,8)||overlap(ip,sizeof(Instruction),wp,8){return INVALID;}
 var scratch:[15]u8=[0;15];let b=slice_from_raw_parts(&scratch[0],15);let n=build(b,ins);
 if n==0||n>15{return INVALID;}if n>out.len{return CAPACITY;}
 var k:usize=0;while k<n{out[k]=scratch[k];k+=1;}*written=n;return OK;
}}

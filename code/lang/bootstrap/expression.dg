// Bounded Dong-native expression syntax. No value evaluation or allocation.
module bootstrap.expression;
import bootstrap.lexer as lex;
pub const NONE:usize=0xffff_ffff_ffff_ffff;
pub const OK:u64=0;pub const INVALID:u64=1;pub const SYNTAX:u64=2;
pub const CAPACITY:u64=3;pub const DEPTH:u64=4;pub const UNSUPPORTED:u64=5;
pub const INTEGER:u64=1;pub const BOOLEAN:u64=2;pub const NULL:u64=3;pub const STRING:u64=4;
pub const NAME:u64=5;pub const UNARY:u64=6;pub const TRY:u64=7;pub const BINARY:u64=8;
pub const ORELSE:u64=9;pub const CALL:u64=10;pub const FIELD:u64=11;pub const INDEX:u64=12;
pub const SLICE:u64=13;pub const ARRAY:u64=14;pub const REPEAT:u64=15;pub const EXIT:u64=16;
pub const ERROR:u64=17;
pub const CAST:u64=18;pub const STRUCT:u64=19;pub const LAYOUT:u64=20;pub const INITIALIZER:u64=21;
pub const TYPE_NAME:u64=32;pub const TYPE_POINTER:u64=33;pub const TYPE_SLICE:u64=34;
pub const TYPE_ARRAY:u64=35;pub const TYPE_OPTIONAL:u64=36;pub const TYPE_ERROR:u64=37;
pub const TYPE_FUNCTION:u64=38;pub const PARAMETER:u64=39;
pub const BLOCK:u64=64;pub const BINDING:u64=65;pub const RETURN:u64=66;pub const IF:u64=67;
pub const WHILE:u64=68;pub const LOOP:u64=69;pub const FOR:u64=70;pub const RANGE:u64=71;
pub const DEFER:u64=72;pub const MATCH:u64=73;pub const ARM:u64=74;pub const PATTERN:u64=75;
pub const UNSAFE_BLOCK:u64=76;pub const ASM:u64=77;pub const BREAK:u64=78;pub const CONTINUE:u64=79;
pub const ASSIGN:u64=80;pub const EXPRESSION_STATEMENT:u64=81;
pub const MODULE:u64=96;pub const IMPORT:u64=97;pub const ATTRIBUTE:u64=98;pub const DECLARATION:u64=99;
pub const FUNCTION:u64=100;pub const STRUCT_DECL:u64=101;pub const FIELD_DECL:u64=102;
pub const ENUM_DECL:u64=103;pub const VARIANT:u64=104;pub const ERROR_DECL:u64=105;
pub const ALIAS_DECL:u64=106;pub const GLOBAL:u64=107;pub const FUNCTION_PARAMETER:u64=108;
pub struct Node{pub kind:u64,pub token:usize,pub op:u64,pub a:usize,pub b:usize,pub c:usize,pub next:usize,pub flags:u64}
pub struct Result{pub root:usize,pub used:usize,pub next:usize,pub error_code:u64,pub error_token:usize}
struct State{source:[]const u8,tokens:[]const lex.Token,nodes:[]Node,at:usize,used:usize,status:u64,error_at:usize,limit:usize}
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=NONE-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
unsafe fn kind(s:*State)u64{unsafe{return (*s).tokens[(*s).at].kind;}}
unsafe fn reject(s:*State,code:u64)usize{unsafe{
 if (*s).status==0{(*s).status=code;(*s).error_at=(*s).at;}return NONE;
}}
unsafe fn reject_at(s:*State,code:u64,at:usize)usize{unsafe{
 if (*s).status==0{(*s).status=code;(*s).error_at=at;}return NONE;
}}
unsafe fn take(s:*State,k:u64)bool{unsafe{
 if kind(s)!=k{return false;}if k!=lex.EOF{(*s).at+=1;}return true;
}}
unsafe fn expect(s:*State,k:u64)bool{unsafe{
 if take(s,k){return true;}reject(s,SYNTAX);return false;
}}
unsafe fn node(s:*State,k:u64,t:usize,op:u64,a:usize,b:usize,c:usize)usize{unsafe{
 if (*s).status!=0{return NONE;}if (*s).used==(*s).nodes.len{return reject(s,CAPACITY);}
 let id=(*s).used;(*s).nodes[id]=Node{kind:k,token:t,op:op,a:a,b:b,c:c,next:NONE,flags:0};(*s).used+=1;return id;
}}
fn precedence(k:u64)u64{
 if k==285{return 0;}if k==519{return 1;}if k==518{return 2;}
 if k==514||k==515||k==516||k==517||k==1084||k==1086{return 3;}
 if k==1148{return 4;}if k==1118{return 5;}if k==1062{return 6;}
 if k==520||k==521{return 7;}if k==1067||k==1069{return 8;}
 if k==1066||k==1071||k==1061{return 9;}return NONE;
}
unsafe fn named(s:*State,t:usize,text:[]const u8)bool{unsafe{
 let token=(*s).tokens[t];if token.end-token.start!=text.len{return false;}
 var i:usize=0;while i<text.len{if (*s).source[token.start+i]!=text[i]{return false;}i+=1;}return true;
}}
unsafe fn dotted(s:*State,id:usize)bool{unsafe{
 var at=id;while (*s).nodes[at].kind==FIELD{at=(*s).nodes[at].a;}return (*s).nodes[at].kind==NAME;
}}
unsafe fn same_token(s:*State,a:usize,b:usize)bool{unsafe{
 let x=(*s).tokens[a];let y=(*s).tokens[b];if x.end-x.start!=y.end-y.start{return false;}
 var i:usize=0;while i<x.end-x.start{if (*s).source[x.start+i]!=(*s).source[y.start+i]{return false;}i+=1;}return true;
}}
unsafe fn path(s:*State,allow_void:bool)usize{unsafe{
 let t=(*s).at;let k=kind(s);
 if k!=lex.IDENTIFIER&&!(allow_void&&(k==289||k==290)){return reject(s,SYNTAX);}
 take(s,k);var id=node(s,NAME,t,0,NONE,NONE,NONE);
 while take(s,1070){let field=(*s).at;if !expect(s,lex.IDENTIFIER){return NONE;}id=node(s,FIELD,field,0,id,NONE,NONE);}
 return id;
}}
fn hex(c:u8)u64{if c>=48&&c<=57{return (c-48)as u64;}if c>=65&&c<=70{return (c-65+10)as u64;}if c>=97&&c<=102{return (c-97+10)as u64;}return 255;}
// Decode the already lexed string spelling, without depending on a mutable
// lexer arena or silently treating escaped ABI names differently.
unsafe fn string_equal(s:*State,t:usize,text:[]const u8)bool{unsafe{
 let token=(*s).tokens[t];if token.end-token.start<2{return false;}
 var at=token.start+1;var i:usize=0;let end=token.end-1;
 while at<end{var c=(*s).source[at]as u64;at+=1;
  if c==92{if at==end{return false;}c=(*s).source[at]as u64;at+=1;
   if c==120{if end-at<2{return false;}c=hex((*s).source[at])*16+hex((*s).source[at+1]);at+=2;}
   else if c==110{c=10;}else if c==114{c=13;}else if c==116{c=9;}else if c==48{c=0;}
  }if i==text.len||c!=text[i]as u64{return false;}i+=1;
 }return i==text.len;
}}
unsafe fn linker_name(s:*State,t:usize)bool{unsafe{
 let token=(*s).tokens[t];if token.end-token.start<3{return false;}
 var at=token.start+1;let end=token.end-1;var count:usize=0;
 while at<end{var c=(*s).source[at]as u64;at+=1;
  if c==92{if at==end{return false;}c=(*s).source[at]as u64;at+=1;
   if c==120{if end-at<2{return false;}c=hex((*s).source[at])*16+hex((*s).source[at+1]);at+=2;}
   else if c==110{c=10;}else if c==114{c=13;}else if c==116{c=9;}else if c==48{c=0;}
  }
  if !(c==95||(c>=65&&c<=90)||(c>=97&&c<=122)||(count!=0&&c>=48&&c<=57)){return false;}count+=1;
 }return count!=0;
}}
unsafe fn append(s:*State,first:*usize,last:*usize,item:usize)void{unsafe{
 if (*s).status!=0{return;}if *first==NONE{*first=item;}else{(*s).nodes[*last].next=item;}*last=item;
}}
unsafe fn type_syntax(s:*State,allow_void:bool,depth:usize)usize{unsafe{
 if (*s).status!=0{return NONE;}if depth>=(*s).limit{return reject(s,DEPTH);}
 let t=(*s).at;let k=kind(s);
 if k==1087||k==1057||k==1066{
  take(s,k);var readonly=false;if k==1066{readonly=take(s,260);}
  let child=type_syntax(s,k==1057,depth+1);var tag=TYPE_POINTER;
  if k==1087{tag=TYPE_OPTIONAL;}else if k==1057{tag=TYPE_ERROR;}
  let id=node(s,tag,t,0,child,NONE,NONE);if (*s).status==0&&readonly{(*s).nodes[id].flags=1;}return id;
 }
 if take(s,1115){
  var count:usize=NONE;var readonly=false;var tag=TYPE_ARRAY;
  if take(s,1117){tag=TYPE_SLICE;readonly=take(s,260);}
  else{count=expression(s,0,depth+1,true);if !expect(s,1117){return NONE;}}
  let element=type_syntax(s,false,depth+1);let id=node(s,tag,t,0,element,count,NONE);
  if (*s).status==0&&readonly{(*s).nodes[id].flags=1;}return id;
 }
 if k==266||k==268||k==267{
  var uns=false;var external=false;var abi:u64=0;
  while kind(s)==268||kind(s)==267{
   let mt=(*s).at;let modifier=kind(s);take(s,modifier);
   if modifier==268{if uns{return reject_at(s,SYNTAX,mt);}uns=true;}
   else{if external{return reject_at(s,SYNTAX,mt);}external=true;let at=(*s).at;
    if !expect(s,lex.STRING){return NONE;}
    if string_equal(s,at,"win64"){abi=1;}else if !string_equal(s,at,"sysv64"){return reject_at(s,UNSUPPORTED,at);}
   }
  }if !expect(s,266)||!expect(s,1064){return NONE;}
  var first:usize=NONE;var last:usize=NONE;
  while kind(s)!=1065&&(*s).status==0{
   let pt=(*s).at;var named_parameter=false;
   if kind(s)==lex.IDENTIFIER&&(*s).at+1<(*s).tokens.len&&(*s).tokens[(*s).at+1].kind==1082{
    take(s,lex.IDENTIFIER);take(s,1082);named_parameter=true;
    var previous=first;while previous!=NONE{
     if (*s).nodes[previous].flags==1&&same_token(s,pt,(*s).nodes[previous].token){return reject_at(s,SYNTAX,pt);}
     previous=(*s).nodes[previous].next;
    }
   }let typ=type_syntax(s,false,depth+1);let item=node(s,PARAMETER,pt,0,typ,NONE,NONE);
   if (*s).status==0&&named_parameter{(*s).nodes[item].flags=1;}append(s,&first,&last,item);
   if !take(s,1068){break;}
  }if !expect(s,1065){return NONE;}let returns=type_syntax(s,true,depth+1);
  let id=node(s,TYPE_FUNCTION,t,abi,first,returns,NONE);if (*s).status==0&&uns{(*s).nodes[id].flags=1;}return id;
 }
 let name=path(s,allow_void);return node(s,TYPE_NAME,t,0,name,NONE,NONE);
}}
// Mirrors the host grammar's prefix/postfix phase followed by precedence
// climbing; orelse is right associative and comparisons cannot be chained.
unsafe fn expression(s:*State,minimum:u64,depth:usize,allow_struct:bool)usize{unsafe{
 if (*s).status!=0{return NONE;}if depth>=(*s).limit{return reject(s,DEPTH);}
 let t=(*s).at;let k=kind(s);var left:usize=NONE;
 if k==283||k==1057||k==1150||k==1069||k==1062||k==1066{
  take(s,k);let child=expression(s,11,depth+1,allow_struct);var tag=UNARY;if k==283{tag=TRY;}
  left=node(s,tag,t,k,child,NONE,NONE);
 }else if k==284{
  take(s,k);if !expect(s,1070){return NONE;}let first=(*s).at;
  if !expect(s,lex.IDENTIFIER){return NONE;}var path=node(s,NAME,first,0,NONE,NONE,NONE);
  while take(s,1070){let field=(*s).at;if !expect(s,lex.IDENTIFIER){return NONE;}path=node(s,FIELD,field,0,path,NONE,NONE);}
  left=node(s,ERROR,t,0,path,NONE,NONE);
 }else if k==lex.INTEGER||k==286||k==287||k==288||k==lex.STRING||k==lex.IDENTIFIER{
  take(s,k);var tag=NAME;if k==lex.INTEGER{tag=INTEGER;}else if k==286||k==287{tag=BOOLEAN;}
  else if k==288{tag=NULL;}else if k==lex.STRING{tag=STRING;}
  if k==lex.IDENTIFIER&&kind(s)==1064&&(named(s,t,"sizeof")||named(s,t,"alignof")||named(s,t,"offsetof")){
   take(s,1064);let typ=type_syntax(s,false,depth+1);var field:usize=NONE;
   if named(s,t,"offsetof"){if !expect(s,1068){return NONE;}field=(*s).at;if !expect(s,lex.IDENTIFIER){return NONE;}}
   if !expect(s,1065){return NONE;}left=node(s,LAYOUT,t,0,typ,NONE,NONE);
   if (*s).status==0{(*s).nodes[left].op=field;}
  }else{left=node(s,tag,t,0,NONE,NONE,NONE);}
 }else if take(s,1115){
  if kind(s)==1117{reject(s,SYNTAX);(*s).error_at=t;return NONE;}let first=expression(s,0,depth+1,true);
  if take(s,1083){let count=expression(s,0,depth+1,true);if !expect(s,1117){return NONE;}left=node(s,REPEAT,t,0,first,count,NONE);}
  else{
   var last=first;while take(s,1068)&&kind(s)!=1117{
    let item=expression(s,0,depth+1,true);if (*s).status!=0{return NONE;}(*s).nodes[last].next=item;last=item;
   }if !expect(s,1117){return NONE;}left=node(s,ARRAY,t,0,first,NONE,NONE);
  }
 }else if take(s,1064){
  left=expression(s,0,depth+1,true);if !expect(s,1065){return NONE;}
  if (*s).status==0{(*s).nodes[left].flags=1;}
 }else{return reject(s,SYNTAX);}
 if (*s).status!=0{return NONE;}
 while true{
  if take(s,1064){
   var first:usize=NONE;var last:usize=NONE;
   if kind(s)!=1065{while true{
    let item=expression(s,0,depth+1,true);if (*s).status!=0{return NONE;}
    if first==NONE{first=item;}else{(*s).nodes[last].next=item;}last=item;
    if !take(s,1068)||kind(s)==1065{break;}
   }}if !expect(s,1065){return NONE;}left=node(s,CALL,(*s).nodes[left].token,0,left,first,NONE);
  }else if take(s,1070){
   let field=(*s).at;if !expect(s,lex.IDENTIFIER){return NONE;}left=node(s,FIELD,field,0,left,NONE,NONE);
  }else if take(s,1115){
   var lo:usize=NONE;if kind(s)!=530{lo=expression(s,0,depth+1,true);}if (*s).status!=0{return NONE;}
   if take(s,530){var hi:usize=NONE;if kind(s)!=1117{hi=expression(s,0,depth+1,true);}
    if !expect(s,1117){return NONE;}left=node(s,SLICE,(*s).nodes[left].token,0,left,lo,hi);
   }else{if !expect(s,1117){return NONE;}left=node(s,INDEX,(*s).nodes[left].token,0,left,lo,NONE);}
  }else if kind(s)==258&&minimum<=10{
   let cast=(*s).at;take(s,258);let typ=type_syntax(s,false,depth+1);left=node(s,CAST,cast,0,left,typ,NONE);
  }else if kind(s)==1147&&allow_struct&&dotted(s,left){
   take(s,1147);var first:usize=NONE;var last:usize=NONE;
   while kind(s)!=1149&&kind(s)!=lex.EOF&&(*s).status==0{
    let field=(*s).at;if !expect(s,lex.IDENTIFIER)||!expect(s,1082){return NONE;}
    let value=expression(s,0,depth+1,true);let item=node(s,INITIALIZER,field,0,value,NONE,NONE);append(s,&first,&last,item);
    if !take(s,1068){break;}
   }if !expect(s,1149){return NONE;}left=node(s,STRUCT,(*s).nodes[left].token,0,left,first,NONE);
  }
  else{break;}if (*s).status!=0{return NONE;}
 }
 while precedence(kind(s))!=NONE&&precedence(kind(s))>=minimum{
  let operator=kind(s);let ot=(*s).at;let p=precedence(operator);
  if p==3&&(*s).nodes[left].kind==BINARY&&precedence((*s).nodes[left].op)==3&&(*s).nodes[left].flags==0{return reject(s,SYNTAX);}
  take(s,operator);var right:usize=NONE;
  if operator==285&&(kind(s)==281||kind(s)==279||kind(s)==280){
   let ct=(*s).at;let ck=kind(s);take(s,ck);let after=kind(s);var value:usize=NONE;
   let delimiter=after==1083||after==1068||after==1065||after==1117||after==1149;
   if ck==281&&!delimiter{value=expression(s,0,depth+1,allow_struct);}
   else if ck!=281&&!delimiter&&after!=1147{return reject(s,SYNTAX);}
   right=node(s,EXIT,ct,ck,value,NONE,NONE);
  }else{var next=p+1;if operator==285{next=p;}right=expression(s,next,depth+1,allow_struct);}
  var tag=BINARY;if operator==285{tag=ORELSE;}left=node(s,tag,ot,operator,left,right,NONE);
  if (*s).status!=0{return NONE;}
 }return left;
}}
unsafe fn block(s:*State,depth:usize)usize{unsafe{
 if (*s).status!=0{return NONE;}if depth>=(*s).limit{return reject(s,DEPTH);}
 let t=(*s).at;if !expect(s,1147){return NONE;}var first:usize=NONE;var last:usize=NONE;
 while kind(s)!=1149&&kind(s)!=lex.EOF&&(*s).status==0{let item=statement(s,depth+1);append(s,&first,&last,item);}
 if !expect(s,1149){return NONE;}return node(s,BLOCK,t,0,first,NONE,NONE);
}}
fn assignment(k:u64)bool{return k==1085||k==512||k==513||(k>=522&&k<=529);}
unsafe fn pattern(s:*State,depth:usize)usize{unsafe{
 let t=(*s).at;let k=kind(s);var name:usize=NONE;var binding:usize=NONE;
 if k==286||k==287||k==288{take(s,k);return node(s,PATTERN,t,k,NONE,NONE,NONE);}
 if k==lex.IDENTIFIER&&named(s,t,"_"){take(s,k);name=node(s,NAME,t,0,NONE,NONE,NONE);return node(s,PATTERN,t,0,name,NONE,NONE);}
 name=path(s,false);if (*s).status!=0{return NONE;}
 let simple=(*s).nodes[name].kind==NAME;var required=false;
 if simple{required=named(s,t,"some")||named(s,t,"err");}
 if take(s,1064){let bt=(*s).at;if !expect(s,lex.IDENTIFIER)||!expect(s,1065){return NONE;}binding=node(s,NAME,bt,0,NONE,NONE,NONE);}
 else if required{return reject_at(s,SYNTAX,t);}
 if simple&&named(s,t,"_")&&binding!=NONE{return reject(s,SYNTAX);}
 return node(s,PATTERN,t,0,name,binding,NONE);
}}
unsafe fn statement(s:*State,depth:usize)usize{unsafe{
 if (*s).status!=0{return NONE;}if depth>=(*s).limit{return reject(s,DEPTH);}
 let t=(*s).at;let k=kind(s);
 if k==261||k==262||k==260{
  take(s,k);let nt=(*s).at;if !expect(s,lex.IDENTIFIER){return NONE;}
  var typ:usize=NONE;var value:usize=NONE;if take(s,1082){typ=type_syntax(s,false,depth+1);}
  if take(s,1085){value=expression(s,0,depth+1,true);}
  if (*s).status!=0{return NONE;}
  if (k!=262&&value==NONE)||(typ==NONE&&value==NONE){return reject_at(s,SYNTAX,nt);}
  if !expect(s,1083){return NONE;}return node(s,BINDING,nt,k,typ,value,NONE);
 }
 if take(s,281){var value:usize=NONE;if kind(s)!=1083{value=expression(s,0,depth+1,true);}
  if !expect(s,1083){return NONE;}return node(s,RETURN,t,0,value,NONE,NONE);
 }
 if k==272||k==274{
  take(s,k);let condition=expression(s,0,depth+1,false);let body=block(s,depth+1);var other:usize=NONE;
  if k==272&&take(s,273){if kind(s)==272{other=statement(s,depth+1);}else{other=block(s,depth+1);}}
  var tag=IF;if k==274{tag=WHILE;}return node(s,tag,t,0,condition,body,other);
 }
 if take(s,275){let body=block(s,depth+1);return node(s,LOOP,t,0,body,NONE,NONE);}
 if take(s,276){let bt=(*s).at;if !expect(s,lex.IDENTIFIER)||!expect(s,277){return NONE;}
  let binding=node(s,NAME,bt,0,NONE,NONE,NONE);var iterable=expression(s,0,depth+1,false);if (*s).status!=0{return NONE;}
  if take(s,530){let rt=(*s).nodes[iterable].token;let upper=expression(s,0,depth+1,false);iterable=node(s,RANGE,rt,0,iterable,upper,NONE);}
  let body=block(s,depth+1);return node(s,FOR,t,0,binding,iterable,body);
 }
 if take(s,282){var body:usize=NONE;
  if kind(s)==1147{body=block(s,depth+1);}else{
   let item=statement(s,depth+1);if (*s).status!=0{return NONE;}
   if (*s).nodes[item].kind!=EXPRESSION_STATEMENT{var at=(*s).nodes[item].token;
    if (*s).nodes[item].kind==BINDING{at-=1;}return reject_at(s,SYNTAX,at);
   }
   body=node(s,BLOCK,t,0,item,NONE,NONE);
  }return node(s,DEFER,t,0,body,NONE,NONE);
 }
 if take(s,278){let value=expression(s,0,depth+1,false);if !expect(s,1147){return NONE;}
  var first:usize=NONE;var last:usize=NONE;
  while kind(s)!=1149&&kind(s)!=lex.EOF&&(*s).status==0{
   let pt=(*s).at;let pat=pattern(s,depth+1);if kind(s)==272{return reject(s,UNSUPPORTED);}
   if !expect(s,531){return NONE;}let body=block(s,depth+1);let arm=node(s,ARM,pt,0,pat,body,NONE);append(s,&first,&last,arm);
   if !take(s,1068){break;}
  }if !expect(s,1149){return NONE;}return node(s,MATCH,t,0,value,first,NONE);
 }
 if take(s,268){let body=block(s,depth+1);return node(s,UNSAFE_BLOCK,t,0,body,NONE,NONE);}
 if take(s,291){if !expect(s,1147){return NONE;}let instruction=(*s).at;
  if kind(s)!=lex.IDENTIFIER||!(named(s,instruction,"cli")||named(s,instruction,"sti")||named(s,instruction,"hlt")
   ||named(s,instruction,"pause")||named(s,instruction,"int3")||named(s,instruction,"lfence")||named(s,instruction,"sfence")||named(s,instruction,"mfence")){return reject(s,UNSUPPORTED);}
  take(s,lex.IDENTIFIER);if !expect(s,1149){return NONE;}return node(s,ASM,instruction,0,NONE,NONE,NONE);
 }
 if kind(s)==1147{return block(s,depth+1);}
 if k==279||k==280{take(s,k);if !expect(s,1083){return NONE;}var tag=BREAK;if k==280{tag=CONTINUE;}return node(s,tag,t,0,NONE,NONE,NONE);}
 let left=expression(s,0,depth+1,true);if (*s).status!=0{return NONE;}
 if assignment(kind(s)){let ot=(*s).at;let op=kind(s);take(s,op);let right=expression(s,0,depth+1,true);
  if !expect(s,1083){return NONE;}return node(s,ASSIGN,ot,op,left,right,NONE);
 }
 if !expect(s,1083){return NONE;}var call=left;if (*s).nodes[call].kind==TRY{call=(*s).nodes[call].a;}
 if (*s).nodes[call].kind!=CALL{return reject_at(s,SYNTAX,t);}return node(s,EXPRESSION_STATEMENT,t,0,left,NONE,NONE);
}}
unsafe fn function_parameter(s:*State,depth:usize,receiver:bool)usize{unsafe{
 let t=(*s).at;if !expect(s,lex.IDENTIFIER)||!expect(s,1082){return NONE;}
 let typ=type_syntax(s,false,depth+1);let id=node(s,FUNCTION_PARAMETER,t,0,typ,NONE,NONE);
 if (*s).status==0&&receiver{(*s).nodes[id].flags=1;}return id;
}}
unsafe fn declaration(s:*State,depth:usize)usize{unsafe{
 if (*s).status!=0{return NONE;}if depth>=(*s).limit{return reject(s,DEPTH);}
 let t=(*s).at;var attrs:usize=NONE;var attr_last:usize=NONE;var seen:u64=0;var has_export=false;
 while kind(s)==259||kind(s)==270||kind(s)==269||kind(s)==271||kind(s)==267||kind(s)==268{
  let at=(*s).at;let modifier=kind(s);var bit:u64=0;
  if modifier==259{bit=1;}else if modifier==270{bit=2;}else if modifier==269{bit=4;}
  else if modifier==271{bit=8;}else if modifier==267{bit=16;}else{bit=32;}
  if (seen&bit)!=0{return reject(s,SYNTAX);}seen|=bit;take(s,modifier);
  var argument:usize=NONE;var extra:usize=NONE;
  if modifier==270{if !expect(s,1064){return NONE;}argument=expression(s,0,depth+1,true);if !expect(s,1065){return NONE;}}
  else if modifier==271{if has_export{return reject(s,SYNTAX);}has_export=true;
   if !expect(s,1064){return NONE;}let st=(*s).at;if !expect(s,lex.STRING)||!expect(s,1065){return NONE;}
   if !linker_name(s,st){return reject_at(s,SYNTAX,st);}argument=node(s,STRING,st,0,NONE,NONE,NONE);
  }else if modifier==267{let st=(*s).at;if !expect(s,lex.STRING){return NONE;}
   if !string_equal(s,st,"sysv64")&&!string_equal(s,st,"win64"){return reject_at(s,UNSUPPORTED,st);}argument=node(s,STRING,st,0,NONE,NONE,NONE);
   if take(s,1064){if has_export{return reject(s,SYNTAX);}has_export=true;let et=(*s).at;
    if !expect(s,lex.STRING)||!expect(s,1065){return NONE;}if !linker_name(s,et){return reject_at(s,SYNTAX,et);}extra=node(s,STRING,et,0,NONE,NONE,NONE);
   }
  }let attr=node(s,ATTRIBUTE,at,modifier,argument,extra,NONE);append(s,&attrs,&attr_last,attr);
 }
 let kt=(*s).at;let k=kind(s);if !take(s,k)||k==lex.EOF{return reject(s,SYNTAX);}var decl:usize=NONE;
 if k==264||k==265{
  let nt=(*s).at;if !expect(s,lex.IDENTIFIER){return NONE;}
  if (k==265&&(seen&~1)!=0)||(k==264&&(seen&56)!=0){return reject_at(s,SYNTAX,nt);}
  if !expect(s,1147){return NONE;}var first:usize=NONE;var last:usize=NONE;
  while kind(s)!=1149&&kind(s)!=lex.EOF&&(*s).status==0{
   var public_field=false;if k==264{public_field=take(s,259);}let ft=(*s).at;
   if !expect(s,lex.IDENTIFIER){return NONE;}var typ:usize=NONE;
   if k==264{if !expect(s,1082){return NONE;}typ=type_syntax(s,false,depth+1);}
   else if take(s,1064){typ=type_syntax(s,false,depth+1);if !expect(s,1065){return NONE;}}
   if k==265&&kind(s)==1085{return reject(s,UNSUPPORTED);}
   var tag=FIELD_DECL;if k==265{tag=VARIANT;}let item=node(s,tag,ft,0,typ,NONE,NONE);
   if (*s).status==0&&public_field{(*s).nodes[item].flags=1;}append(s,&first,&last,item);if !take(s,1068){break;}
  }if !expect(s,1149){return NONE;}var tag=STRUCT_DECL;if k==265{tag=ENUM_DECL;}decl=node(s,tag,nt,0,first,NONE,NONE);
 }else if k==263||k==260||k==262||k==284{
  let nt=(*s).at;if !expect(s,lex.IDENTIFIER){return NONE;}if (seen&~1)!=0{return reject_at(s,SYNTAX,nt);}
  var typ:usize=NONE;var value:usize=NONE;var tag=GLOBAL;
  if k==263{tag=ALIAS_DECL;if !expect(s,1085){return NONE;}typ=type_syntax(s,true,depth+1);}
  else{if k!=284{if !take(s,1082){return reject_at(s,SYNTAX,nt);}typ=type_syntax(s,false,depth+1);}else{tag=ERROR_DECL;}
   if k==262&&kind(s)!=1085{return reject_at(s,SYNTAX,nt);}
   if !expect(s,1085){return NONE;}value=expression(s,0,depth+1,true);
  }if !expect(s,1083){return NONE;}decl=node(s,tag,nt,k,typ,value,NONE);
 }else if k==266{
  if (seen&6)!=0{return reject_at(s,SYNTAX,kt);}var first:usize=NONE;var last:usize=NONE;
  if take(s,1064){let receiver=function_parameter(s,depth+1,true);append(s,&first,&last,receiver);if !expect(s,1065){return NONE;}}
  let nt=(*s).at;if !expect(s,lex.IDENTIFIER)||!expect(s,1064){return NONE;}
  while kind(s)!=1065&&(*s).status==0{let parameter=function_parameter(s,depth+1,false);append(s,&first,&last,parameter);if !take(s,1068){break;}}
  if !expect(s,1065){return NONE;}let returns=type_syntax(s,true,depth+1);var body:usize=NONE;
  if take(s,1083){if (seen&16)==0{return reject_at(s,SYNTAX,nt);}}else{body=block(s,depth+1);}
  decl=node(s,FUNCTION,nt,0,first,returns,body);
 }else{return reject_at(s,SYNTAX,kt);}
 return node(s,DECLARATION,t,0,decl,attrs,NONE);
}}
unsafe fn module_syntax(s:*State,depth:usize)usize{unsafe{
 let t=(*s).at;if !expect(s,256){return NONE;}let name=path(s,false);if !expect(s,1083){return NONE;}
 var first:usize=NONE;var last:usize=NONE;
 while kind(s)!=lex.EOF&&(*s).status==0{
  var item:usize=NONE;
  if kind(s)==257{let it=(*s).at;take(s,257);let imported=path(s,false);var alias:usize=NONE;
   if take(s,258){let at=(*s).at;if !expect(s,lex.IDENTIFIER){return NONE;}alias=node(s,NAME,at,0,NONE,NONE,NONE);}
   if !expect(s,1083){return NONE;}item=node(s,IMPORT,it,0,imported,alias,NONE);
  }else{item=declaration(s,depth+1);}append(s,&first,&last,item);
 }return node(s,MODULE,t,0,name,first,NONE);
}}
// The nodes are caller-owned scratch. On parse failure root is NONE and no
// tree is published; used/next/error describe the bounded partial attempt.
unsafe fn run(mode:u64,source:[]const u8,tokens:[]const lex.Token,start:usize,nodes:[]Node,
 max_depth:usize,allow_struct:bool,result:*Result)u64{unsafe{
 if mode>4||result==null||tokens.len==0||start>=tokens.len||max_depth==0||max_depth>256
  ||tokens.len>NONE/sizeof(lex.Token)||nodes.len>NONE/sizeof(Node){return INVALID;}
 let a=source.ptr as u64;let b=tokens.ptr as u64;let c=nodes.ptr as u64;let d=result as u64;
 let an=source.len;let bn=tokens.len*sizeof(lex.Token);let cn=nodes.len*sizeof(Node);
 if !span(a,an)||!span(b,bn)||!span(c,cn)||!span(d,sizeof(Result))||(b&7)!=0||(cn!=0&&(c&7)!=0)||(d&7)!=0{return INVALID;}
 if overlap(a,an,c,cn)||overlap(a,an,d,sizeof(Result))||overlap(b,bn,c,cn)||overlap(b,bn,d,sizeof(Result))||overlap(c,cn,d,sizeof(Result)){return INVALID;}
 var i:usize=0;var end:usize=0;while i<tokens.len{
  let token=tokens[i];if token.start>token.end||token.end>source.len||token.start<end{return INVALID;}
  if (token.kind==lex.EOF)!=(i==tokens.len-1){return INVALID;}end=token.end;i+=1;
 }
 var s=State{source:source,tokens:tokens,nodes:nodes,at:start,used:0,status:0,error_at:start,limit:max_depth};
 var root:usize=NONE;
 if mode==0{root=expression(&s,0,0,allow_struct);}else if mode==1{root=block(&s,0);}
 else if mode==2{root=module_syntax(&s,0);}else if mode==3{root=statement(&s,0);}else{root=declaration(&s,0);}
 if s.status!=0{root=NONE;}
 *result=Result{root:root,used:s.used,next:s.at,error_code:s.status,error_token:s.error_at};return s.status;
}}
pub unsafe fn parse(source:[]const u8,tokens:[]const lex.Token,start:usize,nodes:[]Node,
 max_depth:usize,allow_struct:bool,result:*Result)u64{unsafe{return run(0,source,tokens,start,nodes,max_depth,allow_struct,result);}}
pub unsafe fn parse_syntax(mode:u64,source:[]const u8,tokens:[]const lex.Token,start:usize,nodes:[]Node,
 max_depth:usize,result:*Result)u64{unsafe{return run(mode,source,tokens,start,nodes,max_depth,true,result);}}
export("dong_bootstrap_expression") pub unsafe fn parse_raw(source:*const u8,length:usize,tokens:*const lex.Token,count:usize,
 start:usize,nodes:*Node,capacity:usize,max_depth:usize,allow_struct:bool,result:*Result)u64{unsafe{
 return parse(slice_from_raw_parts(source,length),slice_from_raw_parts(tokens,count),start,
  slice_from_raw_parts(nodes,capacity),max_depth,allow_struct,result);
}}

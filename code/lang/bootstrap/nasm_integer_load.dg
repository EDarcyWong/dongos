// Emit NASM immediate mov of a fixed-width integer into a 64-bit register.
// Decimal text comes from CR4 decimal_integer into stack scratch first so
// failures never leave a half-written line. INVALID precedes CAPACITY.
module bootstrap.nasm_integer_load;
import bootstrap.decimal_integer as dec;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
const MAX:u64=0xffff_ffff_ffff_ffff;
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn width_ok(width:usize)bool{return width==8||width==16||width==32||width==64;}
fn reg_len(register:u64)usize{
 if register<=7{return 3;}
 if register<=9{return 2;}
 return 3;
}
fn write_reg(out:[]u8,at:usize,register:u64)usize{
 if register==0{out[at]=114;out[at+1]=97;out[at+2]=120;return at+3;}
 if register==1{out[at]=114;out[at+1]=99;out[at+2]=120;return at+3;}
 if register==2{out[at]=114;out[at+1]=100;out[at+2]=120;return at+3;}
 if register==3{out[at]=114;out[at+1]=98;out[at+2]=120;return at+3;}
 if register==4{out[at]=114;out[at+1]=115;out[at+2]=112;return at+3;}
 if register==5{out[at]=114;out[at+1]=98;out[at+2]=112;return at+3;}
 if register==6{out[at]=114;out[at+1]=115;out[at+2]=105;return at+3;}
 if register==7{out[at]=114;out[at+1]=100;out[at+2]=105;return at+3;}
 if register==8{out[at]=114;out[at+1]=56;return at+2;}
 if register==9{out[at]=114;out[at+1]=57;return at+2;}
 if register==10{out[at]=114;out[at+1]=49;out[at+2]=48;return at+3;}
 if register==11{out[at]=114;out[at+1]=49;out[at+2]=49;return at+3;}
 if register==12{out[at]=114;out[at+1]=49;out[at+2]=50;return at+3;}
 if register==13{out[at]=114;out[at+1]=49;out[at+2]=51;return at+3;}
 if register==14{out[at]=114;out[at+1]=49;out[at+2]=52;return at+3;}
 out[at]=114;out[at+1]=49;out[at+2]=53;return at+3;
}
fn copy(out:[]u8,at:usize,text:[]const u8)usize{
 var i:usize=0;while i<text.len{out[at+i]=text[i];i+=1;}return at+text.len;
}
pub unsafe fn emit(register:u64,raw:u64,width:usize,signed:bool,out:[]u8,written:*usize)u64{unsafe{
 let wp=written as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8){return INVALID;}
 if !span(op,out.len){return INVALID;}
 if overlap(wp,8,op,out.len){return INVALID;}
 if register>15{return INVALID;}
 if !width_ok(width){return INVALID;}
 if width!=64{
  let limit=(1 as u64)<<width;
  if raw>=limit{return INVALID;}
 }
 var db:[20]u8=[0;20];var dw:usize=0;
 let dsl=slice_from_raw_parts(&db[0],20);
 let sd=dec.encode(raw,width,signed,dsl,&dw);
 if sd!=OK{return sd;}
 let nl=reg_len(register);
 if nl>MAX-7{return INVALID;}let base=nl+7;
 if dw>MAX-base{return INVALID;}let total=base+dw;
 if total>out.len{return CAPACITY;}
 // "mov "
 out[0]=109;out[1]=111;out[2]=118;out[3]=32;
 var at=write_reg(out,4,register);
 out[at]=44;out[at+1]=32;at+=2;
 at=copy(out,at,slice_from_raw_parts(&db[0],dw));
 out[at]=10;
 *written=total;return OK;
}}

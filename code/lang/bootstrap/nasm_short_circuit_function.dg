// Bounded deterministic preflight/replay. Only the final replay publishes user output.
module bootstrap.nasm_short_circuit_function;
import bootstrap.nasm_symbol as sym;
import bootstrap.nasm_integer_memory_load as mld;
import bootstrap.nasm_integer_memory_store as mst;
import bootstrap.nasm_integer_load as ld;
import bootstrap.nasm_sysv_function_exit as ex;
import bootstrap.nasm_block_emit as blk;
import bootstrap.nasm_function_frame as frame;
import bootstrap.nasm_sysv_direct_invoke as inv;
import bootstrap.nasm_compare_emit as cmp;
import bootstrap.nasm_branch_emit as branch;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
const MAX:u64=0xffff_ffff_ffff_ffff;const RBP:u64=5;
struct Config{module_name:[]const u8,item_name:[]const u8,left_module:[]const u8,left_item:[]const u8,right_module:[]const u8,right_item:[]const u8,operation:u64,eval_block:u64,done_block:u64}
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn room(out:[]u8,at:usize,size:usize)bool{return at<=out.len&&size<=out.len-at;}
unsafe fn put(out:[]u8,at:*usize,text:[]const u8)bool{unsafe{
 if !room(out,*at,text.len){return false;}
 var i:usize=0;while i<text.len{out[*at+i]=text[i];i+=1;}*at+=text.len;return true;
}}
unsafe fn load_memory(piece:[]u8,at:*usize,register:u64,displacement:i64)bool{unsafe{
 if !room(piece,*at,128){return false;}
 var n:usize=0;
 if mld.emit(register,RBP,displacement,64,false,slice_from_raw_parts(&piece[*at],128),&n)!=mld.OK{return false;}
 if n>128{return false;}
 *at+=n;return true;
}}
unsafe fn store_memory(piece:[]u8,at:*usize,source:u64,displacement:i64)bool{unsafe{
 if !room(piece,*at,128){return false;}
 var n:usize=0;
 if mst.emit(source,RBP,displacement,64,slice_from_raw_parts(&piece[*at],128),&n)!=mst.OK{return false;}
 if n>128{return false;}
 *at+=n;return true;
}}
unsafe fn load_immediate(piece:[]u8,at:*usize,register:u64,value:u64)bool{unsafe{
 if !room(piece,*at,64){return false;}
 var n:usize=0;
 if ld.emit(register,value,64,false,slice_from_raw_parts(&piece[*at],64),&n)!=ld.OK{return false;}
 if n>64{return false;}
 *at+=n;return true;
}}
unsafe fn name_ok(s:[]const u8,out:[]u8,wp:u64)bool{unsafe{
 let p=s.ptr as u64;let n=s.len;
 return n>=1&&n<=64&&span(p,n)&&!overlap(p,n,out.ptr as u64,out.len)&&!overlap(p,n,wp,8);
}}
fn same(a:[]const u8,b:[]const u8)bool{
 if a.len!=b.len{return false;}var i:usize=0;while i<a.len{if a[i]!=b[i]{return false;}i+=1;}return true;
}
unsafe fn piece(index:usize,c:*const Config,buffer:[]u8,length:*usize)bool{unsafe{
 var at:usize=0;var n:usize=0;
 if index==0{if sym.encode((*c).module_name,(*c).item_name,slice_from_raw_parts(&buffer[0],266),&n)!=0{return false;}at=n;if !put(buffer,&at,":\n"){return false;}}
 else if index==1{if frame.prologue(16,0,buffer,&n)!=0{return false;}at=n;}
 else if index==2{if inv.emit((*c).left_module,(*c).left_item,slice_from_raw_parts(null as *const u8,0),slice_from_raw_parts(null as *const usize,0),8,16,8,0,buffer,&n)!=0{return false;}at=n;}
 else if index==3{if !load_memory(buffer,&at,0,-8){return false;}if !load_immediate(buffer,&at,1,0){return false;}if cmp.emit(1,0,1,slice_from_raw_parts(&buffer[at],48),&n)!=0{return false;}at+=n;if !store_memory(buffer,&at,0,-8){return false;}}
 else if index==4{if !put(buffer,&at,"test rax, rax\n"){return false;}var condition:u64=1;if (*c).operation==1{condition=0;}if branch.emit(condition,(*c).eval_block,(*c).done_block,(*c).eval_block,slice_from_raw_parts(&buffer[at],128),&n)!=0{return false;}at+=n;}
 else if index==5{if blk.emit(0,(*c).eval_block,buffer,&n)!=0{return false;}at=n;}
 else if index==6{if inv.emit((*c).right_module,(*c).right_item,slice_from_raw_parts(null as *const u8,0),slice_from_raw_parts(null as *const usize,0),8,16,16,0,buffer,&n)!=0{return false;}at=n;}
 else if index==7{if !load_memory(buffer,&at,0,-16){return false;}if !load_immediate(buffer,&at,1,0){return false;}if cmp.emit(1,0,1,slice_from_raw_parts(&buffer[at],48),&n)!=0{return false;}at+=n;if !store_memory(buffer,&at,0,-8){return false;}}
 else if index==8{if ex.emit(1,16,0,8,0,buffer,&n)!=0{return false;}at=n;}
 else if index==9{if blk.emit(0,(*c).done_block,buffer,&n)!=0{return false;}at=n;}
 else if index==10{if ex.emit(1,16,0,8,0,buffer,&n)!=0{return false;}at=n;}
 else{return false;}if at>1536{return false;}*length=at;return true;
}}
pub unsafe fn emit(module_name:[]const u8,item_name:[]const u8,left_module:[]const u8,left_item:[]const u8,right_module:[]const u8,right_item:[]const u8,operation:u64,eval_block:u64,done_block:u64,out:[]u8,written:*usize)u64{unsafe{
let wp=written as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8)||!span(op,out.len)||overlap(wp,8,op,out.len){return INVALID;}
if !name_ok(module_name,out,wp)||!name_ok(item_name,out,wp){return INVALID;}
if !name_ok(left_module,out,wp)||!name_ok(left_item,out,wp)||!name_ok(right_module,out,wp)||!name_ok(right_item,out,wp){return INVALID;}
 if operation>1||eval_block==MAX||done_block==MAX||eval_block==done_block{return INVALID;}
 if (same(module_name,left_module)&&same(item_name,left_item))||(same(module_name,right_module)&&same(item_name,right_item)){return INVALID;}
let c=Config{module_name:module_name,item_name:item_name,left_module:left_module,left_item:left_item,right_module:right_module,right_item:right_item,operation:operation,eval_block:eval_block,done_block:done_block};
var buffer:[1536]u8=[0;1536];var n:usize=0;var total:usize=0;var p:usize=0;
 while p<11{
  if !piece(p,&c,slice_from_raw_parts(&buffer[0],1536),&n)||n>1536{return INVALID;}
  total+=n;p+=1;
 }
 if total>out.len{return CAPACITY;}
 var at:usize=0;p=0;
 while p<11{
  if !piece(p,&c,slice_from_raw_parts(&buffer[0],1536),&n){return INVALID;}
  var i:usize=0;while i<n{out[at+i]=buffer[i];i+=1;}at+=n;p+=1;
 }
 *written=at;return OK;
}}

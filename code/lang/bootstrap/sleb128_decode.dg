// Bounded shortest SLEB128 i64 decoder. Reads at most 10 bytes: the low 7 bits
// of each byte are payload and bit 7 is the continue flag; the terminating
// byte's payload bit 6 is the sign bit. The 10th byte only decides bit 63, so
// it must terminate and its payload must be 0 (positive) or 127 (negative).
module bootstrap.sleb128_decode;
pub const OK:u64=0;pub const INVALID:u64=1;pub const TRUNCATED:u64=2;pub const OVERFLOW:u64=3;pub const NONCANONICAL:u64=4;
const MAX:u64=0xffff_ffff_ffff_ffff;
const BIT63:u64=0x8000_0000_0000_0000;
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
unsafe fn valid(input:[]const u8,value:*i64,consumed:*usize)bool{unsafe{
 if value==null||consumed==null{return false;}
 let ip=input.ptr as u64;let vp=value as u64;let cp=consumed as u64;let inn=input.len;
 if !span(ip,inn)||!span(vp,8)||!span(cp,8){return false;}
 if (vp&7)!=0||(cp&7)!=0{return false;}
 if overlap(ip,inn,vp,8)||overlap(ip,inn,cp,8)||overlap(vp,8,cp,8){return false;}
 return true;
}}
pub unsafe fn decode(input:[]const u8,value:*i64,consumed:*usize)u64{unsafe{
 if !valid(input,value,consumed){return INVALID;}
 let n=input.len;var result:u64=0;var shift:usize=0;var i:usize=0;
 while i<n{
  let b:u8=input[i];let payload:u64=(b&0x7f)as u64;let cont:u8=b&0x80;
  if i==9{
   if cont!=0||(payload!=0&&payload!=0x7f){return OVERFLOW;}
   let prev6:bool=(input[8]&0x40)!=0;
   if (payload==0&&!prev6)||(payload==0x7f&&prev6){return NONCANONICAL;}
   if payload==0x7f{result|=BIT63;}
   *value=result as i64;*consumed=10;return OK;
  }
  if cont!=0{result|=payload<<shift;shift+=7;i+=1;}
  else{
   if i!=0{let prev6:bool=(input[i-1]&0x40)!=0;if (payload==0&&!prev6)||(payload==0x7f&&prev6){return NONCANONICAL;}}
   result|=payload<<shift;
   if (payload&0x40)!=0{result|=MAX<<(shift+7);}
   *value=result as i64;*consumed=i+1;return OK;
  }
 }
 return TRUNCATED;
}}

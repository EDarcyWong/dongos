// Dong-native bootstrap lexer. See lang/tests/test_bootstrap_lexer.py.
// Byte spans borrow immutable UTF-8 input; positions count Unicode code points.
// No allocation, globals, I/O, integer conversion or Python target dependency.
module bootstrap.lexer;
import bootstrap.unicode as unicode;
pub const EOF:u64=0;pub const IDENTIFIER:u64=1;pub const INTEGER:u64=2;pub const STRING:u64=3;
pub const BAD_UTF8:u64=1;pub const BLOCK_COMMENT:u64=2;pub const STRING_NEWLINE:u64=3;
pub const UNTERMINATED_STRING:u64=4;pub const HEX_ESCAPE:u64=5;pub const STRING_ESCAPE:u64=6;
pub const INTEGER_LITERAL:u64=7;pub const CHARACTER:u64=8;pub const TOKEN_CAPACITY:u64=9;
pub const STRING_CAPACITY:u64=10;pub const INVALID_ARGUMENT:u64=11;
pub struct Token{pub kind:u64,pub start:usize,pub end:usize,pub line:u64,pub column:u64,pub value_start:usize,pub value_length:usize}
pub struct Result{pub count:usize,pub used:usize,pub error_code:u64,pub error_start:usize,pub error_line:u64,pub error_column:u64}
pub const EMPTY_TOKEN:Token=Token{kind:0,start:0,end:0,line:0,column:0,value_start:0,value_length:0};
pub const EMPTY_RESULT:Result=Result{count:0,used:0,error_code:0,error_start:0,error_line:0,error_column:0};
struct State{source:[]const u8,tokens:[]Token,strings:[]u8,at:usize,line:u64,column:u64,result:Result}
fn equal(a:[]const u8,b:[]const u8)bool{
 if a.len!=b.len{return false;}var i:usize=0;while i<a.len{if a[i]!=b[i]{return false;}i+=1;}return true;
}
fn keyword(text:[]const u8)u64{
 if equal(text,"module"){return 256;}
 if equal(text,"import"){return 257;}
 if equal(text,"as"){return 258;}
 if equal(text,"pub"){return 259;}
 if equal(text,"const"){return 260;}
 if equal(text,"let"){return 261;}
 if equal(text,"var"){return 262;}
 if equal(text,"type"){return 263;}
 if equal(text,"struct"){return 264;}
 if equal(text,"enum"){return 265;}
 if equal(text,"fn"){return 266;}
 if equal(text,"extern"){return 267;}
 if equal(text,"unsafe"){return 268;}
 if equal(text,"packed"){return 269;}
 if equal(text,"align"){return 270;}
 if equal(text,"export"){return 271;}
 if equal(text,"if"){return 272;}
 if equal(text,"else"){return 273;}
 if equal(text,"while"){return 274;}
 if equal(text,"loop"){return 275;}
 if equal(text,"for"){return 276;}
 if equal(text,"in"){return 277;}
 if equal(text,"match"){return 278;}
 if equal(text,"break"){return 279;}
 if equal(text,"continue"){return 280;}
 if equal(text,"return"){return 281;}
 if equal(text,"defer"){return 282;}
 if equal(text,"try"){return 283;}
 if equal(text,"error"){return 284;}
 if equal(text,"orelse"){return 285;}
 if equal(text,"true"){return 286;}
 if equal(text,"false"){return 287;}
 if equal(text,"null"){return 288;}
 if equal(text,"void"){return 289;}
 if equal(text,"noreturn"){return 290;}
 if equal(text,"asm"){return 291;}
 return IDENTIFIER;
}
pub fn kind_name(kind:u64)[]const u8{
 if kind==EOF{return "eof";}if kind==IDENTIFIER{return "identifier";}if kind==INTEGER{return "integer";}if kind==STRING{return "string";}
 if kind==256{return "module";}
 if kind==257{return "import";}
 if kind==258{return "as";}
 if kind==259{return "pub";}
 if kind==260{return "const";}
 if kind==261{return "let";}
 if kind==262{return "var";}
 if kind==263{return "type";}
 if kind==264{return "struct";}
 if kind==265{return "enum";}
 if kind==266{return "fn";}
 if kind==267{return "extern";}
 if kind==268{return "unsafe";}
 if kind==269{return "packed";}
 if kind==270{return "align";}
 if kind==271{return "export";}
 if kind==272{return "if";}
 if kind==273{return "else";}
 if kind==274{return "while";}
 if kind==275{return "loop";}
 if kind==276{return "for";}
 if kind==277{return "in";}
 if kind==278{return "match";}
 if kind==279{return "break";}
 if kind==280{return "continue";}
 if kind==281{return "return";}
 if kind==282{return "defer";}
 if kind==283{return "try";}
 if kind==284{return "error";}
 if kind==285{return "orelse";}
 if kind==286{return "true";}
 if kind==287{return "false";}
 if kind==288{return "null";}
 if kind==289{return "void";}
 if kind==290{return "noreturn";}
 if kind==291{return "asm";}
 if kind==512{return "<<=";}
 if kind==513{return ">>=";}
 if kind==514{return "==";}
 if kind==515{return "!=";}
 if kind==516{return "<=";}
 if kind==517{return ">=";}
 if kind==518{return "&&";}
 if kind==519{return "||";}
 if kind==520{return "<<";}
 if kind==521{return ">>";}
 if kind==522{return "+=";}
 if kind==523{return "-=";}
 if kind==524{return "*=";}
 if kind==525{return "/=";}
 if kind==526{return "%=";}
 if kind==527{return "&=";}
 if kind==528{return "|=";}
 if kind==529{return "^=";}
 if kind==530{return "..";}
 if kind==531{return "=>";}
 if kind==1147{return "{";}
 if kind==1149{return "}";}
 if kind==1064{return "(";}
 if kind==1065{return ")";}
 if kind==1115{return "[";}
 if kind==1117{return "]";}
 if kind==1083{return ";";}
 if kind==1068{return ",";}
 if kind==1082{return ":";}
 if kind==1070{return ".";}
 if kind==1067{return "+";}
 if kind==1069{return "-";}
 if kind==1066{return "*";}
 if kind==1071{return "/";}
 if kind==1061{return "%";}
 if kind==1062{return "&";}
 if kind==1148{return "|";}
 if kind==1118{return "^";}
 if kind==1150{return "~";}
 if kind==1057{return "!";}
 if kind==1084{return "<";}
 if kind==1086{return ">";}
 if kind==1085{return "=";}
 if kind==1087{return "?";}
 return "";
}
fn valid_span(address:u64,bytes:u64)bool{return bytes==0||(address!=0&&bytes<=0xffff_ffff_ffff_ffff-address);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{
 if n==0||m==0{return false;}if a<=b{return b-a<n;}return a-b<m;
}
unsafe fn reject(s:*State,code:u64,at:usize,line:u64,column:u64)u64{unsafe{
 (*s).result.error_code=code;(*s).result.error_start=at;(*s).result.error_line=line;(*s).result.error_column=column;return code;
}}
unsafe fn next(s:*State)void{unsafe{
 var decoded=unicode.EMPTY;let valid=unicode.decode((*s).source,(*s).at,&decoded);
 if !valid{return;}(*s).at+=decoded.bytes;
 if decoded.cp==10{(*s).line+=1;(*s).column=1;}else{(*s).column+=1;}
}}
unsafe fn prefix(s:*State,text:[]const u8)bool{unsafe{
 if text.len>(*s).source.len-(*s).at{return false;}var i:usize=0;
 while i<text.len{if (*s).source[(*s).at+i]!=text[i]{return false;}i+=1;}return true;
}}
fn hex(byte:u8)u64{
 if byte>=48&&byte<=57{return (byte-48) as u64;}if byte>=65&&byte<=70{return (byte-55) as u64;}
 if byte>=97&&byte<=102{return (byte-87) as u64;}return 256;
}
fn integer_valid(text:[]const u8)bool{
 var at:usize=0;var base:u64=10;
 if text.len>=2&&text[0]==48{if text[1]==120{base=16;at=2;}else if text[1]==98{base=2;at=2;}}
 if at==text.len{return false;}var digit:bool=false;var separator:bool=false;
 while at<text.len{let ch=text[at];
  if ch==95{if !digit||separator{return false;}separator=true;}
  else{if hex(ch)>=base{return false;}digit=true;separator=false;}at+=1;
 }return digit&&!separator;
}
unsafe fn append_string(s:*State,used:*usize,value:u8,token:*const Token)u64{unsafe{
 if *used>=(*s).strings.len{return reject(s,STRING_CAPACITY,(*token).start,(*token).line,(*token).column);}
 (*s).strings[*used]=value;*used+=1;return 0;
}}
unsafe fn string(s:*State,token:*Token)u64{unsafe{
 next(s);var used=(*s).result.used;(*token).value_start=used;(*token).kind=STRING;
 while (*s).at<(*s).source.len&&(*s).source[(*s).at]!=34{
  let ch=(*s).source[(*s).at];
  if ch==13||ch==10{return reject(s,STRING_NEWLINE,(*token).start,(*token).line,(*token).column);}
  if ch!=92{
   var decoded=unicode.EMPTY;let valid=unicode.decode((*s).source,(*s).at,&decoded);if !valid{return BAD_UTF8;}
   var i:usize=0;while i<decoded.bytes{let status=append_string(s,&used,(*s).source[(*s).at+i],token);if status!=0{return status;}i+=1;}
   next(s);continue;
  }
  let escape_at=(*s).at;let escape_line=(*s).line;let escape_column=(*s).column;next(s);
  if (*s).at==(*s).source.len{return reject(s,UNTERMINATED_STRING,(*token).start,(*token).line,(*token).column);}
  let code=(*s).source[(*s).at];var value:u8=0;
  if code==110{value=10;}else if code==114{value=13;}else if code==116{value=9;}else if code==48{value=0;}
  else if code==92{value=92;}else if code==34{value=34;}
  else if code==120{
   if (*s).source.len-(*s).at<3||hex((*s).source[(*s).at+1])>15||hex((*s).source[(*s).at+2])>15{
    return reject(s,HEX_ESCAPE,escape_at,escape_line,escape_column);
   }
   value=(hex((*s).source[(*s).at+1])*16+hex((*s).source[(*s).at+2])) as u8;next(s);next(s);
  }else{return reject(s,STRING_ESCAPE,escape_at,escape_line,escape_column);}
  let status=append_string(s,&used,value,token);if status!=0{return status;}next(s);
 }
 if (*s).at==(*s).source.len{return reject(s,UNTERMINATED_STRING,(*token).start,(*token).line,(*token).column);}
 next(s);(*token).end=(*s).at;(*token).value_length=used-(*s).result.used;(*s).result.used=used;return 0;
}}
unsafe fn scan(s:*State)u64{unsafe{
 // Decode the entire source before lexing, matching the file loader's strict UTF-8 contract.
 while (*s).at<(*s).source.len{var decoded=unicode.EMPTY;
  if !unicode.decode((*s).source,(*s).at,&decoded){return reject(s,BAD_UTF8,(*s).at,(*s).line,(*s).column);}next(s);
 }
 (*s).at=0;(*s).line=1;(*s).column=1;
 while (*s).at<(*s).source.len{
  var decoded=unicode.EMPTY;let valid=unicode.decode((*s).source,(*s).at,&decoded);if !valid{return BAD_UTF8;}
  if unicode.space(decoded.cp){next(s);continue;}
  if prefix(s,"//"){while (*s).at<(*s).source.len&&(*s).source[(*s).at]!=10{next(s);}continue;}
  var token=EMPTY_TOKEN;token.start=(*s).at;token.line=(*s).line;token.column=(*s).column;
  if prefix(s,"/*"){
   next(s);next(s);while (*s).at<(*s).source.len&&!prefix(s,"*/"){next(s);}
   if (*s).at==(*s).source.len{return reject(s,BLOCK_COMMENT,token.start,token.line,token.column);}next(s);next(s);continue;
  }
  if (*s).result.count>=(*s).tokens.len{return reject(s,TOKEN_CAPACITY,token.start,token.line,token.column);}
  if decoded.cp==34{let status=string(s,&token);if status!=0{return status;}}
  else if decoded.cp>=48&&decoded.cp<=57{
   next(s);while (*s).at<(*s).source.len{
    let ok=unicode.decode((*s).source,(*s).at,&decoded);if !ok{return BAD_UTF8;}
    if decoded.cp!=95&&!unicode.alnum(decoded.cp){break;}next(s);
   }token.end=(*s).at;token.kind=INTEGER;
   if !integer_valid((*s).source[token.start..token.end]){return reject(s,INTEGER_LITERAL,token.start,token.line,token.column);}
  }else if unicode.id_start(decoded.cp){
   next(s);while (*s).at<(*s).source.len{
    let ok=unicode.decode((*s).source,(*s).at,&decoded);if !ok{return BAD_UTF8;}
    if !unicode.id_continue(decoded.cp){break;}next(s);
   }token.end=(*s).at;token.kind=keyword((*s).source[token.start..token.end]);
  }else{
   var width:usize=0;
   if prefix(s,"<<="){token.kind=512;width=3;}
   else if prefix(s,">>="){token.kind=513;width=3;}
   else if prefix(s,"=="){token.kind=514;width=2;}
   else if prefix(s,"!="){token.kind=515;width=2;}
   else if prefix(s,"<="){token.kind=516;width=2;}
   else if prefix(s,">="){token.kind=517;width=2;}
   else if prefix(s,"&&"){token.kind=518;width=2;}
   else if prefix(s,"||"){token.kind=519;width=2;}
   else if prefix(s,"<<"){token.kind=520;width=2;}
   else if prefix(s,">>"){token.kind=521;width=2;}
   else if prefix(s,"+="){token.kind=522;width=2;}
   else if prefix(s,"-="){token.kind=523;width=2;}
   else if prefix(s,"*="){token.kind=524;width=2;}
   else if prefix(s,"/="){token.kind=525;width=2;}
   else if prefix(s,"%="){token.kind=526;width=2;}
   else if prefix(s,"&="){token.kind=527;width=2;}
   else if prefix(s,"|="){token.kind=528;width=2;}
   else if prefix(s,"^="){token.kind=529;width=2;}
   else if prefix(s,".."){token.kind=530;width=2;}
   else if prefix(s,"=>"){token.kind=531;width=2;}
   if width==0{
    let cp=decoded.cp;
    if cp==123||cp==125||cp==40||cp==41||cp==91||cp==93||cp==59||cp==44||cp==58||cp==46
     ||cp==43||cp==45||cp==42||cp==47||cp==37||cp==38||cp==124||cp==94||cp==126||cp==33||cp==60||cp==62||cp==61||cp==63{
     token.kind=1024+cp as u64;width=1;
    }else{return reject(s,CHARACTER,token.start,token.line,token.column);}
   }
   var i:usize=0;while i<width{next(s);i+=1;}token.end=(*s).at;
  }
  (*s).tokens[(*s).result.count]=token;(*s).result.count+=1;
 }
 if (*s).result.count>=(*s).tokens.len{return reject(s,TOKEN_CAPACITY,(*s).at,(*s).line,(*s).column);}
 (*s).tokens[(*s).result.count]=Token{kind:EOF,start:(*s).at,end:(*s).at,line:(*s).line,column:(*s).column,value_start:0,value_length:0};
 (*s).result.count+=1;return 0;
}}
// Inputs and output spans must be caller-owned, naturally aligned and disjoint.
// INVALID_ARGUMENT does not touch outputs. Other failures publish a completed
// token/string prefix in Result; an unfinished string may overwrite unused arena
// bytes within its declared capacity but is never published as a Token.
pub unsafe fn lex(source:[]const u8,tokens:[]Token,strings:[]u8,out:*Result)u64{unsafe{
 if out==null||tokens.len>0xffff_ffff_ffff_ffff/sizeof(Token){return INVALID_ARGUMENT;}
 let a=source.ptr as u64;let b=tokens.ptr as u64;let c=strings.ptr as u64;let d=out as u64;
 let n=source.len as u64;let m=tokens.len as u64*sizeof(Token);let k=strings.len as u64;
 if !valid_span(a,n)||!valid_span(b,m)||!valid_span(c,k)||!valid_span(d,sizeof(Result))
  ||(m!=0&&(b&7)!=0)||(d&7)!=0||n==0xffff_ffff_ffff_ffff{return INVALID_ARGUMENT;}
 if overlap(a,n,b,m)||overlap(a,n,c,k)||overlap(a,n,d,sizeof(Result))
  ||overlap(b,m,c,k)||overlap(b,m,d,sizeof(Result))||overlap(c,k,d,sizeof(Result)){return INVALID_ARGUMENT;}
 var s=State{source:source,tokens:tokens,strings:strings,at:0,line:1,column:1,result:EMPTY_RESULT};
 let status=scan(&s);*out=s.result;return status;
}}
export("dong_bootstrap_lex") pub unsafe fn lex_raw(source:*const u8,length:usize,tokens:*Token,capacity:usize,strings:*u8,bytes:usize,out:*Result)u64{unsafe{
 return lex(slice_from_raw_parts(source,length),slice_from_raw_parts(tokens,capacity),slice_from_raw_parts(strings,bytes),out);
}}


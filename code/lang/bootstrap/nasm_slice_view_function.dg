// Bounded deterministic preflight/replay. Only the final replay publishes user output.
module bootstrap.nasm_slice_view_function;
import bootstrap.nasm_symbol as sym;
import bootstrap.nasm_sysv_function_entry as ent;
import bootstrap.nasm_integer_memory_load as mld;
import bootstrap.nasm_integer_memory_store as mst;
import bootstrap.nasm_integer_load as ld;
import bootstrap.nasm_sysv_function_exit as ex;
import bootstrap.nasm_block_emit as blk;
import bootstrap.nasm_slice_bounds_guard as bounds;
import bootstrap.nasm_bounds_guard as indexguard;
import bootstrap.nasm_compare_emit as cmp;
import bootstrap.nasm_integer_binary as bin;
import bootstrap.nasm_integer_shift as shift;
import bootstrap.nasm_checked_add_sub as addsub;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
const MAX:u64=0xffff_ffff_ffff_ffff;const RBP:u64=5;
struct Config{module_name:[]const u8,item_name:[]const u8,element_size:u64,error_block:u64}
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn room(out:[]u8,at:usize,size:usize)bool{return at<=out.len&&size<=out.len-at;}
unsafe fn put(out:[]u8,at:*usize,text:[]const u8)bool{unsafe{
 if !room(out,*at,text.len){return false;}
 var i:usize=0;while i<text.len{out[*at+i]=text[i];i+=1;}*at+=text.len;return true;
}}
unsafe fn load_memory(piece:[]u8,at:*usize,register:u64,displacement:i64)bool{unsafe{
 if !room(piece,*at,128){return false;}
 var n:usize=0;
 if mld.emit(register,RBP,displacement,64,false,slice_from_raw_parts(&piece[*at],128),&n)!=mld.OK{return false;}
 if n>128{return false;}
 *at+=n;return true;
}}
unsafe fn store_memory(piece:[]u8,at:*usize,source:u64,displacement:i64)bool{unsafe{
 if !room(piece,*at,128){return false;}
 var n:usize=0;
 if mst.emit(source,RBP,displacement,64,slice_from_raw_parts(&piece[*at],128),&n)!=mst.OK{return false;}
 if n>128{return false;}
 *at+=n;return true;
}}
unsafe fn load_immediate(piece:[]u8,at:*usize,register:u64,value:u64)bool{unsafe{
 if !room(piece,*at,64){return false;}
 var n:usize=0;
 if ld.emit(register,value,64,false,slice_from_raw_parts(&piece[*at],64),&n)!=ld.OK{return false;}
 if n>64{return false;}
 *at+=n;return true;
}}
unsafe fn name_ok(s:[]const u8,out:[]u8,wp:u64)bool{unsafe{
 let p=s.ptr as u64;let n=s.len;
 return n>=1&&n<=64&&span(p,n)&&!overlap(p,n,out.ptr as u64,out.len)&&!overlap(p,n,wp,8);
}}
unsafe fn piece(index:usize,c:*const Config,buffer:[]u8,length:*usize)bool{unsafe{
 var at:usize=0;var n:usize=0;
 if index==0{if sym.encode((*c).module_name,(*c).item_name,slice_from_raw_parts(&buffer[0],266),&n)!=0{return false;}at=n;if !put(buffer,&at,":\n"){return false;}}
 else if index==1{var kinds:[4]u8=[0;4];var offsets:[4]usize=[0;4];offsets[0]=8;offsets[1]=16;offsets[2]=24;offsets[3]=32;if ent.emit(slice_from_raw_parts(&kinds[0],4),slice_from_raw_parts(&offsets[0],4),48,buffer,&n)!=0{return false;}at=n;}
 else if index==2{if !load_memory(buffer,&at,7,-24){return false;}if !load_memory(buffer,&at,6,-32){return false;}if !load_memory(buffer,&at,2,-16){return false;}}
 else if index==3{if bounds.emit((*c).error_block,buffer,&n)!=0{return false;}at=n;}
 else if index==4{if !load_memory(buffer,&at,0,-8){return false;}if !load_immediate(buffer,&at,1,0){return false;}if cmp.emit(1,0,1,slice_from_raw_parts(&buffer[at],48),&n)!=0{return false;}at+=n;if !store_memory(buffer,&at,0,-40){return false;}}
 else if index==5{if !load_memory(buffer,&at,0,-16){return false;}if !load_immediate(buffer,&at,1,0){return false;}if cmp.emit(0,0,1,slice_from_raw_parts(&buffer[at],48),&n)!=0{return false;}at+=n;if !load_memory(buffer,&at,1,-40){return false;}if bin.emit(3,0,1,slice_from_raw_parts(&buffer[at],16),&n)!=0{return false;}at+=n;}
 else if index==6{if !load_immediate(buffer,&at,1,0){return false;}if indexguard.emit(1,0,(*c).error_block,slice_from_raw_parts(&buffer[at],64),&n)!=0{return false;}at+=n;}
 else if index==7{var k:u64=0;if (*c).element_size==2{k=1;}else if (*c).element_size==4{k=2;}else if (*c).element_size==8{k=3;}if k!=0{if !load_memory(buffer,&at,0,-16){return false;}if !load_immediate(buffer,&at,1,1<<(64-k)){return false;}if indexguard.emit(0,1,(*c).error_block,slice_from_raw_parts(&buffer[at],64),&n)!=0{return false;}at+=n;}}
 else if index==8{var k:u64=0;if (*c).element_size==2{k=1;}else if (*c).element_size==4{k=2;}else if (*c).element_size==8{k=3;}if !load_memory(buffer,&at,1,-16){return false;}if k!=0{var count:usize=0;if shift.emit(0,1,k,slice_from_raw_parts(&buffer[at],32),&count)!=0{return false;}at+=count;}if !load_memory(buffer,&at,0,-8){return false;}if addsub.emit(0,false,0,1,(*c).error_block,slice_from_raw_parts(&buffer[at],64),&n)!=0{return false;}at+=n;}
 else if index==9{var k:u64=0;if (*c).element_size==2{k=1;}else if (*c).element_size==4{k=2;}else if (*c).element_size==8{k=3;}if !load_memory(buffer,&at,1,-24){return false;}if k!=0{var count:usize=0;if shift.emit(0,1,k,slice_from_raw_parts(&buffer[at],32),&count)!=0{return false;}at+=count;}if !load_memory(buffer,&at,0,-8){return false;}if addsub.emit(0,false,0,1,(*c).error_block,slice_from_raw_parts(&buffer[at],64),&n)!=0{return false;}at+=n;if !store_memory(buffer,&at,0,-40){return false;}}
 else if index==10{if !load_memory(buffer,&at,0,-32){return false;}if !load_memory(buffer,&at,1,-24){return false;}if bin.emit(1,0,1,slice_from_raw_parts(&buffer[at],16),&n)!=0{return false;}at+=n;if !store_memory(buffer,&at,0,-48){return false;}}
 else if index==11{if ex.emit(11,48,0,40,48,buffer,&n)!=0{return false;}at=n;}
 else if index==12{if blk.emit(0,(*c).error_block,buffer,&n)!=0{return false;}at=n;}
 else if index==13{if !load_immediate(buffer,&at,0,0){return false;}if !store_memory(buffer,&at,0,-40){return false;}if !load_immediate(buffer,&at,0,MAX){return false;}if !store_memory(buffer,&at,0,-48){return false;}}
 else if index==14{if ex.emit(11,48,0,40,48,buffer,&n)!=0{return false;}at=n;}
 else{return false;}if at>1536{return false;}*length=at;return true;
}}
pub unsafe fn emit(module_name:[]const u8,item_name:[]const u8,element_size:u64,error_block:u64,out:[]u8,written:*usize)u64{unsafe{
let wp=written as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8)||!span(op,out.len)||overlap(wp,8,op,out.len){return INVALID;}
if !name_ok(module_name,out,wp)||!name_ok(item_name,out,wp){return INVALID;}
if (element_size!=1&&element_size!=2&&element_size!=4&&element_size!=8)||error_block==MAX{return INVALID;}
let c=Config{module_name:module_name,item_name:item_name,element_size:element_size,error_block:error_block};
var buffer:[1536]u8=[0;1536];var n:usize=0;var total:usize=0;var p:usize=0;
 while p<15{
  if !piece(p,&c,slice_from_raw_parts(&buffer[0],1536),&n)||n>1536{return INVALID;}
  total+=n;p+=1;
 }
 if total>out.len{return CAPACITY;}
 var at:usize=0;p=0;
 while p<15{
  if !piece(p,&c,slice_from_raw_parts(&buffer[0],1536),&n){return INVALID;}
  var i:usize=0;while i<n{out[at+i]=buffer[i];i+=1;}at+=n;p+=1;
 }
 *written=at;return OK;
}}

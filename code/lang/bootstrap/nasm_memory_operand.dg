// Encode a restricted NASM base+displacement memory operand using CR4
// decimal_integer for the absolute displacement. Descriptors, base id,
// i32 displacement bounds, and need length are settled before any user-out
// write. CR4 encodes into stack scratch first so failures never leave a
// half-written operand. INVALID precedes CAPACITY.
module bootstrap.nasm_memory_operand;
import bootstrap.decimal_integer as dec;
pub const OK:u64=0;pub const INVALID:u64=1;pub const CAPACITY:u64=2;
const MAX:u64=0xffff_ffff_ffff_ffff;
const I32_MIN:i64=-2147483648;
const I32_MAX:i64=2147483647;
fn span(p:u64,n:u64)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:u64,n:u64,b:u64,m:u64)bool{return n!=0&&m!=0&&a<b+m&&b<a+n;}
fn reg_len(base:u64)usize{
 if base<=7{return 3;}
 if base<=9{return 2;}
 return 3;
}
fn write_reg(out:[]u8,at:usize,base:u64)usize{
 if base==0{out[at]=114;out[at+1]=97;out[at+2]=120;return at+3;}
 if base==1{out[at]=114;out[at+1]=99;out[at+2]=120;return at+3;}
 if base==2{out[at]=114;out[at+1]=100;out[at+2]=120;return at+3;}
 if base==3{out[at]=114;out[at+1]=98;out[at+2]=120;return at+3;}
 if base==4{out[at]=114;out[at+1]=115;out[at+2]=112;return at+3;}
 if base==5{out[at]=114;out[at+1]=98;out[at+2]=112;return at+3;}
 if base==6{out[at]=114;out[at+1]=115;out[at+2]=105;return at+3;}
 if base==7{out[at]=114;out[at+1]=100;out[at+2]=105;return at+3;}
 if base==8{out[at]=114;out[at+1]=56;return at+2;}
 if base==9{out[at]=114;out[at+1]=57;return at+2;}
 if base==10{out[at]=114;out[at+1]=49;out[at+2]=48;return at+3;}
 if base==11{out[at]=114;out[at+1]=49;out[at+2]=49;return at+3;}
 if base==12{out[at]=114;out[at+1]=49;out[at+2]=50;return at+3;}
 if base==13{out[at]=114;out[at+1]=49;out[at+2]=51;return at+3;}
 if base==14{out[at]=114;out[at+1]=49;out[at+2]=52;return at+3;}
 out[at]=114;out[at+1]=49;out[at+2]=53;return at+3;
}
fn copy(out:[]u8,at:usize,text:[]const u8)usize{
 var i:usize=0;while i<text.len{out[at+i]=text[i];i+=1;}return at+text.len;
}
pub unsafe fn encode(base:u64,displacement:i64,out:[]u8,written:*usize)u64{unsafe{
 let wp=written as u64;let op=out.ptr as u64;
 if written==null||(wp&7)!=0||!span(wp,8){return INVALID;}
 if !span(op,out.len){return INVALID;}
 if overlap(wp,8,op,out.len){return INVALID;}
 if base>15{return INVALID;}
 if displacement<I32_MIN||displacement>I32_MAX{return INVALID;}
 let nl=reg_len(base);
 if displacement==0{
  let total=nl+2;
  if total>out.len{return CAPACITY;}
  out[0]=91;var at=write_reg(out,1,base);out[at]=93;
  *written=total;return OK;
 }
 var mag:u64=displacement as u64;
 if displacement<0{mag=wrapping_sub(0 as u64,displacement as u64);}
 var db:[20]u8=[0;20];var dw:usize=0;
 let dsl=slice_from_raw_parts(&db[0],20);
 let sd=dec.encode(mag,64,false,dsl,&dw);
 if sd!=OK{return sd;}
 if nl>MAX-5{return INVALID;}let base_len=nl+5;
 if dw>MAX-base_len{return INVALID;}let total=base_len+dw;
 if total>out.len{return CAPACITY;}
 out[0]=91;var at=write_reg(out,1,base);
 out[at]=32;
 if displacement<0{out[at+1]=45;}else{out[at+1]=43;}
 out[at+2]=32;at+=3;
 at=copy(out,at,slice_from_raw_parts(&db[0],dw));
 out[at]=93;
 *written=total;return OK;
}}

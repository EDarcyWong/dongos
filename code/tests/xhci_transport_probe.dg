module xhci_transport_probe;
import usb.xhci_transport as t;
import usb.xhci_controller as c;
import usb.enumerate as e;
import usb.transport as io;
import usb.xhci_ring as ring;
import usb.xhci_trb as wire;
import xhci_controller_probe as controller;
export("xt_init") fn initialize(s:*t.State,h:*c.State)u64 {unsafe {match t.initialize(s,h) {ok=>{return 0;},err(code)=>{return code;},}}}
export("xt_ops") fn ops()u64 {unsafe {return (&t.OPS) as u64;}}
export("xt_port") fn port(s:*t.State,number:u64,out:*io.Port)u64 {unsafe {match t.probe_port(s,number,out) {ok=>{return 0;},err(code)=>{return code;},}}}
export("xt_enum") fn enumerate(s:*e.State,transport:*t.State,setup:*const e.Setup)u64 {unsafe {
    match e.initialize(s,&t.OPS,transport as u64,setup) {ok=>{return 0;},err(code)=>{return code;},}
}}
export("xt_control") fn control(s:*t.State,slot:u64,r:*ring.Producer,request:*const wire.Control,b:*const io.Buffer,end:u64,out:*u64)u64 {unsafe {
    let region=wire.Region {physical:(*s).physical,bytes:(*s).bytes,physical_bits:(*(*s).controller).setup.physical_bits};
    match io.control(&t.OPS,s as u64,slot,r,&region,request,b,end,out) {ok=>{return 0;},err(code)=>{return code;},}
}}

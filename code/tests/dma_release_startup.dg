// Appended to a private copy of boot.memory_startup for release_dma tests.
// The supervisor alias is writable so unshare_precheck's owned/writable
// cross-check sees the same state as production contiguous() frames.
var TEST_TABLES:[64]paging.Table=[paging.Table { entries:[0;512] };64];
export("dma_kernel_setup") fn test_setup(alias:u64,pages:usize)u64 {
    unsafe {
        WORK.space=paging.EMPTY_SPACE;WORK.ready=false;
        match paging.init(&WORK.space,TEST_TABLES[..],0x80_0000,WORK.table_meta[..],48,true) {
            ok=>{},err(code)=>{return code;},
        }
        var i:usize=0;
        while i<pages {
            match paging.map_live(&WORK.space,alias+i as u64*4096,0x20_0000+i as u64*4096,paging.WRITE) {
                ok=>{},err(code)=>{return code;},
            }
            i+=1;
        }
        WORK.ready=true;
    }return 0;
}

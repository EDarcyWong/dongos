unsafe fn control(context:u64,slot:u64,r:*ring.Producer,input:*const wire.ControlPlan,b:*const io.Buffer,end:u64,out:*u64)u64 {unsafe {
    let s=context as *State;if out==null {return 6;}match available(s) {ok=>{},err(e)=>{return 6;},}
    match producer(s,slot,r,1,false) {ok=>{},err(e)=>{return 6;},}
    match buffer(s,slot,b,true) {ok=>{},err(e)=>{return 6;},}

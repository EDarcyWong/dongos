unsafe fn reset_inner(s:*State,port:u64,end:u64,out:*io.Port)!void {unsafe {
    let c=(*s).controller;let offset=(*c).caps.operational+0x400+(port-1)*16;try ended(s,end);
    let before=try read(s,offset);if (before&1)==0 {return error.Removed;}if (before&8)!=0 {return error.IoFailure;}
    // Do not echo PED/RW1CS, PLS/LWS or W1C change fields as ordinary RW bits.
    let neutral=before&0x0e00_c200;let protocol=(*c).caps.protocols[(port-1) as usize];var reset:u64=16;var completed:u64=1<<21;
    if protocol==3 {reset=1<<31;completed=1<<19;}else if protocol!=2 {return error.Unsupported;}
    try write(s,offset,(neutral|reset) as u32);var loops:usize=0;
    while loops<LIMIT {
        let value=try read(s,offset);if (value&1)==0 {return error.Removed;}
        if (value&8)!=0 {return error.IoFailure;}
        if (value&reset)==0&&(value&2)!=0&&(value&0x1e0)==0&&(value&completed)!=0 {
            let speed=(value>>10)&15;if speed==0||speed>4||(protocol==2&&speed==4)||(protocol==3&&speed!=4) {return error.Unsupported;}
            try write(s,offset,((value&0x0e00_c200)|(value&0x00fe_0000)) as u32);
            let after=try read(s,offset);if (after&3)!=3||(after&0x1e0)!=0 {return error.Protocol;}
            *out=io.Port {connected:1,speed:speed};return;

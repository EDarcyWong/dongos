unsafe fn transfer(s:*State,slot:u64,r:*ring.Producer,trbs:[]const wire.Trb,bytes:u64,inward:bool,control:bool,end:u64,out:*u64)!void {unsafe {
    try ended(s,end);let index=try register(s,r,trbs,bytes,inward,control,false,0,null);let p=&(*s).pending[index];var loops:usize=0;

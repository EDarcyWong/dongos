unsafe fn register(s:*State,r:*ring.Producer,trbs:[]const wire.Trb,bytes:u64,inward:bool,control:bool,asynchronous:bool,cookie:u64,pointer:*u8)!usize {unsafe {
    var free:usize=PENDING;var i:usize=0;
    while i<PENDING {
        let p=&(*s).pending[i];if (*p).active==0 {if free==PENDING {free=i;}}
        else if (*p).producer==r||((*(*p).producer).slot==(*r).slot&&(*(*p).producer).endpoint==(*r).endpoint)||(cookie!=0&&(*p).cookie==cookie) {return error.Busy;}i+=1;
    }
    if free==PENDING {return error.Busy;}
    match ring.plan(r,trbs,&(*s).plan) {ok=>{},err(e)=>{return error.Protocol;},}
    let p=&(*s).pending[free];*p=EMPTY_PENDING;(*p).active=1;(*p).producer=r;(*p).generation=(*s).plan.generation;(*p).bytes=bytes;(*p).actual=bytes;(*p).cookie=cookie;(*p).pointer=pointer;
    if inward {(*p).inward=1;}if control {(*p).control=1;}if asynchronous {(*p).asynchronous=1;}
    match ring.publish(r,&(*s).plan,&RING_OPS,s as u64) {ok=>{},err(e)=>{return error.IoFailure;},}

unsafe fn bulk(context:u64,slot:u64,address:u64,r:*ring.Producer,b:*const io.Buffer,end:u64,out:*u64)u64 {unsafe {
    // The same bounded executor serves a single normal bulk/interrupt TD.
    let s=context as *State;if out==null||address>255||(address&0x70)!=0||(address&15)==0 {return 6;}
    match available(s) {ok=>{},err(e)=>{return 6;},}let endpoint=(address&15)*2+(address>>7);
    match producer(s,slot,r,endpoint,false) {ok=>{},err(e)=>{return 6;},}match buffer(s,slot,b,false) {ok=>{},err(e)=>{return 6;},}
    let region=wire.Region {physical:(*s).physical,bytes:(*s).bytes,physical_bits:(*(*s).controller).setup.physical_bits};var encoded=wire.EMPTY;
    match wire.normal(&region,(*b).physical,(*b).bytes,(address&128)!=0,&encoded) {ok=>{},err(e)=>{return 6;},}
    (*s).busy=1;var actual:u64=0;let result=transfer(s,slot,r,slice_from_raw_parts(&encoded,1),(*b).bytes,(address&128)!=0,false,end,&actual);(*s).busy=0;
    match result {ok=>{*out=actual;return 0;},err(e)=>{return fail(s,e);},}
}}
unsafe fn endpoint_state(s:*State,slot:u64,endpoint:u64,dequeue:*u64)!u64 {unsafe {
    let base=try scope(s,slot);let c=(*s).controller;
    if endpoint==0||endpoint>31 {return error.Invalid;}if ring_fence(s as u64,3)!=0 {return error.IoFailure;}
    let pointer=(*s).pointer+(base-(*s).physical+4096+endpoint*(*c).caps.context_bytes) as usize;
    *dequeue=volatile_load((pointer+8) as *const u64);return (volatile_load(pointer as *const u32)&7) as u64;
}}
unsafe fn recover_inner(s:*State,slot:u64,address:u64,r:*ring.Producer,end:u64)!void {unsafe {
    var endpoint:u64=1;if address!=0 {endpoint=(address&15)*2+(address>>7);}
    try producer(s,slot,r,endpoint,true);var pending:usize=PENDING;var i:usize=0;
    while i<PENDING {if (*s).pending[i].active==1&&(*s).pending[i].producer==r {if pending!=PENDING {return error.Protocol;}pending=i;}i+=1;}
    let halted=((*s).stalled[slot as usize]&(1<<endpoint))!=0;
    if halted {
        if pending==PENDING||(*r).fault!=1||(*r).pending!=1||(*s).pending[pending].done!=1||(*s).pending[pending].status!=1 {return error.Protocol;}
    }else if pending!=PENDING||(*r).fault!=0||(*r).pending!=0 {return error.Busy;}
    var dequeue:u64=0;let before=try endpoint_state(s,slot,endpoint,&dequeue);
    var command:u64=14;
    if halted {if before!=2 {return error.Protocol;}}
    else {if before==1 {command=15;}else if before!=3 {return error.Protocol;}}
    var result:u64=0;
    if halted||before==1 {
        let reset=wire.Trb {parameter:0,status:0,control:((command<<10)|(endpoint<<16)|(slot<<24)) as u32};
        try submit(s,&reset,end,&result);if result!=slot||(try endpoint_state(s,slot,endpoint,&dequeue))!=3 {return error.Protocol;}
        if (*s).resets==MAX {return error.Protocol;}(*s).resets+=1;
    }
    if (*r).enqueue>=(*r).entries-1||(*r).cycle>1 {return error.Protocol;}
    let expected=(*r).physical+(*r).enqueue*16|(*r).cycle;
    let set=wire.Trb {parameter:expected,status:0,control:((16<<10)|(endpoint<<16)|(slot<<24)) as u32};
    try submit(s,&set,end,&result);
    if result!=slot||(try endpoint_state(s,slot,endpoint,&dequeue))!=3||dequeue!=expected {return error.Protocol;}
    // Only confirmed hardware Reset/Stop + SetTRDequeue transfers ownership
    // of the abandoned TD back. Software flags are cleared strictly last.
    if (*s).dequeues==MAX {return error.Protocol;}(*s).dequeues+=1;
    (*r).fault=0;(*r).pending=0;(*r).count=0;(*s).stalled[slot as usize]&=~(1<<endpoint);
    if pending!=PENDING {(*s).pending[pending]=EMPTY_PENDING;}
}return;}
unsafe fn recover(context:u64,slot:u64,address:u64,r:*ring.Producer,end:u64)u64 {unsafe {
    let s=context as *State;if address>255||(address&0x70)!=0||(address!=0&&(address&15)==0) {return 6;}
    match available(s) {ok=>{},err(e)=>{return 6;},}
    (*s).busy=1;let result=recover_inner(s,slot,address,r,end);(*s).busy=0;
    match result {ok=>{return 0;},err(e)=>{return fail(s,e);},}
}}
// A posted HID IN has no transaction deadline. It owns its ring and buffer
// until a real completion (or outer controller quarantine), even when idle.
pub unsafe fn post(s:*State,slot:u64,address:u64,r:*ring.Producer,b:*const io.Buffer,cookie:u64)!void {unsafe {
    try available(s);if cookie==0||address<129||address>143||b==null||(*b).bytes==0||(*b).bytes>1024 {return error.Invalid;}
    let endpoint=(address&15)*2+1;try producer(s,slot,r,endpoint,false);try buffer(s,slot,b,false);try healthy(s);
    let region=wire.Region {physical:(*s).physical,bytes:(*s).bytes,physical_bits:(*(*s).controller).setup.physical_bits};var encoded=wire.EMPTY;
    match wire.normal(&region,(*b).physical,(*b).bytes,true,&encoded) {ok=>{},err(e)=>{return error.Invalid;},}
    (*s).busy=1;let result=register(s,r,slice_from_raw_parts(&encoded,1),(*b).bytes,true,false,true,cookie,(*b).pointer);(*s).busy=0;
    match result {ok(value)=>{return;},err(e)=>{if e==0x0819_0008 {return error.Busy;}let ignored=fail(s,e);return error.Protocol;},}
}}
unsafe fn poll_inner(s:*State,budget:u64,out:*Report)!bool {unsafe {
    try healthy(s);var i:u64=0;while i<budget {if !(try pump_one(s)) {break;}i+=1;}
    var chosen:usize=PENDING;var sequence=MAX;var at:usize=0;
    while at<PENDING {let p=&(*s).pending[at];if (*p).active==1&&(*p).asynchronous==1&&(*p).done==1&&(*p).sequence<sequence {chosen=at;sequence=(*p).sequence;}at+=1;}
    if chosen==PENDING {return false;}let p=&(*s).pending[chosen];let r=(*p).producer;
    *out=Report {cookie:(*p).cookie,slot:(*r).slot,address:((*r).endpoint/2)|128,bytes:(*p).bytes,actual:(*p).actual,status:(*p).status,generation:(*p).generation,epoch:(*s).epoch,pointer:(*p).pointer};
    if (*p).status==0 {*p=EMPTY_PENDING;}else {(*p).asynchronous=0;}return true;
}}
pub unsafe fn poll(s:*State,budget:u64,out:*Report)!bool {unsafe {
    try available(s);if budget==0||budget>256||out==null {return error.Invalid;}
    (*s).busy=1;let result=poll_inner(s,budget,out);(*s).busy=0;
    match result {ok(value)=>{return value;},err(e)=>{let ignored=fail(s,e);return result;},}
}}
unsafe fn clock(context:u64,out:*u64)u64 {unsafe {
    let s=context as *State;if out==null {return 6;}match available(s) {ok=>{},err(e)=>{return 6;},}
    match now(s) {ok(value)=>{*out=value;return 0;},err(e)=>{return fail(s,e);},}
}}
unsafe fn barrier(context:u64)u64 {unsafe {
    let s=context as *State;match available(s) {ok=>{},err(e)=>{return 6;},}
    compiler_fence();let value=ring_fence(context,4);compiler_fence();if value!=0 {return fail(s,0x0819_0004);}return 0;
}}
pub unsafe fn initialize(s:*State,c:*hc.State)!void {unsafe {
    if s==null||c==null||(*s).held!=0||(*c).busy!=0||(*c).info.held!=1||(*c).info.ready!=1||(*c).info.fault!=0||(*c).enabled!=1||(*c).ops==null
        ||(*c).setup.bytes!=131072||(*c).setup.pointer==null||(*c).setup.epoch==0||(*c).setup.lease_token==0
        ||(*c).caps.enabled_slots==0||(*c).caps.enabled_slots>8||(*c).caps.ports==0||(*c).caps.ports>32
        ||(*c).command.pending!=0||(*c).command.fault!=0||(*c).events.fault!=0 {return error.Invalid;}
    if (*c).command.physical!=(*c).setup.physical+4096||(*c).command.pointer!=(*c).setup.pointer+4096||(*c).command.epoch!=(*c).setup.epoch
        ||(*c).events.physical!=(*c).setup.physical+8192||(*c).events.pointer!=(*c).setup.pointer+8192||(*c).events.epoch!=(*c).setup.epoch {return error.Invalid;}
    *s=EMPTY;(*s).controller=c;(*s).epoch=(*c).setup.epoch;(*s).token=(*c).setup.lease_token;(*s).physical=(*c).setup.physical;
    (*s).pointer=(*c).setup.pointer;(*s).bytes=(*c).setup.bytes;(*s).last_tsc=(*c).info.last_tsc;(*s).held=1;(*s).ready=1;
    (*c).busy=2;
}return;}
// Discovery does not reset an empty port and does not poison other devices.
// Root service code probes ports first, then gives each connected device one
// distinct retained 32KiB scope before invoking enumerate.initialize.
pub unsafe fn probe_port(s:*State,port:u64,out:*io.Port)!void {unsafe {
    if out==null {return error.Invalid;}try available(s);let c=(*s).controller;
    if port==0||port>(*c).caps.ports {return error.Invalid;}try healthy(s);
    let value=try read(s,(*c).caps.operational+0x400+(port-1)*16);
    if (value&1)==0 {*out=io.Port {connected:0,speed:0};return;}
    if (value&8)!=0 {return error.IoFailure;}let protocol=(*c).caps.protocols[(port-1) as usize];
    if protocol!=2&&protocol!=3 {return error.Unsupported;}
    *out=io.Port {connected:1,speed:(value>>10)&15};
}return;}

        try ended(s,end);loops+=1;
    }
}return error.Timeout;}
unsafe fn reset_port(context:u64,port:u64,end:u64,out:*io.Port)u64 {unsafe {
    let s=context as *State;if out==null {return 6;}match available(s) {ok=>{},err(e)=>{return 6;},}
    let c=(*s).controller;if port==0||port>(*c).caps.ports {return 6;}
    var i:usize=1;while i<9 {if (*s).slots[i]==1&&(*s).ports[i]==port {return 6;}i+=1;}
    (*s).busy=1;let result=reset_inner(s,port,end,out);(*s).busy=0;match result {ok=>{return 0;},err(e)=>{return fail(s,e);},}
}}
unsafe fn canonical(s:*State,input:*const wire.ControlPlan,b:*const io.Buffer)!void {unsafe {
    if input==null||b==null {return error.Invalid;}
    let parameter=(*input).trbs[0].parameter;let request=wire.Control {request_type:parameter&255,request:(parameter>>8)&255,value:(parameter>>16)&65535,
        index:(parameter>>32)&65535,bytes:parameter>>48,data:(*b).physical};
    if request.bytes!=(*b).bytes {return error.Invalid;}
    let region=wire.Region {physical:(*s).physical,bytes:(*s).bytes,physical_bits:(*(*s).controller).setup.physical_bits};var expected=wire.EMPTY_CONTROL;
    match wire.control(&region,&request,&expected) {ok=>{},err(e)=>{return error.Invalid;},}
    if (*input).count!=expected.count {return error.Invalid;}
    var i:usize=0;while i<3 {
        if (*input).trbs[i].parameter!=expected.trbs[i].parameter||(*input).trbs[i].status!=expected.trbs[i].status||(*input).trbs[i].control!=expected.trbs[i].control {return error.Invalid;}i+=1;
    }

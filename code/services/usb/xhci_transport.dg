        let pumped=try pump_one(s);if (*p).done==1 {
            if (*p).status==1 {return error.Stall;}try healthy(s);*out=(*p).actual;*p=EMPTY_PENDING;return;
        }
        try ended(s,end);loops+=1;
    }

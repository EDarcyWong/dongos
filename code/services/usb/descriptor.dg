// Bounded standard USB descriptor parsing for direct-root HID boot and BOT.
module usb.descriptor;
pub error Invalid=0x0812_0001;
pub error Truncated=0x0812_0002;
pub error Unsupported=0x0812_0003;
pub error Capacity=0x0812_0004;
pub const KEYBOARD:u64=1;
pub const MOUSE:u64=2;
pub const STORAGE:u64=3;
pub struct Device {pub usb:u64,pub vendor:u64,pub product:u64,pub release:u64,pub class:u64,pub subclass:u64,pub protocol:u64,pub packet:u64,pub configurations:u64,pub manufacturer:u64,pub product_string:u64,pub serial:u64}
pub struct Binding {pub kind:u64,pub interface:u64,pub in_address:u64,pub out_address:u64,pub in_packet:u64,pub out_packet:u64,pub interval:u64,pub report_bytes:u64}
pub const EMPTY_BINDING:Binding=Binding {kind:0,interface:0,in_address:0,out_address:0,in_packet:0,out_packet:0,interval:0,report_bytes:0};
pub struct Configuration {pub value:u64,pub attributes:u64,pub power_ma:u64,pub count:usize,pub bindings:[8]Binding}
pub const EMPTY_CONFIGURATION:Configuration=Configuration {value:0,attributes:0,power_ma:0,count:0,bindings:[EMPTY_BINDING;8]};
fn u16(data:[]const u8,offset:usize)u64 {return data[offset] as u64|((data[offset+1] as u64)<<8);}
fn speed_valid(speed:u64)!void {if speed<1||speed>4 {return error.Unsupported;}return;}
pub fn packet0(data:[]const u8,speed:u64)!u64 {
    try speed_valid(speed);if data.ptr==null||data.len<8 {return error.Truncated;}
    if data[0]!=18||data[1]!=1 {return error.Invalid;}let packet=data[7] as u64;
    if speed==4 {if packet!=9||u16(data,2)<0x300 {return error.Invalid;}return 512;}
    if u16(data,2)<0x100||u16(data,2)>=0x300 {return error.Unsupported;}
    if speed==2 {if packet!=8 {return error.Invalid;}}
    else if speed==3 {if packet!=64 {return error.Invalid;}}
    else if packet!=8&&packet!=16&&packet!=32&&packet!=64 {return error.Invalid;}
    return packet;
}
pub unsafe fn device(data:[]const u8,speed:u64,out:*Device)!void {unsafe {
    if out==null {return error.Invalid;}let packet=try packet0(data,speed);
    if data.len<18 {return error.Truncated;}if data.len!=18||data[17]==0 {return error.Invalid;}
    if data[4]==9 {return error.Unsupported;}
    *out=Device {usb:u16(data,2),vendor:u16(data,8),product:u16(data,10),release:u16(data,12),class:data[4] as u64,
        subclass:data[5] as u64,protocol:data[6] as u64,packet:packet,configurations:data[17] as u64,
        manufacturer:data[14] as u64,product_string:data[15] as u64,serial:data[16] as u64};
}return;}
pub fn configuration_bytes(data:[]const u8)!usize {
    if data.ptr==null||data.len<9 {return error.Truncated;}
    if data[0]!=9||data[1]!=2||data[4]==0||data[4]>8||data[5]==0||(data[7]&0x9f)!=0x80 {return error.Invalid;}
    let bytes=u16(data,2);if bytes<9 {return error.Invalid;}if bytes>4096 {return error.Capacity;}return bytes as usize;
}
struct Current {pub active:u64,pub expected:u64,pub seen:u64,pub hid:u64,pub companion:u64,pub last_address:u64,pub last_packet:u64,pub last_type:u64,pub binding:Binding}
const EMPTY_CURRENT:Current=Current {active:0,expected:0,seen:0,hid:0,companion:0,last_address:0,last_packet:0,last_type:0,binding:EMPTY_BINDING};
unsafe fn finish(current:*const Current,out:*Configuration)!void {unsafe {
    if (*current).active==0 {return;}if (*current).seen!=(*current).expected||(*current).companion!=0 {return error.Invalid;}
    let b=(*current).binding;if b.kind==0 {return;}
    if b.kind==STORAGE {if (*current).expected!=2||b.in_address==0||b.out_address==0 {return error.Invalid;}}
    else {if (*current).expected!=1||(*current).hid!=1||b.in_address==0||b.out_address!=0||b.report_bytes==0 {return error.Invalid;}}
    if (*out).count==8 {return error.Capacity;}(*out).bindings[(*out).count]=b;(*out).count+=1;
}return;}
fn packet_valid(speed:u64,kind:u64,packet:u64,interval:u64)!void {
    if packet==0||packet>1024 {return error.Invalid;}
    if kind==2 {
        if speed==2 {return error.Unsupported;}if speed==1 {if packet!=8&&packet!=16&&packet!=32&&packet!=64 {return error.Invalid;}}
        else if speed==3 {if packet!=512 {return error.Invalid;}}else if packet!=1024 {return error.Invalid;}
    }else if kind==3 {
        if interval==0||(speed>=3&&interval>16)||(speed==2&&packet>8)||(speed==1&&packet>64) {return error.Invalid;}
    }else {return error.Unsupported;}
    return;
}
pub unsafe fn configuration(data:[]const u8,speed:u64,out:*Configuration)!void {unsafe {
    try speed_valid(speed);if out==null {return error.Invalid;}let total=try configuration_bytes(data);
    if data.len<total {return error.Truncated;}if data.len!=total {return error.Invalid;}
    var result=EMPTY_CONFIGURATION;result.value=data[5] as u64;result.attributes=data[7] as u64;
    result.power_ma=(data[8] as u64)*2;if speed==4 {result.power_ma=(data[8] as u64)*8;}
    var current=EMPTY_CURRENT;var interfaces:[256]u8=[0;256];var interface_count:u64=0;var endpoints:u64=0;var cursor:usize=9;
    while cursor<total {
        if total-cursor<2 {return error.Truncated;}let length=data[cursor] as usize;let kind=data[cursor+1];
        if length<2 {return error.Invalid;}if length>total-cursor {return error.Truncated;}
        if current.companion!=0&&kind!=48 {return error.Invalid;}
        if kind==4 {
            if length!=9 {return error.Invalid;}try finish(&current,&result);current=EMPTY_CURRENT;
            let number=data[cursor+2] as usize;if data[cursor+3]!=0 {return error.Unsupported;}
            if interfaces[number]!=0 {return error.Invalid;}interfaces[number]=1;interface_count+=1;
            if interface_count>8 {return error.Capacity;}current.active=1;current.expected=data[cursor+4] as u64;
            if current.expected>15 {return error.Invalid;}current.binding.interface=number as u64;
            let class=data[cursor+5];let subclass=data[cursor+6];let protocol=data[cursor+7];
            if class==3&&subclass==1&&(protocol==1||protocol==2) {current.binding.kind=protocol as u64;}
            if class==8&&subclass==6&&protocol==80 {current.binding.kind=STORAGE;}
        }else if kind==5 {
            if current.active==0||length!=7||current.seen>=current.expected {return error.Invalid;}
            let address=data[cursor+2] as u64;let attr=data[cursor+3] as u64;let packet=u16(data,cursor+4);let interval=data[cursor+6] as u64;
            if address&0x70!=0||address&15==0||attr&0xfc!=0||packet&0xf800!=0 {return error.Invalid;}
            let index=(address&15)*2+(address>>7);let mask=(1 as u64)<<index;
            if endpoints&mask!=0 {return error.Invalid;}endpoints|=mask;let transfer=attr&3;
            try packet_valid(speed,transfer,packet,interval);current.seen+=1;current.last_address=address;current.last_packet=packet;current.last_type=transfer;
            if speed==4 {current.companion=1;}
            let selected=current.binding.kind;
            if selected!=0 {
                if selected==STORAGE {if transfer!=2 {return error.Invalid;}}
                else {var minimum:u64=3;if selected==KEYBOARD {minimum=8;}if transfer!=3||address&128==0||packet<minimum {return error.Invalid;}}
                if address&128!=0 {if current.binding.in_address!=0 {return error.Invalid;}current.binding.in_address=address;current.binding.in_packet=packet;current.binding.interval=interval;}
                else {if current.binding.out_address!=0 {return error.Invalid;}current.binding.out_address=address;current.binding.out_packet=packet;}
            }
        }else if kind==33 {
            if current.active==0||current.binding.kind==0||current.binding.kind==STORAGE||length!=9||current.hid!=0
                ||data[cursor+5]!=1||data[cursor+6]!=34||u16(data,cursor+7)==0 {return error.Invalid;}
            let bytes=u16(data,cursor+7);if bytes>4096 {return error.Capacity;}current.hid=1;current.binding.report_bytes=bytes;
        }else if kind==48 {
            if speed!=4||current.companion!=1||length!=6 {return error.Invalid;}
            if data[cursor+2]!=0||data[cursor+3]!=0 {return error.Unsupported;}
            let interval_bytes=u16(data,cursor+4);if current.last_type==2 {if interval_bytes!=0 {return error.Invalid;}}
            else if interval_bytes!=current.last_packet {return error.Unsupported;}
            current.companion=0;
        }else if kind==1||kind==2||kind==34||kind==49 {return error.Unsupported;}
        cursor+=length;
    }
    try finish(&current,&result);if interface_count!=data[4] as u64 {return error.Invalid;}
    if result.count==0 {return error.Unsupported;}*out=result;
}return;}
unsafe fn string_code(data:[]const u8,index:usize,value:*u64,used:*usize)!void {unsafe {
    let first=u16(data,index);*used=2;
    if first>=0xd800&&first<=0xdbff {
        if data.len-index<4 {return error.Invalid;}let second=u16(data,index+2);
        if second<0xdc00||second>0xdfff {return error.Invalid;}
        *value=0x10000+(first-0xd800)*1024+second-0xdc00;*used=4;
    }else {if first>=0xdc00&&first<=0xdfff {return error.Invalid;}*value=first;}
}return;}
fn string_shape(data:[]const u8)!void {
    if data.ptr==null||data.len<2 {return error.Truncated;}
    if data.len>254||(data.len&1)!=0||data[0] as usize!=data.len||data[1]!=3 {return error.Invalid;}return;
}
pub fn language(data:[]const u8,preferred:u64)!u64 {
    try string_shape(data);if data.len<4||preferred>65535 {return error.Invalid;}
    var result=u16(data,2);var index:usize=2;
    while index<data.len {let item=u16(data,index);if item==0 {return error.Invalid;}if item==preferred {result=item;}index+=2;}
    return result;
}
pub fn string_utf8(data:[]const u8,out:[]u8)!usize {
    try string_shape(data);var needed:usize=0;var index:usize=2;
    while index<data.len {var value:u64=0;var used:usize=0;unsafe {try string_code(data,index,&value,&used);}
        var count:usize=1;if value>127 {count=2;}if value>2047 {count=3;}if value>65535 {count=4;}
        needed+=count;index+=used;
    }
    if out.len<needed {return error.Capacity;}if needed!=0&&out.ptr==null {return error.Invalid;}
    var input:u64=0;var output:u64=0;unsafe {input=data.ptr as u64;output=out.ptr as u64;}
    if input>0xffff_ffff_ffff_ffff-data.len as u64||output>0xffff_ffff_ffff_ffff-needed as u64 {return error.Invalid;}
    if needed!=0&&input<output+needed as u64&&output<input+data.len as u64 {return error.Invalid;}
    index=2;var target:usize=0;
    while index<data.len {var value:u64=0;var used:usize=0;unsafe {try string_code(data,index,&value,&used);}
        if value<=127 {out[target]=value as u8;target+=1;}
        else if value<=2047 {out[target]=(0xc0|(value>>6)) as u8;out[target+1]=(0x80|(value&63)) as u8;target+=2;}
        else if value<=65535 {out[target]=(0xe0|(value>>12)) as u8;out[target+1]=(0x80|((value>>6)&63)) as u8;out[target+2]=(0x80|(value&63)) as u8;target+=3;}
        else {out[target]=(0xf0|(value>>18)) as u8;out[target+1]=(0x80|((value>>12)&63)) as u8;out[target+2]=(0x80|((value>>6)&63)) as u8;out[target+3]=(0x80|(value&63)) as u8;target+=4;}
        index+=used;
    }
    return target;
}

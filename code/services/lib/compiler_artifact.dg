// One-shot commit using a caller-owned writable grant. No authority acquisition.
module lib.compiler_artifact;
import lib.files as files;
import bootstrap.guest_artifact_commit as commit;
pub const PROTOCOL:u64=0x0513_0002;
pub const MAX_ARTIFACT:usize=2097152;
const MAX:u64=0xffff_ffff_ffff_ffff;
struct Context{session:*files.Session,token:u64,code:u64}
struct Region{p:u64,n:usize}
fn span(p:u64,n:usize)bool{return n==0||(p!=0&&n<=MAX-p);}
fn overlap(a:*const Region,b:*const Region)bool{unsafe{return (*a).n!=0&&(*b).n!=0&&(*a).p<(*b).p+(*b).n&&(*b).p<(*a).p+(*a).n;}}
fn write_at(raw:u64,offset:u64,src:*const u8,length:u64)i64{unsafe{
 let c=raw as *Context;var count=length;if count>61440{count=61440;}
 let status=files.write((*c).session,(*c).token,offset,slice_from_raw_parts(src,count as usize));
 if status!=0{(*c).code=status;return -1;}
 let moved=(*(*c).session).response.words[1];
 if moved>count{(*c).code=PROTOCOL;return -1;}
 return moved as i64;
}}
fn flush(raw:u64)i64{unsafe{
 let c=raw as *Context;let status=files.sync((*c).session,(*c).token);
 if status!=0{(*c).code=status;return -1;}return 0;
}}
// A fresh one-shot transaction; never automatically retry this function after
// an error. State reports confirmed bytes; external writes cannot be undone.
pub unsafe fn store(s:*files.Session,token:u64,src:[]const u8,st:*commit.State,io_error:*u64)u64{unsafe{
 if s==null||(s as u64&7)!=0||!span(s as u64,sizeof(files.Session))
  ||st==null||(st as u64&7)!=0||io_error==null||(io_error as u64&7)!=0
  ||token==0||src.len>MAX_ARTIFACT{return commit.COMMIT_INVALID;}
 let channel=(*s).channel;
 if (*s).endpoint==0||channel==0||(channel&4095)!=0{return commit.COMMIT_INVALID;}
 let regions=[Region{p:s as u64,n:sizeof(files.Session)},Region{p:channel,n:65536},
  Region{p:src.ptr as u64,n:src.len},Region{p:st as u64,n:sizeof(commit.State)},Region{p:io_error as u64,n:8}];
 var i:usize=0;while i<regions.len{
  if !span(regions[i].p,regions[i].n){return commit.COMMIT_INVALID;}
  var j:usize=0;while j<i{if overlap(&regions[i],&regions[j]){return commit.COMMIT_INVALID;}j+=1;}i+=1;
 }
 var context=Context{session:s,token:token,code:0};
 let initialized=commit.init(st,src.len as u64);if initialized!=commit.COMMIT_STEP{return initialized;}
 let status=commit.run(st,&context as u64,src,write_at,flush);
 *io_error=context.code;return status;
}}

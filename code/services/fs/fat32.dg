unsafe fn reserve_slots(v:*Volume,w:*Scratch,directory:u64,slots:u64,extra:u64)!u64{unsafe{
    let count=try chain_length(v,w,directory);let per=(*v).spc*16;var capacity=count*per;if capacity>4096||slots==0||slots>21{return error.errors.Unsupported;}
    var at:u64=0;var run:u64=0;var start:u64=0;var ended:bool=false;var found:bool=false;var first_end:u64=4096;var item=EMPTY_ENTRY;
    while at<capacity{if !ended{let exists=try slot_in(v,w,directory,at,&item);if !exists{return error.errors.Corrupt;}if item.name[0]==0{ended=true;first_end=at;}}
        if ended||item.name[0]==0xe5{if run==0{start=at;}run+=1;if run==slots{found=true;break;}}else{run=0;}at+=1;
    }
    if !found{if run==0{start=capacity;}ended=true;if first_end==4096{first_end=capacity;}}
    var need=start+slots;if ended{need+=1;}if need>4096{return error.errors.NoSpace;}
    var growth:u64=0;if need>capacity{growth=(need-capacity+per-1)/per;}try enough(v,w,growth+extra);try begin_write(v,w);
    var last=try nth(v,w,directory,count-1);var n:u64=0;while n<growth{let fresh=try allocate(v,w);try durable(v);try fat_put(v,w,last,fresh);last=fresh;n+=1;}
    try durable(v);
    if ended{let exists=try slot_in(v,w,directory,start+slots,&item);if !exists{return error.errors.Corrupt;}(*w).sector[item.offset as usize]=0;try write_sector(v,item.sector,&(*w).sector[0]);try durable(v);
        // Bytes after an old end marker are unspecified. Keep that marker in
        // place while making all newly exposed intermediate slots non-live.
        var clear=first_end+1;while clear<start+slots{let present=try slot_in(v,w,directory,clear,&item);if !present{return error.errors.Corrupt;}(*w).sector[item.offset as usize]=0xe5;try write_sector(v,item.sector,&(*w).sector[0]);clear+=1;}try durable(v);
    }
    return start;
}}
unsafe fn initialize_directory(v:*Volume,w:*Scratch,directory:u64,parent:u64)!void{unsafe{
    let lba=try cluster_sector(v,directory);var i:usize=0;while i<512{(*w).sector[i]=0;i+=1;}
    i=0;while i<11{(*w).sector[i]=32;(*w).sector[32+i]=32;i+=1;}(*w).sector[0]=46;(*w).sector[32]=46;(*w).sector[33]=46;(*w).sector[11]=16;(*w).sector[43]=16;
    put16(&(*w).sector[0],20,directory>>16);put16(&(*w).sector[0],26,directory);
    var up=parent;if parent==(*v).root{up=0;}put16(&(*w).sector[0],52,up>>16);put16(&(*w).sector[0],58,up);
    try write_sector(v,lba,&(*w).sector[0]);try durable(v);
}return;}
pub unsafe fn path_create(v:*Volume,w:*Scratch,x:*Workspace,input:[]const u8)!void{unsafe{
    try enter(v,true);let result=path_create_inner(v,w,x,input,false);return path_finish(v,result);
}}
pub unsafe fn path_mkdir(v:*Volume,w:*Scratch,x:*Workspace,input:[]const u8)!void{unsafe{
    try enter(v,true);let result=path_create_inner(v,w,x,input,true);return path_finish(v,result);
}}
unsafe fn path_create_inner(v:*Volume,w:*Scratch,x:*Workspace,input:[]const u8,directory:bool)!void{unsafe{
    var parent=EMPTY_ENTRY;var start:usize=0;var end:usize=0;try leaf_parent(v,w,x,input,&parent,&start,&end);let name=input[start..end];
    try empty_lookup(v,w,x,parent.cluster,name);let long=try choose_alias(v,w,x,parent.cluster,name);
    if (*v).read_only!=0{return error.errors.ReadOnly;}prepare_short(w,directory,0);
    if long{try lfn.encode(name,(*w).entry[0..32],&(*w).group);}else{(*w).group.count=1;var i:usize=0;while i<32{(*w).group.bytes[i]=(*w).entry[i];i+=1;}}
    var extra:u64=0;if directory{extra=1;}let first=try reserve_slots(v,w,parent.cluster,(*w).group.count as u64,extra);
    if directory{let cluster=try allocate(v,w);try initialize_directory(v,w,cluster,parent.cluster);let off=((*w).group.count-1)*32;put16(&(*w).group.bytes[0],off+20,cluster>>16);put16(&(*w).group.bytes[0],off+26,cluster);}
    var n:usize=0;while n+1<(*w).group.count{try write_raw(v,w,parent.cluster,first+n as u64,&(*w).group.bytes[n*32]);n+=1;}
    // LFN slots cannot become reachable through a new short entry until their
    // complete bytes and every allocation/link are acknowledged durable.
    try durable(v);try write_raw(v,w,parent.cluster,first+n as u64,&(*w).group.bytes[n*32]);try durable(v);
}return;}
pub unsafe fn path_remove(v:*Volume,w:*Scratch,x:*Workspace,input:[]const u8)!void{unsafe{
    try enter(v,true);let result=path_remove_inner(v,w,x,input);return path_finish(v,result);
}}
unsafe fn path_remove_inner(v:*Volume,w:*Scratch,x:*Workspace,input:[]const u8)!void{unsafe{
    var parent=EMPTY_ENTRY;var start:usize=0;var end:usize=0;try leaf_parent(v,w,x,input,&parent,&start,&end);
    try find_path(v,w,x,parent.cluster,input[start..end],&(*x).selected);let item=(*x).selected.entry;let first=(*x).selected.first_index;let group=(*x).selected.group_count;
    if (item.attributes&1)!=0{return error.errors.ReadOnly;}if (item.attributes&16)!=0{var raw:u64=0;while try scan(v,w,item.cluster,&raw,&(*x).candidate){if dot_kind(&(*x).candidate.entry)==0{return error.errors.Unsupported;}}}
    if (*v).read_only!=0{return error.errors.ReadOnly;}try begin_write(v,w);var n:u64=0;var slot_item=EMPTY_ENTRY;
    // First remove the short entry, then the now-unreachable LFN slots. A stop
    // can leave orphan names on a dirty volume, never a live freed cluster.
    let exists=try slot_in(v,w,parent.cluster,first+group-1,&slot_item);if !exists{return error.errors.Corrupt;}(*w).sector[slot_item.offset as usize]=0xe5;try write_sector(v,slot_item.sector,&(*w).sector[0]);try durable(v);
    while n+1<group{let present=try slot_in(v,w,parent.cluster,first+n,&slot_item);if !present{return error.errors.Corrupt;}(*w).sector[slot_item.offset as usize]=0xe5;try write_sector(v,slot_item.sector,&(*w).sector[0]);n+=1;}
    try durable(v);try free_chain(v,w,item.cluster);
}return;}

unsafe fn root_namespace_free(v:*Volume,w:*Scratch,name:[]const u8)!void{unsafe{
    var raw:u64=0;var record=EMPTY_PATH_ENTRY;while try scan(v,w,(*v).root,&raw,&record){if alias_matches(&record.entry,name)||(record.has_lfn==1&&same(record.name[0..record.name_length],name)){return error.errors.Exists;}}
    if (*v).read_only!=0{return error.errors.ReadOnly;}
}return;}

unsafe fn checked_path(input:[]const u8,out:*path.Path)!void{unsafe{
    let canonical=path.normalize("/",input,out);match canonical{ok=>{return;},err(e)=>{return error.errors.InvalidArgument;},}
}}

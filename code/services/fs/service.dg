// FAT runs in its own CPL3 address space. Device callbacks cross a separate
// endpoint/shared channel; no filesystem code executes in the microkernel.
module fs.service;
import lib.sys as sys;
import fs.protocol as protocol;
import fs.fat32 as fat;
import fs.mount_cache as mount_cache;
import fs.handles as grants;
pub error BlockIo = 0x0508_0001;
pub error InvalidBoot = 0x0508_0002;
pub error BadRequest = 0x0508_0003;
pub error Stale = 0x0508_0004;
const BLOCK_CHANNEL: u64 = 0x5100_0000;
var BOOT: *const sys.Boot = null;
var VOLUME: fat.Volume = fat.EMPTY_VOLUME;
var SCRATCH: fat.Scratch = fat.EMPTY_SCRATCH;
var DEVICE: fat.Device = fat.Device { context: 0, capacity_sectors: 0, max_transfer_sectors: 128,
    read: read_blocks, write: write_blocks, flush: flush_blocks };
// This private adapter exists only during the serialized mount. No page-table,
// device capability, controller state or auditor contract is changed.
var MOUNT_CACHE:mount_cache.State=mount_cache.EMPTY;
var MOUNT_DEVICE:fat.Device=fat.Device{context:0,capacity_sectors:0,max_transfer_sectors:128,
    read:read_blocks,write:write_blocks,flush:flush_blocks};
var BLOCK_REQUEST: sys.Message = sys.EMPTY_MESSAGE;
var BLOCK_RESPONSE: sys.Message = sys.EMPTY_MESSAGE;
var REQUEST: sys.Message = sys.EMPTY_MESSAGE;
var RESPONSE: sys.Message = sys.EMPTY_MESSAGE;
var ENTRY: fat.DirEntry = fat.EMPTY_ENTRY;
var PATH_ENTRY:fat.PathEntry=fat.EMPTY_PATH_ENTRY;
var WORK:fat.Workspace=fat.EMPTY_WORKSPACE;
var PATH:[4096]u8=[0;4096];
var CHANNEL:u64=0;
var GENERATION:u64=1;
var GRANTS:grants.Table=grants.EMPTY_TABLE;
var OWNER:u64=0;
var ALLOWED:u64=0;
var GUI_ROLE:u64=0;
var GUI_SCOPE:u64=0;
var CLIENTS:[17]u64=[0;17];
var TICKET: u64 = 0;
var BLOCK_FAILURE_LOGGED:bool=false;

unsafe fn block_failure(label:[]const u8,value:u64)void {unsafe {
    var line:[64]u8=[0;64];let digits="0123456789abcdef";
    if label.len>46 {return;}var i:usize=0;
    while i<label.len {line[i]=label[i];i+=1;}i=0;
    while i<16 {line[label.len+i]=digits[((value>>((15-i)*4))&15) as usize];i+=1;}
    line[label.len+16]=13;line[label.len+17]=10;
    let logged=sys.log(slice_from_raw_parts(&line[0],label.len+18));
}return;}

// Exit notifications come only from the kernel, not an IPC message. A late
// notification for an older PID incarnation cannot revoke its new process.
unsafe fn departed()!void {unsafe {
    var count:usize=0;while count<16 {
        let event=sys.svc_call(0x2c,(*BOOT).endpoint,0,0,0,0,0);
        if event==0 {return;}
        let caller=event>>32;let incarnation=event&0xffff_ffff;
        if caller==0||incarnation==0 {return error.BadRequest;}
        if caller<17 {
            let old=CLIENTS[caller as usize];
            if old!=0&&(old&0xffff_ffff)<=incarnation {
                grants.revoke_owner(&GRANTS,old);CLIENTS[caller as usize]=0;
            }
        }
        count+=1;
    }
}return;}

unsafe fn block_call(op: u64,lba: u64,count: usize) u64 {
    unsafe {
        BLOCK_REQUEST = sys.EMPTY_MESSAGE;
        BLOCK_REQUEST.words[0] = op; BLOCK_REQUEST.words[1] = lba; BLOCK_REQUEST.words[2] = count as u64;
        let status = sys.call((*BOOT).block,&BLOCK_REQUEST,&BLOCK_RESPONSE);
        if status != 0 {
            if !BLOCK_FAILURE_LOGGED {BLOCK_FAILURE_LOGGED=true;block_failure("fs_block_call_status=0x",status);block_failure("fs_block_lba=0x",lba);}
            return status;
        }
        if BLOCK_RESPONSE.words[0]!=0&&!BLOCK_FAILURE_LOGGED {
            BLOCK_FAILURE_LOGGED=true;block_failure("fs_block_reply_status=0x",BLOCK_RESPONSE.words[0]);block_failure("fs_block_lba=0x",lba);
        }
        return BLOCK_RESPONSE.words[0];
    }
}
unsafe fn read_blocks(context: u64,lba: u64,count: usize,out: *u8) u64 {
    unsafe {
        if count == 0 || count > 128 { return 1; }
        let status = block_call(protocol.READ,lba,count);
        if status != 0 { return status; }
        var i: usize = 0;
        while i < count * 512 { *(out + i) = *((BLOCK_CHANNEL as *const u8) + i); i += 1; }
    }
    return 0;
}
unsafe fn write_blocks(context: u64,lba: u64,count: usize,input: *const u8) u64 {
    unsafe {
        if count == 0 || count > 128 { return 1; }
        var i: usize = 0;
        while i < count * 512 { *((BLOCK_CHANNEL as *u8) + i) = *(input + i); i += 1; }
        return block_call(protocol.WRITE,lba,count);
    }
}
unsafe fn flush_blocks(context: u64) u64 { unsafe { return block_call(protocol.FLUSH,0,0); } }

unsafe fn setup() !void {
    unsafe {
        BOOT = sys.boot();
        if BOOT == null || (*BOOT).version != 1 || (*BOOT).channel_address != 0x5000_0000
            || (*BOOT).channel_bytes != protocol.CHANNEL_BYTES { return error.InvalidBoot; }
        if block_call(protocol.READY,0,0) != 0 { return error.BlockIo; }
        DEVICE.capacity_sectors = BLOCK_RESPONSE.words[2];
        let device_read_only=BLOCK_RESPONSE.words[3];
        try mount_cache.begin(&MOUNT_CACHE,&DEVICE,&MOUNT_DEVICE);
        let mounted=fat.mount(&VOLUME,&MOUNT_DEVICE,&SCRATCH);
        mount_cache.finish(&MOUNT_CACHE);
        match mounted{ok=>{VOLUME.device=&DEVICE;},err(code)=>{return mounted;},}
        if device_read_only != 0 { VOLUME.read_only = 1; }
    }
    return;
}

// The only authority for a channel is the kernel's accepted caller/ticket.
// Copy the raw path before any output or nested block call can reuse buffers.
unsafe fn select_channel() !void {unsafe {
    let caller=sys.peer((*BOOT).endpoint,TICKET);
    if caller==1 {CHANNEL=0x5000_0000;}
    else if caller==4 {CHANNEL=0x5200_0000;}
    else if caller>=8&&caller<=16 {CHANNEL=0x5300_0000+(caller-8)*0x10000;}
    else {return error.BadRequest;}
    let session=sys.svc_call(0x2a,(*BOOT).endpoint,TICKET,0,0,0,0);
    let epoch=session>>32;let incarnation=session&0xffff_ffff;
    if epoch==0||incarnation==0 {return error.BadRequest;}
    if GRANTS.ready!=0&&GRANTS.epoch!=epoch {GRANTS=grants.EMPTY_TABLE;}
    if GRANTS.ready==0 {try grants.init(&GRANTS,epoch);}
    OWNER=(caller<<32)|incarnation;
    if CLIENTS[caller as usize]!=0&&CLIENTS[caller as usize]!=OWNER {
        grants.revoke_owner(&GRANTS,CLIENTS[caller as usize]);
    }
    CLIENTS[caller as usize]=OWNER;
    ALLOWED=sys.svc_call(0x2b,(*BOOT).endpoint,TICKET,0,0,0,0);
    if (ALLOWED&~grants.ALL)!=0 {return error.BadRequest;}
    let policy=sys.svc_call(0x2d,(*BOOT).endpoint,TICKET,0,0,0,0);
    GUI_ROLE=policy&0xffff_ffff;GUI_SCOPE=policy>>32;
    if !((GUI_ROLE==0||GUI_ROLE==1)&&GUI_SCOPE==0)
        &&!((GUI_ROLE==2||GUI_ROLE==3)&&GUI_SCOPE==1)&&!(GUI_ROLE==4&&GUI_SCOPE==2) {return error.BadRequest;}
    return;
}}
unsafe fn record(next:u64)void {unsafe {
    let out=(CHANNEL+protocol.PATH_DATA) as *u8;
    let bytes=protocol.PATH_RECORD_PREFIX+PATH_ENTRY.name_length as u64;
    var i:usize=0;while i<80 {*(out+i)=0;i+=1;}
    write_unaligned(out as *u64,bytes);
    write_unaligned((out+8) as *u64,PATH_ENTRY.name_length as u64);
    write_unaligned((out+16) as *u64,PATH_ENTRY.entry.attributes as u64);
    write_unaligned((out+24) as *u64,PATH_ENTRY.entry.size);
    write_unaligned((out+32) as *u64,PATH_ENTRY.has_lfn);
    var encoding:u64=1;if PATH_ENTRY.name_length==0 {encoding=2;}
    write_unaligned((out+40) as *u64,encoding);
    write_unaligned((out+48) as *u64,next);
    write_unaligned((out+56) as *u64,GENERATION);
    i=0;while i<11 {*(out+64+i)=PATH_ENTRY.entry.name[i];i+=1;}
    i=0;while i<PATH_ENTRY.name_length {*(out+80+i)=PATH_ENTRY.name[i];i+=1;}
    RESPONSE.words[1]=1;RESPONSE.words[2]=PATH_ENTRY.entry.size;
    RESPONSE.words[3]=PATH_ENTRY.entry.attributes as u64;RESPONSE.words[4]=bytes;
    RESPONSE.words[7]=next;
}return;}
fn mutating(op:u64)bool {
    return op==protocol.PATH_WRITE||op==protocol.PATH_CREATE||op==protocol.PATH_MKDIR
        ||op==protocol.PATH_REMOVE||op==protocol.PATH_TRUNCATE||op==protocol.PATH_APPEND;
}
unsafe fn path_operate()!void {unsafe {
    if ALLOWED!=grants.ALL {return error.grants.Denied;}
    let op=REQUEST.words[0];let offset=REQUEST.words[1];let count=REQUEST.words[2];
    let length=REQUEST.words[3];let channel=CHANNEL as *u8;
    if op<protocol.PATH_STAT||op>protocol.PATH_APPEND||REQUEST.words[5]!=protocol.VERSION
        ||REQUEST.words[7]!=0||REQUEST.words[4]!=protocol.PATH_DATA
        ||length==0||length>protocol.PATH_BYTES||count>protocol.PATH_PAYLOAD
        ||*channel!=47 {return error.BadRequest;}
    if op==protocol.PATH_LIST {
        if offset==0 {if REQUEST.words[6]!=0 {return error.Stale;}}
        else {if REQUEST.words[6]!=GENERATION {return error.Stale;}}
        if offset>=4096 {return error.BadRequest;}
    }else {if REQUEST.words[6]!=0 {return error.BadRequest;}}
    if op!=protocol.PATH_READ&&op!=protocol.PATH_WRITE&&op!=protocol.PATH_APPEND&&count!=0 {return error.BadRequest;}
    if op!=protocol.PATH_READ&&op!=protocol.PATH_WRITE&&op!=protocol.PATH_TRUNCATE&&op!=protocol.PATH_LIST&&offset!=0 {return error.BadRequest;}
    if mutating(op)&&GENERATION==0xffff_ffff_ffff_ffff {return error.Stale;}
    var i:usize=0;while i<length as usize {PATH[i]=*(channel+i);i+=1;}
    let name=PATH[0..length as usize];
    if op==protocol.PATH_STAT {try fat.path_stat(&VOLUME,&SCRATCH,&WORK,name,&PATH_ENTRY);record(0);return;}
    if op==protocol.PATH_LIST {if try fat.path_list(&VOLUME,&SCRATCH,&WORK,name,offset,&PATH_ENTRY) {record(offset+1);}return;}
    if op==protocol.PATH_READ {
        let bytes=try fat.path_read(&VOLUME,&SCRATCH,&WORK,name,offset,slice_from_raw_parts(channel+4096,count as usize));
        RESPONSE.words[1]=bytes as u64;return;
    }
    if op==protocol.PATH_WRITE||op==protocol.PATH_APPEND {
        var position=offset;
        if op==protocol.PATH_APPEND {try fat.path_stat(&VOLUME,&SCRATCH,&WORK,name,&PATH_ENTRY);position=PATH_ENTRY.entry.size;}
        let bytes=try fat.path_write(&VOLUME,&SCRATCH,&WORK,name,position,slice_from_raw_parts((channel+4096) as *const u8,count as usize));
        RESPONSE.words[1]=bytes as u64;
    }else if op==protocol.PATH_CREATE {try fat.path_create(&VOLUME,&SCRATCH,&WORK,name);}
    else if op==protocol.PATH_MKDIR {try fat.path_mkdir(&VOLUME,&SCRATCH,&WORK,name);}
    else if op==protocol.PATH_REMOVE {try fat.path_remove(&VOLUME,&SCRATCH,&WORK,name);}
    else if op==protocol.PATH_TRUNCATE {try fat.path_truncate(&VOLUME,&SCRATCH,&WORK,name,offset);}
    if op==protocol.PATH_CREATE||op==protocol.PATH_MKDIR||op==protocol.PATH_REMOVE {grants.namespace_changed(&GRANTS);}
    GENERATION+=1;
}return;}
unsafe fn legacy_operate()!void {unsafe {
    if ALLOWED!=grants.ALL {return error.grants.Denied;}
    let op=REQUEST.words[0];let offset=REQUEST.words[1];let count=REQUEST.words[2];
    let length=REQUEST.words[3];let data=REQUEST.words[4];let channel=CHANNEL as *u8;
    if REQUEST.words[5]!=0||REQUEST.words[6]!=0||REQUEST.words[7]!=0 {return error.BadRequest;}
    if op==protocol.READY {RESPONSE.words[2]=VOLUME.total;RESPONSE.words[3]=VOLUME.read_only;return;}
    if op==protocol.FLUSH {try fat.flush(&VOLUME,&SCRATCH);return;}
    if op==protocol.LIST {
        if try fat.list(&VOLUME,&SCRATCH,offset,&ENTRY) {
            var i:usize=0;while i<11 {*(channel+i)=ENTRY.name[i];i+=1;}
            RESPONSE.words[1]=1;RESPONSE.words[2]=ENTRY.size;RESPONSE.words[3]=ENTRY.attributes as u64;
        }return;
    }
    if op!=protocol.READ&&op!=protocol.WRITE&&op!=protocol.CREATE&&op!=protocol.REMOVE&&op!=protocol.TRUNCATE {return error.BadRequest;}
    if length==0||length>16||data<16||data>protocol.CHANNEL_BYTES||count>protocol.CHANNEL_BYTES-data {return error.BadRequest;}
    // Legacy names remain single-component short aliases. Unified lookup and
    // mutations still account for the entire LFN group and directory namespace.
    PATH[0]=47;var i:usize=0;while i<length as usize {
        let b=*(channel+i);if b==47||b==92||b==0 {return error.BadRequest;}
        PATH[i+1]=b;i+=1;
    }
    let name=PATH[0..length as usize+1];
    if op==protocol.READ {
        RESPONSE.words[1]=(try fat.path_read(&VOLUME,&SCRATCH,&WORK,name,offset,slice_from_raw_parts(channel+data as usize,count as usize))) as u64;return;
    }
    if GENERATION==0xffff_ffff_ffff_ffff {return error.Stale;}
    if op==protocol.WRITE {
        RESPONSE.words[1]=(try fat.path_write(&VOLUME,&SCRATCH,&WORK,name,offset,slice_from_raw_parts((channel+data as usize) as *const u8,count as usize))) as u64;
    }else if op==protocol.CREATE {try fat.path_create(&VOLUME,&SCRATCH,&WORK,name);}
    else if op==protocol.REMOVE {try fat.path_remove(&VOLUME,&SCRATCH,&WORK,name);}
    else {try fat.path_truncate(&VOLUME,&SCRATCH,&WORK,name,offset);}
    if op==protocol.CREATE||op==protocol.REMOVE {grants.namespace_changed(&GRANTS);}
    GENERATION+=1;
}return;}
// Copy an authorized object's stable path and verify its disk identity before
// using a path API. Namespace mutations revoke every such grant, so a removed
// and recreated slot can never silently become the old handle's new target.
unsafe fn grant_path(slot:usize)!usize {unsafe {
    let item=&GRANTS.entries[slot];var i:usize=0;
    try fat.path_stat(&VOLUME,&SCRATCH,&WORK,(*item).path[0..(*item).length],&PATH_ENTRY);
    if PATH_ENTRY.entry.sector!=(*item).sector||PATH_ENTRY.entry.offset!=(*item).offset {return error.grants.InvalidHandle;}
    if (*item).kind!=grants.ROOT {
        i=0;while i<11 {if PATH_ENTRY.entry.name[i]!=(*item).alias[i] {return error.grants.InvalidHandle;}i+=1;}
    }
    return (*item).length;
}}
unsafe fn child_path(slot:usize,length:usize)!usize {unsafe {
    let item=&GRANTS.entries[slot];let raw=CHANNEL as *const u8;
    if (*item).kind==grants.FILE {return error.grants.Denied;}
    var used:usize=0;
    if (*item).kind==grants.ROOT&&*raw==47 {
        while used<length {PATH[used]=*(raw+used);used+=1;}return used;
    }
    if *raw==47 {return error.grants.Denied;}
    // A delegated directory never grants authority to its parent. Check the
    // original component stream before lexical folding or filesystem I/O.
    var at:usize=0;while at<length {
        let start=at;while at<length&&*(raw+at)!=47 {at+=1;}
        if at-start==2&&*(raw+start)==46&&*(raw+start+1)==46 {return error.grants.Denied;}
        if at<length {at+=1;}
    }
    used=(*item).length;var slash:usize=1;if used==1 {slash=0;}
    if used+slash>4096||length>4096-used-slash {return error.BadRequest;}
    var i:usize=0;while i<used {PATH[i]=(*item).path[i];i+=1;}
    if slash!=0 {PATH[used]=47;used+=1;}
    i=0;while i<length {PATH[used+i]=*(raw+i);i+=1;}
    return used+length;
}}
// Scope comes from kernel-authenticated configuration, never path input.
unsafe fn same_scope(item:*const grants.Entry,name:[]const u8,prefix:bool)bool {unsafe {
    if (*item).length<name.len||(!prefix&&(*item).length!=name.len) {return false;}
    var i:usize=0;while i<name.len {
        var a=(*item).path[i];var b=name[i];if a>=97&&a<=122 {a-=32;}if b>=97&&b<=122 {b-=32;}
        if a!=b {return false;}i+=1;
    }
    if prefix&&(*item).length>name.len&&(*item).path[name.len]!=47 {return false;}return true;
}}
unsafe fn scoped_mask(slot:usize)u64 {unsafe {
    let item=&GRANTS.entries[slot];
    if (ALLOWED&395)!=395||(*item).kind==grants.ROOT {return ALLOWED;}
    if GUI_SCOPE==1&&(GUI_ROLE==2||GUI_ROLE==3)&&same_scope(item,"/Documents",true) {
        if GUI_ROLE==2 {return ALLOWED|grants.ALL;}return ALLOWED|447;
    }
    if GUI_SCOPE==2&&GUI_ROLE==4&&(*item).kind==grants.FILE
        &&(same_scope(item,"/DESK0.CFG",false)||same_scope(item,"/DESK1.CFG",false)) {return ALLOWED|39;}
    return ALLOWED;
}}
unsafe fn provision_scope(name:[]const u8,directory:bool)!void {unsafe {
    let result=fat.path_stat(&VOLUME,&SCRATCH,&WORK,name,&PATH_ENTRY);var missing:bool=false;
    match result {ok=>{},err(e)=>{if e!=0x0504_0006 {return result;}missing=true;},}
    if missing {
        if GENERATION==0xffff_ffff_ffff_ffff {return error.Stale;}
        if directory {try fat.path_mkdir(&VOLUME,&SCRATCH,&WORK,name);}else {try fat.path_create(&VOLUME,&SCRATCH,&WORK,name);}
        grants.namespace_changed(&GRANTS);GENERATION+=1;
        try fat.path_stat(&VOLUME,&SCRATCH,&WORK,name,&PATH_ENTRY);
    }
    if directory&&((PATH_ENTRY.entry.attributes&16)==0) {return error.grants.Denied;}
    if !directory&&((PATH_ENTRY.entry.attributes&16)!=0) {return error.grants.Denied;}
}return;}
unsafe fn fixed_scope(selector:u64)!void {unsafe {
    if selector==0||selector>3 {return error.BadRequest;}if (ALLOWED&395)!=395 {return error.grants.Denied;}
    var name:[]const u8="/Documents";var directory:bool=true;var rights:u64=447;
    if selector==1 {
        if GUI_SCOPE!=1||(GUI_ROLE!=2&&GUI_ROLE!=3) {return error.grants.Denied;}
        if GUI_ROLE==2 {rights=grants.ALL;}
    }else {
        if GUI_SCOPE!=2||GUI_ROLE!=4 {return error.grants.Denied;}
        directory=false;rights=39;name="/DESK0.CFG";if selector==3 {name="/DESK1.CFG";}
    }
    try provision_scope(name,directory);var kind=grants.FILE;if directory {kind=grants.DIRECTORY;}
    RESPONSE.words[1]=try grants.install(&GRANTS,OWNER,kind,rights,WORK.canonical.bytes[0..WORK.canonical.length],
        PATH_ENTRY.entry.sector,PATH_ENTRY.entry.offset,PATH_ENTRY.entry.name[0..11]);
    RESPONSE.words[2]=rights;RESPONSE.words[3]=kind;
}return;}
unsafe fn handle_operate()!void {unsafe {
    let op=REQUEST.words[0];let token=REQUEST.words[1];let offset=REQUEST.words[2];
    let count=REQUEST.words[3];let rights=REQUEST.words[4];let length=REQUEST.words[5];
    if op<protocol.H_ROOT||op>protocol.H_SCOPE_SYNC||REQUEST.words[6]!=protocol.HANDLE_VERSION
        ||REQUEST.words[7]!=0||count>protocol.PATH_PAYLOAD||length>protocol.PATH_BYTES {return error.BadRequest;}
    let child=op==protocol.H_OPEN||op==protocol.H_CREATE||op==protocol.H_MKDIR;
    if child {if length==0 {return error.BadRequest;}}
    else {if length!=0 {return error.BadRequest;}}
    if op!=protocol.H_READ&&op!=protocol.H_WRITE&&op!=protocol.H_APPEND&&count!=0 {return error.BadRequest;}
    if op!=protocol.H_LIST&&op!=protocol.H_READ&&op!=protocol.H_WRITE&&op!=protocol.H_TRUNCATE&&op!=protocol.H_SCOPE&&offset!=0 {return error.BadRequest;}
    if op!=protocol.H_ROOT&&op!=protocol.H_OPEN&&op!=protocol.H_DUP&&op!=protocol.H_LIST&&rights!=0 {return error.BadRequest;}
    if op==protocol.H_ROOT {
        if token!=0||rights==0||(rights&~grants.ALL)!=0 {return error.BadRequest;}
        if (rights&~ALLOWED)!=0 {return error.grants.Denied;}
        PATH[0]=47;var alias:[11]u8=[0;11];
        RESPONSE.words[1]=try grants.install(&GRANTS,OWNER,grants.ROOT,rights,PATH[0..1],0,0,alias[0..11]);
        RESPONSE.words[2]=rights;return;
    }
    if op==protocol.H_SCOPE {if token!=0 {return error.BadRequest;}try fixed_scope(offset);return;}
    if op==protocol.H_CLOSE {try grants.close(&GRANTS,OWNER,token);return;}
    if op==protocol.H_DUP {
        let duplicate_slot=try grants.lookup(&GRANTS,OWNER,token,0);let duplicate_mask=scoped_mask(duplicate_slot);
        if (duplicate_mask&grants.DUP)==0||(rights&~duplicate_mask)!=0 {return error.grants.Denied;}
        RESPONSE.words[1]=try grants.duplicate(&GRANTS,OWNER,token,rights);RESPONSE.words[2]=rights;return;
    }
    // Flush namespace mutations only through the fixed writable Documents
    // directory authority. Child directories and read-only DUPs cannot flush.
    if op==protocol.H_SCOPE_SYNC {
        let scope_slot=try grants.lookup(&GRANTS,OWNER,token,0);let scope_item=&GRANTS.entries[scope_slot];
        let necessary=grants.WRITE|grants.CREATE|grants.REMOVE|grants.MKDIR;
        if GUI_ROLE!=2||GUI_SCOPE!=1||(*scope_item).kind!=grants.DIRECTORY
            ||!same_scope(scope_item,"/Documents",false)
            ||((*scope_item).rights&scoped_mask(scope_slot)&necessary)!=necessary {return error.grants.Denied;}
        let scope_identity=try grant_path(scope_slot);try fat.flush(&VOLUME,&SCRATCH);return;
    }
    // SYNC is a file capability operation, not a mount-wide legacy bypass.
    // A current WRITE or TRUNCATE grant suffices; STAT is not additionally
    // required. Recheck the file identity before flushing the actual volume.
    if op==protocol.H_SYNC {
        let sync_slot=try grants.lookup(&GRANTS,OWNER,token,0);let sync_item=&GRANTS.entries[sync_slot];
        if (*sync_item).kind!=grants.FILE||((*sync_item).rights&scoped_mask(sync_slot)&(grants.WRITE|grants.TRUNCATE))==0 {return error.grants.Denied;}
        let identity=try grant_path(sync_slot);
        try fat.flush(&VOLUME,&SCRATCH);return;
    }
    var required=grants.STAT;
    if op==protocol.H_OPEN {required=grants.OPEN;}
    else if op==protocol.H_LIST {required=grants.LIST;}
    else if op==protocol.H_READ {required=grants.READ;}
    else if op==protocol.H_WRITE||op==protocol.H_APPEND {required=grants.WRITE;}
    else if op==protocol.H_TRUNCATE {required=grants.TRUNCATE;}
    else if op==protocol.H_REMOVE {required=grants.REMOVE;}
    else if op==protocol.H_CREATE {required=grants.CREATE;}
    else if op==protocol.H_MKDIR {required=grants.MKDIR;}
    let slot=try grants.lookup(&GRANTS,OWNER,token,required);let item=&GRANTS.entries[slot];let effective=scoped_mask(slot);
    if (required&~effective)!=0 {return error.grants.Denied;}
    if op==protocol.H_OPEN&&(rights==0||(rights&~(*item).rights)!=0||(rights&~effective)!=0) {return error.grants.Denied;}
    if op==protocol.H_LIST {
        if offset>=4096 {return error.BadRequest;}
        if offset==0 {if rights!=0 {return error.Stale;}}
        else {if rights!=GENERATION {return error.Stale;}}
        if (*item).kind==grants.FILE {return error.grants.Denied;}
    }
    if (op==protocol.H_READ||op==protocol.H_WRITE||op==protocol.H_APPEND||op==protocol.H_TRUNCATE)&&(*item).kind!=grants.FILE {return error.grants.Denied;}
    if op==protocol.H_REMOVE&&((*item).kind==grants.ROOT
        ||(GUI_SCOPE==1&&same_scope(item,"/Documents",false))) {return error.grants.Denied;}
    let mutation=op==protocol.H_WRITE||op==protocol.H_APPEND||op==protocol.H_TRUNCATE
        ||op==protocol.H_REMOVE||op==protocol.H_CREATE||op==protocol.H_MKDIR;
    if mutation&&GENERATION==0xffff_ffff_ffff_ffff {return error.Stale;}
    var bytes:usize=0;if child {bytes=try child_path(slot,length as usize);}
    let base_length=try grant_path(slot);
    if !child {bytes=base_length;var i:usize=0;while i<bytes {PATH[i]=(*item).path[i];i+=1;}}
    let name=PATH[0..bytes];let data=(CHANNEL+protocol.PATH_DATA) as *u8;
    if op==protocol.H_OPEN {
        try fat.path_stat(&VOLUME,&SCRATCH,&WORK,name,&PATH_ENTRY);
        var kind=grants.FILE;if (PATH_ENTRY.entry.attributes&16)!=0 {kind=grants.DIRECTORY;}
        RESPONSE.words[1]=try grants.install(&GRANTS,OWNER,kind,rights,
            WORK.canonical.bytes[0..WORK.canonical.length],PATH_ENTRY.entry.sector,
            PATH_ENTRY.entry.offset,PATH_ENTRY.entry.name[0..11]);
        RESPONSE.words[2]=rights;return;
    }
    if op==protocol.H_STAT {record(0);return;}
    if op==protocol.H_LIST {if try fat.path_list(&VOLUME,&SCRATCH,&WORK,name,offset,&PATH_ENTRY) {record(offset+1);}return;}
    if op==protocol.H_READ {RESPONSE.words[1]=(try fat.path_read(&VOLUME,&SCRATCH,&WORK,name,offset,slice_from_raw_parts(data,count as usize))) as u64;return;}
    if op==protocol.H_WRITE||op==protocol.H_APPEND {
        var position=offset;if op==protocol.H_APPEND {position=PATH_ENTRY.entry.size;}
        RESPONSE.words[1]=(try fat.path_write(&VOLUME,&SCRATCH,&WORK,name,position,slice_from_raw_parts(data as *const u8,count as usize))) as u64;
    }else if op==protocol.H_TRUNCATE {try fat.path_truncate(&VOLUME,&SCRATCH,&WORK,name,offset);}
    else if op==protocol.H_REMOVE {try fat.path_remove(&VOLUME,&SCRATCH,&WORK,name);}
    else if op==protocol.H_CREATE {try fat.path_create(&VOLUME,&SCRATCH,&WORK,name);}
    else if op==protocol.H_MKDIR {try fat.path_mkdir(&VOLUME,&SCRATCH,&WORK,name);}
    if op==protocol.H_REMOVE||op==protocol.H_CREATE||op==protocol.H_MKDIR {grants.namespace_changed(&GRANTS);}
    GENERATION+=1;
}return;}
unsafe fn dispatch()!void {unsafe {
    if REQUEST.words[0]>=protocol.H_ROOT {try handle_operate();}
    else if REQUEST.words[0]>=protocol.PATH_STAT {try path_operate();}
    else {try legacy_operate();}
}return;}
unsafe fn operate()u64 {unsafe {
    RESPONSE=sys.EMPTY_MESSAGE;
    let exits=departed();match exits {ok=>{},err(e)=>{return e;},}
    let selected=select_channel();match selected {ok=>{},err(e)=>{return e;},}
    let done=dispatch();var status:u64=0;
    match done {ok=>{},err(e)=>{status=e;RESPONSE=sys.EMPTY_MESSAGE;},}
    if VOLUME.failed!=0 {grants.namespace_changed(&GRANTS);}
    RESPONSE.words[5]=protocol.VERSION;if REQUEST.words[0]>=protocol.H_ROOT&&REQUEST.words[0]<=protocol.H_SCOPE_SYNC {RESPONSE.words[5]=protocol.HANDLE_VERSION;}
    RESPONSE.words[6]=GENERATION;
    return status;
}}

export("service_main") fn main() u64 {
    unsafe {
        match setup() { ok => {}, err(code) => { return code; }, }
        let announced=sys.ready_boot(BOOT);if announced!=0 {return announced;}
        let logged = sys.log("DONGOS_FS_READY\r\n");
        if logged != 0 { return logged; }
        match departed() {ok=>{},err(e)=>{return e;},}
        var status = sys.svc_receive((*BOOT).endpoint,&REQUEST,&TICKET);
        loop {
            if status != 0 { return status; }
            RESPONSE.words[0] = operate();
            status = sys.svc_reply_wait((*BOOT).endpoint,TICKET,&RESPONSE,&REQUEST,&TICKET);
        }
    }
}

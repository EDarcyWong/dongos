// Shared pure matching policy. Kernel admission still rereads the actual
// hardware; class fields received from a caller never confer authority.
module drivers.device_policy;
import lib.device_abi as abi;
pub unsafe fn rank(d:*const abi.Device,role:u64)u64 {unsafe {
    if d==null||(*d).version!=1 {return 0;}
    if role==abi.PS2 {if (*d).kind==abi.I8042 {return 1;}return 0;}
    if (*d).kind!=abi.PCI||((*d).header&127)!=0 {return 0;}
    if role==abi.BLOCK {
        if (*d).vendor==0x1af4&&(*d).device_id==0x1042 {return 3;}
        if (*d).class_code==0x010802 {return 2;}
        if (*d).class_code==0x010601 {return 1;}
    }else if role==abi.TABLET {
        if (*d).vendor==0x1af4&&(*d).device_id==0x1052 {return 1;}
    }else if role==abi.XHCI {if (*d).class_code==0x0c0330 {return 1;}}
    return 0;
}}
pub unsafe fn same_identity(a:*const abi.Device,b:*const abi.Device)bool {unsafe {
    if a==null||b==null {return false;}
    return (*a).version==(*b).version&&(*a).kind==(*b).kind&&(*a).ecam==(*b).ecam&&(*a).segment==(*b).segment
        &&(*a).bus==(*b).bus&&(*a).device==(*b).device&&(*a).function==(*b).function&&(*a).vendor==(*b).vendor
        &&(*a).device_id==(*b).device_id&&(*a).class_code==(*b).class_code&&(*a).header==(*b).header;
}}

// Pure validation of the six reserved BSS guard pages. Layout stays 184 bytes;
// df/nmi/exception_stack continue to describe only their usable 16KiB stacks.
module boot.ist_layout;

import boot.memory_resources as resources;

const PAGE: u64 = 4096;
const STACK_BYTES: u64 = 16384;

// Non-null layout must point to readable, initialized Layout storage. This
// function never writes to it. Null is rejected without dereferencing it.
pub fn valid(layout: *const resources.Layout) bool {
    if layout == null { return false; }
    unsafe {
        let bss = (*layout).bss;
        if bss.start >= bss.end || ((bss.start | bss.end) & (PAGE - 1)) != 0 {
            return false;
        }
        let stacks: [3]resources.Span = [(*layout).df, (*layout).nmi, (*layout).exception_stack];
        let live: [4]resources.Span = [(*layout).gdt, (*layout).tss, (*layout).idt, (*layout).workspace];
        for span in live { if span.start >= span.end { return false; } }
        // Check subtraction bounds before deriving either guard endpoint.
        for stack in stacks {
            if stack.start < bss.start || stack.end > bss.end || stack.start >= stack.end {
                return false;
            }
            if stack.end - stack.start != STACK_BYTES ||
               ((stack.start | stack.end) & (PAGE - 1)) != 0 {
                return false;
            }
            if stack.start - bss.start < PAGE || bss.end - stack.end < PAGE {
                return false;
            }
        }
        var a: usize = 0;
        while a < 3 {
            let low = stacks[a].start - PAGE;
            let high = stacks[a].end + PAGE;
            var b: usize = a + 1;
            while b < 3 {
                if low < stacks[b].end + PAGE && stacks[b].start - PAGE < high {
                    return false;
                }
                b += 1;
            }
            for span in live {
                if (low < span.end && span.start < stacks[a].start) ||
                   (stacks[a].end < span.end && span.start < high) {
                    return false;
                }
            }
            a += 1;
        }
    }
    return true;
}

// True only for one of the six page starts, never an interior byte. Invalid
// layouts return false; callers must reject !valid before mapping any BSS.
pub fn is_guard(address: u64, layout: *const resources.Layout) bool {
    if (address & (PAGE - 1)) != 0 || !valid(layout) { return false; }
    unsafe {
        let stacks: [3]resources.Span = [(*layout).df, (*layout).nmi, (*layout).exception_stack];
        for stack in stacks {
            if address == stack.start - PAGE || address == stack.end { return true; }
        }
    }
    return false;
}

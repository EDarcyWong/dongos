// Object and mapping ledger. Only the serialized kernel RAM broker mutates it.
module ipc.shared_core;
import ipc.handles as handles;import lib.shared_abi as abi;
pub const OBJECTS:usize=8;pub const PROCESSES:usize=16;pub const MAPS:usize=4;pub const PAGES:usize=16;
pub const BASE:u64=0x7300_0000;pub const STRIDE:u64=0x2_0000;
pub const TAG:u64=0x5348_0000_0000_0000;pub const GENERATION_MAX:u64=0x0000_00ff_ffff_ffff;
pub const LIVE:u64=1;pub const HELD:u64=2;
pub struct Object{pub generation:u64,pub state:u64,pub cap_refs:u64,pub map_refs:u64,pub pages:usize}
pub struct Map{pub generation:u64,pub state:u64,pub owner:u64,pub root_generation:u64,pub object:u64,pub rights:u64,pub pages:usize,pub address:u64}
pub const EMPTY_OBJECT:Object=Object{generation:1,state:0,cap_refs:0,map_refs:0,pages:0};
pub const EMPTY_MAP:Map=Map{generation:1,state:0,owner:0,root_generation:0,object:0,rights:0,pages:0,address:0};
pub struct Registry{pub ready:u64,pub pool_physical:u64,pub pool_alias:u64,pub owners:[16]u64,pub objects:[8]Object,pub maps:[16][4]Map}
pub fn tagged(identity:u64)bool{return (identity&0xffff_0000_0000_0000)==TAG;}
pub fn owner_valid(id:usize,owner:u64)bool{return id<16&&(owner>>32)==id as u64+1&&(owner&0xffff_ffff)!=0&&(owner&0xffff_ffff)<=0x0fff_ffff;}
pub unsafe fn initialize(reg:*Registry,physical:u64,alias:u64)!void{unsafe{
 if reg==null||(*reg).ready!=0||physical==0||alias==0||(physical&4095)!=0||(alias&4095)!=0
  ||physical>=0x1_0000_0000_0000||0x8_0000>0x1_0000_0000_0000-physical||alias>0xffff_ffff_ffff_ffff-0x8_0000{return error.abi.Invalid;}
 (*reg).pool_physical=physical;(*reg).pool_alias=alias;var i:usize=0;
 while i<8{(*reg).objects[i]=EMPTY_OBJECT;i+=1;}i=0;
 while i<16{(*reg).owners[i]=0;var m:usize=0;while m<4{(*reg).maps[i][m]=EMPTY_MAP;m+=1;}i+=1;}(*reg).ready=1;
}return;}
pub unsafe fn get(reg:*Registry,identity:u64)!usize{unsafe{
 if reg==null||(*reg).ready!=1||!tagged(identity){return error.abi.Stale;}
 let slot=identity&255;let generation=(identity>>8)&GENERATION_MAX;
 if slot==0||slot>8||generation==0{return error.abi.Stale;}let value=(*reg).objects[(slot-1) as usize];
 if value.generation!=generation||value.state!=LIVE||value.pages==0||value.pages>16||value.cap_refs>512||value.map_refs>64{return error.abi.Stale;}return (slot-1) as usize;
}}
pub unsafe fn identity(reg:*const Registry,index:usize)u64{unsafe{return TAG|((*reg).objects[index].generation<<8)|index as u64+1;}}
pub unsafe fn physical(reg:*const Registry,index:usize)u64{unsafe{return (*reg).pool_physical+index as u64*65536;}}
pub unsafe fn alias(reg:*const Registry,index:usize)u64{unsafe{return (*reg).pool_alias+index as u64*65536;}}
pub unsafe fn bind_owner(reg:*Registry,id:usize,owner:u64)!void{unsafe{
 if reg==null||(*reg).ready!=1||!owner_valid(id,owner){return error.abi.Invalid;}
 if (*reg).owners[id]!=0&&(*reg).owners[id]!=owner{return error.abi.Stale;}(*reg).owners[id]=owner;
}return;}
pub unsafe fn map_get(reg:*Registry,id:usize,owner:u64,root_generation:u64,token:u64)!usize{unsafe{
 if reg==null||(*reg).ready!=1||!owner_valid(id,owner)||(*reg).owners[id]!=owner||root_generation==0{return error.abi.Stale;}
 let slot=token&255;let generation=token>>8;if slot==0||slot>4||generation==0{return error.abi.Stale;}
 let map=(*reg).maps[id][(slot-1) as usize];
 if map.state!=LIVE||map.generation!=generation||map.owner!=owner||map.root_generation!=root_generation{return error.abi.Stale;}
 let object=try get(reg,map.object);if (*reg).objects[object].map_refs==0{return error.abi.Stale;}
 return (slot-1) as usize;
}}
pub unsafe fn reserve_map(reg:*Registry,id:usize,owner:u64,root_generation:u64,object:u64,rights:u64)!usize{unsafe{
 if !owner_valid(id,owner)||root_generation==0||reg==null||(*reg).ready!=1||(*reg).owners[id]!=owner
  ||(rights&~(handles.READ|handles.WRITE))!=0||(rights&handles.READ)==0{return error.abi.Denied;}
 let index=try get(reg,object);if (*reg).objects[index].cap_refs==0||(*reg).objects[index].map_refs>=64{return error.abi.Exhausted;}
 var m:usize=0;while m<4{let previous=(*reg).maps[id][m];
  if previous.state==0&&previous.generation>0&&previous.generation<handles.MAX_GENERATION{
   (*reg).maps[id][m]=Map{generation:previous.generation,state:3,owner:owner,root_generation:root_generation,
    object:object,rights:rights,pages:(*reg).objects[index].pages,address:BASE+m as u64*STRIDE};
   (*reg).objects[index].map_refs+=1;return m;
  }m+=1;
 }
}return error.abi.NoSpace;}
pub unsafe fn hold_map(reg:*Registry,id:usize,index:usize)void{unsafe{
 let identity=(*reg).maps[id][index].object;let slot=identity&255;
 if tagged(identity)&&slot!=0&&slot<=8{(*reg).objects[(slot-1) as usize].state=HELD;}
 (*reg).maps[id][index].state=HELD;
}return;}
pub unsafe fn publish_map(reg:*Registry,id:usize,index:usize)void{unsafe{(*reg).maps[id][index].state=LIVE;}return;}
// The caller has already completed every PTE withdrawal, all-tag remote ACK
// and receipt reclamation. No fallible step may follow this metadata release.
pub unsafe fn release_map(reg:*Registry,id:usize,index:usize)u64{unsafe{
 let map=(*reg).maps[id][index];let object=(map.object&255) as usize-1;
 (*reg).objects[object].map_refs-=1;(*reg).maps[id][index]=EMPTY_MAP;
 (*reg).maps[id][index].generation=map.generation+1;return map.object;
}}

        try memory.copy_out(CURRENT,(*frame).r10,slice_from_raw_parts((&device_host.IRQ) as *const u8,sizeof(dev.Irq)));
        (*frame).rax=0;return CURRENT;
    }
    if code==dev.IRQ_WAIT{
        let token=try authority((*frame).rdi,handles.INTERRUPT,handles.WAIT);
        if (*frame).r10>1||(*frame).r9!=0{return error.Protocol;}
        try memory.check_range(CURRENT,(*frame).rdx,sizeof(dev.Irq),true);
        let polled=device_host.poll_irq(token,owner_key(CURRENT),(*frame).rsi);
        match polled{ok=>{
            device_host.IRQ.token=(*frame).rdi;
            try memory.copy_out(CURRENT,(*frame).rdx,slice_from_raw_parts((&device_host.IRQ) as *const u8,sizeof(dev.Irq)));(*frame).rax=0;return CURRENT;

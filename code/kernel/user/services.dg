    }
    if code==capabi.CLAIM{
        if (*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
        let caller=try accepted_caller((*frame).rdi,(*frame).rsi);
        let id=try endpoint((*frame).rdi,handles.WAIT|handles.REPLY);let pending=CAP_OFFERS[id];
        if pending.live!=1||pending.ticket!=(*frame).rsi||pending.caller!=owner_key(caller)
            ||pending.receiver!=owner_key(CURRENT){return error.Protocol;}
        try memory.check_range(CURRENT,(*frame).rdx,sizeof(capabi.Received),true);
        try cap_source(caller,&pending.offer);var received=capabi.EMPTY_RECEIVED;
        try capnotify.deliver(&CAP_NOTICES,&STATES[caller].table,&STATES[CURRENT].table,&pending.offer,&received);
        try memory.copy_out(CURRENT,(*frame).rdx,slice_from_raw_parts((&received) as *const u8,sizeof(capabi.Received)));
        CAP_OFFERS[id]=capnotify.EMPTY_DELIVERY;(*frame).rax=0;return CURRENT;
    }

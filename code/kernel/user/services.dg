            return error.power.ExecutionReturned;
        }
        if code==0x74 {
            if !GRAPHICS || CURRENT!=3 || (try authority((*frame).rdi,handles.DEVICE,handles.WRITE))!=gui.DISPLAY_OBJECT { return error.Protocol; }
            desktop.presented(arch.read_tsc());(*frame).rax=0;return CURRENT;
        }
        if code==0x77 {
            if !GRAPHICS || CURRENT!=3 || (try authority((*frame).rdi,handles.DEVICE,handles.WRITE))!=gui.DISPLAY_OBJECT { return error.Protocol; }
            match desktop.select_font((*frame).rsi) {
                ok(bytes)=>{(*frame).rax=bytes;},
                err(code)=>{if memory.RESOURCE_FAILED { INFO.last_error=code;INFO.errors+=1;return NONE; }(*frame).rax=code;},
            }
            return CURRENT;
        }
        if code==0x75 || code==0x76 {
            if !GRAPHICS || CURRENT!=4 || (try authority((*frame).rdi,handles.CONSOLE,handles.READ|handles.WRITE))!=gui.INPUT_OBJECT { return error.Protocol; }
            if code==0x75 { (*frame).rax=services_i8042_read();return CURRENT; }
            if ((*frame).rsi!=0x60 && (*frame).rsi!=0x64) || (*frame).rdx>255 { return error.Protocol; }
            (*frame).rax=services_i8042_write((*frame).rsi,(*frame).rdx);return CURRENT;
        }
        if code==0xff||code==0xfe{
            if CATALOG!=null{var state=proc.EXITED;if code==0xfe{state=proc.FAULTED;}
                try retire(CURRENT,state,(*frame).rdi);return try runnable();
            }
        }
        if code==0xff {
            if CURRENT!=0 || (*frame).rdi!=0 || INFO.calls!=INFO.replies { return error.Protocol; }
            INFO.completed=1; INFO.steps|=24; INFO.end_tsc=arch.read_tsc(); return NONE;
        }
        if code==0xfe { INFO.last_error=(*frame).rdi; return error.UserFailure; }
    }
    return error.InvalidCall;
}
pub var USER_FAULTS:u64=0;
pub var USER_IRQS:u64=0;
export("dong_user_exception_dispatch") fn exception(context:*const u64)*abi.Frame{unsafe{
    if CATALOG==null||context==null||CURRENT>=ACTIVE||!managed(CURRENT)||(*(context+19)&3)!=3{return null;}
    user_enter_kernel();sched_xstate_save(&XSTATES[CURRENT].bytes[0]);
    let frame=&(*process(CURRENT)).frame;
    memory.runtime_copy_bytes(frame as *u8,(context+1) as *const u8,120);
    // Preserve DF/RF from this trusted hardware capture: an IRQ can interrupt
    // a backward REP copy. user_resume_frame uses the dedicated IRET validator.
    (*frame).rip=*(context+18);(*frame).rflags=*(context+20);(*frame).rsp=*(context+21);
    (*frame).cr3=(*process(CURRENT)).root;(*frame).fs_base=0;(*frame).gs_base=0;(*frame).reserved=0;
    let vector=*(context+16);var next=CURRENT;
    if vector==0x51||vector==0x5c||vector==0x60{
        let delivered=device_host.interrupt(vector);match delivered{ok(owner)=>{USER_IRQS+=1;},err(e)=>{},}
        if device_host.PCI_FAILED{return null;}
        match wake_irqs(){ok=>{},err(e)=>{return null;},}
    }else{
        USER_FAULTS+=1;
        match retire(CURRENT,proc.FAULTED,vector){ok=>{},err(e)=>{return null;},}
        match runnable(){ok(id)=>{next=id;},err(e)=>{return null;},}
    }
    if next>=ACTIVE||!managed(next){return null;}
    CURRENT=next;INFO.current=next as u64+1;sched_xstate_restore(&XSTATES[next].bytes[0]);return &(*process(next)).frame;
}}
export("dong_user_dispatch") fn dispatch(frame:*abi.Frame)*abi.Frame {
    unsafe {
        user_enter_kernel();
        sched_xstate_save(&XSTATES[CURRENT].bytes[0]);
        (*process(CURRENT)).frame=*frame; STATES[CURRENT].started=1;
        INFO.syscalls+=1;
        let saved=&(*process(CURRENT)).frame;
        var next=CURRENT;
        var valid=true;
        if CATALOG!=null&&user_validate_frame(saved)==0{
            valid=false;USER_FAULTS+=1;
            match retire(CURRENT,proc.FAULTED,0x0405_0001){ok=>{},err(e)=>{return null;},}
            match runnable(){ok(id)=>{next=id;},err(e)=>{return null;},}
        }
        if valid{match perform(saved) {
            ok(id)=>{next=id;},
            err(code)=>{
                INFO.errors+=1;
                if LAUNCH_FAILED||memory.STAGE_FAILED||memory.UNSHARE_FAILED||memory.RESOURCE_FAILED||memory.OBJECT_FAILED||device_host.PCI_FAILED||windows.FAILED{INFO.last_error=code;next=NONE;}
                else if INFO.last_syscall==0xfe || INFO.last_syscall==0xff {
                    if INFO.last_error==0 { INFO.last_error=code; } next=NONE;
                } else { (*saved).rax=code; }
            },
        }
        }
        // SHARED_POSTCHECK_BEGIN
        if memory.OBJECT_FAILED{INFO.last_error=0x0410_0004;next=NONE;}
        if device_host.PCI_FAILED{INFO.last_error=0x050b_0002;next=NONE;}
        // SHARED_POSTCHECK_END
        INFO.frames=memory.frame_count() as u64;
        if CATALOG!=null{INFO.process_count=0;var id:usize=0;while id<ACTIVE{if managed(id){INFO.process_count+=1;}id+=1;}}
        if next==NONE { sched_xstate_restore(&KERNEL_XSTATE.bytes[0]); return null; }
        if next>=ACTIVE { INFO.last_error=0x050b_0002; sched_xstate_restore(&KERNEL_XSTATE.bytes[0]); return null; }
        CURRENT=next; INFO.current=next as u64+1;
        sched_xstate_restore(&XSTATES[next].bytes[0]);
        return &(*process(next)).frame;
    }
}
export("dong_desktop_enable") fn enable_desktop()void { unsafe { if INFO.process_count==0 { GRAPHICS=true;ACTIVE=COUNT; } } return; }
unsafe fn pci_inventory_call(frame:*abi.Frame)!usize{unsafe{
 if !GRAPHICS||CATALOG==null||!managed(CURRENT)||(CURRENT!=2&&CURRENT!=4&&CURRENT!=13)
  ||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
 if (try authority((*frame).rdi,handles.CONFIGURATION,handles.READ))!=devices.CONFIGURATION_OBJECT{return error.Protocol;}
 try memory.check_range(CURRENT,(*frame).rdx,sizeof(pci_inventory_abi.Entry),true);
 var entry=pci_inventory_abi.EMPTY;try device_host.read_pci_inventory((*frame).rsi,&entry);
 try memory.copy_out(CURRENT,(*frame).rdx,slice_from_raw_parts((&entry) as *const u8,sizeof(pci_inventory_abi.Entry)));
 (*frame).rax=0;return CURRENT;
}return error.InvalidCall;}
unsafe fn shared_call(frame:*abi.Frame)!usize{unsafe{
 if CATALOG==null||!managed(CURRENT)||memory.OBJECT_FAILED
  ||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
 let code=(*frame).rax;let owner=owner_key(CURRENT);
 if code==shared_abi.CREATE{
  try memory.check_range(CURRENT,(*frame).rdx,8,true);
  let token=try shared.create(&STATES[CURRENT].table,(*frame).rdi,(*frame).rsi);
  try memory.copy_out(CURRENT,(*frame).rdx,slice_from_raw_parts((&token) as *const u8,8));
 }else if code==shared_abi.MAP{
  try memory.check_range(CURRENT,(*frame).rdx,sizeof(shared_abi.Mapping),true);var out=shared_abi.EMPTY_MAPPING;
  try shared.map(CURRENT,owner,&STATES[CURRENT].table,(*frame).rdi,(*frame).rsi,&out);
  try memory.copy_out(CURRENT,(*frame).rdx,slice_from_raw_parts((&out) as *const u8,sizeof(shared_abi.Mapping)));
 }else if code==shared_abi.UNMAP{
  if (*frame).rsi!=0||(*frame).rdx!=0{return error.Protocol;}try shared.unmap(CURRENT,owner,(*frame).rdi);
 }else if code==shared_abi.INFO{
  if (*frame).rdx!=0{return error.Protocol;}try memory.check_range(CURRENT,(*frame).rsi,sizeof(shared_abi.Info),true);
  var out=shared_abi.EMPTY_INFO;try shared.info(&STATES[CURRENT].table,(*frame).rdi,&out);
  try memory.copy_out(CURRENT,(*frame).rsi,slice_from_raw_parts((&out) as *const u8,sizeof(shared_abi.Info)));
 }else{return error.InvalidCall;}
 (*frame).rax=0;return CURRENT;
}return error.InvalidCall;}
// Isolated SMP mode: this module executes side effects only on BSP under BKL.
// The domain is the sole GPR/xstate authority; old dispatch remains unselected.
pub unsafe fn enable_smp()!void{unsafe{
    let b=smp_bridge.pointer();if b==null||(*b).ready!=1||(*b).failed!=0||SMP_ENABLED||CATALOG==null{return error.Protocol;}
    let d=(*b).domain;if (*d).owner!=0||(*d).lock!=1{return error.Protocol;}
    CURRENT=NONE;SMP_ENABLED=true;
}return;}
unsafe fn runtime_pcid_metric(index:u64)u64{unsafe{
    if SMP_ENABLED{return services_smp_pcid_metric(index);}return services_pcid_metric(index);
}}
export("dong_user_smp_project") fn smp_project()u64{unsafe{
    if memory.OBJECT_FAILED||device_host.PCI_FAILED{return 0x060b_0011;}
    let b=smp_bridge.pointer();if b==null||!SMP_ENABLED||(*b).failed!=0{return 0x060b_0011;}
    let d=(*b).domain;if (*d).owner!=0||(*d).lock!=1||CURRENT!=NONE{return 0x060b_0011;}
    let waiters=wake_waiters();match waiters{ok=>{},err(e)=>{return e;},}
    let irqs=wake_irqs();match irqs{ok=>{},err(e)=>{return e;},}
    var slot:usize=0;while slot<ACTIVE{
        let p=(*d).processes+slot;
        if managed(slot){
            let incarnation=(*CATALOG).incarnation[slot];
            if (*p).token==0{
                let cfg=procs.current(CATALOG,slot);var affinity:u64=1;
                // Hardware services/compositor/init stay BSP. Ordinary apps
                // may execute concurrently and migrate between eligible CPUs.
                if cfg>=7&&cfg!=13{affinity=(*d).online;}
                SMP_TEST_SLOTS&=~(1<<slot as u64);
                if cfg>=7&&cfg<=11{SMP_TEST_SLOTS|=1<<slot as u64;}
                var token:u64=0;
                let added=smp_domain.admit(d,0,slot,incarnation,(*process(slot)).root,
                    (&(*process(slot)).frame) as u64,(&XSTATES[slot].bytes[0]) as u64,8,affinity,&token);
                match added{ok=>{},err(e)=>{return e;},}
                if STATES[slot].waiting!=0{return 0x060b_0011;}
            }else if (*p).incarnation!=incarnation||(*p).root!=(*process(slot)).root{return 0x060b_0011;}
            if (*(*d).engine).threads[slot].state==smp_queue.BLOCKED&&STATES[slot].waiting==0{
                let woken=smp_domain.wake(d,0,slot,incarnation);match woken{ok=>{},err(e)=>{return e;},}
            }
        }else if (*p).token!=0{return 0x060b_0011;}
        slot+=1;
    }
    INFO.frames=memory.frame_count() as u64;INFO.process_count=(*(*d).engine).count;return 0;
}}
// This hint is calculated only by BSP from the authoritative saved Frame and
// live Catalog/domain identity. It is never a user-provided skip flag. Unknown,
// invalid, mutation, fault and ECAM-window replacement retain both barriers.
export("dong_user_smp_service_policy") fn smp_service_policy(slot:usize,event:u64,pointer:u64)u64{unsafe{
 if CATALOG==null{return 0;}
 let b=smp_bridge.pointer();if b==null||!SMP_ENABLED||(*b).failed!=0||slot>=ACTIVE||event!=257||CURRENT!=NONE{return 0;}
 let d=(*b).domain;let p=(*d).processes+slot;let cpu=(*d).cpus;
 if (*d).owner!=0||(*d).lock!=1||(*cpu).mode!=smp_domain.LOCKED||(*cpu).slot!=slot as u64
  ||(*cpu).token!=(*p).token||(*p).token==0||(*p).root!=(*process(slot)).root||(*cpu).incarnation!=(*p).incarnation
  ||(*p).incarnation!=(*CATALOG).incarnation[slot]||pointer!=(&(*process(slot)).frame) as u64||!managed(slot){return 0;}
 let frame=pointer as *abi.Frame;if user_validate_frame(frame)!=1{return 0;}
 if (*frame).rax==3{
  if (*frame).rdi!=0||(*frame).rsi!=0||(*frame).rdx!=0||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return 0;}
  // runnable() wakes blocked lifecycle/IRQ outputs through owned RAM aliases;
  // it changes no PTE/capability/lifetime. Queue projection remains BSP+BKL.
  return 1;
 }
 if (*frame).rax==dev.IRQ_WAIT{
  if (*frame).r10!=dev.NONBLOCK||(*frame).r8!=0||(*frame).r9!=0{return 0;}
  var irq=handles.EMPTY_VIEW;match handles.lookup(&STATES[slot].table,(*frame).rdi,handles.INTERRUPT,handles.WAIT,&irq){ok=>{},err(e)=>{return 0;},}
  match memory.check_range(slot,(*frame).rdx,sizeof(dev.Irq),true){ok=>{},err(e)=>{return 0;},}
  if !device_host.irq_poll_readonly(irq.object,((slot as u64+1)<<32)|(*CATALOG).incarnation[slot],(*frame).rsi){return 0;}
  return 1;
 }
 if (*frame).rax==0x73{
  if (*frame).rdi!=0||(*frame).rsi!=0||(*frame).rdx!=0||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return 0;}return 1;
 }
 if (*frame).rax!=0x60||(slot!=2&&(!GRAPHICS||(slot!=4&&slot!=13)))||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return 0;}
 var view=handles.EMPTY_VIEW;match handles.lookup(&STATES[slot].table,(*frame).rdi,handles.CONFIGURATION,handles.READ,&view){ok=>{},err(e)=>{return 0;},}
 if view.object!=devices.CONFIGURATION_OBJECT{return 0;}
 match memory.check_range(slot,(*frame).rdx,4,true){ok=>{},err(e)=>{return 0;},}
 if !devices.configuration_read_stable((*frame).rsi){return 0;}return 1;
}}
export("dong_user_smp_service") fn smp_service(slot:usize,event:u64,pointer:u64)u64{unsafe{
    let b=smp_bridge.pointer();if b==null||!SMP_ENABLED||(*b).failed!=0||slot>=ACTIVE||event==0||CURRENT!=NONE{return 0x060b_0011;}
    let d=(*b).domain;let p=(*d).processes+slot;let cpu=(*d).cpus;
    if (*d).owner!=0||(*d).lock!=1||(*cpu).mode!=smp_domain.LOCKED||(*cpu).slot!=slot as u64
        ||(*cpu).token!=(*p).token||(*p).incarnation!=(*CATALOG).incarnation[slot]||pointer!=(&(*process(slot)).frame) as u64||!managed(slot){return 0x060b_0011;}
    CURRENT=slot;INFO.current=slot as u64+1;let frame=pointer as *abi.Frame;var failure:u64=0;
    if event==257{
        INFO.syscalls+=1;STATES[slot].started=1;
        if user_validate_frame(frame)==0{
            USER_FAULTS+=1;let result=retire(slot,proc.FAULTED,0x0405_0001);match result{ok=>{},err(e)=>{failure=e;},}
        }else{
            let operation=(*frame).rax;
            match perform(frame){ok(hint)=>{},err(code)=>{
                INFO.errors+=1;
                if LAUNCH_FAILED||memory.STAGE_FAILED||memory.UNSHARE_FAILED||memory.RESOURCE_FAILED||memory.OBJECT_FAILED||device_host.PCI_FAILED||windows.FAILED||operation==0xfe||operation==0xff{failure=code;}
                else{(*frame).rax=code;}
            },}
        }
    }else if event==258{
        // A trusted IRQ capture may contain a user-controlled unusable RSP,
        // flags or other return state. Retire only that process through the
        // same global detach/flush/reclaim path as a real CPL3 exception.
        USER_FAULTS+=1;let result=retire(slot,proc.FAULTED,0x0405_0001);match result{ok=>{},err(e)=>{failure=e;},}
    }else if event<=32{
        USER_FAULTS+=1;let result=retire(slot,proc.FAULTED,event-1);match result{ok=>{},err(e)=>{failure=e;},}
    }else{failure=0x060b_0011;}
    if memory.OBJECT_FAILED{failure=0x0410_0004;}
    if device_host.PCI_FAILED{failure=0x060b_0011;}
    CURRENT=NONE;if failure!=0{INFO.last_error=failure;return failure;}return 0;
}}
export("dong_user_smp_interrupt") fn smp_interrupt(vector:u64)u64{unsafe{
    let b=smp_bridge.pointer();if b==null||!SMP_ENABLED||(*b).failed!=0||CURRENT!=NONE{return 0x060b_0011;}
    let d=(*b).domain;if (*d).owner!=0||(*d).lock!=1||(vector!=0x51&&vector!=0x5c&&vector!=0x60){return 0x060b_0011;}
    match device_host.interrupt(vector){ok(owner)=>{USER_IRQS+=1;},err(e)=>{},}
    if device_host.PCI_FAILED{return 0x060b_0011;}
    match wake_irqs(){ok=>{return 0;},err(e)=>{return e;},}
}}

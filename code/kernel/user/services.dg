            }(*frame).rax=value;USB_DEPARTED=0;return CURRENT;
        }
        if code==0x2f{
            if !GRAPHICS||CATALOG==null||CURRENT!=4||!managed(4)||procs.current(CATALOG,4)!=4
                ||(*frame).rsi!=0||(*frame).rdx!=0||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0
                ||(try endpoint((*frame).rdi,handles.WAIT|handles.REPLY))!=4{return error.Protocol;}
            var value:u64=0;
            if managed(13)&&procs.current(CATALOG,13)==13&&(*CATALOG).states[13].state==proc.READY{
                let incarnation=(*CATALOG).incarnation[13];
                if incarnation==0||incarnation>0x0fff_ffff{return error.Protocol;}
                value=(0x5548_5244<<32)|incarnation;
            }(*frame).rax=value;return CURRENT;
        }
        if code==0x29||code==0x2a||code==0x2b {
            let id=try endpoint((*frame).rdi,handles.WAIT|handles.REPLY);
            if (*frame).rdx!=0 || (*frame).r10!=0 || (*frame).r8!=0 || (*frame).r9!=0
                || ENDPOINTS[id].owner!=CURRENT as u64+1 || ENDPOINTS[id].initialized!=1 || ENDPOINTS[id].live!=1
                || ENDPOINTS[id].state!=ipc.ACCEPTED || ENDPOINTS[id].token!=(*frame).rsi
                || ENDPOINTS[id].caller==0 || ENDPOINTS[id].caller>ACTIVE as u64
                || ENDPOINTS[id].caller==ENDPOINTS[id].owner {return error.Protocol;}
            let caller=(ENDPOINTS[id].caller-1) as usize;(*frame).rax=ENDPOINTS[id].caller;
            if code==0x2a{var owner_generation:u64=1;var caller_generation:u64=1;
                if CATALOG!=null{owner_generation=(*CATALOG).incarnation[CURRENT];caller_generation=(*CATALOG).incarnation[caller];}
                (*frame).rax=(owner_generation<<32)|caller_generation;
            }
            if code==0x2b{(*frame).rax=FS_RIGHTS[caller];}
            return CURRENT;
        }
        if code==0x60 {
            if (try authority((*frame).rdi,handles.CONFIGURATION,handles.READ))!=devices.CONFIGURATION_OBJECT || (CURRENT!=2 && (!GRAPHICS || (CURRENT!=4&&CURRENT!=13))) { return error.Protocol; }
            try memory.check_range(CURRENT,(*frame).rdx,4,true);
            let value=try devices.configuration_read((*frame).rsi);
            write_unaligned((&BUFFER[0]) as *u32,value);
            try memory.copy_out(CURRENT,(*frame).rdx,BUFFER[..4]); (*frame).rax=0; return CURRENT;
        }
        if code==0x61 {
            if (try authority((*frame).rdi,handles.CONFIGURATION,handles.READ|handles.WRITE))!=devices.CONFIGURATION_OBJECT { return error.Protocol; }
            try memory.check_range(CURRENT,(*frame).rdx,6*sizeof(vp.Bar),true);
            if GRAPHICS&&CURRENT!=13{try device_host.attach_pci(CURRENT,owner_key(CURRENT));}
            try devices.grant(CURRENT,&STATES[CURRENT].table,(*frame).rsi);
            try memory.copy_out(CURRENT,(*frame).rdx,slice_from_raw_parts(devices.granted_bars(CURRENT) as *const u8,6*sizeof(vp.Bar)));
            (*frame).rax=0; return CURRENT;
        }
        if code==0x62 { let object=try authority((*frame).rdi,handles.DEVICE,handles.MAP); (*frame).rax=try devices.mapped(CURRENT,object); return CURRENT; }
        if code==0x63 {
            if (try authority((*frame).rdi,handles.DMA,handles.MAP|handles.WRITE))!=devices.DMA_OBJECT { return error.Protocol; }
            try memory.check_range(CURRENT,(*frame).r10,sizeof(blk.Lease),true);
            try devices.dma_acquire(CURRENT,(*frame).rsi,(*frame).rdx);
            try memory.copy_out(CURRENT,(*frame).r10,slice_from_raw_parts(devices.dma_lease(CURRENT) as *const u8,sizeof(blk.Lease)));
            (*frame).rax=0; return CURRENT;
        }
        // DMA close is intentionally not recycled yet. The kernel retains
        // ownership even if a driver lies about device reset completion.
        if code==0x64 { return error.devices.Busy; }
        if code==0x65 {
            if CURRENT!=2 || (try authority((*frame).rdi,handles.CONFIGURATION,handles.READ|handles.WRITE))!=devices.CONFIGURATION_OBJECT {return error.Protocol;}
            try devices.ahci_enable(CURRENT,(*frame).rsi);(*frame).rax=0;return CURRENT;
        }
        if code==0x66 {
            if CURRENT!=2 || (*frame).rsi!=0 || (*frame).rdx!=0 || (*frame).r10!=0 || (*frame).r8!=0 || (*frame).r9!=0
                || (try authority((*frame).rdi,handles.CONFIGURATION,handles.READ|handles.WRITE))!=devices.CONFIGURATION_OBJECT {return error.Protocol;}
            try devices.nvme_enable(CURRENT);(*frame).rax=0;return CURRENT;
        }
        if code==0x67{
            if !GRAPHICS||CATALOG==null||CURRENT!=13||procs.current(CATALOG,CURRENT)!=13
                ||(*frame).rsi!=0||(*frame).rdx!=0||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0
                ||(try authority((*frame).rdi,handles.CONFIGURATION,handles.READ|handles.WRITE))!=devices.CONFIGURATION_OBJECT{return error.Protocol;}
            try devices.xhci_enable(CURRENT,owner_key(CURRENT),(*CATALOG).incarnation[CURRENT]);
            (*frame).rax=0;return CURRENT;
        }
        if code==0x70 {
            if (*frame).rsi>4096 { return error.Protocol; }
            let count=(*frame).rsi as usize;
            try memory.copy_in(CURRENT,(*frame).rdi,BUFFER[..count]);
            (*frame).rax=services_write_bytes(&BUFFER[0],count); return CURRENT;
        }
        if code==0x71 {
            if (try authority((*frame).rdi,handles.CONSOLE,handles.READ))!=devices.CONSOLE_OBJECT { return error.Protocol; }
            (*frame).rax=services_character();
            if (*frame).rax==256&&KEYBOARD!=null&&CATALOG!=null&&managed(4){
                match console.pop(KEYBOARD,&KEY_BYTE){ok(found)=>{if found{(*frame).rax=KEY_BYTE as u64;}},err(e)=>{(*frame).rax=e;},}
            }
            return CURRENT;
        }
        if code==0x73 { (*frame).rax=arch.read_tsc(); return CURRENT; }
        if code==0x78 {
            if CURRENT!=0 || INFO.calls!=INFO.replies { return error.Protocol; }
            if (try authority((*frame).rdi,handles.DEVICE,handles.WRITE))!=power.POWER_OBJECT { return error.Protocol; }
            let action=(*frame).rsi;
            try power.validate_request(action);
            var message="DONGOS_POWER_RESET_REQUEST\r\n";
            if action==2 { message="DONGOS_POWER_S5_REQUEST\r\n"; }
            if services_write_bytes(message.ptr,message.len)!=0 { return error.Protocol; }

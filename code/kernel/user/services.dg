        if (*frame).r8!=0&&arch.read_tsc()>=(*frame).r8{return error.dev.Timeout;}
        IRQ_TOKEN[CURRENT]=(*frame).rdi;IRQ_AFTER[CURRENT]=(*frame).rsi;IRQ_POINTER[CURRENT]=(*frame).rdx;IRQ_DEADLINE[CURRENT]=(*frame).r8;
        STATES[CURRENT].waiting=5;(*frame).rax=0;return try runnable();
    }
    if code==dev.IRQ_ACK{
        let token=try authority((*frame).rdi,handles.INTERRUPT,handles.SIGNAL);
        if (*frame).rdx!=0||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
        try device_host.ack_irq(token,owner_key(CURRENT),(*frame).rsi);(*frame).rax=0;return CURRENT;

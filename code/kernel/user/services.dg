unsafe fn perform(frame:*abi.Frame)!usize {
    unsafe {
        let code=(*frame).rax; INFO.last_syscall=code; INFO.last_pid=CURRENT as u64+1;
        if code>=0x80&&code<=0x89{return try process_call(frame);}
        if code>=capabi.CREATE&&code<=capabi.EXPORT_ENDPOINT{return try capability_call(frame);}
        if code>=shared_abi.CREATE&&code<=shared_abi.INFO{return try shared_call(frame);}
        if code>=0x90&&code<=0x96{return try device_call(frame);}
        if code==pci_inventory_abi.ENUMERATE{return try pci_inventory_call(frame);}
        if code>=window.ALLOCATE&&code<=window.PEER{return try window_call(frame);}
        if code==1 { (*frame).rax=CURRENT as u64+1; return CURRENT; }
        if code==2 { (*frame).rax=BOOT_ADDRESS; return CURRENT; }
        if code==3 { (*frame).rax=0; return runnable(); }
        if code==0x10 {
            var cap=handles.EMPTY_VIEW;try capnotify.view(&STATES[CURRENT].table,(*frame).rdi,&cap);
            if cap.kind==handles.INTERRUPT&&device_host.is_pci_irq(cap.object){try device_host.close_pci_irq(cap.object,owner_key(CURRENT));}
            try capnotify.close(&CAP_NOTICES,&STATES[CURRENT].table,(*frame).rdi); (*frame).rax=0; return CURRENT;
        }
        if code==0x11 { (*frame).rax=try capnotify.duplicate(&CAP_NOTICES,&STATES[CURRENT].table,(*frame).rdi,(*frame).rsi); return CURRENT; }
        if code==0x22 {
            let id=try endpoint((*frame).rdi,handles.CALL);
            let owner=(ENDPOINTS[id].owner-1) as usize;
            if owner==CURRENT { return error.Protocol; }
            if !managed(owner)||ENDPOINTS[id].live!=1{return error.proc.PeerGone;}
            try memory.check_range(CURRENT,(*frame).rdx,64,true);
            try memory.copy_in(CURRENT,(*frame).rsi,BUFFER[..64]);
            if SMP_ENABLED&&CATALOG!=null{
                try pending_call_enqueue(id,frame);try pending_call_pump(id);
                if STATES[CURRENT].waiting==0{return CURRENT;}
                if STATES[owner].waiting==0{return owner;}return try runnable();
            }
            let token=try ipc.call(&ENDPOINTS[id],CURRENT as u64+1,BUFFER[..64]);
            CAP_OFFERS[id]=capnotify.EMPTY_DELIVERY;
            STATES[CURRENT].ticket=token; STATES[CURRENT].reply_pointer=(*frame).rdx; STATES[CURRENT].waiting=1;
            INFO.calls+=1;
            if STATES[owner].waiting==2 { try accept(id); }
            if STATES[owner].waiting==0{return owner;}return try runnable();
        }
        if code==0x23 {
            let id=try endpoint((*frame).rdi,handles.WAIT);
            if ENDPOINTS[id].owner!=CURRENT as u64+1 { return error.Protocol; }
            try memory.check_range(CURRENT,(*frame).rsi,64,true);
            CANCELED[id]=0;STATES[CURRENT].receive_pointer=(*frame).rsi;
            try pending_call_pump(id);
            if ENDPOINTS[id].state==ipc.PENDING { try accept(id); return CURRENT; }
            STATES[CURRENT].waiting=2; (*frame).rax=0; return runnable();
        }
        if code==0x25{
            let id=try endpoint((*frame).rdi,handles.WAIT);
            if id!=CURRENT||ENDPOINTS[id].owner!=CURRENT as u64+1
                ||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
            try memory.check_range(CURRENT,(*frame).rsi,64,true);
            try memory.check_range(CURRENT,(*frame).rdx,8,true);
            if (*frame).rsi<(*frame).rdx+8&&(*frame).rdx<(*frame).rsi+64{return error.Protocol;}
            if ENDPOINTS[id].state!=ipc.PENDING{return error.proc.WouldBlock;}
            var message=ipc.EMPTY_MESSAGE;var ticket:u64=0;
            try ipc.accept(&ENDPOINTS[id],CURRENT as u64+1,&message,&ticket);
            try memory.copy_out(CURRENT,(*frame).rsi,message.bytes[..]);
            try memory.copy_out(CURRENT,(*frame).rdx,slice_from_raw_parts((&ticket) as *const u8,8));
            CANCELED[id]=0;(*frame).rax=0;return CURRENT;
        }
        if code==0x24 || code==0x26 {
            let id=try endpoint((*frame).rdi,handles.REPLY);
            if code==0x26 { try memory.check_range(CURRENT,(*frame).r10,64,true); }
            try memory.copy_in(CURRENT,(*frame).rdx,BUFFER[..64]);
            if CANCELED[id]!=0&&(*frame).rsi==CANCELED[id]{
                CANCELED[id]=0;if CAP_OFFERS[id].ticket==(*frame).rsi{CAP_OFFERS[id]=capnotify.EMPTY_DELIVERY;}(*frame).rax=0;
                if code==0x26{
                    STATES[CURRENT].receive_pointer=(*frame).r10;
                    try pending_call_pump(id);
                    if ENDPOINTS[id].state==ipc.PENDING{try accept(id);return CURRENT;}
                    STATES[CURRENT].waiting=2;return try runnable();
                }try pending_call_pump(id);return CURRENT;
            }
            let caller=(ENDPOINTS[id].caller-1) as usize;
            if caller>=ACTIVE { return error.Protocol; }
            try ipc.reply(&ENDPOINTS[id],CURRENT as u64+1,(*frame).rsi,BUFFER[..64]);
            var message=ipc.EMPTY_MESSAGE;
            try ipc.take_reply(&ENDPOINTS[id],caller as u64+1,STATES[caller].ticket,&message);
            try memory.copy_out(caller,STATES[caller].reply_pointer,message.bytes[..]);
            CAP_OFFERS[id]=capnotify.EMPTY_DELIVERY;
            STATES[caller].waiting=0; (*process(caller)).frame.rax=0; (*frame).rax=0; INFO.replies+=1;
            if code==0x26 { STATES[CURRENT].receive_pointer=(*frame).r10; STATES[CURRENT].waiting=2; }
            try pending_call_pump(id);return caller;
        }
        if code==0x2c{
            let id=try endpoint((*frame).rdi,handles.WAIT|handles.REPLY);
            if CURRENT!=1||id!=CURRENT||(*frame).rsi!=0||(*frame).rdx!=0||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
            (*frame).rax=0;var pid:usize=0;while pid<ACTIVE{if DEPARTED[pid]!=0{
                (*frame).rax=((pid as u64+1)<<32)|DEPARTED[pid];DEPARTED[pid]=0;break;
            }pid+=1;}return CURRENT;
        }
        if code==0x2d{
            if CURRENT!=1||(*frame).rdx!=0||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
            let caller=try accepted_caller((*frame).rdi,(*frame).rsi);let role=gui_role(caller);
            var scope:u64=0;if role==window.FILES||role==window.EDITOR{scope=1;}
            if role==window.SETTINGS{scope=2;}
            (*frame).rax=(scope<<32)|role;return CURRENT;
        }
        if code==0x2e{
            if !GRAPHICS||CATALOG==null||CURRENT!=4||!managed(4)||procs.current(CATALOG,4)!=4
                ||(*frame).rsi!=0||(*frame).rdx!=0||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0
                ||(try endpoint((*frame).rdi,handles.WAIT|handles.REPLY))!=4{return error.Protocol;}
            // Only a trusted Catalog retirement records this epoch. No HID

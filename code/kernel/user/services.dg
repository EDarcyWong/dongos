// Three real isolated BSP services: shell -> FAT -> VirtIO. Each endpoint
// keeps a distinct trusted caller/ticket; nested calls do not borrow user IDs.
module user.services;
import user.abi as abi;
import boot.trace as trace;
import boot.trace_runtime as boot_trace;
import user.memory as memory;
import user.devices as devices;
import ipc.handles as handles;
import ipc.core as ipc;
import boot.service_memory as resources;
import exec.bundle as bundle;
import lib.abi as sys;
import drivers.virtio_pci as vp;
import drivers.virtio_blk as blk;
import arch.x86_64 as arch;
import user.desktop as desktop;
import lib.desktop as gui;
import boot.power_startup as power;
import irq.platform as platform;
import user.processes as procs;
import user.device_host as device_host;
import lib.device_abi as dev;
import input.console as console;
import lib.process_abi as proc;
import user.window_broker as windows;
import lib.window_broker_abi as window;
import sched.user_bridge as smp_bridge;
import sched.user_domain as smp_domain;
import sched.multicore as smp_queue;
import ipc.cap_notify as capnotify;
import lib.pci_inventory_abi as pci_inventory_abi;
import user.shared_objects as shared;
import lib.shared_abi as shared_abi;
import lib.cap_notify_abi as capabi;
pub error InvalidCall=0x050b_0001;
pub error Protocol=0x050b_0002;
pub error UserFailure=0x050b_0003;
const COUNT: usize=16;
var ACTIVE: usize=3;
var GRAPHICS: bool=false;
const NONE: usize=memory.LIMIT;
const BOOT_ADDRESS: u64=0x7000_0000;
pub struct Report {
    pub version:u64,pub process_count:u64,pub syscalls:u64,pub calls:u64,pub replies:u64,
    pub errors:u64,pub last_error:u64,pub last_pid:u64,pub last_syscall:u64,pub completed:u64,
    pub steps:u64,pub shell_root:u64,pub fs_root:u64,pub block_root:u64,pub frames:u64,
    pub bundle_physical:u64,pub arena_physical:u64,pub start_tsc:u64,pub end_tsc:u64,pub current:u64,
}
var INFO: Report=Report { version:1,process_count:0,syscalls:0,calls:0,replies:0,errors:0,last_error:0,
    last_pid:0,last_syscall:0,completed:0,steps:0,shell_root:0,fs_root:0,block_root:0,frames:0,
    bundle_physical:0,arena_physical:0,start_tsc:0,end_tsc:0,current:0 };
const EMPTY_BOOT:sys.Boot=sys.Boot { version:1,process:0,endpoint:0,filesystem:0,block:0,channel:0,
    channel_address:0,channel_bytes:65536,configuration:0,dma:0,console:0,service_count:3,
    reserved0:0,reserved1:0,reserved2:0,reserved3:0 };
struct State { table:handles.Table,reply_pointer:u64,receive_pointer:u64,ticket:u64,waiting:u64,started:u64 }
const EMPTY_STATE:State=State { table:handles.EMPTY_TABLE,reply_pointer:0,receive_pointer:0,ticket:0,waiting:0,started:0 };
var STATES:[COUNT]State=[EMPTY_STATE;COUNT];
var BOOTS:[COUNT]sys.Boot=[EMPTY_BOOT;COUNT];
var ENDPOINTS:[COUNT]ipc.Endpoint=[ipc.EMPTY_ENDPOINT;COUNT];
align(64) struct XState { bytes:[1024]u8 }
var XSTATES:[COUNT]XState=[XState { bytes:[0;1024] };COUNT];
var KERNEL_XSTATE:XState=XState { bytes:[0;1024] };
var CURRENT:usize=0;
var SMP_ENABLED:bool=false;
// Trusted role mask for the explicit ordinary busy-workload XSAVE bad build.
// GUI clients may reuse the same physical slots and must never be selected.
var SMP_TEST_SLOTS:u64=0;
var BUFFER:[4097]u8=[0;4097];
pub var CATALOG:*procs.Catalog=null;
var PRELOADED:[COUNT]bool=[false;COUNT];
var DEPARTED:[COUNT]u64=[0;COUNT];
var GUI_DEPARTED:[COUNT]u64=[0;COUNT];
var USB_DEPARTED:u64=0;
var CAP_NOTICES:capnotify.Registry=capnotify.EMPTY_REGISTRY;
var CAP_OFFERS:[COUNT]capnotify.Delivery=[capnotify.EMPTY_DELIVERY;COUNT];

// One trusted request snapshot per process bounds ordinary CALL backpressure.
// waiting=6 owns no endpoint ticket, capability offer or accepted request.
struct PendingCall {sequence:u64,endpoint:u64,identity:u64,caller:u64,owner:u64,capability:u64,reply:u64,bytes:[64]u8}
const EMPTY_PENDING_CALL:PendingCall=PendingCall{sequence:0,endpoint:0,identity:0,caller:0,owner:0,capability:0,reply:0,bytes:[0;64]};
var PENDING_CALLS:[COUNT]PendingCall=[EMPTY_PENDING_CALL;COUNT];
var PENDING_CALL_SEQUENCE:u64=0;

var WAIT_AFTER:[COUNT]u64=[0;COUNT];
var WAIT_POINTER:[COUNT]u64=[0;COUNT];
var WAIT_DEADLINE:[COUNT]u64=[0;COUNT];
var FS_RIGHTS:[COUNT]u64=[0;COUNT];
var IRQ_TOKEN:[COUNT]u64=[0;COUNT];
var IRQ_AFTER:[COUNT]u64=[0;COUNT];
var IRQ_POINTER:[COUNT]u64=[0;COUNT];
var IRQ_DEADLINE:[COUNT]u64=[0;COUNT];
var CLOCK_HZ:u64=0;
var EXECUTABLE:*u8=null;
var EVENT:proc.Event=proc.EMPTY_EVENT;
var KEYBOARD: *console.Queue=null;
var KEY_BYTE:u8=0;
var SNAPSHOT:proc.Snapshot=proc.EMPTY_SNAPSHOT;
var LAUNCH_FAILED:bool=false;
const MANAGER_OBJECT:u64=0x500;
const DEVICE_MANAGER_OBJECT:u64=0x501;
unsafe extern "sysv64" fn user_enter_kernel()void;
unsafe extern "sysv64" fn user_validate_frame(frame:*const abi.Frame)u64;
unsafe extern "sysv64" fn services_pcid_metric(index:u64)u64;
unsafe extern "sysv64" fn services_smp_pcid_metric(index:u64)u64;
unsafe extern "sysv64" fn sched_xstate_save(out:*u8)void;
unsafe extern "sysv64" fn sched_xstate_restore(input:*const u8)void;
unsafe extern "sysv64" fn services_write_bytes(input:*const u8,bytes:usize)u64;
unsafe extern "sysv64" fn services_character()u64;
unsafe extern "sysv64" fn services_i8042_read()u64;
unsafe extern "sysv64" fn services_i8042_write(port:u64,value:u64)u64;
unsafe fn process(id:usize)*memory.Process { unsafe { return memory.processes()+id; } }
pub fn first()*abi.Frame { unsafe { if GRAPHICS{CURRENT=5;return &(*process(5)).frame;}return &(*process(0)).frame; } }
pub fn report_pointer()*const Report { unsafe { return &INFO; } }
unsafe fn install_identity(id:usize,cfg:usize,generation:u64,argument:u64)!void{unsafe{
    if STATES[id].table.ready==0{try handles.init(&STATES[id].table);}
    BOOTS[id]=EMPTY_BOOT;BOOTs_common(id);
    ENDPOINTS[id]=ipc.EMPTY_ENDPOINT;
    try ipc.endpoint_init(&ENDPOINTS[id],(generation-1)*16+id as u64+1,id as u64+1);
    BOOTS[id].endpoint=try handles.install(&STATES[id].table,handles.ENDPOINT,id as u64+1,handles.WAIT|handles.REPLY);
    BOOTS[id].channel=try handles.install(&STATES[id].table,handles.SHARED,200+id as u64,handles.READ|handles.WRITE|handles.MAP);
    if id==0||id==3||(id>=7&&id!=13){
        BOOTS[id].filesystem=try handles.install(&STATES[id].table,handles.ENDPOINT,2,handles.CALL);
        FS_RIGHTS[id]=395;if id==0||id==3{FS_RIGHTS[id]=1023;}
    }
    if id==0{
        BOOTS[id].console=try handles.install(&STATES[id].table,handles.CONSOLE,devices.CONSOLE_OBJECT,handles.READ|handles.WRITE);
        BOOTS[id].reserved3=try handles.install(&STATES[id].table,handles.DEVICE,power.POWER_OBJECT,handles.WRITE);
        if GRAPHICS{try BOOTs_manager(id);BOOTS[id].reserved1=procs.CONFIGS as u64;}
    }
    if id==1{BOOTS[id].block=try handles.install(&STATES[id].table,handles.ENDPOINT,3,handles.CALL);}
    if id==2&&GRAPHICS{BOOTS[id].block=try handles.install(&STATES[id].table,handles.ENDPOINT,14,handles.CALL);}
    if id==2||id==4||id==13{
        BOOTS[id].configuration=try handles.install(&STATES[id].table,handles.CONFIGURATION,devices.CONFIGURATION_OBJECT,handles.READ|handles.WRITE);
        BOOTS[id].dma=try handles.install(&STATES[id].table,handles.DMA,devices.DMA_OBJECT,handles.READ|handles.WRITE|handles.MAP);
        BOOTS[id].reserved0=devices.region_base();BOOTs_region(id);
    }
    if id==3{
        BOOTS[id].console=try handles.install(&STATES[id].table,handles.DEVICE,gui.DISPLAY_OBJECT,handles.READ|handles.WRITE|handles.MAP);
        BOOTS[id].reserved0=gui.DESCRIPTOR;
        try BOOTs_manager(id);BOOTS[id].reserved1=procs.CONFIGS as u64;
    }
    if id==4{
        BOOTS[id].console=try handles.install(&STATES[id].table,handles.CONSOLE,gui.INPUT_OBJECT,handles.READ|handles.WRITE);
        BOOTS[id].reserved3=gui.DESCRIPTOR;
    }
    if id==5||id==6{
        let manager=try handles.install(&STATES[id].table,handles.PROCESS_MANAGER,MANAGER_OBJECT,handles.READ|handles.WRITE|handles.WAIT);
        BOOTS[id].reserved0=manager;BOOTS[id].reserved1=procs.CONFIGS as u64;
        BOOTS[id].reserved2=generation;BOOTS[id].reserved3=CLOCK_HZ;
        if id==6{BOOTS[id].configuration=try handles.install(&STATES[id].table,handles.DEVICE_MANAGER,DEVICE_MANAGER_OBJECT,handles.READ|handles.WRITE);}
    }
    if id==13{
        if cfg!=13{return error.Protocol;}
        BOOTS[id].console=try handles.install(&STATES[id].table,handles.ENDPOINT,5,handles.CALL);
        BOOTS[id].channel_address=0x5100_0000;
    }
    if id>=7&&id!=13{
        if cfg>=procs.CONFIGS{return error.Protocol;}
        BOOTS[id].reserved0=argument;
        BOOTS[id].reserved1=cfg as u64;BOOTS[id].reserved2=generation;BOOTS[id].reserved3=CLOCK_HZ;
        if cfg>=14&&cfg<=17{
            BOOTS[id].console=try handles.install(&STATES[id].table,handles.ENDPOINT,4,handles.CALL);
            try desktop.map_client_font(id);
            if cfg==14{try BOOTs_manager(id);BOOTS[id].reserved1=procs.CONFIGS as u64;}
        }
        if cfg==7&&(*CATALOG).states[10].state==proc.READY{
            let peer=(*CATALOG).slot[10];
            BOOTS[id].block=try handles.install(&STATES[id].table,handles.ENDPOINT,peer+1,handles.CALL);
        }
    }
    let boot_page=try memory.anonymous(id,BOOT_ADDRESS);
    try memory.copy_out(id,BOOT_ADDRESS,slice_from_raw_parts((&BOOTS[id]) as *const u8,sizeof(sys.Boot)));
    try memory.readonly_data(id,BOOT_ADDRESS);
    memory.runtime_copy_bytes(&XSTATES[id].bytes[0],&KERNEL_XSTATE.bytes[0],1024);
    // This one-shot owner publication is the final fallible identity step.
    // A Boot mapping failure must leave the optional driver attachable.
    if GRAPHICS{try shared.bind_owner(id,((id as u64+1)<<32)|generation);}
    if id==13{try device_host.xhci_attach(id,((id as u64+1)<<32)|generation,generation);}
}return;}
unsafe fn BOOTs_common(id:usize)void{unsafe{
    BOOTS[id].process=id as u64+1;BOOTS[id].service_count=3;if GRAPHICS{BOOTS[id].service_count=7;}
    BOOTS[id].channel_address=0x5000_0000;if id==2{BOOTS[id].channel_address=0x5100_0000;}
    if id==3{BOOTS[id].channel_address=0x5200_0000;}if id==4{BOOTS[id].channel_address=desktop.INPUT_QUEUE;}
    if id>=7{BOOTS[id].channel_address=0x5300_0000+(id as u64-7)*0x10000;}
}return;}
unsafe fn BOOTs_region(id:usize)void{unsafe{
    BOOTS[id].reserved1=devices.region_first();BOOTS[id].reserved2=devices.region_last();BOOTS[id].reserved3=CLOCK_HZ;
}return;}
unsafe fn BOOTs_manager(id:usize)!void{unsafe{
    BOOTS[id].configuration=try handles.install(&STATES[id].table,handles.PROCESS_MANAGER,MANAGER_OBJECT,handles.READ|handles.WRITE|handles.WAIT);
}return;}
unsafe fn load_base(id:usize,image:[]const u8)!void{unsafe{
    if GRAPHICS{try memory.load_random(id,image);}
    else{try memory.load(id,image,0x1000_0000+id as u64*0x0100_0000,memory.STACK_TOP-id as u64*0x0100_0000);}
}return;}
pub unsafe fn prepare(kernel_physical:u64)!void{unsafe{
    if INFO.process_count!=0{return error.Protocol;}
    if !resources.is_applied(){try resources.apply();}
    var anchor=resources.Block{physical:0,virtual:0,pages:0};try resources.allocate(1,1,&anchor);
    try devices.initialize();try memory.initialize(kernel_physical);
    var clock=platform.EMPTY_REPORT;try platform.describe(&clock);if clock.tsc_hz==0{return error.Protocol;}CLOCK_HZ=clock.tsc_hz;
    if GRAPHICS{
        try memory.enable_arena(16384);
        var model=anchor;try resources.allocate((sizeof(procs.Catalog)+4095)/4096,1,&model);
        CATALOG=model.virtual as *procs.Catalog;try procs.initialize(CATALOG,CLOCK_HZ);boot_trace.configure((*CATALOG).count,0x3c000);try device_host.initialize();try shared.initialize();
    }
    var image=bundle.Contents{pointer:null,length:0};
    try resources.find("shell",&image);try load_base(0,slice_from_raw_parts(image.pointer,image.length));
    try resources.find("fs",&image);try load_base(1,slice_from_raw_parts(image.pointer,image.length));
    try resources.find("block",&image);try load_base(2,slice_from_raw_parts(image.pointer,image.length));
    if GRAPHICS{
        try resources.find("compositor",&image);try memory.load_random(3,slice_from_raw_parts(image.pointer,image.length));
        try resources.find("input",&image);try memory.load_random(4,slice_from_raw_parts(image.pointer,image.length));
        try desktop.prepare(3,4);
        let keyboard_page=try memory.anonymous(4,console.ADDRESS);
        KEYBOARD=(try memory.owned_alias(4,console.ADDRESS,true)) as *console.Queue;
        try memory.share(4,0,console.ADDRESS,false);
        try resources.find("init",&image);try memory.load_random(5,slice_from_raw_parts(image.pointer,image.length));
        try procs.start(CATALOG,5,5,0,&SNAPSHOT);boot_trace.event(trace.SERVICE_START,5,SNAPSHOT.generation,(*CATALOG).configs[5].dependencies);
    }
    var i:usize=0;while i<16{
        let a=try memory.anonymous(0,0x5000_0000+i as u64*4096);try memory.share(0,1,0x5000_0000+i as u64*4096,true);
        let b=try memory.anonymous(1,0x5100_0000+i as u64*4096);try memory.share(1,2,0x5100_0000+i as u64*4096,true);
        if GRAPHICS{let c=try memory.anonymous(1,0x5200_0000+i as u64*4096);try memory.share(1,3,0x5200_0000+i as u64*4096,true);}
        i+=1;
    }
    if GRAPHICS{
        var app:usize=7;while app<COUNT{if app==13{app+=1;continue;}i=0;while i<16{
            let channel=try memory.anonymous(1,0x5300_0000+(app as u64-7)*0x10000+i as u64*4096);i+=1;
        }try probe_pages(app);app+=1;}
    }
    sched_xstate_save(&KERNEL_XSTATE.bytes[0]);
    var loaded:usize=3;if GRAPHICS{loaded=6;}
    i=0;while i<loaded{try install_identity(i,i,1,0);if GRAPHICS&&i<5{PRELOADED[i]=true;STATES[i].waiting=4;}i+=1;}
    INFO.process_count=loaded as u64;INFO.steps=7;
    INFO.shell_root=(*process(0)).root;INFO.fs_root=(*process(1)).root;INFO.block_root=(*process(2)).root;
    INFO.bundle_physical=(*resources.plan_pointer()).bundle.physical;INFO.arena_physical=(*resources.plan_pointer()).arena.physical;
    INFO.start_tsc=arch.read_tsc();
}return;}
unsafe fn authority(token:u64,kind:u64,rights:u64)!u64 {
    unsafe { var found=handles.EMPTY_VIEW; try handles.lookup(&STATES[CURRENT].table,token,kind,rights,&found); return found.object; }
}
unsafe fn endpoint(token:u64,rights:u64)!usize {
    unsafe { let object=try authority(token,handles.ENDPOINT,rights);
        if object==0 || object>ACTIVE as u64 { return error.Protocol; } return (object-1) as usize; }
}

unsafe fn pending_call_enqueue(id:usize,frame:*abi.Frame)!void{unsafe{
    if CATALOG==null||!SMP_ENABLED||CURRENT>=ACTIVE||id>=ACTIVE||STATES[CURRENT].waiting!=0
        ||PENDING_CALLS[CURRENT].sequence!=0||PENDING_CALL_SEQUENCE==0xffff_ffff_ffff_ffff{return error.Protocol;}
    let owner=(ENDPOINTS[id].owner-1) as usize;
    if owner>=ACTIVE||owner==CURRENT||!managed(CURRENT)||!managed(owner)||ENDPOINTS[id].live!=1{return error.proc.PeerGone;}
    PENDING_CALL_SEQUENCE+=1;
    var pending=EMPTY_PENDING_CALL;pending.sequence=PENDING_CALL_SEQUENCE;pending.endpoint=id as u64;
    pending.identity=ENDPOINTS[id].identity;pending.caller=owner_key(CURRENT);pending.owner=owner_key(owner);
    pending.capability=(*frame).rdi;pending.reply=(*frame).rdx;
    var byte:usize=0;while byte<64{pending.bytes[byte]=BUFFER[byte];byte+=1;}
    PENDING_CALLS[CURRENT]=pending;STATES[CURRENT].ticket=0;STATES[CURRENT].reply_pointer=pending.reply;STATES[CURRENT].waiting=6;
}return;}
unsafe fn pending_call_finish(slot:usize,status:u64)void{unsafe{
    PENDING_CALLS[slot]=EMPTY_PENDING_CALL;STATES[slot].waiting=0;(*process(slot)).frame.rax=status;
}return;}
// Only ordinary CALL/RECEIVE/REPLY and revoke paths invoke this function.
// None is classified as a read-only policy=1 syscall. Queue projection and
// read-only yield/IRQ polling never admit calls or touch capability lifetime.
unsafe fn pending_call_pump(id:usize)!void{unsafe{
    if CATALOG==null||!SMP_ENABLED{return;}
    if id>=ACTIVE{return error.Protocol;}
    var pass:usize=0;while pass<COUNT&&ENDPOINTS[id].state==ipc.IDLE{
        var slot=NONE;var sequence:u64=0xffff_ffff_ffff_ffff;var scan:usize=0;
        while scan<ACTIVE{let item=PENDING_CALLS[scan];
            if item.sequence!=0&&item.endpoint==id as u64&&(slot==NONE||item.sequence<sequence){slot=scan;sequence=item.sequence;}
            scan+=1;
        }
        if slot==NONE{return;}
        let pending=PENDING_CALLS[slot];
        // A stale record must never alter a reused process's saved Frame.
        if !managed(slot)||pending.caller!=owner_key(slot){return error.Protocol;}
        if STATES[slot].waiting!=6||STATES[slot].ticket!=0||STATES[slot].reply_pointer!=pending.reply{return error.Protocol;}
        let owner=(ENDPOINTS[id].owner-1) as usize;
        if ENDPOINTS[id].live!=1||ENDPOINTS[id].identity!=pending.identity||owner>=ACTIVE||!managed(owner)
            ||pending.owner!=owner_key(owner){pending_call_finish(slot,0x0511_0008);pass+=1;continue;}
        var permit=handles.EMPTY_VIEW;var status:u64=0;
        match handles.lookup(&STATES[slot].table,pending.capability,handles.ENDPOINT,handles.CALL,&permit){ok=>{},err(e)=>{status=e;},}
        if status==0&&permit.object!=id as u64+1{status=0x050b_0002;}
        if status==0{match memory.check_range(slot,pending.reply,64,true){ok=>{},err(e)=>{status=e;},}}
        if status!=0{pending_call_finish(slot,status);pass+=1;continue;}
        var ticket:u64=0;match ipc.call(&ENDPOINTS[id],slot as u64+1,pending.bytes[..]){ok(value)=>{ticket=value;},err(e)=>{status=e;},}
        if status!=0{pending_call_finish(slot,status);pass+=1;continue;}
        // Only the original core's successful admission publishes a ticket,
        // consumes endpoint capacity and clears the old capability offer.
        CAP_OFFERS[id]=capnotify.EMPTY_DELIVERY;
        PENDING_CALLS[slot]=EMPTY_PENDING_CALL;STATES[slot].ticket=ticket;STATES[slot].waiting=1;INFO.calls+=1;
        if STATES[owner].waiting==2{try accept(id);}return;
    }
}return;}
unsafe fn pending_calls_departed(id:usize)void{unsafe{
    var slot:usize=0;while slot<ACTIVE{let pending=PENDING_CALLS[slot];
        if pending.sequence!=0{
            if slot==id{PENDING_CALLS[slot]=EMPTY_PENDING_CALL;}
            else if (pending.owner>>32)==id as u64+1{
                // Same-incarnation queued callers receive peer loss without
                // fabricating a reply or assigning an endpoint ticket.
                if managed(slot)&&pending.caller==owner_key(slot)&&STATES[slot].waiting==6{pending_call_finish(slot,0x0511_0008);}
                else{PENDING_CALLS[slot]=EMPTY_PENDING_CALL;}
            }
        }slot+=1;
    }
}return;}

unsafe fn accept(id:usize)!void {
    unsafe {
        let owner=(ENDPOINTS[id].owner-1) as usize;
        var message=ipc.EMPTY_MESSAGE; var token:u64=0;
        try ipc.accept(&ENDPOINTS[id],owner as u64+1,&message,&token);
        try memory.copy_out(owner,STATES[owner].receive_pointer,message.bytes[..]);
        STATES[owner].waiting=0; (*process(owner)).frame.rax=0; (*process(owner)).frame.rdx=token;
    }
    return;
}
unsafe fn managed(slot:usize)bool{unsafe{
    if slot>=ACTIVE||(*process(slot)).ready!=1{return false;}
    return CATALOG==null||procs.current(CATALOG,slot)!=procs.NONE;
}}
unsafe fn wake_waiters()!void{unsafe{
    if CATALOG==null{return;}
    var id:usize=0;while id<ACTIVE{
        if STATES[id].waiting==3&&managed(id){
            var status:u64=0;var found=false;
            match procs.event(CATALOG,id,WAIT_AFTER[id],&EVENT){ok(value)=>{found=value;},err(e)=>{status=e;},}
            if !found&&status==0&&WAIT_DEADLINE[id]!=0&&arch.read_tsc()>=WAIT_DEADLINE[id]{status=0x0511_0007;}
            if found{try memory.copy_out(id,WAIT_POINTER[id],slice_from_raw_parts((&EVENT) as *const u8,sizeof(proc.Event)));}
            if found||status!=0{STATES[id].waiting=0;(*process(id)).frame.rax=status;}
        }id+=1;
    }
}return;}
unsafe fn runnable()!usize{unsafe{
    try wake_waiters();try wake_irqs();var step:usize=1;
    while step<ACTIVE{let candidate=(CURRENT+step)%ACTIVE;
        if managed(candidate)&&STATES[candidate].waiting==0{return candidate;}step+=1;
    }
    if managed(CURRENT)&&STATES[CURRENT].waiting==0{return CURRENT;}
    if SMP_ENABLED{return NONE;}
}return error.Protocol;}
unsafe fn manager(token:u64,right:u64)!void{unsafe{
    if CATALOG==null||(try authority(token,handles.PROCESS_MANAGER,right))!=MANAGER_OBJECT
        ||(CURRENT!=0&&CURRENT!=3&&CURRENT!=5&&CURRENT!=6&&procs.current(CATALOG,CURRENT)!=14){return error.Protocol;}
}return;}
unsafe fn close_table(id:usize)!void{unsafe{
    var i:usize=0;while i<32{let item=STATES[id].table.entries[i];
        if item.live==1{try capnotify.close(&CAP_NOTICES,&STATES[id].table,(item.generation<<8)|i as u64+1);}i+=1;
    }
}return;}
var CANCELED:[COUNT]u64=[0;COUNT];
unsafe fn revoke_loaded(id:usize,incarnation:u64)!void{unsafe{
    cap_departed(id);
    pending_calls_departed(id);STATES[id].waiting=9;
    // An unstarted preload has no published incarnation or filesystem
    // session. Do not fabricate a departure for its future first generation.
    if incarnation!=0{DEPARTED[id]=incarnation;}FS_RIGHTS[id]=0;
    try device_host.revoke_owner(((id as u64+1)<<32)|incarnation);
    var ep:usize=0;while ep<ACTIVE{
        if ENDPOINTS[ep].live==1{
            let caller=ENDPOINTS[ep].caller;
            if ENDPOINTS[ep].owner==id as u64+1&&caller!=0&&caller<=ACTIVE as u64&&caller!=id as u64+1{
                let other=(caller-1) as usize;

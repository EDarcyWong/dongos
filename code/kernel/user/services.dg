unsafe fn wake_irqs()!void{unsafe{
    if CATALOG==null{return;}
    var id:usize=0;while id<ACTIVE{
        if STATES[id].waiting==5&&managed(id){
            var view=handles.EMPTY_VIEW;var status:u64=0;
            let permit=handles.lookup(&STATES[id].table,IRQ_TOKEN[id],handles.INTERRUPT,handles.WAIT,&view);
            match permit{ok=>{},err(e)=>{status=e;},}
            if status==0{let polled=device_host.poll_irq(view.object,owner_key(id),IRQ_AFTER[id]);
                match polled{ok=>{
                    device_host.IRQ.token=IRQ_TOKEN[id];
                    try memory.copy_out(id,IRQ_POINTER[id],slice_from_raw_parts((&device_host.IRQ) as *const u8,sizeof(dev.Irq)));
                    STATES[id].waiting=0;(*process(id)).frame.rax=0;
                },err(e)=>{if e!=0x0512_0006{status=e;}},}
            }
            if status==0&&STATES[id].waiting==5&&IRQ_DEADLINE[id]!=0&&arch.read_tsc()>=IRQ_DEADLINE[id]{status=0x0512_0007;}
            if status!=0{STATES[id].waiting=0;(*process(id)).frame.rax=status;}
        }id+=1;
    }
}return;}
unsafe fn cap_source(actor:usize,offer:*const capabi.Offer)!void{unsafe{
    var value=handles.EMPTY_VIEW;try capnotify.validate(&CAP_NOTICES,&STATES[actor].table,offer,&value);
    if value.kind==handles.ENDPOINT{
        if value.object==0||value.object>ACTIVE as u64{return error.Protocol;}
        let peer=(value.object-1) as usize;
        if !managed(peer)||ENDPOINTS[peer].live!=1||ENDPOINTS[peer].owner!=value.object{return error.proc.PeerGone;}
    }
}return;}
unsafe fn cap_departed(id:usize)void{unsafe{
    var ep:usize=0;while ep<ACTIVE{
        let item=CAP_OFFERS[ep];
        if item.live==1&&((item.caller>>32)==id as u64+1||(item.receiver>>32)==id as u64+1){CAP_OFFERS[ep]=capnotify.EMPTY_DELIVERY;}
        ep+=1;
    }
}return;}
unsafe fn capability_call(frame:*abi.Frame)!usize{unsafe{
    if CATALOG==null||!managed(CURRENT){return error.Protocol;}
    let code=(*frame).rax;
    if code==capabi.CREATE{
        if (*frame).rdx!=0||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
        try memory.check_range(CURRENT,(*frame).rdi,8,true);
        let token=try capnotify.create(&CAP_NOTICES,&STATES[CURRENT].table,(*frame).rsi);
        try memory.copy_out(CURRENT,(*frame).rdi,slice_from_raw_parts((&token) as *const u8,8));
        (*frame).rax=0;return CURRENT;
    }
    if code==capabi.SIGNAL{
        if (*frame).rdx!=0||(*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
        try capnotify.signal(&CAP_NOTICES,&STATES[CURRENT].table,(*frame).rdi,(*frame).rsi);
        (*frame).rax=0;return CURRENT;
    }
    if code==capabi.TAKE{
        if (*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
        try memory.check_range(CURRENT,(*frame).rdx,8,true);var bits:u64=0;
        try capnotify.take(&CAP_NOTICES,&STATES[CURRENT].table,(*frame).rdi,(*frame).rsi,&bits);
        try memory.copy_out(CURRENT,(*frame).rdx,slice_from_raw_parts((&bits) as *const u8,8));
        (*frame).rax=0;return CURRENT;
    }
    if code==capabi.EXPORT_ENDPOINT{
        if (*frame).r10!=0||(*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
        let id=try endpoint((*frame).rdi,handles.WAIT|handles.REPLY);
        if id!=CURRENT||ENDPOINTS[id].owner!=CURRENT as u64+1||ENDPOINTS[id].live!=1
            ||((*frame).rdx&handles.CALL)==0||((*frame).rdx&~(handles.CALL|handles.TRANSFER))!=0{return error.Protocol;}
        try memory.check_range(CURRENT,(*frame).rsi,8,true);
        let token=try handles.install(&STATES[CURRENT].table,handles.ENDPOINT,CURRENT as u64+1,(*frame).rdx);
        try memory.copy_out(CURRENT,(*frame).rsi,slice_from_raw_parts((&token) as *const u8,8));
        (*frame).rax=0;return CURRENT;
    }
    if code==capabi.CALL_CAP{
        if (*frame).r8!=0||(*frame).r9!=0{return error.Protocol;}
        let id=try endpoint((*frame).rdi,handles.CALL);let owner=(ENDPOINTS[id].owner-1) as usize;
        if owner==CURRENT||owner>=ACTIVE{return error.Protocol;}
        if !managed(owner)||ENDPOINTS[id].live!=1{return error.proc.PeerGone;}
        try memory.check_range(CURRENT,(*frame).rdx,64,true);
        var offer=capabi.EMPTY_OFFER;
        try memory.copy_in(CURRENT,(*frame).r10,slice_from_raw_parts((&offer) as *u8,sizeof(capabi.Offer)));
        try cap_source(CURRENT,&offer);
        try memory.copy_in(CURRENT,(*frame).rsi,BUFFER[..64]);
        let ticket=try ipc.call(&ENDPOINTS[id],CURRENT as u64+1,BUFFER[..64]);
        CAP_OFFERS[id]=capnotify.Delivery{live:1,caller:owner_key(CURRENT),receiver:owner_key(owner),ticket:ticket,offer:offer};
        STATES[CURRENT].ticket=ticket;STATES[CURRENT].reply_pointer=(*frame).rdx;STATES[CURRENT].waiting=1;
        INFO.calls+=1;if STATES[owner].waiting==2{try accept(id);}

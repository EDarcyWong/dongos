pub fn dma_pinned(id:usize)bool { unsafe { return id>=LIMIT || PINNED[id]; } }
pub fn generation(id:usize)u64 { unsafe { if id>=LIMIT { return 0; }return GENERATIONS[id]; } }

// Scan only the private user branch. All present entries there have U/S=1;
// intermediate-table PAs are disjoint held BSS/arena table allocations and
// cannot equal an owned user-RAM frame.
unsafe fn referenced(physical:u64)bool {
    unsafe {
        var id:usize=0;
        while id<LIMIT {
            if PROCESSES[id].ready!=0 {
                var table:usize=1;
                while table<pool_pages(id) {
                    if META[id][table]!=0 {
                        var slot:usize=0;
                        while slot<512 {
                            let entry=(*table_at(id,table)).entries[slot];
                            if (entry&5)==5 && (entry&0x000f_ffff_ffff_f000)==physical { return true; }
                            slot+=1;
                        }
                    }
                    table+=1;
                }
            }
            id+=1;
        }
    }return false;
}

// BSP/IF=0 only. No AP executes these roots. The caller first removes the
// process from scheduling and revokes its capabilities/IPC. Drivers with a
// live DMA lease are deliberately ineligible: keeping their RAM is mandatory.
// The current root may not be destroyed. A failure remains fail-stop/held.
pub unsafe fn destroy(id:usize)!void {
    unsafe {
        if UNSHARE_FAILED||STAGE_FAILED||STAGE_ID!=LIMIT||id>=LIMIT || PROCESSES[id].ready!=1 || PINNED[id] || user_current_root()==PROCESSES[id].root { return error.InvalidState; }
        let root=PROCESSES[id].root;
        PROCESSES[id].ready=0;
        atomic_store(&(*table_at(id,0)).entries[0],0);
        compiler_fence();user_pcid_flush_all();compiler_fence();
        if user_pcid_unbind(id as u64,root)!=1 { return error.InvalidState; }
        try reference_batch();
        // The detached private tables still contain the retiring root's USER
        // leaves. Only RAM referenced by those entries can lose its final
        // reference in this operation. Do not scan every desktop/cache frame
        // against every live tree. Intermediate table PAs and external device
        // or bundle pages are disjoint from owned Frame allocations.
        var table:usize=1;
        while table<pool_pages(id) {
            if META[id][table]!=0 {
                var slot:usize=0;
                while slot<512 {
                    let entry=(*table_at(id,table)).entries[slot];
                    if (entry&5)==5 {
                        match frame_index(entry&0x000f_ffff_ffff_f000) {
                            ok(index)=>{if *recycled(index)==0{*recycled(index)=4;}},
                            err(code)=>{},
                        }
                    }
                    slot+=1;
                }
            }
            table+=1;
        }
        var index:usize=0;
        while index<FRAME_COUNT {
            if *recycled(index)==4 {
                if referenced_frame(index) {
                    *recycled(index)=0;index+=1;continue;
                }
                // Executable USER aliases are gone and their translations
                // retired before restoring a writable supervisor alias.
                if (*record(index)).writable==0 {
                    try paging.protect_live(startup.space_pointer(),(*record(index)).virtual,paging.WRITE);
                    devices.runtime_invalidate((*record(index)).virtual);
                    user_pcid_flush_all();(*record(index)).writable=1;
                }
                *recycled(index)=1;
            if index<REUSE_FROM{REUSE_FROM=index;}
            }
            index+=1;
        }
        table=0;
        while table<pool_pages(id) {
            var slot:usize=0;
            while slot<512 { (*table_at(id,table)).entries[slot]=0;slot+=1; }
            META[id][table]=0;table+=1;
        }
        SPACES[id]=paging.EMPTY_SPACE;PROCESSES[id]=EMPTY_PROCESS;
    }return;
}

pub unsafe fn check_range(id: usize, address: u64, bytes: usize, write: bool) !void {
    unsafe {
        if OBJECT_FAILED || id >= LIMIT || PROCESSES[id].ready == 0 || address < elf.USER_MIN || address >= elf.USER_LIMIT
            || (bytes as u64) > elf.USER_LIMIT - address { return error.InvalidAddress; }
        if bytes == 0 { return; }
        var page = address & ~4095;
        let last = (address + bytes as u64 - 1) & ~4095;
        loop {
            var m = paging.Mapping { physical: 0, flags: 0 };
            try paging.query(&SPACES[id],page,&m);
            if (m.flags & paging.USER) == 0 || (write && (m.flags & paging.WRITE) == 0) { return error.InvalidAccess; }
            let checked_alias = try copy_alias(id,page,&m,write);
            if page == last { break; }
            page += 4096;
        }
    }
    return;
}

// Trusted BSP borrow only: the owner remains live and its mapping cannot be
// changed/destroyed for this borrow's lifetime. No MMIO/resource mapping can
// manufacture an alias; only an owned RAM Frame is eligible. Callers caching
// this pointer must revoke it before process retirement or permission change.
pub unsafe fn owned_alias(id:usize,virtual:u64,write:bool)!u64 {
    unsafe {
        try check_range(id,virtual,1,write);
        var mapping=paging.Mapping { physical:0,flags:0 };
        try paging.query(&SPACES[id],virtual&~4095,&mapping);
        return try copy_alias(id,virtual,&mapping,write);
    }
}

// Complete-range prevalidation precedes all copies. Kernel dereferences only
// owned supervisor aliases, so SMAP stays enabled and AC stays zero.
pub unsafe fn copy_in(id: usize, address: u64, output: []u8) !void {
    unsafe {
        try check_range(id,address,output.len,false);
        var offset: usize = 0;
        while offset < output.len {
            let current = address + offset as u64;
            var m = paging.Mapping { physical: 0, flags: 0 };
            try paging.query(&SPACES[id],current & ~4095,&m);
            let alias = try copy_alias(id,current,&m,false);
            let available = 4096 - ((current & 4095) as usize);
            let left = output.len - offset;
            var count = available;
            if left < count { count = left; }
            runtime_copy_bytes(output.ptr + offset,alias as *const u8,count);
            offset += count;
        }
    }
    return;
}
pub unsafe fn copy_out(id: usize, address: u64, input: []const u8) !void {
    unsafe {
        try check_range(id,address,input.len,true);
        var offset: usize = 0;
        while offset < input.len {
            let current = address + offset as u64;
            var m = paging.Mapping { physical: 0, flags: 0 };
            try paging.query(&SPACES[id],current & ~4095,&m);
            let alias = try copy_alias(id,current,&m,true);
            let available = 4096 - ((current & 4095) as usize);
            let left = input.len - offset;
            var count = available;
            if left < count { count = left; }
            runtime_copy_bytes(alias as *u8,input.ptr + offset,count);
            offset += count;
        }
    }
    return;
}

// Privileged setup-only shared data mapping. The caller has not entered any
// of these roots yet; they are never changed behind a running CPU.
pub unsafe fn anonymous(id: usize, virtual: u64) !u64 {
    unsafe {
        if id >= LIMIT || PROCESSES[id].ready == 0 || virtual < elf.USER_MIN || virtual >= elf.USER_LIMIT || (virtual & 4095) != 0 {
            return error.InvalidAddress;
        }
        let index = try page(id,virtual,paging.WRITE);
        return (*record(index)).physical;
    }
}
pub unsafe fn share(source: usize, target: usize, virtual: u64, write: bool) !void {
    unsafe { return share_at(source,target,virtual,virtual,write); }
}

// DMA ownership covers the entire rounded allocation, including a suffix
// whose Frame/USER mapping was never published. Never manufacture a second
// USER alias through the ordinary sharing API, even for an incomplete lease.
unsafe fn dma_reserved(physical:u64)bool {unsafe{
    var id:usize=0;while id<LIMIT{
        let lease=DMA_LEASES[id];
        if lease.state!=0&&lease.physical!=0&&physical>=lease.physical
            &&(physical-lease.physical)/4096<lease.pages{return true;}
        id+=1;
    }
    return false;
}}

// Owned data only, BSP/IF=0. Both roots and the source allocation remain
// stable throughout publication. The target must be absent; map_live performs
// that complete preflight before allocating tables or publishing any entry.
pub unsafe fn share_at(source:usize,target:usize,source_virtual:u64,target_virtual:u64,write:bool)!void {
    unsafe {
        if source >= LIMIT || target >= LIMIT || PROCESSES[source].ready == 0 || PROCESSES[target].ready == 0
            || source_virtual < elf.USER_MIN || source_virtual >= elf.USER_LIMIT || (source_virtual & 4095) != 0
            || target_virtual < elf.USER_MIN || target_virtual >= elf.USER_LIMIT || (target_virtual & 4095) != 0
            || 4096>elf.USER_LIMIT-source_virtual || 4096>elf.USER_LIMIT-target_virtual { return error.InvalidAddress; }
        var mapping = paging.Mapping { physical: 0, flags: 0 };
        try paging.query(&SPACES[source],source_virtual,&mapping);
        if (mapping.flags & (paging.USER | paging.EXECUTE | paging.UNCACHED)) != paging.USER
            || (write && (mapping.flags & paging.WRITE) == 0) { return error.InvalidAccess; }
        if dma_reserved(mapping.physical){return error.InvalidAccess;}
        let index = try frame_index(mapping.physical);
        if write&&(*record(index)).writable!=1 { return error.InvalidAccess; }
        var flags = paging.USER;
        if write { flags |= paging.WRITE; }
        try paging.map_live(&SPACES[target],target_virtual,mapping.physical,flags);
        devices.runtime_invalidate(target_virtual);
        user_pcid_invalidate_root(PROCESSES[target].root);
    }
    return;
}

// Exclusive BSP publication of a device grant. The privileged caller must
// verify the physical MMIO range and lifetime; ordinary user-copy rejects it
// because this mapping has no owned RAM Frame record.
pub unsafe fn map_device(id: usize, virtual: u64, physical: u64, bytes: u64) !void {
    unsafe {
        if id >= LIMIT || PROCESSES[id].ready == 0 || virtual < elf.USER_MIN || virtual >= elf.USER_LIMIT
            || bytes == 0 || (virtual & 4095) != 0 || (physical & 4095) != 0 || (bytes & 4095) != 0
            || bytes > elf.USER_LIMIT - virtual || physical == 0 || physical >= 0x1_0000_0000_0000
            || bytes > 0x1_0000_0000_0000 - physical { return error.InvalidAddress; }
        var offset: u64 = 0;
        while offset < bytes {
            try paging.map_live(&SPACES[id],virtual + offset,physical + offset,paging.USER | paging.WRITE | paging.UNCACHED);
            devices.runtime_invalidate(virtual + offset);
            offset += 4096;
        }
        user_pcid_invalidate_root(PROCESSES[id].root);
    }
    return;
}

// Setup-only immutable bundle view; the trusted bridge has already validated
// the whole payload hash and zero padding. No RAM owner or writable alias is
// manufactured, and ordinary syscall copy rejects these external frames.
pub unsafe fn map_resource(id:usize,virtual:u64,physical:u64,bytes:u64)!void {
    unsafe {
        if id>=LIMIT || PROCESSES[id].ready==0 || virtual<elf.USER_MIN || virtual>=elf.USER_LIMIT
            || bytes==0 || (virtual&4095)!=0 || (physical&4095)!=0 || (bytes&4095)!=0
            || bytes>elf.USER_LIMIT-virtual || physical==0 || physical>=0x1_0000_0000
            || bytes>0x1_0000_0000-physical { return error.InvalidAddress; }
        var offset:u64=0;
        while offset<bytes {
            try paging.map_live(&SPACES[id],virtual+offset,physical+offset,paging.USER);
            devices.runtime_invalidate(virtual+offset);offset+=4096;
        }
        user_pcid_invalidate_root(PROCESSES[id].root);
    }
    return;
}

// A bounded coherent DMA allocation. The whole power-of-two block remains
// held for the service lifetime; no page can be recycled behind a live device.
pub unsafe fn contiguous(id: usize, virtual: u64, requested: usize) !u64 {
    unsafe {
        if id >= LIMIT || PROCESSES[id].ready == 0 || PINNED[id] || DMA_LEASES[id].state!=0
            || PROCESSES[id].root==0 || GENERATIONS[id]==0 || requested == 0 || requested > 32
            || virtual < elf.USER_MIN || virtual >= elf.USER_LIMIT || (virtual & 4095) != 0 {
            return error.InvalidAddress;
        }
        var order: usize = 0; var pages: usize = 1;
        while pages < requested { pages *= 2; order += 1; }
        if FRAME_COUNT>capacity() || pages > capacity() - FRAME_COUNT || (pages as u64) * 4096 > elf.USER_LIMIT - virtual { return error.Capacity; }
        // Reserve metadata and pin before any allocator side effect. Even an
        // allocation failure is retained; a retry must not overwrite evidence.
        DMA_LEASES[id]=DmaLease {physical:0,virtual:virtual,pages:pages,root:PROCESSES[id].root,
            generation:GENERATIONS[id],attempted:0,mapped:0,state:DMA_HELD};
        PINNED[id]=true;
        var physical:u64=0;
        if EXTENDED!=null {
            var held=resources.Block { physical:0,virtual:0,pages:0 };
            try resources.reserve(pages,pages,&held);physical=held.physical;
        } else { physical=try buddy.alloc(startup.allocator_pointer(),order); }
        DMA_LEASES[id].physical=physical;
        var offset: usize = 0;
        while offset < pages {
            // own_frame itself can fail after publishing supervisor metadata.
            // Record the attempted page before entering it, not just successes.
            DMA_LEASES[id].attempted=offset+1;
            let index = try own_frame(physical + offset as u64 * 4096);
            *recycled(index)=2;
            try paging.map_live(&SPACES[id],virtual + offset as u64 * 4096,(*record(index)).physical,paging.USER | paging.WRITE);
            DMA_LEASES[id].mapped=offset+1;
            devices.runtime_invalidate(virtual + offset as u64 * 4096);
            offset += 1;
        }
        user_pcid_invalidate_root(PROCESSES[id].root);
        DMA_LEASES[id].state=DMA_COMPLETE;
        return physical;
    }
}

pub unsafe fn readonly_data(id: usize,virtual: u64) !void {
    unsafe {
        if id>=LIMIT || PROCESSES[id].ready==0 || (virtual&4095)!=0 { return error.InvalidState; }
        try check_range(id,virtual,4096,true);
        try paging.protect_live(&SPACES[id],virtual,paging.USER);
        devices.runtime_invalidate(virtual);
        user_pcid_invalidate_root(PROCESSES[id].root);
    }
    return;
}

// Trusted desktop bridge only: external bundle pages remain immutable/held.
// No user address or PA is accepted by the public syscall selecting this path.
pub var RESOURCE_FAILED:bool=false;
fn resource_page(physical:u64,bytes:u64,offset:u64)u64 {
    let rounded=((bytes+4095)/4096)*4096;
    if offset<rounded { return physical+offset; }return physical+rounded-4096;
}
pub unsafe fn resource_aperture(id:usize,virtual:u64,physical:u64,bytes:u64)!void {
    unsafe {
        if id!=3 || virtual!=0x7200_0000 || bytes<48 || bytes>0x80_0000 || (physical&4095)!=0
            || physical==0 || physical>=0x1_0000_0000 || bytes>0x1_0000_0000-physical { return error.InvalidAddress; }
        var offset:u64=0;while offset<0x80_0000 {
            try paging.map_live(&SPACES[id],virtual+offset,resource_page(physical,bytes,offset),paging.USER);
            devices.runtime_invalidate(virtual+offset);offset+=4096;
        }
        user_pcid_invalidate_root(PROCESSES[id].root);
    }return;
}
pub unsafe fn readonly_alias(id:usize,virtual:u64)!u64 {
    unsafe {
        if id!=3 || virtual!=0x7000_1000 { return error.InvalidAddress; }
        var m=paging.Mapping { physical:0,flags:0 };try paging.query(&SPACES[id],virtual,&m);
        if m.flags!=paging.USER { return error.InvalidAccess; }
        let index=try frame_index(m.physical);if (*record(index)).writable!=1 { return error.InvalidAccess; }
        return (*record(index)).virtual;
    }
}
pub unsafe fn replace_resource_aperture(id:usize,virtual:u64,old_physical:u64,old_bytes:u64,physical:u64,bytes:u64)!void {
    unsafe {
        if id!=3 || virtual!=0x7200_0000 || RESOURCE_FAILED || PROCESSES[id].ready!=1
            || old_bytes<48 || old_bytes>0x80_0000 || bytes<48 || bytes>0x80_0000
            || physical==0 || old_physical==0 || (physical&4095)!=0 || (old_physical&4095)!=0
            || physical>=0x1_0000_0000 || bytes>0x1_0000_0000-physical
            || old_physical>=0x1_0000_0000 || old_bytes>0x1_0000_0000-old_physical { return error.InvalidAddress; }
        var offset:u64=0;while offset<0x80_0000 {
            var m=paging.Mapping { physical:0,flags:0 };try paging.query(&SPACES[id],virtual+offset,&m);
            if m.flags!=paging.USER || m.physical!=resource_page(old_physical,old_bytes,offset) { return error.InvalidAccess; }
            offset+=4096;
        }
        // All structure/PA preflight is complete. An unexpected commit error
        // must stop the service runtime; it may never resume a mixed aperture.
        RESOURCE_FAILED=true;offset=0;
        while offset<0x80_0000 {
            try paging.replace_live(&SPACES[id],virtual+offset,resource_page(physical,bytes,offset),paging.USER);offset+=4096;
        }
        compiler_fence();devices.runtime_flush_root();user_pcid_flush_all();compiler_fence();RESOURCE_FAILED=false;
    }return;
}

// The GUI broker alone supplies held immutable font bundle spans. Ordinary
// callers cannot choose PA/VA or use this mapping as owned RAM. Initial map
// belongs to the active ELF stage and abort_candidate withdraws its complete
// private branch; a later update is an all-page precheck then fail-stop commit.
pub unsafe fn gui_resource_aperture(id:usize,old_physical:u64,old_bytes:u64,physical:u64,bytes:u64)!void {unsafe {
    if RESOURCE_FAILED||UNSHARE_FAILED||STAGE_FAILED||id<7||id>=LIMIT||id==13||PROCESSES[id].ready!=1
        ||GENERATIONS[id]==0||PINNED[id]||user_current_root()==PROCESSES[id].root {return error.InvalidState;}
    if bytes<48||bytes>0x80_0000||physical==0||(physical&4095)!=0||physical>=0x1_0000_0000
        ||bytes>0x1_0000_0000-physical {return error.InvalidAddress;}
    let initial=old_physical==0;
    if initial {
        if old_bytes!=0||!staging(id) {return error.InvalidState;}
        // All 2048 pages must be absent before any table entry is changed.
        try shared_absent(id,0x7200_0000,2048);
    }else {
        if STAGE_ID!=LIMIT||old_bytes<48||old_bytes>0x80_0000||(old_physical&4095)!=0
            ||old_physical>=0x1_0000_0000||old_bytes>0x1_0000_0000-old_physical {return error.InvalidAddress;}
        var offset:u64=0;while offset<0x80_0000 {
            var m=paging.Mapping {physical:0,flags:0};try paging.query(&SPACES[id],0x7200_0000+offset,&m);
            if m.flags!=paging.USER||m.physical!=resource_page(old_physical,old_bytes,offset) {return error.InvalidAccess;}
            offset+=4096;
        }
    }
    // Bundle bytes are outside the Frame allocator. Catch accidental reuse of
    // an owned RAM span even if a privileged broker supplies the wrong span.
    var offset:u64=0;let rounded=((bytes+4095)/4096)*4096;
    while offset<rounded {
        match frame_index(physical+offset) {ok(index)=>{return error.InvalidAccess;},err(code)=>{if code!=0x0406_0005 {return error.NotOwned;}},}
        offset+=4096;
    }
    if !initial&&old_physical==physical&&old_bytes==bytes {return;}
    if !initial {RESOURCE_FAILED=true;}
    offset=0;while offset<0x80_0000 {
        if initial {try paging.map_live(&SPACES[id],0x7200_0000+offset,resource_page(physical,bytes,offset),paging.USER);}
        else {try paging.replace_live(&SPACES[id],0x7200_0000+offset,resource_page(physical,bytes,offset),paging.USER);}
        offset+=4096;
    }
    compiler_fence();devices.runtime_flush_root();user_pcid_flush_all();compiler_fence();
    // An error in the replacement loop never reaches this clear. Initial
    // failures remain abortable stages, before scheduling/catalog publication.
    if !initial {RESOURCE_FAILED=false;}
}return;}

// Exclusive two-root allocation transaction. journal() records each recycled
// selection/new owner before supervisor or USER publication can fail. The
// broker publishes its lease only after this returns success.
unsafe fn shared_absent(id:usize,base:u64,pages:usize)!void{unsafe{
    var page:usize=0;while page<pages{
        var m=paging.Mapping{physical:0,flags:0};
        let queried=paging.query(&SPACES[id],base+page as u64*4096,&m);
        match queried{ok=>{return error.InvalidAccess;},err(code)=>{if code!=0x0203_0002{return queried;}},}
        page+=1;
    }
}return;}
unsafe fn shared_cleanup(source:usize,target:usize,source_base:u64,target_base:u64,source_pages:usize,target_pages:usize)!void{unsafe{
    if source_pages!=0{try unshare_unmap(source,source_base,source_pages);}
    if target_pages!=0{try unshare_unmap(target,target_base,target_pages);}
    // Even a fresh supervisor alias failure may leave a journaled orphan.
    // Its alias must be proven before it can be zeroed/reused; otherwise hold.
    if UNSHARE_COUNT!=0{try unshare_recycle(UNSHARE_COUNT);}
}return;}
unsafe fn shared_candidate(source:usize,target:usize,source_base:u64,target_base:u64,pages:usize,source_pages:*usize,target_pages:*usize)!void{unsafe{
    var page:usize=0;while page<pages{
        let index=try fresh();
        try paging.map_live(&SPACES[source],source_base+page as u64*4096,(*record(index)).physical,paging.USER|paging.WRITE);
        *source_pages+=1;
        try paging.map_live(&SPACES[target],target_base+page as u64*4096,(*record(index)).physical,paging.USER|paging.WRITE);
        *target_pages+=1;page+=1;
    }
}return;}
pub unsafe fn allocate_shared(source:usize,target:usize,source_base:u64,target_base:u64,pages:usize)!void{unsafe{
    if UNSHARE_FAILED||STAGE_FAILED||UNSHARE_ACTIVE||STAGE_ID!=LIMIT||source>=LIMIT||target>=LIMIT||source==target
        ||PROCESSES[source].ready!=1||PROCESSES[target].ready!=1||PINNED[source]||PINNED[target]
        ||user_current_root()==PROCESSES[source].root||user_current_root()==PROCESSES[target].root{return error.InvalidState;}
    if pages==0||pages>UNSHARE_LIMIT||source_base<elf.USER_MIN||source_base>=elf.USER_LIMIT||target_base<elf.USER_MIN||target_base>=elf.USER_LIMIT
        ||(source_base&4095)!=0||(target_base&4095)!=0||pages as u64>(elf.USER_LIMIT-source_base)/4096
        ||pages as u64>(elf.USER_LIMIT-target_base)/4096{return error.InvalidAddress;}
    try shared_absent(source,source_base,pages);try shared_absent(target,target_base,pages);
    if pages>available_frames(){return error.Capacity;}try unshare_scratch();
    UNSHARE_ACTIVE=true;UNSHARE_ALLOCATING=true;UNSHARE_COUNT=0;
    var source_pages:usize=0;var target_pages:usize=0;
    let created=shared_candidate(source,target,source_base,target_base,pages,&source_pages,&target_pages);
    UNSHARE_ALLOCATING=false;
    match created{ok=>{},err(code)=>{
        let cleanup=shared_cleanup(source,target,source_base,target_base,source_pages,target_pages);
        match cleanup{ok=>{UNSHARE_ACTIVE=false;return created;},err(failure)=>{UNSHARE_FAILED=true;return cleanup;},}
    },}
    compiler_fence();user_pcid_invalidate_root(PROCESSES[source].root);user_pcid_invalidate_root(PROCESSES[target].root);user_pcid_flush_all();compiler_fence();
    UNSHARE_ACTIVE=false;
}return;}


// Generic object-owned RAM aperture, distinct from creator FRAMES and resources.
pub var OBJECT_FAILED:bool=false;
var OBJECT_REGISTRY:*object_core.Registry=null;
var OBJECT_RECEIPTS:*paging.Retired=null;
unsafe extern "sysv64" fn user_shared_barrier()u64;
pub unsafe fn object_failed()void{unsafe{OBJECT_FAILED=true;}return;}
pub unsafe fn object_attach(reg:*object_core.Registry)!void{unsafe{
 if OBJECT_REGISTRY!=null||reg==null||(*reg).ready!=1||OBJECT_FAILED{return error.InvalidState;}
 var page:usize=0;while page<128{var m=paging.Mapping{physical:0,flags:0};
  try paging.query(startup.space_pointer(),(*reg).pool_alias+page as u64*4096,&m);
  if m.physical!=(*reg).pool_physical+page as u64*4096||m.flags!=paging.WRITE{return error.NotOwned;}page+=1;
 }
 var block=resources.Block{physical:0,virtual:0,pages:0};
 try resources.allocate((16*sizeof(paging.Retired)+4095)/4096,1,&block);
 OBJECT_RECEIPTS=block.virtual as *paging.Retired;OBJECT_REGISTRY=reg;
}return;}
pub unsafe fn object_slot_precheck(index:usize,pages:usize)!void{unsafe{
 if OBJECT_REGISTRY==null||OBJECT_FAILED||index>=8||pages==0||pages>16{return error.InvalidState;}
 var p:usize=0;while p<pages{var m=paging.Mapping{physical:0,flags:0};
  try paging.query(startup.space_pointer(),object_core.alias(OBJECT_REGISTRY,index)+p as u64*4096,&m);
  if m.physical!=object_core.physical(OBJECT_REGISTRY,index)+p as u64*4096||m.flags!=paging.WRITE{return error.NotOwned;}p+=1;
 }
}return;}
unsafe fn object_alias(id:usize,address:u64,mapping:*const paging.Mapping,write:bool)!u64{unsafe{
 if OBJECT_FAILED||OBJECT_REGISTRY==null||id>=LIMIT||PROCESSES[id].ready!=1
  ||address<object_core.BASE||address>=object_core.BASE+4*object_core.STRIDE{return error.NotOwned;}
 let index=((address-object_core.BASE)/object_core.STRIDE) as usize;let map=(*OBJECT_REGISTRY).maps[id][index];
 let owner=(*OBJECT_REGISTRY).owners[id];
 let confirmed=try object_core.map_get(OBJECT_REGISTRY,id,owner,GENERATIONS[id],(map.generation<<8)|index as u64+1);
 if confirmed!=index||address<map.address||address-map.address>=map.pages as u64*4096
  ||(write&&(map.rights&2)==0){return error.InvalidAccess;}
 let object=try object_core.get(OBJECT_REGISTRY,map.object);let offset=(address-map.address)&~4095;
 var flags=paging.USER;if (map.rights&2)!=0{flags|=paging.WRITE;}
 if (*mapping).physical!=object_core.physical(OBJECT_REGISTRY,object)+offset||(*mapping).flags!=flags{object_core.hold_map(OBJECT_REGISTRY,id,index);OBJECT_FAILED=true;return error.NotOwned;}
 var alias=paging.Mapping{physical:0,flags:0};let supervisor=object_core.alias(OBJECT_REGISTRY,object)+offset;
 try paging.query(startup.space_pointer(),supervisor,&alias);
 if alias.physical!=(*mapping).physical||alias.flags!=paging.WRITE{object_core.hold_map(OBJECT_REGISTRY,id,index);OBJECT_FAILED=true;return error.NotOwned;}
 return supervisor+(address&4095);
}}
unsafe fn copy_alias(id:usize,address:u64,mapping:*const paging.Mapping,write:bool)!u64{unsafe{
 let index=frame_index((*mapping).physical);
 match index{ok(i)=>{
  if write&&(*record(i)).writable==0{return error.InvalidAccess;}
  return (*record(i)).virtual+(address&4095);
 },err(code)=>{return try object_alias(id,address,mapping,write);},}
}}
unsafe fn object_precheck(id:usize,map:*const object_core.Map)!void{unsafe{
 let object=try object_core.get(OBJECT_REGISTRY,(*map).object);try object_slot_precheck(object,(*map).pages);
 var flags=paging.USER;if ((*map).rights&2)!=0{flags|=paging.WRITE;}
 var p:usize=0;while p<(*map).pages{var m=paging.Mapping{physical:0,flags:0};
  try paging.query(&SPACES[id],(*map).address+p as u64*4096,&m);
  if m.physical!=object_core.physical(OBJECT_REGISTRY,object)+p as u64*4096||m.flags!=flags{return error.NotOwned;}p+=1;
 }
}return;}
unsafe fn object_map_commit(id:usize,index:usize)!void{unsafe{
 let map=(*OBJECT_REGISTRY).maps[id][index];let object=try object_core.get(OBJECT_REGISTRY,map.object);
 var flags=paging.USER;if (map.rights&2)!=0{flags|=paging.WRITE;}
 var p:usize=0;while p<map.pages{
  try paging.map_live(&SPACES[id],map.address+p as u64*4096,object_core.physical(OBJECT_REGISTRY,object)+p as u64*4096,flags);p+=1;
 }
 compiler_fence();if user_shared_barrier()!=1{return error.InvalidState;}compiler_fence();
 object_core.publish_map(OBJECT_REGISTRY,id,index);
}return;}
pub unsafe fn object_map(id:usize,owner:u64,object:u64,rights:u64,out:*object_abi.Mapping)!void{unsafe{
 if OBJECT_FAILED||UNSHARE_FAILED||STAGE_FAILED||STAGE_ID!=LIMIT||id>=LIMIT||PROCESSES[id].ready!=1
  ||PINNED[id]||user_current_root()==PROCESSES[id].root||out==null||OBJECT_REGISTRY==null{return error.InvalidState;}
 if !object_core.owner_valid(id,owner)||(*OBJECT_REGISTRY).owners[id]!=owner{return error.InvalidState;}
 let obj=try object_core.get(OBJECT_REGISTRY,object);let pages=(*OBJECT_REGISTRY).objects[obj].pages;
 try object_slot_precheck(obj,pages);var index:usize=0;
 while index<4{let m=(*OBJECT_REGISTRY).maps[id][index];if m.state==0&&m.generation<0x00ff_ffff_ffff_ffff{break;}index+=1;}
 if index==4{return error.Capacity;}try shared_absent(id,object_core.BASE+index as u64*object_core.STRIDE,pages);
 let reserved=try object_core.reserve_map(OBJECT_REGISTRY,id,owner,GENERATIONS[id],object,rights);
 if reserved!=index{OBJECT_FAILED=true;object_core.hold_map(OBJECT_REGISTRY,id,reserved);return error.InvalidState;}
 let installed=object_map_commit(id,index);match installed{ok=>{},err(code)=>{object_core.hold_map(OBJECT_REGISTRY,id,index);OBJECT_FAILED=true;return installed;},}
 let map=(*OBJECT_REGISTRY).maps[id][index];
 *out=object_abi.Mapping{version:1,token:(map.generation<<8)|index as u64+1,address:map.address,bytes:map.pages as u64*4096,rights:map.rights,reserved:[0;3]};
}return;}
unsafe fn object_withdraw(id:usize,index:usize)!void{unsafe{
 let map=(*OBJECT_REGISTRY).maps[id][index];var p:usize=0;
 while p<map.pages{try paging.unmap_live(&SPACES[id],map.address+p as u64*4096,OBJECT_RECEIPTS+p);p+=1;}
 compiler_fence();if user_shared_barrier()!=1{return error.InvalidState;}compiler_fence();
 p=0;while p<map.pages{try paging.reclaim(&SPACES[id],OBJECT_RECEIPTS+p);p+=1;}
}return;}
pub unsafe fn object_unmap(id:usize,owner:u64,token:u64,out:*u64)!void{unsafe{
 if OBJECT_FAILED||UNSHARE_FAILED||STAGE_FAILED||STAGE_ID!=LIMIT||id>=LIMIT||PROCESSES[id].ready!=1
  ||PINNED[id]||user_current_root()==PROCESSES[id].root||OBJECT_RECEIPTS==null||out==null{return error.InvalidState;}
 let index=try object_core.map_get(OBJECT_REGISTRY,id,owner,GENERATIONS[id],token);
 let prechecked=object_precheck(id,&(*OBJECT_REGISTRY).maps[id][index]);
 match prechecked{ok=>{},err(code)=>{object_core.hold_map(OBJECT_REGISTRY,id,index);OBJECT_FAILED=true;return prechecked;},}
 (*OBJECT_REGISTRY).maps[id][index].state=3;let removed=object_withdraw(id,index);
 match removed{ok=>{},err(code)=>{object_core.hold_map(OBJECT_REGISTRY,id,index);OBJECT_FAILED=true;return removed;},}
 *out=object_core.release_map(OBJECT_REGISTRY,id,index);
}return;}
pub unsafe fn object_owner_gone(id:usize,owner:u64,out:*u64)!void{unsafe{
 if OBJECT_FAILED||id>=LIMIT||PROCESSES[id].ready!=0||PROCESSES[id].root!=0||out==null
  ||OBJECT_REGISTRY==null||!object_core.owner_valid(id,owner)||(*OBJECT_REGISTRY).owners[id]!=owner{return error.InvalidState;}
 var i:usize=0;var count:usize=0;while i<4{let map=(*OBJECT_REGISTRY).maps[id][i];
  if map.state!=0{let verified=try object_core.map_get(OBJECT_REGISTRY,id,owner,GENERATIONS[id],(map.generation<<8)|i as u64+1);count+=1;}i+=1;
 }
 compiler_fence();if count!=0&&user_shared_barrier()!=1{
  i=0;while i<4{if (*OBJECT_REGISTRY).maps[id][i].state!=0{object_core.hold_map(OBJECT_REGISTRY,id,i);}i+=1;}
  OBJECT_FAILED=true;return error.InvalidState;
 }compiler_fence();
 i=0;while i<4{*(out+i)=0;if (*OBJECT_REGISTRY).maps[id][i].state!=0{*(out+i)=object_core.release_map(OBJECT_REGISTRY,id,i);}i+=1;}
 (*OBJECT_REGISTRY).owners[id]=0;
}return;}

unsafe fn object_abort_owner(id:usize)void{unsafe{
 if OBJECT_REGISTRY==null{return;}var m:usize=0;
 while m<4{if (*OBJECT_REGISTRY).maps[id][m].state!=0{object_core.hold_map(OBJECT_REGISTRY,id,m);OBJECT_FAILED=true;return;}m+=1;}
 (*OBJECT_REGISTRY).owners[id]=0;
}return;}
